  test_st_shows_zipped_git_dirs() {
    # 'gz' archives a repo's git dir to .git.zip / .git.real.zip and removes
    # the live dir. st must show such a dir as [zipped] (not let it vanish),
    # tag a zipped PATH directly, NOT double a zipped-under-sidecar, and NOT
    # tag a live repo that merely keeps a backup zip (the 'gz -k' case).
    _rt_repo top
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    # plain nested repo, git dir zipped away
    ( cd top && mkdir plainkid && cd plainkid && git init -q && git config user.email t@t.com \
        && git config user.name t && git commit -qm x --allow-empty \
        && zip -qr .git.zip .git >/dev/null 2>&1 && rm -rf .git )
    # sidecar containing a nested sidecar; zip the INNER one (zipped-under-sidecar)
    ( cd top && mkdir -p sc/inner )
    ( cd top/sc && git init --separate-git-dir=.git.real -q && rm -f .git \
        && git --git-dir=.git.real config core.worktree .. )
    ( cd top/sc/inner && git init --separate-git-dir=.git.real -q && rm -f .git \
        && git --git-dir=.git.real config core.worktree .. \
        && zip -qr .git.real.zip .git.real >/dev/null 2>&1 && rm -rf .git.real )
    # gz -k style: LIVE repo that also keeps a backup .git.zip (must stay live)
    ( cd top && mkdir keptkid && cd keptkid && git init -q && git config user.email t@t.com \
        && git config user.name t && git commit -qm x --allow-empty \
        && zip -qr .git.zip .git >/dev/null 2>&1 )
    cd top || return 1
    _rt_ok "st -R on tree with zipped dirs" _rt_my_git -R st "$PWD" || return 1
    _rt_contains "a zipped dir is shown as [zipped]" "$_rt_out" "[zipped]" || return 1
    _rt_contains "zipped note mentions how to restore" "$_rt_out" "unflatten --zip" || return 1
    # exactly TWO [zipped] (plainkid + sc/inner), not three — no doubling, and
    # keptkid (live + backup zip) must not be counted
    _z=$(grep -c '\[zipped\]' "$_rt_out" 2>/dev/null)
    [ "$_z" = 2 ] || { _rt_fail "expected 2 [zipped] lines, got $_z (doubling, or gz -k repo wrongly zipped?)"; return 1; }
    # keptkid stays a live repo, never [zipped]
    if grep -F 'keptkid' "$_rt_out" | grep -qF '[zipped]'; then
      _rt_fail "a live repo with only a backup .git.zip (gz -k) was wrongly tagged [zipped]"; return 1
    fi
    # summary counts them
    _rt_contains "summary reports zipped=2" "$_rt_out" "zipped=2" || return 1
    # st on a zipped PATH directly must work (not 'not a git repo')
    _rt_ok "st on a zipped PATH" _rt_my_git st "$PWD/plainkid" || return 1
    _rt_contains "zipped path tagged [zipped]" "$_rt_out" "[zipped]" || return 1
    return 0
  }

