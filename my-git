  test_sidecar_is_ordinary_content_not_a_gitlink() {
    # Empirical verification (see conversation): a sidecar is NOT a git
    # submodule in any technical sense -- no gitlink, no .gitmodules
    # entry, nothing resolvable via 'git submodule'. To git it's just
    # an ordinary tracked directory (kid's files as plain 100644 blobs)
    # plus one more subdirectory that happens to be locally excluded
    # (via the PARENT's own .git/info/exclude, not a committed
    # .gitignore -- see _fl_write_sidecar_status's neighboring code).
    _rt_repo kid_o
    ( cd kid_o && printf '*.txt\n' > .gitignore && echo a > a.md && git add .gitignore a.md && git commit -q -m a )
    _rt_repo global
    ( cd global && git clone -q ../kid_o kid >/dev/null 2>&1 )
    # conf.ini deliberately OUTSIDE global/ — an untracked file inside
    # it would defeat the whole point of the "clean status" check below.
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    cd global || return 1
    _rt_ok "flatten go kid --sidecar" _rt_my_git flatten go kid --sidecar || return 1

    # 1) NOT a gitlink: mode 100644 (ordinary blob), not 160000.
    _rt_gitlink_mode "kid/a.md tracked as plain blob, not a gitlink" kid/a.md 100644 || return 1

    # 2) git status is clean right after sidecaring.
    _rt_clean "clean right after sidecaring" || return 1

    # 3) editing tracked content shows as an ordinary M.
    echo more >> kid/a.md
    _rt_s=$(git status --porcelain)
    case "$_rt_s" in
      *"M kid/a.md"*) : ;;
      *) _rt_fail "expected 'M kid/a.md' after editing tracked content, got: $_rt_s"; return 1 ;;
    esac
    git checkout -- kid/a.md

    # 4) a new file NOT matched by the kid's old .gitignore shows as
    #    ordinary untracked ?? -- normal discovery, no special casing.
    echo x > kid/newthing.log
    _rt_s=$(git status --porcelain)
    case "$_rt_s" in
      *"?? kid/newthing.log"*) : ;;
      *) _rt_fail "expected '?? kid/newthing.log', got: $_rt_s"; return 1 ;;
    esac
    rm -f kid/newthing.log

    # 5) .git.real is filesystem-visible even though git-status-invisible.
    _rt_isdir ".git.real filesystem-visible" kid/.git.real || return 1
    return 0
  }

  test_flatten_merge_deletes_and_snapshots_even_with_nothing_new_to_stage() {
    # Regression: found via a real-world case — a kid nested inside a
    # path whose enclosing scope was already captured some other way
    # (e.g. an already-sidecared grandparent), so the kid's own tracked
    # FILES are already byte-identical to what the parent has. The
    # deletion + .git.merged write happen EARLY (before the later 'git
    # add' even runs), so they must survive regardless of whether that
    # add finds any of the kid's own content newly stageable — and in
    # practice it always does anyway, since .git.merged itself is a
    # brand new file, so the commit succeeds normally rather than
    # hitting the (separate, still-tested-elsewhere) nothing-to-commit
    # bailout path.
    _rt_repo kid_o
    ( cd kid_o && echo a > a.txt && git add a.txt && git commit -q -m a )
    _rt_repo global
    ( cd global && git clone -q ../kid_o kid >/dev/null 2>&1 )
    # Pre-track kid's content in the parent BEFORE merging, simulating
    # content already captured some other way.
    ( cd global && _tmpgd=$(mktemp -d) && mv kid/.git "$_tmpgd/" \
        && git add -A && git commit -q -m "pre-existing copy of kid content" \
        && mv "$_tmpgd/.git" kid/ && rm -rf "$_tmpgd" )
    # conf.ini deliberately OUTSIDE global/ — an untracked file inside
    # it would defeat the "ends up clean" check below.
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    cd global || return 1
    _rt_ok "flatten go kid --merge" _rt_my_git flatten go kid --merge || return 1
    _rt_absent "kid/.git deleted even though its content was already tracked" kid/.git || return 1
    _rt_exists "kid/.git.merged written even though its content was already tracked" kid/.git.merged || return 1
    _rt_clean "parent ends up clean (snapshot file itself got committed)" || return 1
    return 0
  }

