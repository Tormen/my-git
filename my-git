  test_flatten_analyze_is_read_only_even_with_pending_sidecar_exclude() {
    # REGRESSION (found while testing on a real production tree): flatten
    # ANALYZE (no 'go') is documented as "print the plan, change nothing"
    # — but ensure_sidecar_exclude was called UNCONDITIONALLY near the
    # top of cmd_flatten, before the analyze/go branch. On a tree that
    # already HAS sidecars but not yet the '**/.git.real' .gitignore rule,
    # a plain 'flatten --merge <path>' (analyze) therefore wrote AND
    # staged a .gitignore change — a real write during a read-only run.
    # Fixed by gating that call on go mode. Here: a sidecar exists but the
    # exclude rule is deliberately absent, then an ANALYZE run must leave
    # .gitignore (and everything else) byte-for-byte untouched.
    _rt_repo_file kid_o a.md
    _rt_repo global
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd global && git clone -q ../kid_o kid >/dev/null 2>&1 )
    cd global || return 1
    _rt_ok "flatten go kid --sidecar" _rt_my_git flatten go kid --sidecar || return 1
    # Remove the exclude rule flatten's go-path added, so analyze has a
    # reason to (wrongly) re-add it — recreating the exact bug condition.
    if [ -f .gitignore ]; then grep -vxF '**/.git.real' .gitignore > .gitignore.tmp 2>/dev/null; mv .gitignore.tmp .gitignore; fi
    git add -A >/dev/null 2>&1; git commit -q -m "drop the exclude rule for the test" >/dev/null 2>&1
    _rt_before=$(git status --porcelain)
    _rt_before_gi=$(cat .gitignore 2>/dev/null)
    _rt_ok "flatten --merge kid (ANALYZE — must write nothing)" _rt_my_git flatten --merge kid || return 1
    _rt_after=$(git status --porcelain)
    [ "$_rt_before" = "$_rt_after" ] || { _rt_fail "analyze changed git status: before='$_rt_before' after='$_rt_after'"; return 1; }
    [ "$_rt_before_gi" = "$(cat .gitignore 2>/dev/null)" ] || { _rt_fail "analyze modified .gitignore"; return 1; }
    _rt_absent "analyze did NOT create the merge marker" kid/.git.merged || return 1
    _rt_isdir "analyze left the sidecar intact" kid/.git.real || return 1
    return 0
  }

  test_flatten_merge_sidecar_containing_embedded_repos() {
