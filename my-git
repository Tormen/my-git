    _rt_drv=$(mktemp "${TMPDIR:-/tmp}/${US}.purgedrv.XXXXXX") || { _rt_fail "mktemp py failed"; return 1; }
    cat > "$_rt_drv" <<'PYDRV'
import os, pty, sys, time, select
mygit, conf, phrase = sys.argv[1], sys.argv[2], sys.argv[3]
pid, fd = pty.fork()
if pid == 0:
    os.execv("/bin/sh", ["/bin/sh", mygit, "--config", conf, "purge", "go", "kid"])
sent = False
t0 = time.time(); buf = b""
while time.time() - t0 < 120:
    r, _, _ = select.select([fd], [], [], 0.5)
    if fd in r:
        try: d = os.read(fd, 4096)
        except OSError: break
        if not d: break
        buf += d
        if not sent and b"Type exactly" in buf:
            os.write(fd, phrase.encode() + b"\n"); sent = True
try: os.waitpid(pid, 0)
except OSError: pass
sys.stdout.write(buf.decode(errors="replace"))
PYDRV
    _rt_ok "drive purge go through the gate" \
      sh -c "python3 '$_rt_drv' '$_rt_self' '$_rt_conf_path' 'I am sure' > '$_rt_out' 2>&1" \
