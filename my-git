    cat > "$_rt_drv" <<'PYDRV'
import os, pty, sys, time, select
mygit, conf = sys.argv[1], sys.argv[2]
pid, fd = pty.fork()
if pid == 0:
    os.execv("/bin/sh", ["/bin/sh", mygit, "--config", conf, "flatten", "go", "-i"])
sent = 0
# lowercase 'z' must be REJECTED (modes are uppercase); 'Z' then applies zip; 'y' confirms
seq = [b"z\n", b"Z\n", b"y\n"]
t0 = time.time()
buf = b""
while time.time() - t0 < 20:
