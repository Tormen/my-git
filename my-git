  test_flatten_merge_stale_config_missing_sidecar_dirname_does_not_destroy_live_repo() {
    # CRITICAL regression: the direct sidecar->merge special case checks
    # '[ -d "$_fl_scope_path/$GIT_SIDECAR_DIRNAME" ]' to decide whether a
    # PATH is already a sidecar. Found by direct testing: if the config
    # doesn't set GIT_SIDECAR_DIRNAME at all (a real scenario -- e.g. a
    # config file written before the GIT_REAL_DIRNAME->GIT_SIDECAR_DIRNAME
    # rename), that variable is empty, so the check silently degrades to
    # '[ -d "$_fl_scope_path/" ]' -- true for ANY existing path. An
    # ordinary LIVE registered/embedded nested repo (not a sidecar at
    # all) then wrongly takes the "already a sidecar, merge directly"
    # branch and gets destroyed instead of properly merged. Fixed by
    # giving GIT_SIDECAR_DIRNAME a back-compat default in load_config()
    # (': "${GIT_SIDECAR_DIRNAME:=.git.real}"'), same pattern already
    # used there for MC_AUTO_COMMIT_UNTRACKED/ST_EXCLUDE_DIRS.
    _rt_repo kid_o
    ( cd kid_o && echo a > a.md && git add a.md && git commit -q -m a )
    _rt_repo global
    ( cd global && git clone -q ../kid_o kid >/dev/null 2>&1 )
    _rt_conf_path="$PWD/conf.ini"
    # Deliberately a STALE config: everything _rt_conf normally writes,
    # EXCEPT GIT_SIDECAR_DIRNAME -- simulating a config file that
    # predates that variable's existence.
    cat > "$_rt_conf_path" <<'_RT_STALE_CONF_EOF'
GIT_REPOS=""
CHECK_CLAUDE_SETUP=0
CLAUDE_PROJECT_DIR_CENTRAL_REPO=""
COMMIT_MSG_LAST_N=3
COMMIT_MSG_DIFF_MAX_FILES=10
MC_AUTO_COMMIT_UNTRACKED=1
ST_EXCLUDE_DIRS=""
PRIV_POLICY_USER_TO_ROOT=warn
PRIV_POLICY_USER_TO_USER=fail
DEFAULT_VERBOSE=0
DEFAULT_DEBUG=0
SM_AUTO_SAFE_DIRECTORY=1
SM_SSH_CONNECT_TIMEOUT=5
AUTO_SIDECAR_SUBMODULES=0
AUTO_SIDECAR_EMBEDDED=0
_RT_STALE_CONF_EOF
    cd global || return 1

    _rt_ok "flatten go kid --merge (stale config missing GIT_SIDECAR_DIRNAME)" _rt_my_git flatten go kid --merge || return 1
    _rt_exists "kid/a.md survives (repo was merged, not destroyed)" kid/a.md || return 1
    _rt_absent "kid/.git deleted (real merge happened)" kid/.git || return 1
    _rt_exists "kid/.git.merged written (real merge happened)" kid/.git.merged || return 1
