_my-git() {
  local context state line
  typeset -A opt_args

  local -a commands
  commands=(
    'status:Recursive overview of every repo in a tree (alias: st, s)'
    'masscommits:Analyze / go = add+commit+push (alias: mc, c)'
    'pull:Fetch + fast-forward clean/behind repos (alias: pl)'
    'fetch:Refs-only update, never merges'
    'sync:Composite sm -> pull -> mc (alias: syn)'
    'remote:List / audit git remotes (alias: rem)'
    'flatten:Nested repo -> parent content; modes --sidecar/--merge/--zip (alias: fl)'
    'unflatten:Reverse of flatten — rebuild a live .git (alias: unfl)'
    'shadow:Keep nested .git LIVE and also track its files in the parent; content-mirror (alias: sh)'
    'unshadow:Reverse of shadow — parent stops tracking; .git stays live (alias: unsh)'
    'purge:Remove a path'\''s content AND history from a repo — REWRITES HISTORY'
