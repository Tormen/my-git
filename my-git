  test_repair_summary_and_bare_repair() {
    # Bare 'repair' defaults to --sidecar analyze (no error). A clean tree
    # says NOTHING to auto-repair and does NOT offer 'go'; a tree with a
    # fixable issue offers 'go', and 'go' reports FIXED. (So the user always
    # knows whether anything happened — the reported UX bug.)
    _rt_repo_file kid_o k.txt
    _rt_repo top
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
