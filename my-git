  test_flatten_merge_preserves_history_in_parent() {
    # THE point of merge preservation: after 'flatten --merge' the nested
    # repo's .git is gone from the path, but every one of its commits,
    # branches and tags must be READABLE FROM THE PARENT under
    # refs/my-git/merged/<path>/. Before this, merge deleted the object
    # database outright and the history was gone for good.
    _rt_repo_file kid_o a.md
    ( cd kid_o && echo b > b.md && git add b.md && git commit -q -m second \
        && git tag v1 && git branch sidebranch )
    _rt_repo global
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd global && git clone -q ../kid_o kid >/dev/null 2>&1 )
    # A clone lands non-default branches under refs/remotes/origin/, so
    # make a genuine LOCAL branch to prove refs/heads/* is carried too.
    git --git-dir=global/kid/.git branch sidebranch HEAD
    cd global || return 1
    _kid_tip=$(git --git-dir=kid/.git rev-parse HEAD)
    _kid_n=$(git --git-dir=kid/.git rev-list --count HEAD)

    _rt_ok "flatten go kid --merge" _rt_my_git flatten go kid --merge || return 1
    _rt_absent "kid/.git no longer at the path" kid/.git || return 1

    # The tip must be a real, readable object in the PARENT now.
    git cat-file -e "$_kid_tip^{commit}" 2>/dev/null \
      || { _rt_fail "kid's tip $_kid_tip is NOT in the parent object DB — history was lost"; return 1; }
    [ "$(git rev-list --count "$_kid_tip")" = "$_kid_n" ] \
      || { _rt_fail "expected $_kid_n commit(s) reachable from the preserved tip"; return 1; }
    git rev-parse -q --verify refs/my-git/merged/kid/heads/sidebranch >/dev/null \
      || { _rt_fail "branch 'sidebranch' not pinned under refs/my-git/merged/kid/"; return 1; }
    git rev-parse -q --verify refs/my-git/merged/kid/tags/v1 >/dev/null \
      || { _rt_fail "tag 'v1' not pinned under refs/my-git/merged/kid/"; return 1; }
    _rt_contains "snapshot records the preserved namespace" kid/.git.merged "preserved-refs: refs/my-git/merged/kid/" || return 1
    _rt_contains "snapshot says history-preserved: yes" kid/.git.merged "history-preserved: yes" || return 1
    _rt_clean "parent ends up clean" || return 1
    return 0
  }

  test_unflatten_merge_restores_full_preserved_history() {
    # Round trip: everything merge preserved must come back — the FULL
    # pre-merge commit count (not just merge-day-forward, which is all
    # the old subtree-split fallback could manage), plus branches, tags,
    # and the original branch checked out. The worktree must NOT be
    # reset: post-merge edits survive as uncommitted changes.
    _rt_repo_file kid_o a.md
    ( cd kid_o && echo b > b.md && git add b.md && git commit -q -m second \
        && git tag v1 && git branch sidebranch )
    _rt_repo global
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd global && git clone -q ../kid_o kid >/dev/null 2>&1 )
    git --git-dir=global/kid/.git branch sidebranch HEAD
    cd global || return 1
    _kid_n=$(git --git-dir=kid/.git rev-list --count HEAD)
    _kid_branch=$(git --git-dir=kid/.git symbolic-ref --short HEAD)
    _rt_ok "flatten go kid --merge" _rt_my_git flatten go kid --merge || return 1
    # Post-merge drift, committed by the PARENT — must survive unflatten.
    echo "after the merge" >> kid/a.md
    git add kid/a.md && git commit -q -m "parent edits kid/a.md after the merge"

    _rt_ok "unflatten go kid --merge" _rt_my_git unflatten go kid --merge || return 1
    _rt_isdir "kid/.git is live again" kid/.git || return 1
    [ "$(git -C kid rev-list --count HEAD)" = "$_kid_n" ] \
      || { _rt_fail "expected the full $_kid_n-commit pre-merge history back, got $(git -C kid rev-list --count HEAD)"; return 1; }
    [ "$(git -C kid symbolic-ref --short HEAD)" = "$_kid_branch" ] \
      || { _rt_fail "HEAD should be back on '$_kid_branch'"; return 1; }
