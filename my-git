  test_scope_walks_up_to_unreadable_enclosing_repo_not_git_repos() {
    # REGRESSION (found running bare 'my-git' from /LINKS/global as a
    # non-root user): standing INSIDE a repo whose .git this user cannot
    # READ (e.g. root-owned) must scope to THAT repo, not fall back to the
    # whole $GIT_REPOS list and scan unrelated trees. git's own detection
    # ('git rev-parse') fails on the unreadable .git, so a filesystem
    # walk-up (fs_toplevel_of) must catch the enclosing repo first.
    # Simulated with chmod 000 on .git: 'git rev-parse' fails, but the
    # '.git' entry is still visible to a plain '[ -e ]' test.
    _rt_repo enclosing
    ( cd enclosing && mkdir -p deep/sub && echo x > deep/sub/f.txt && git add -A && git commit -q -m x )
    _rt_repo decoy_repo   # would appear ONLY if scope wrongly fell back to $GIT_REPOS
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    printf 'GIT_REPOS="%s/decoy_repo"\n' "$PWD" >> "$_rt_conf_path"
    chmod 000 enclosing/.git
    ( cd enclosing/deep/sub && _rt_my_git st ) > "$_rt_out" 2>&1
    chmod -R u+rwx enclosing/.git 2>/dev/null   # restore BEFORE asserting so harness cleanup works
    _rt_contains "scoped to the enclosing repo (via fs walk-up)" "$_rt_out" "enclosing" || return 1
    _rt_not_contains "did NOT widen scope to the \$GIT_REPOS decoy" "$_rt_out" "decoy_repo" || return 1
    return 0
  }

