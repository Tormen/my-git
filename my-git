  test_audit_and_repair_sidecar_setup() {
    # 'audit --sidecar' must DETECT the three fixable setup faults a legacy
    # sidecar can carry, and 'repair --sidecar go' must FIX all three while
    # leaving files on disk. Then a re-audit must come back clean.
    _rt_repo_file kid_o k.txt
    _rt_repo repo
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd repo && git clone -q ../kid_o sc >/dev/null 2>&1 )
    cd repo || return 1
    _rt_ok "sidecar sc" _rt_my_git flatten go sc --sidecar || return 1
    # ── deliberately BREAK the setup that flatten got right ───────────────
    #  (A) drop the tracked exclude
    rm -f .gitignore
    #  (C) make core.worktree absolute (non-portable)
    git config --file sc/.git.real/config core.worktree "$PWD/sc"
    #  (B) commit the sidecar object-DB as content
    git add -f sc/.git.real >/dev/null 2>&1
    git commit -q -m "break: track internals + drop exclude" >/dev/null 2>&1
    # ── analyze: all three must be reported, nothing changed ──────────────
    _rt_ok "audit --sidecar analyze" _rt_my_git audit --sidecar "$PWD" || return 1
    _rt_contains "audit flags missing exclude" "$_rt_out" "not in tracked .gitignore" || return 1
    _rt_contains "audit flags tracked object-DB" "$_rt_out" "TRACKED as content" || return 1
    _rt_contains "audit flags absolute worktree"  "$_rt_out" "core.worktree is absolute" || return 1
    # analyze must NOT have touched anything
    _rt_absent "analyze did not add .gitignore" .gitignore || return 1
    [ -n "$(git ls-files -- 'sc/.git.real/*' 2>/dev/null)" ] || { _rt_fail "analyze wrongly untracked internals"; return 1; }
    # ── go: apply the fixes ───────────────────────────────────────────────
    _rt_ok "repair --sidecar go" _rt_my_git repair --sidecar go "$PWD" || return 1
    _rt_exists "repair added .gitignore" .gitignore || return 1
    _rt_contains "exclude entry present" .gitignore "**/.git.real" || return 1
    [ -z "$(git ls-files -- 'sc/.git.real/*' 2>/dev/null)" ] || { _rt_fail "repair did not untrack internals"; return 1; }
    # The removal must be COMMITTED, not merely staged. (An earlier bug used
    # 'git commit -- <dir>', which takes the WORKTREE view where the files
    # still exist and so commits nothing — leaving the rm --cached staged.
    # 'git ls-files' reads the index and would look "clean" either way, so
    # assert on BOTH the index being empty AND HEAD no longer holding them.)
    [ -z "$(git diff --cached --name-only 2>/dev/null)" ] || { _rt_fail "repair left the untracking staged, not committed"; return 1; }
    [ -z "$(git ls-tree -r HEAD -- sc/.git.real 2>/dev/null)" ] || { _rt_fail "sidecar internals still present in HEAD after repair"; return 1; }
    _rt_isdir "internals still on disk after repair" sc/.git.real || return 1
    _cw=$(git config --file sc/.git.real/config core.worktree)
    [ "$_cw" = ".." ] || { _rt_fail "core.worktree not made portable, got '$_cw'"; return 1; }
    # ── re-audit: clean, no ISSUE lines ──────────────────────────────────
    _rt_ok "audit after repair" _rt_my_git audit --sidecar "$PWD" || return 1
    _rt_not_contains "no residual ISSUE after repair" "$_rt_out" "ISSUE" || return 1
    return 0
  }

  test_repair_sidecar_does_not_sweep_pre_staged_work() {
    # The (B) untrack step must commit ONLY its own index-only removal. If
    # the user already has UNRELATED staged changes, a plain 'git commit'
    # would sweep them in — so repair must SKIP (B) and warn, leaving both
    # the tracked internals AND the user's staged work exactly as they were.
    _rt_repo_file kid_o k.txt
    _rt_repo repo
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd repo && git clone -q ../kid_o sc >/dev/null 2>&1 )
