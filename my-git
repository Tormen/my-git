  test_shadow_hook_bumps_last_shadowed_on_commit() {
    # shadow installs a parent pre-commit hook that bumps 'last-shadowed' at
    # COMMIT time — ONLY for shadowed repos that commit stages content into,
    # atomically (marker rides in the same commit). Untouched repos stay put;
    # the hook is retired when the last shadow is removed.
    _rt_repo_file kid_o k.txt
    _rt_repo top
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd top && git clone -q ../kid_o a >/dev/null 2>&1 && git clone -q ../kid_o b >/dev/null 2>&1 )
    cd top || return 1
    _rt_ok "shadow go" _rt_my_git shadow go || return 1
    _rt_exists "pre-commit hook installed" .git/hooks/pre-commit || return 1
    grep -qF 'my-git shadow (managed block' .git/hooks/pre-commit \
      || { _rt_fail "hook missing the managed block"; return 1; }
    _a0=$(sed -n 's/^last-shadowed: //p' a/.git.shadow.status | head -1)
    _b0=$(sed -n 's/^last-shadowed: //p' b/.git.shadow.status | head -1)
    # touch a NEW file in 'a' only, then a normal commit
    echo new > a/brand.txt
    sleep 1
    git add -A >/dev/null 2>&1
    git commit -q -m "touch a" >/dev/null 2>&1 || { _rt_fail "commit failed"; return 1; }
    _a1=$(sed -n 's/^last-shadowed: //p' a/.git.shadow.status | head -1)
    _b1=$(sed -n 's/^last-shadowed: //p' b/.git.shadow.status | head -1)
    [ "$_a0" != "$_a1" ] || { _rt_fail "a's last-shadowed should bump on commit (was $_a0)"; return 1; }
    [ "$_b0" = "$_b1" ] || { _rt_fail "b (untouched) last-shadowed must NOT change"; return 1; }
    # bumped marker rode in the commit — nothing left staged/dirty
    if [ -n "$(git status --porcelain a/.git.shadow.status 2>/dev/null)" ]; then
      _rt_fail "a's marker left dirty — not committed atomically by the hook"; return 1
    fi
    git show --stat --oneline HEAD 2>/dev/null | grep -qF 'a/.git.shadow.status' \
      || { _rt_fail "the bumped marker should be part of that commit"; return 1; }
    # remove the last shadow -> hook retired
    _rt_ok "unshadow go" _rt_my_git unshadow go || return 1
    _rt_absent "pre-commit hook retired after last unshadow" .git/hooks/pre-commit || return 1
    return 0
  }

  test_shadow_hook_preserves_foreign_precommit() {
