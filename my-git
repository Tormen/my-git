    git add -f kid >/dev/null 2>&1
    mv "$_rt_hold" kid/.git
    git commit -q -m "damaged: content staged over the gitlink"
    [ -z "$(git ls-files -s -- kid | awk '$1 == 160000 { print }')" ] \
      || { _rt_fail "setup: kid should NOT be a gitlink any more"; return 1; }

