  test_run_as_owner_capture_warns_on_mixed_ownership() {
    # The mixed-ownership trap: my-git reads a repo as its .git owner, but a
    # tracked file (.gitmodules, …) is owned by someone else -> Permission
    # denied -> empty result. Silently under-reporting is the real defect;
    # run_as_owner_capture must WARN loudly (once per repo), and stay quiet on
    # a genuinely-empty clean read.
    _rt_repo repo
    cd repo || return 1
    # simulate git hitting a root-owned tracked file: empty stdout, error stderr.
    run_as_owner_capture "$PWD" sh -c 'echo "warning: unable to access foo: Permission denied" >&2' \
      2>"$_rt_err" >/dev/null
    _rt_contains "warns loudly about mixed ownership" "$_rt_err" "mixed ownership" || return 1
    # deduped: a second access failure for the SAME repo must not re-warn.
    run_as_owner_capture "$PWD" sh -c 'echo "Permission denied" >&2' 2>"${_rt_err}.2" >/dev/null
    if grep -q 'mixed ownership' "${_rt_err}.2" 2>/dev/null; then
      _rt_fail "should warn only once per repo per run"; return 1
    fi
    # a clean read (no access error) on a DIFFERENT repo must NOT warn.
    cd .. || return 1
    _rt_repo clean_repo
    run_as_owner_capture "$PWD/clean_repo" sh -c 'echo ok' 2>"${_rt_err}.3" >/dev/null
    if grep -q 'mixed ownership' "${_rt_err}.3" 2>/dev/null; then
      _rt_fail "must not warn on a clean read"; return 1
    fi
    return 0
  }

  test_st_broken_gitdir_not_masquerade_as_parent() {
