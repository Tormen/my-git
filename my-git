  test_audit_repair_sidecar_untracked_content() {
    # A sidecar's worktree content (incl. its .status snapshot) must be
    # TRACKED by the parent. audit --sidecar flags untracked sidecar files;
    # repair go 'git add's+commits them, while never tracking .git.real.
    _rt_repo_file kid_o k.txt
    _rt_repo top
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd top && git clone -q ../kid_o sc >/dev/null 2>&1 )
