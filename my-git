    _rt_not_contains "must not claim the submodule's parent mirrors it" "$_rt_out" "does NOT mirror it" || return 1
    _rt_absent "stale marker cleaned" mid/kid/.git.shadow.status || return 1
    # The gitlink itself must be left completely alone.
    [ "$(cd mid && git ls-files -s -- kid | awk '{print $1}')" = 160000 ] \
      || { _rt_fail "the submodule registration was damaged"; return 1; }
    return 0
  }

