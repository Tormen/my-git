  test_pull_heals_a_missing_strategy_but_never_overrides_one() {
    # Since git 2.27, 'git pull' on a DIVERGED branch aborts outright with
    # "Need to specify how to reconcile divergent branches". That is a
    # configuration gap, not a conflict, and every repo hits it separately.
    # pull fills the gap -- but ONLY when there is one: pull.rebase/pull.ff
    # is a real preference, and overwriting a stated one is exactly the
    # "my-git decided for you" damage this tool has caused before.
    _rt_repo up_o
    ( cd up_o && echo a > a.md && git add -A && git commit -q -m one )
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    git clone -q up_o work >/dev/null 2>&1
    ( cd up_o && echo b > b.md && git add -A && git commit -q -m theirs )
    cd work || return 1
    git config user.email t@t.com; git config user.name t
    echo c > c.md && git add -A && git commit -q -m mine        # diverged
    git config --unset pull.rebase 2>/dev/null
    git config --unset pull.ff 2>/dev/null

    _rt_ok "pull go heals the gap" _rt_my_git pull go || return 1
    [ "$(git config --get pull.rebase)" = false ] \
      || { _rt_fail "no strategy was set (got '$(git config --get pull.rebase)')"; return 1; }

    # A stated preference must survive untouched.
    git config pull.rebase true
    _rt_ok "pull go again" _rt_my_git pull go || return 1
    [ "$(git config --get pull.rebase)" = true ] \
      || { _rt_fail "overwrote an existing preference"; return 1; }

    # The knob IS the strategy, so it must also be able to choose one...
    git config --unset pull.rebase
    AUTOHEAL_PULL_STRATEGY=rebase _rt_my_git pull go >/dev/null 2>&1
    [ "$(git config --get pull.rebase)" = true ] \
      || { _rt_fail "AUTOHEAL_PULL_STRATEGY=rebase did not choose rebase"; return 1; }
    git config --unset pull.rebase
    AUTOHEAL_PULL_STRATEGY=ff-only _rt_my_git pull go >/dev/null 2>&1
    [ "$(git config --get pull.ff)" = only ] \
      || { _rt_fail "AUTOHEAL_PULL_STRATEGY=ff-only did not set pull.ff"; return 1; }
    git config --unset pull.ff

    # ...and every off-word must disable it.
    for _rt_off in "" no off 0; do
      git config --unset pull.rebase 2>/dev/null
      AUTOHEAL_PULL_STRATEGY="$_rt_off" _rt_my_git pull go >/dev/null 2>&1
      [ -z "$(git config --get pull.rebase)" ] \
        || { _rt_fail "healed despite AUTOHEAL_PULL_STRATEGY='$_rt_off'"; return 1; }
    done
    return 0
  }

  test_st_heals_pull_strategy_only_where_the_branch_diverged() {
    # 'st' heals the missing pull strategy, because 'st' is what people run
    # -- wiring it only into 'my-git pull' meant a plain 'my-git' left the
    # repo still unable to pull. But it heals ONLY on a DIVERGED row: that
    # is the sole state where the gap actually bites, and healing every repo
    # cost 0.3s per st to fix something almost none of them had.
    _rt_repo up_o
    ( cd up_o && echo a > a.md && git add -A && git commit -q -m one )
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
