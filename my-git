try: os.waitpid(pid, 0)
except OSError: pass
sys.stdout.write(buf.decode(errors="replace"))
PYDRV
    _rt_ok "drive -i menu via pty (choose zip)" sh -c "python3 '$_rt_drv' '$_rt_self' '$_rt_conf_path' > '$_rt_out' 2>&1" || { rm -f "$_rt_drv"; return 1; }
