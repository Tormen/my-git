      git config user.email t@t.com; git config user.name t
      mkdir subdir; echo content > subdir/readme.txt
      git add subdir; git commit -q -m "src content"
      git clone -q ../../normal-child-o normal-child >/dev/null 2>&1
      mkdir -p empty-child; git init -q empty-child >/dev/null 2>&1
      touch normal-child/.git/../.git 2>/dev/null || true
