  test_unshadow_stops_parent_tracking() {
    # unshadow reverses shadow: the parent stops tracking the files
    # ('git rm --cached' + commit) but the nested LIVE .git is UNTOUCHED.
    _rt_repo_file kid_o k.txt
    _rt_repo top
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd top && git clone -q ../kid_o kid >/dev/null 2>&1 )
