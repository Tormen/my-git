  # MY_GIT_SELFTEST in cmd_run_tests for why.
  [ -z "${MY_GIT_SELFTEST:-}" ] || return 0

  _comp_dir="$HOME/.zsh/completions"
  _comp_file="$_comp_dir/_my-git"

  _tmp=$(mktemp 2>/dev/null) || return 0
  cat >"$_tmp" <<'COMPLETION_EOF'
