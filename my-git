    _rt_contains "took a backup first" "$_rt_out" "backing up .git" || return 1
    _rt_n_after=$(git log --oneline --all -- kid 2>/dev/null | grep -c .)
    [ "$_rt_n_after" = 0 ] \
      || { rm -f "$_rt_drv"; _rt_fail "kid still appears in $_rt_n_after commit(s) after purge"; return 1; }
    # The path's OWN repo and its files are untouched — purge removes the
