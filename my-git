# ════════════════════════════════════════════════════════════════════════
# ═══ SUBMODULES (sm) — merged from my-git-submodules.sh ════════════════
# ════════════════════════════════════════════════════════════════════════
# Helpers prefixed _sm_ where they would clash with my-git-level names.
# Everything else retains its original name.

_sm_IGNORE_MARKER='my-git.ignore'
_sm_PREEXISTING_SUFFIX='.preexisting.'

_sm_ask() {
  _prompt=$1
  if [ -r /dev/tty ]; then
    printf '%s' "$_prompt" >/dev/tty
    IFS= read -r _ans </dev/tty || _ans=''
    # Strip all whitespace (including trailing CR from CRLF-ish terminals)
    # so case-matches like a|A actually fire for typed single-char answers.
    _ans=$(printf '%s' "$_ans" | tr -d '[:space:]')
    printf '%s' "$_ans"
  else
    printf 'error: interactive prompt needed but no TTY available: %s\n' \
      "$_prompt" >&2
    exit 4
  fi
}

_sm_record_change() {
  # _sm_record_change <path>
  # Append <path> (a worktree-relative path) to SM_COMMIT_PATHS if not
  # already present. Used to track the exact set of tracked files my-git
  # touched in this run, so we can commit ONLY those paths at the end
  # without dragging in the user's unrelated staged/unstaged changes.
  _rc_p=$1
  [ -n "$_rc_p" ] || return 0
  # Normalize: strip any leading ./
  case "$_rc_p" in ./*) _rc_p=${_rc_p#./} ;; esac
  case "
${SM_COMMIT_PATHS}
" in
    *"
${_rc_p}
"*) return 0 ;;
  esac
  SM_COMMIT_PATHS="${SM_COMMIT_PATHS}${_rc_p}
"
}

_sm_append_negation() {
  # _sm_append_negation <gitignore-file> <path-relative-to-its-dir>
  # Appends '!<rel>/\n' (with a leading newline if needed). Idempotent:
  # returns 0 without appending if the exact line is already present.
  # Returns 1 on write failure.
  _an_file=$1
  _an_rel=$2
  _an_line="!${_an_rel}/"
  if [ -f "$_an_file" ] && grep -qxF "$_an_line" "$_an_file" 2>/dev/null; then
    return 2
  fi
  if [ -s "$_an_file" ]; then
    _an_last=$(tail -c1 "$_an_file" 2>/dev/null)
    if [ "$_an_last" != "" ] && [ "$_an_last" != "
" ]; then
      printf '\n' >> "$_an_file" 2>/dev/null || {
        log_error "could not append to $_an_file — skipping"
        return 1
      }
    fi
  fi
  printf '%s\n' "$_an_line" >> "$_an_file" 2>/dev/null || {
    log_error "could not append to $_an_file — skipping"
    return 1
  }
  return 0
}

_sm_normalize_url() {
  _u=$1
  _u=$(printf '%s' "$_u" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  case "$_u" in
    https://github.com/*/*)
      _rest=${_u#https://github.com/}
      _owner=${_rest%%/*}
      _rest=${_rest#*/}
      _repo=${_rest%%/*}
      _repo=${_repo%.git}
      printf 'git@github.com:%s/%s.git' "$_owner" "$_repo"
      ;;
    *) printf '%s' "$_u" ;;
  esac
}

_sm_url_is_suspicious() {
  case "$1" in
    git+ssh://*|git+https://*|ssh+git://*) return 0 ;;
    *) return 1 ;;
  esac
}

_sm_resolve_gitdir() {
  _gp=$1; _sp=$2
  if [ -d "$_gp" ]; then
    printf '%s' "$_gp"
  else
    # A registered submodule can sit on disk with NO .git at all -- never
    # initialised, or its gitdir removed. That is a legitimate state, not an
    # error, but reading the gitfile blind made sed print
    # "No such file or directory" to stderr on every single run.
    [ -f "$_gp" ] || return 1
    _gd=$(sed -n 's/^gitdir: //p' "$_gp" 2>/dev/null)
    case "$_gd" in
      /*) printf '%s' "$_gd" ;;
      *)  printf '%s/%s' "$_sp" "$_gd" ;;
    esac
  fi
}

_sm_resolve_cfg() {
  _gd=$(_sm_resolve_gitdir "$1" "$2")
  printf '%s/config' "$_gd"
}

_sm_ignore_marker_path() {
  _gd=$(_sm_resolve_gitdir "$1" "$2")
  printf '%s/%s' "$_gd" "$_sm_IGNORE_MARKER"
}

_sm_is_ignored() {
  [ -e "$(_sm_ignore_marker_path "$1" "$2")" ]
}

_sm_mark_ignored() {
  _m=$(_sm_ignore_marker_path "$1" "$2")
  : > "$_m" 2>/dev/null || {
    printf 'WARN  could not create ignore marker at %s\n' "$_m" >&2
    return 1
  }
  printf 'IGNORE   marker written: %s\n' "$_m"
}

_sm_unmark_ignored() {
  _m=$(_sm_ignore_marker_path "$1" "$2")
  [ -e "$_m" ] || return 0
  rm -f "$_m" 2>/dev/null || {
    printf 'WARN  could not remove ignore marker at %s\n' "$_m" >&2
    return 1
  }
}

# ─── ignore / unignore (top-level) ──────────────────────────────────────
# Toggle the GENERIC nested-repo ignore marker. It is NOT sm-specific: an
# ignored nested repo is left alone by EVERY my-git subcommand — 'st' does
# not descend into it, 'sm' does not register it as a submodule, 'mc' does
# not auto-commit it, 'flatten' does not touch it. It's the opt-out that
# keeps a nested repo a deliberate raw-nested-git. (On-disk marker file:
# '$_sm_IGNORE_MARKER'.) The marker lives inside the repo's own gitdir, so it
# is tracked by nothing — a pure filesystem flag, no commit needed.
#
# Echo the .git PATH (for the _sm_* helpers) of worktree $1 — its live '.git'
# or, for a flattened sidecar, its GIT_SIDECAR_DIRNAME. Fails if neither.
_ign_gitpath_of() {
  _igp=$1
  if [ -e "$_igp/.git" ]; then
    printf '%s/.git' "$_igp"
  elif [ -d "$_igp/${GIT_SIDECAR_DIRNAME:-.git.real}" ]; then
    printf '%s/%s' "$_igp" "${GIT_SIDECAR_DIRNAME:-.git.real}"
  else
    return 1
  fi
}

# Print repo paths (relative to cwd) that carry the ignore marker — the bulk
# target set for a bare 'unignore'. Same discovery as 'sm --list-ignored'
# (live nested '.git' at depth >= 2).
_ign_list_ignored() {
  find "${1:-.}" -mindepth 2 -name .git \( -type d -o -type f \) 2>/dev/null | sort \
    | while IFS= read -r _ili_gp; do
        _ili_sp=${_ili_gp%/.git}; _ili_sp=${_ili_sp#./}
        _sm_is_ignored "$_ili_gp" "$_ili_sp" && printf '%s\n' "$_ili_sp"
      done
}

# Consistent with flatten/unflatten/shadow/unshadow: analyze by default, 'go'
# to apply, '-i' to confirm per repo, and a bare verb acts tree-wide. 'ignore'
# needs a <path> (no bulk 'ignore everything'); bare 'unignore' targets EVERY
# ignored repo under the toplevel.
_ignore_apply() {
  _ia_mode=$1; shift    # 'ignore' | 'unignore'
  _ia_go=analyze
  _ia_i=0
  _ia_scope_raw=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        printf 'usage: %s %s [go] [-i] %s\n' "$US" "$_ia_mode" \
          "$([ "$_ia_mode" = unignore ] && printf '[<path>]' || printf '<path>')"
        printf '  Toggle the generic nested-repo ignore marker (%s) — analyze by\n' "$_sm_IGNORE_MARKER"
        printf '  default, apply with '\''go'\'' (-i to confirm per repo).\n'
        printf '  An ignored repo is left alone by ALL my-git ops: st won'\''t descend,\n'
        printf '  sm won'\''t register it as a submodule, mc/flatten skip it.\n'
        [ "$_ia_mode" = unignore ] && \
          printf '  With no <path>, acts on EVERY ignored repo under the toplevel.\n'
        printf '  List current: %s sm --list-ignored\n' "$US"
        exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose) VERYVRB=1 ;;
      -D|--debug) DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      go) _ia_go=go ;;
      -n|-T|--try|--dry|--dry-run) _ia_go=analyze ;;
      -i|--interactive) _ia_i=1; require_tty "$_ia_mode" ;;
      --) shift; break ;;
      -*) fatal "$_ia_mode: unknown option: $1" 64 ;;
      *) [ -n "$_ia_scope_raw" ] && fatal "$_ia_mode: only one path argument is supported (got '$_ia_scope_raw' and '$1')" 64
         _ia_scope_raw=$1 ;;
    esac
    shift
  done
  if [ $# -gt 0 ]; then
    [ -n "$_ia_scope_raw" ] && fatal "$_ia_mode: only one path argument is supported" 64
    _ia_scope_raw=$1
  fi

  _ia_top=$(git_toplevel_of "$PWD"); [ -n "$_ia_top" ] || fatal "$_ia_mode: not inside a git repo" 1
  _ia_scope=""
  if [ -n "$_ia_scope_raw" ]; then
    _ia_abs=$(cd "$_ia_scope_raw" 2>/dev/null && pwd -P) || fatal "$_ia_mode: '$_ia_scope_raw': no such directory" 1
    _ia_top_abs=$(cd "$_ia_top" 2>/dev/null && pwd -P)
    case "$_ia_abs" in
      "$_ia_top_abs")   fatal "$_ia_mode: '$_ia_scope_raw' is the toplevel itself, not a nested repo" 64 ;;
      "$_ia_top_abs"/*) _ia_scope=${_ia_abs#"$_ia_top_abs"/} ;;
      *)                fatal "$_ia_mode: '$_ia_scope_raw' is not inside $_ia_top" 64 ;;
    esac
  fi
  cd "$_ia_top" || fatal "$_ia_mode: cannot cd to $_ia_top" 1

  # Unusual among the mutating commands: NOTHING is committed, and the
  # toplevel is only used to resolve the path. The marker is written into
  # the NESTED repo's own gitdir, which no repo tracks.
  log_repo_context "$_ia_mode" "$_ia_top" \
    "used ONLY to resolve the path -- this repo is NOT modified and NOTHING is committed" \
    "${_ia_scope:+target: $_ia_scope}" \
    "the marker is written inside the nested repo's own gitdir ($_sm_IGNORE_MARKER) -- untracked by every repo"

  # Build the target list.
  if [ -n "$_ia_scope" ]; then
    _ign_gitpath_of "$_ia_scope" >/dev/null 2>&1 \
      || fatal "$_ia_mode: '$_ia_scope' is not a nested git repo (no .git or ${GIT_SIDECAR_DIRNAME:-.git.real})" 1
    _ia_list=$_ia_scope
  elif [ "$_ia_mode" = ignore ]; then
    fatal "ignore: needs a <path> to ignore (there is no bulk 'ignore everything' — it would be a foot-gun). Ignore one repo:  $US ignore go <path>" 64
  else
    _ia_list=$(_ign_list_ignored ".")
    [ -n "$_ia_list" ] || { log_major "$_ia_top: nothing to unignore (no repo carries the $_sm_IGNORE_MARKER marker)"; exit 0; }
  fi

  # Analyze (default): show the plan, don't touch anything.
  if [ "$_ia_go" != go ]; then
    log_major "$_ia_top: $_ia_mode plan"
    printf '%s\n' "$_ia_list" | while IFS= read -r _p; do
      [ -n "$_p" ] || continue
      _gp=$(_ign_gitpath_of "$_p" 2>/dev/null) || continue
      if [ "$_ia_mode" = ignore ]; then
        if _sm_is_ignored "$_gp" "$_p"; then
          printf '  %s>> %s   (already ignored — no change)%s\n' "$C_BLUE" "$_p" "$C_RESET"
        else
          printf '  %s>> %s   (mark ignored — my-git will leave it alone)%s\n' "$C_BLUE" "$_p" "$C_RESET"
        fi
      else
        printf '  %s>> %s   (remove ignore marker — my-git includes it again)%s\n' "$C_BLUE" "$_p" "$C_RESET"
      fi
    done
    echo
    log_major "This was analyze-only — re-run with 'go' to apply:"
    printf '  %s>>   %s %s go %s%s%s\n' "$C_BLUE" "$US" "$_ia_mode" \
      "$([ "$_ia_i" = 1 ] && printf -- '-i ')" "${_ia_scope_raw:-}" "$C_RESET"
    exit 0
  fi

  # Apply.
  _ia_ok=0; _ia_noop=0; _ia_fail=0; _ia_skip=0; _ia_n=0
  _ia_total=$(printf '%s\n' "$_ia_list" | grep -c .)
  _ia_oifs=$IFS; IFS='
'
  # shellcheck disable=SC2086
  set -- $_ia_list
  IFS=$_ia_oifs
  for _p in "$@"; do
    [ -n "$_p" ] || continue
    _ia_n=$((_ia_n + 1))
    if [ "$_ia_i" = 1 ]; then
      _prompt_ysa "[$_ia_n of $_ia_total] \"$_p\" $_ia_mode (marker in its OWN gitdir; no repo is committed to) ?"
      case $? in
        1) _ia_skip=$((_ia_skip + 1)); log_medium "skip  $_p"; continue ;;
        2) log_major "aborted"; break ;;
        3) _ia_i=0 ;;
      esac
    fi
    if ! _gp=$(_ign_gitpath_of "$_p" 2>/dev/null); then
      log_error "$_ia_mode: '$_p' is not a nested git repo"; _ia_fail=$((_ia_fail + 1)); continue
    fi
    if [ "$_ia_mode" = ignore ]; then
      if _sm_is_ignored "$_gp" "$_p"; then
        log_medium "already ignored: $_p"; _ia_noop=$((_ia_noop + 1))
      elif _sm_mark_ignored "$_gp" "$_p" >/dev/null; then
        log_ok "ignored $_p — my-git will leave it alone (st won't descend; sm won't register; mc/flatten skip it)"
        _ia_ok=$((_ia_ok + 1))
      else _ia_fail=$((_ia_fail + 1)); fi
    else
      if ! _sm_is_ignored "$_gp" "$_p"; then
        log_medium "not ignored: $_p"; _ia_noop=$((_ia_noop + 1))
      elif _sm_unmark_ignored "$_gp" "$_p"; then
        log_ok "unignored $_p — my-git includes it again ('sm go' may now register it as a submodule)"
        _ia_ok=$((_ia_ok + 1))
      else _ia_fail=$((_ia_fail + 1)); fi
    fi
  done
  log_major "$_ia_mode: $_ia_ok changed, $_ia_noop no-op$([ "$_ia_skip" -gt 0 ] && printf ', %s skipped' "$_ia_skip")$([ "$_ia_fail" -gt 0 ] && printf ', %s FAILED' "$_ia_fail")"
  [ "$_ia_fail" -eq 0 ]
}

cmd_ignore()   { _ignore_apply ignore "$@"; }
cmd_unignore() { _ignore_apply unignore "$@"; }

_sm_safe_git() {
  _repo=$1; shift
  _sg_log=$(mktemp "${TMPDIR:-/tmp}/safegit.XXXXXX")
  run git "$@" 2>"$_sg_log"
  _sg_rc=$?
  if [ "$_sg_rc" -ne 0 ] && [ "$SM_AUTO_SAFE_DIRECTORY" -eq 1 ] \
     && grep -q 'detected dubious ownership' "$_sg_log" 2>/dev/null; then
    _abs=$(cd "$_repo" 2>/dev/null && pwd -P) || _abs=$_repo
    printf 'INFO   registering safe.directory exception for %s\n' "$_abs" >&2
    if run git config --global --add safe.directory "$_abs" >/dev/null 2>&1; then
      run git "$@" 2>"$_sg_log"
      _sg_rc=$?
    else
      printf 'WARN   could not add safe.directory exception\n' >&2
    fi
  fi
  cat "$_sg_log" >&2
  rm -f "$_sg_log"
  return "$_sg_rc"
}

_sm_find_leftovers() {
  trace "find . -type d -name '*${_sm_PREEXISTING_SUFFIX}*'   # discover sm .preexisting leftovers"
  find . -mindepth 1 -type d -name "*${_sm_PREEXISTING_SUFFIX}*" \
       -not -path '*/.git/*' 2>/dev/null | sed 's|^\./||' | sort
}

_sm_is_registered_submodule() {
  _sp=$1
  [ -f .gitmodules ] || return 1
  git config -f .gitmodules --get-regexp "^submodule\..*\.path$" 2>/dev/null \
      | sed 's/^[^ ]* //' | grep -Fxq "$_sp"
}

# _sm_registered_path_for_url <url>
#   Print the path under which <url> is registered in $_sm_toplevel/.gitmodules,
#   or nothing if it isn't. If multiple entries have the same url, prints the
#   first one.
_sm_registered_path_for_url() {
  _url_match=$1
  [ -z "$_url_match" ] && return 1
  [ -f .gitmodules ] || return 1
  git config -f .gitmodules --get-regexp "^submodule\..*\.url$" 2>/dev/null \
      | while IFS= read -r _line; do
          _key=${_line%% *}
          _val=${_line#* }
          [ "$_val" = "$_url_match" ] || continue
          _name=${_key#submodule.}
          _name=${_name%.url}
          _p=$(git config -f .gitmodules --get "submodule.${_name}.path" 2>/dev/null || true)
          [ -n "$_p" ] && { printf '%s\n' "$_p"; return 0; }
        done
}

_sm_is_tracked_in_index() {
  git ls-files --error-unmatch -- "$1" >/dev/null 2>&1
}

# _sm_is_gitlink_in_index <path>
#   0 when the index holds <path> as a 160000 GITLINK -- the entry a real
#   submodule has. A .gitmodules entry alone proves nothing: 'shadow' and
#   'flatten' stage a nested repo's FILES with 'git add -f', which replaces
#   the gitlink with ordinary content while .gitmodules keeps its entry.
#   The result looks registered to anything that only reads .gitmodules,
#   but git no longer treats it as a submodule at all.
_sm_is_gitlink_in_index() {
  [ "$(git ls-files -s -- "$1" 2>/dev/null | awk 'BEGIN{FS=" "} {print $1; exit}')" = 160000 ]
}

_sm_enclosing_submodule() {
  # Returns the longest path P (if any) such that $1 lives under P AND
  # P itself is a nested-repo boundary — checked two ways:
  #   1. P is registered in .gitmodules (most authoritative; kept as
  #      its own check since a registration can exist even if this
  #      scan's 'find' somehow missed the directory itself).
  #   2. P is ANY other path this scan found a .git at (registered or
  #      not, ignored or not, orphan-gitlinked or not). A path living
  #      under an UNREGISTERED or orphan-gitlink repo is still that
  #      repo's own concern, not this scope's — e.g. an unregistered
  #      'src' with its own internal, properly-registered submodules:
  #      those submodules are src's business, even though src itself
  #      isn't registered HERE. Without this second check, such
  #      children get wrongly treated as this scope's own candidates,
  #      producing real (if git-safely-refused) errors — 'fatal:
  #      Pathspec ... is in submodule ...' — while a whole separate
  #      attempt to add THIS scope's own copy is bogusly queued too.
  _sp=$1
  _best=""
  if [ -f .gitmodules ]; then
    _best=$(git config -f .gitmodules --get-regexp "^submodule\..*\.path$" 2>/dev/null \
        | sed 's/^[^ ]* //' \
        | while IFS= read -r _p; do
            [ -n "$_p" ] || continue
            # Prefix-match via parameter expansion, NOT 'case' — a case
            # statement inline inside a loop that's inside $(...) fails
            # to parse under bash 3.2 (Apple's frozen /bin/bash and
            # /bin/sh on macOS), confirmed against a real bash 3.2 build.
            [ "${_sp#"$_p"/}" != "$_sp" ] && printf '%s\n' "$_p"
          done \
        | awk '{ if (length($0) > length(best)) best=$0 } END { if (best != "") print best }')
  fi
  if [ -z "$_best" ] && [ -n "${_sm_tmpfile:-}" ] && [ -f "$_sm_tmpfile" ]; then
    _best=$(sed -e 's|^\./||' -e 's|/\.git$||' "$_sm_tmpfile" \
        | while IFS= read -r _p; do
            [ -n "$_p" ] && [ "$_p" != "$_sp" ] || continue
            [ "${_sp#"$_p"/}" != "$_sp" ] && printf '%s\n' "$_p"
          done \
        | awk '{ if (length($0) > length(best)) best=$0 } END { if (best != "") print best }')
  fi
  [ -n "$_best" ] || return 1
  printf '%s\n' "$_best"
}

_sm_find_moved_submodule() {
  _url_match=$1
  [ -f .gitmodules ] || return 1
  [ -z "$_url_match" ] && return 1
  git config -f .gitmodules --get-regexp "^submodule\..*\.url$" 2>/dev/null \
      | while IFS= read -r _line; do
          _key=${_line%% *}
          _val=${_line#* }
          [ "$_val" = "$_url_match" ] || continue
          _name=${_key#submodule.}
          _name=${_name%.url}
          _path=$(git config -f .gitmodules --get "submodule.${_name}.path" 2>/dev/null || true)
          [ -z "$_path" ] && continue
          if [ ! -e "$_path" ]; then
            printf '%s\n' "$_path"
            return 0
          fi
        done
}

_sm_nested_is_clean() {
  _sp=$1
  _out=$(_sm_safe_git "$_sp" -C "$_sp" status --porcelain 2>/dev/null || true)
  [ -z "$_out" ]
}
_sm_nested_head()   { _sm_safe_git "$1" -C "$1" rev-parse --short HEAD 2>/dev/null || echo '?'; }
_sm_nested_branch() { _sm_safe_git "$1" -C "$1" symbolic-ref --quiet --short HEAD 2>/dev/null || echo '(detached)'; }

_sm_emit_compact() {
  _st=$1; _fl=$2; _sp=$3; _info=$4
  printf '%-8s %-2s  %-52s %s\n' "$_st" "$_fl" "$_sp" "$_info"
}

_sm_gitpath_for() {
  _sp=$1
  if [ -d "$_sp/.git" ] || [ -f "$_sp/.git" ]; then
    printf '%s/.git' "$_sp"
  fi
}

_sm_persist_url_change() {
  _pc_cfg=$1; _pc_new=$2; _pc_orig=$3
  [ -f "$_pc_cfg" ] || {
    printf 'WARN  could not persist URL (config not found: %s)\n' "$_pc_cfg" >&2
    return 1
  }
  _pc_cur=$(git config -f "$_pc_cfg" --get remote.origin.url 2>/dev/null || true)
  if [ "$_pc_cur" = "$_pc_new" ]; then
    return 0
  fi
  if ! git config -f "$_pc_cfg" remote.origin.url "$_pc_new" 2>/dev/null; then
    run git config -f "$_pc_cfg" --add remote.origin.url "$_pc_new" 2>/dev/null || {
      printf 'WARN  could not write remote.origin.url to %s\n' "$_pc_cfg" >&2
      return 1
    }
  fi
  if [ -n "$_pc_orig" ] && ! grep -Fq "# my-git-submodules: previous remote.origin.url =" "$_pc_cfg" 2>/dev/null; then
    {
      printf '\n# my-git-submodules: previous remote.origin.url = %s (changed %s)\n' \
        "$_pc_orig" "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date)"
    } >> "$_pc_cfg"
  fi
  printf 'CONFIG   updated %s: remote.origin.url = %s\n' "$_pc_cfg" "$_pc_new"
}

_sm_remove_gitmodules_entry() {
  _rge_name=$1
  [ -f .gitmodules ] || return 0
  _rge_tmp=$(mktemp "${TMPDIR:-/tmp}/gitmodules.XXXXXX")
  if awk -v want="[submodule \"$_rge_name\"]" '
      /^\[/ { skip = ($0 == want) ? 1 : 0 }
      skip == 0 { print }
  ' .gitmodules > "$_rge_tmp"; then
    run mv -- "$_rge_tmp" .gitmodules
  else
    rm -f "$_rge_tmp"
    return 1
  fi
}

# _sm_autocommit_if_safe <sp>
#   If the nested repo at <sp> has ONLY modifications to already-tracked
#   files (no untracked files, no unpushed commits, no stashes), commit -a
#   with a message listing the changed filenames AND push to origin.
#   Intended as a pre-rebind auto-save: the rebind re-clones from origin,
#   so anything not pushed is lost. Only safe to auto-handle when the
#   change set is purely a 'git commit -a' away from a clean pushed state.
#   Returns: 0 on success  | 1 if not applicable  | 2 on failure
_sm_autocommit_if_safe() {
  _ac_sp=$1
  _porc=$(_sm_safe_git "$_ac_sp" -C "$_ac_sp" status --porcelain 2>/dev/null || true)
  [ -n "$_porc" ] || return 1
  printf '%s\n' "$_porc" | awk '/^\?\?/ { f=1 } END { exit !f }' && return 1
  _up=$(_sm_safe_git "$_ac_sp" -C "$_ac_sp" log --branches --not --remotes --oneline 2>/dev/null || true)
  [ -n "$_up" ] && return 1
  _st=$(_sm_safe_git "$_ac_sp" -C "$_ac_sp" stash list 2>/dev/null || true)
  [ -n "$_st" ] && return 1
  _files=$(printf '%s\n' "$_porc" | awk '{print substr($0,4)}' | sort -u)
  _msg=$(printf '%s\n' "$_files" | paste -sd, - | sed 's/,/, /g')
  printf '    auto-commit (tracked-file mods only): %s\n' "$_msg"
  _sm_safe_git "$_ac_sp" -C "$_ac_sp" commit -a -q -m "$_msg" >/dev/null 2>&1 || {
    printf '    auto-commit failed — falling back to warn\n' >&2
    return 2
  }
  printf '    auto-push to origin\n'
  _sm_safe_git "$_ac_sp" -C "$_ac_sp" push -q 2>/dev/null || {
    printf '    auto-push failed — falling back to warn\n' >&2
    return 2
  }
  return 0
}

# _sm_collect_ignore_patterns
#   Scan $_sm_toplevel for nested repos carrying the ignore marker and print
#   one `/path/` line per match on stdout. Callers use this to build the
#   .git/info/exclude block or to emit to the terminal. Returns 1 if none.
_sm_collect_ignore_patterns() {
  _cip_tmp=$(mktemp "${TMPDIR:-/tmp}/syncignfind.XXXXXX")
  trace "find . -mindepth 2 -name .git   # discover nested repos (ignore-pattern collection)"
  find . -mindepth 2 -name .git \( -type d -o -type f \) \
       -not -path "*${_sm_PREEXISTING_SUFFIX}*" | sort > "$_cip_tmp"
  _cip_patterns=$(
    while IFS= read -r gp; do
      sp=${gp%/.git}; sp=${sp#./}
      if _sm_is_ignored "$gp" "$sp"; then
        printf '/%s/\n' "$sp"
      fi
    done < "$_cip_tmp"
  )
  rm -f "$_cip_tmp"
  [ -z "$_cip_patterns" ] && return 1
  printf '%s\n' "$_cip_patterns"
  return 0
}

_sm_emit_ignore_patterns() {
  _eip_pats=$(_sm_collect_ignore_patterns) || return 1
  _eip_header='# --- my-git-submodules: ignored nested repos (do not edit between markers) ---'
  _eip_footer='# --- end my-git-submodules ---'
  printf '%s\n%s\n%s\n' "$_eip_header" "$_eip_pats" "$_eip_footer"
}

# _sm_sync_ignore_exclude [quiet]
#   Rewrite the marker-delimited block in $_sm_toplevel/.git/info/exclude to
#   exactly match the current set of ignored nested repos. Also drops the
#   block entirely when there are none. Idempotent.
#   With arg "quiet", print nothing when already up-to-date.
_sm_sync_ignore_exclude() {
  _sie_quiet=${1:-}
  _sie_header='# --- my-git-submodules: ignored nested repos (do not edit between markers) ---'
  _sie_footer='# --- end my-git-submodules ---'
  _sie_pats=$(_sm_collect_ignore_patterns || true)
  _sie_exclude="$_sm_toplevel/.git/info/exclude"
  mkdir -p "$_sm_toplevel/.git/info" 2>/dev/null || true
  _sie_existing=''
  [ -f "$_sie_exclude" ] && _sie_existing=$(cat "$_sie_exclude")
  _sie_clean=$(
    printf '%s\n' "$_sie_existing" | awk -v h="$_sie_header" -v f="$_sie_footer" '
      $0 == h { inblock = 1; next }
      $0 == f { inblock = 0; next }
      inblock == 0 { print }
    '
  )
  if [ -z "$_sie_pats" ]; then
    # No ignored repos — strip any existing block.
    if printf '%s\n' "$_sie_existing" | grep -Fxq "$_sie_header"; then
      _sie_new=$(mktemp "${TMPDIR:-/tmp}/exclude.XXXXXX")
      [ -n "$_sie_clean" ] && printf '%s\n' "$_sie_clean" > "$_sie_new" || : > "$_sie_new"
      if mv -- "$_sie_new" "$_sie_exclude"; then
        [ "$_sie_quiet" = quiet ] || printf 'Removed stale ignored-block from %s\n' "$_sie_exclude"
      else
        rm -f "$_sie_new"
        echo "error: could not write $_sie_exclude" >&2
        return 1
      fi
    else
      [ "$_sie_quiet" = quiet ] || echo "No ignored nested repos — nothing to sync."
    fi
    return 0
  fi
  # Something to write. Skip the mv if contents would be identical.
  _sie_would=$(
    [ -n "$_sie_clean" ] && printf '%s\n' "$_sie_clean"
    printf '%s\n%s\n%s\n' "$_sie_header" "$_sie_pats" "$_sie_footer"
  )
  if [ "$_sie_would" = "$_sie_existing" ]; then
    [ "$_sie_quiet" = quiet ] || echo ".git/info/exclude already up to date."
    return 0
  fi
  _sie_new=$(mktemp "${TMPDIR:-/tmp}/exclude.XXXXXX")
  printf '%s\n' "$_sie_would" > "$_sie_new"
  if mv -- "$_sie_new" "$_sie_exclude"; then
    _sie_count=$(printf '%s\n' "$_sie_pats" | wc -l | tr -d ' ')
    printf 'Synced %s ignored nested-repo paths to %s\n' "$_sie_count" "$_sie_exclude"
    [ "$_sie_quiet" = quiet ] || echo "These are local-only (not tracked by git)."
  else
    rm -f "$_sie_new"
    echo "error: could not write $_sie_exclude" >&2
    return 1
  fi
}

# _sm_try_preserve_rebind <old_path> <new_sp> <url>
#   Move the nested gitdir into .git/modules/<new_sp>, rewrite <new_sp>/.git
#   to point at it, update .gitmodules in place, and stage the move in the
#   superproject index. NO re-clone — ALL local state (branches, unpushed
#   commits, stashes, uncommitted changes, reflogs, hooks) is kept intact.
#
#   Source gitdir is located in priority order:
#     1. .git/modules/<old_path>   (stale super-repo entry, if any)
#     2. <new_sp>/.git/            (embedded real dir — user moved manually)
#     3. target of <new_sp>/.git   (pointer file to a gitdir elsewhere)
#
#   Returns: 0 on success | 1 if no source gitdir is found / move fails.
_sm_try_preserve_rebind() {
  _pr_old=$1; _pr_sp=$2; _pr_url=$3
  _pr_stale="$_sm_toplevel/.git/modules/$_pr_old"
  _pr_new_gd="$_sm_toplevel/.git/modules/$_pr_sp"
  [ -e "$_pr_new_gd" ]  && return 1
  [ -e "$_pr_sp/.git" ] || return 1
  # Locate the source gitdir.
  _pr_src=''
  _pr_src_kind=''
  if [ -d "$_pr_stale" ]; then
    _pr_src=$_pr_stale
    _pr_src_kind=stale
  elif [ -d "$_pr_sp/.git" ]; then
    _pr_src=$_pr_sp/.git
    _pr_src_kind=embedded
  elif [ -f "$_pr_sp/.git" ]; then
    _pr_gdline=$(sed -n 's/^gitdir: //p' "$_pr_sp/.git")
    case "$_pr_gdline" in
      /*) _pr_src=$_pr_gdline ;;
      *)  _pr_src=$_pr_sp/$_pr_gdline ;;
    esac
    [ -d "$_pr_src" ] || return 1
    _pr_src_kind=pointer
  else
    return 1
  fi
  # Compute relative paths for the new pointer and core.worktree.
  _pr_up=$(printf '%s' "$_pr_sp" | awk -F/ '{ for (i=1;i<=NF;i++) printf "../" }')
  _pr_wt_up=$(printf '%s' ".git/modules/$_pr_sp" | awk -F/ '{ for (i=1;i<=NF;i++) printf "../" }')
  # Move gitdir to its canonical super-repo location.
  _pr_newdir=${_pr_new_gd%/*}
  mkdir -p "$_pr_newdir" || return 1
  run mv -- "$_pr_src" "$_pr_new_gd" || return 1
  # For the stale/pointer cases the remaining <sp>/.git is an old pointer
  # (or a now-stale pointer file to the place we just emptied). For the
  # embedded case, the mv above already took <sp>/.git away.
  [ -e "$_pr_sp/.git" ] && rm -rf -- "$_pr_sp/.git" 2>/dev/null
  printf 'gitdir: %s.git/modules/%s\n' "$_pr_up" "$_pr_sp" > "$_pr_sp/.git" || {
    # Roll back: move gitdir back where it came from.
    run mv -- "$_pr_new_gd" "$_pr_src" 2>/dev/null || true
    return 1
  }
  # Fix up the moved gitdir's config.
  run git config -f "$_pr_new_gd/config" core.worktree "${_pr_wt_up}${_pr_sp}" || true
  [ -n "$_pr_url" ] && git config -f "$_pr_new_gd/config" remote.origin.url "$_pr_url" || true
  # Update .gitmodules: drop old entry, append new.
  if [ -f "$_sm_toplevel/.gitmodules" ]; then
    _sm_remove_gitmodules_entry "$_pr_old" || true
  fi
  {
    printf '[submodule "%s"]\n' "$_pr_sp"
    printf '\tpath = %s\n' "$_pr_sp"
    printf '\turl = %s\n' "$_pr_url"
  } >> "$_sm_toplevel/.gitmodules"
  # Update the superproject index.
  if git ls-files --error-unmatch -- "$_pr_old" >/dev/null 2>&1; then
    run git update-index --force-remove -- "$_pr_old" 2>/dev/null || true
    _sm_record_change "$_pr_old"
  fi
  run git add -- "$_sm_toplevel/.gitmodules" "$_pr_sp" 2>/dev/null || true
  _sm_record_change ".gitmodules"
  _sm_record_change "$_pr_sp"
  return 0
}

_sm_rebind_has_risky_state() {
  _rhs_sp=$1
  [ -d "$_rhs_sp/.git" ] || [ -f "$_rhs_sp/.git" ] || return 1
  _risk=''
  _out=$(_sm_safe_git "$_rhs_sp" -C "$_rhs_sp" status --porcelain 2>/dev/null || true)
  [ -n "$_out" ] && _risk="${_risk}uncommitted changes; "
  _out=$(_sm_safe_git "$_rhs_sp" -C "$_rhs_sp" log --branches --not --remotes --oneline 2>/dev/null || true)
  [ -n "$_out" ] && _risk="${_risk}unpushed commits on local branches; "
  _out=$(_sm_safe_git "$_rhs_sp" -C "$_rhs_sp" stash list 2>/dev/null || true)
  [ -n "$_out" ] && _risk="${_risk}stashes; "
  if [ -n "$_risk" ]; then
    printf '%s' "${_risk%; }"
    return 0
  fi
  return 1
}

# ─── cmd_submodules: top-level dispatch + recursion wrapper ─────────────
# The actual work is in _sm_run_here() (the former cmd_submodules body,
# renamed so we can run it in a subshell to contain its 'exit' calls).
# cmd_submodules() wraps that call and — when -R/--recursive is given —
# recurses into every registered direct submodule. Default is single-level
# (git itself only cares about one level of gitlinks per super-repo).
#
# Even with -R, flag-driven modes that already perform their own global
# traversal (--list-ignored, --emit-gitignore, --clean-leftovers,
# --sync-gitignore, --unstage-embedded) do NOT recurse — running them N
# times would duplicate output.
_sm_mode_wants_recursion() {
  # -R / --recursive is required; without it, never recurse.
  _want_r=0
  for _arg; do
    case "$_arg" in
      -R|--recursive) _want_r=1 ;;
    esac
  done
  [ "$_want_r" = 1 ] || return 1
  for _arg; do
    case "$_arg" in
      --list-ignored|--emit-gitignore|--clean-leftovers|--clean-stale|--sync-gitignore|--unstage-embedded)
        return 1 ;;
      -h|--help)
        return 1 ;;
    esac
  done
  return 0
}

cmd_submodules() {
  # Run the body in a subshell so its 'exit' calls contain to this level
  # and don't abort the outer recursion walk. User-triggered abort uses
  # exit code 77, which we propagate up so [A]bort in a nested call
  # terminates the whole walk (not just the current node).
  ( _sm_run_here "$@" )
  _sm_outer_rc=$?
  [ "$_sm_outer_rc" = 77 ] && return 77

  # Recurse into each direct registered submodule in depth-first top-down
  # order. Parents are processed before children so that rebinds/renames
  # at the parent level settle before we look inside.
  if _sm_mode_wants_recursion "$@"; then
    _sm_cwd_abs=$(pwd -P)
    _sm_rec_list=$(mktemp "${TMPDIR:-/tmp}/smrec.XXXXXX")
    list_direct_submodules "$_sm_cwd_abs" > "$_sm_rec_list" 2>/dev/null || :
    while IFS= read -r _sm_sub; do
      [ -n "$_sm_sub" ] || continue
      _sm_abs="$_sm_cwd_abs/$_sm_sub"
      [ -e "$_sm_abs/.git" ] || continue
      # Skip children that have nothing to report and no further
      # registered submodules to descend into — avoids the "=== path ==="
      # banner followed by "No nested Git repositories found" noise.
      _sm_child_reg=$(list_direct_submodules "$_sm_abs")
      _sm_child_unreg=$(list_unregistered_nested "$_sm_abs")
      _sm_child_stale=$(list_stale_submodules "$_sm_abs")
      if [ -z "$_sm_child_reg" ] && [ -z "$_sm_child_unreg" ] && [ -z "$_sm_child_stale" ]; then
        continue
      fi
      printf '\n============================================================\n'
      printf '=== %s\n' "$_sm_abs"
      printf '============================================================\n'
      ( cd "$_sm_abs" 2>/dev/null && cmd_submodules "$@" )
      _sm_child_rc=$?
      if [ "$_sm_child_rc" = 77 ]; then
        rm -f "$_sm_rec_list"
        return 77
      fi
    done < "$_sm_rec_list"
    rm -f "$_sm_rec_list"
  fi
  return $_sm_outer_rc
}

# ═══ unsm — the reverse of sm: de-register a submodule back to a ═════════
# raw-nested-git. Removes it from .gitmodules + .git/config + the parent
# index gitlink, DE-ABSORBS its gitdir (parent/.git/modules/<name> ->
# <path>/.git) so the repo stays LIVE and standalone, and self-commits the
# parent teardown. Follows the analyze/go/-i/scope idiom; single-level by
# default, -R walks the tree, a PATH scopes to one submodule anywhere.

# _unsm_one <parent_abs> <sub>  — de-register ONE submodule. STAGES the
# parent changes (does not commit; caller commits the index as-is). The
# gitdir de-absorb, if needed, is a filesystem move so history is preserved.
_unsm_one() {
  _uso_parent=$1; _uso_sub=$2
  _uso_gm="$_uso_parent/.gitmodules"
  [ -f "$_uso_gm" ] || { log_error "unsm: $_uso_parent has no .gitmodules"; return 1; }
  _uso_name=$(run_as_owner_capture "$_uso_parent" git config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
    | awk -v s="$_uso_sub" '{$1=$1; p=$0; sub(/^[^ ]* /,""); if ($0==s){print p}}' \
    | sed 's/ .*//; s/^submodule\.//; s/\.path$//' | head -1)
  [ -n "$_uso_name" ] || { log_error "unsm: '$_uso_sub' is not a registered submodule of $_uso_parent"; return 1; }

  _uso_gp="$_uso_parent/$_uso_sub/.git"
  _uso_pgd=$( cd "$_uso_parent" 2>/dev/null && git rev-parse --absolute-git-dir 2>/dev/null )
  _uso_absorbed="$_uso_pgd/modules/$_uso_name"

  # ── De-absorb the gitdir so <sub>/.git is a real, standalone dir ──
  if [ -d "$_uso_gp" ]; then
    # A real .git DIR at the worktree is what git ACTUALLY uses (verified:
    # 'git -C <path> rev-parse --absolute-git-dir' resolves here, not into the
    # parent's .git/modules). So the repo is ALREADY standalone. Unlike
    # flatten — which RELOCATES a gitdir and must refuse an ambiguous
    # both-exist state — unsm keeps this live .git untouched and only drops
    # the registration, so there's nothing to disambiguate. A leftover
    # absorbed gitdir under .git/modules/<name> is simply orphaned now; leave
    # it in place (never risk deleting possibly-unique history) and point it out.
    if [ -e "$_uso_absorbed" ]; then
      log_medium "unsm  $_uso_sub  (using its live .git; leftover $_uso_absorbed is now orphaned — 'rm -rf' it by hand if you don't want it)"
    else
      log_dbg_med "unsm: $_uso_sub already has a standalone .git dir — no de-absorb needed"
    fi
  elif [ -e "$_uso_gp" ]; then
    # gitfile pointer (absorbed layout): move the real gitdir back into place.
    [ -d "$_uso_absorbed" ] || { log_error "unsm: $_uso_sub: gitfile points away but $_uso_absorbed is missing — history not found, cannot de-absorb"; return 1; }
    run rm -f -- "$_uso_gp" || { log_error "unsm: $_uso_sub: removing gitfile pointer failed"; return 1; }
    if ! run mv -- "$_uso_absorbed" "$_uso_gp"; then
      log_error "unsm: $_uso_sub: mv $_uso_absorbed -> $_uso_gp failed"; return 1
    fi
    # A plain <sub>/.git needs no core.worktree/core.bare override (same as
    # unflatten --sidecar) — the old values pointed at the modules/ location.
    run git config --file "$_uso_gp/config" --unset core.worktree 2>/dev/null || true
    run git config --file "$_uso_gp/config" --unset core.bare 2>/dev/null || true
    log_medium "unsm  $_uso_sub  (de-absorbed $_uso_absorbed -> $_uso_sub/.git)"
  else
    log_error "unsm: $_uso_sub: no .git present — not a live submodule worktree (run 'git submodule update --init' first?)"; return 1
  fi

  # ── Remove the registration + gitlink, staged for the caller's commit ──
  ( cd "$_uso_parent" || exit 1
    run git config -f .gitmodules --remove-section "submodule.$_uso_name" 2>/dev/null || true
    run git config --remove-section "submodule.$_uso_name" 2>/dev/null || true
    # Drop the gitlink from the index (worktree keeps its now-live .git).
    run git rm --cached -q -- "$_uso_sub" >/dev/null 2>&1 \
      || run git update-index --force-remove -- "$_uso_sub" >/dev/null 2>&1 || true
    # If no submodule sections remain, the .gitmodules file itself is cruft.
    if [ -f .gitmodules ] && ! git config -f .gitmodules --get-regexp '^submodule\.' >/dev/null 2>&1; then
      run git rm -f -q -- .gitmodules >/dev/null 2>&1 || run rm -f -- .gitmodules
    else
      run git add -- .gitmodules >/dev/null 2>&1 || true
    fi
  )
  return 0
}

# _unsm_discover <top_abs> <recursive0|1>  — print "parent_abs<TAB>sub" for
# every registered submodule (single level, or the whole tree with -R).
_unsm_discover() {
  _und_top=$1; _und_rec=$2
  if [ "$_und_rec" = 1 ]; then
    find "$_und_top" -name .gitmodules -not -path '*/.git/*' \
         -not -path "*/${GIT_SIDECAR_DIRNAME:-.git.real}/*" 2>/dev/null | sort \
      | while IFS= read -r _und_gm; do
          _und_p=$(dirname "$_und_gm")
          list_direct_submodules "$_und_p" | while IFS= read -r _und_s; do
            [ -n "$_und_s" ] && printf '%s\t%s\n' "$_und_p" "$_und_s"
          done
        done
  else
    list_direct_submodules "$_und_top" | while IFS= read -r _und_s; do
      [ -n "$_und_s" ] && printf '%s\t%s\n' "$_und_top" "$_und_s"
    done
  fi
}

# Commit the current parent's staged de-registration as-is (a scoped
# 'git commit -- <sub>' would re-add the live nested repo as a gitlink, so we
# commit the index directly) — unless it had pre-existing staged work, in
# which case we leave ours staged rather than mix them. Uses _un_* globals.
_unsm_flush_parent() {
  { [ -n "$_un_cur" ] && [ "$_un_cur_changed" = 1 ]; } || { _un_cur=""; _un_cur_changed=0; return 0; }
  if [ -n "$_un_cur_pre" ]; then
    log_warn "unsm: $_un_cur had pre-existing staged changes — de-registration left STAGED (commit it yourself so nothing unrelated is swept in)"
  else
    ( cd "$_un_cur" && run git commit -q -m "my-git unsm: de-registered submodule(s) -> raw-nested-git (dropped .gitmodules + gitlink, de-absorbed .git)" >/dev/null 2>&1 ) \
      || log_warn "unsm: commit in $_un_cur failed — de-registration left staged"
  fi
  _un_cur=""; _un_cur_changed=0
}

cmd_unsm() {
  _un_mode=analyze; _un_i=0; _un_scope_raw=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help)
        printf 'usage: %s unsm [go] [-i] [-R] [<path>]\n' "$US"
        printf '  Reverse of '\''sm'\'': de-register submodule(s) back to raw-nested-git\n'
        printf '  (drop .gitmodules + gitlink, de-absorb .git/modules/<name> -> <path>/.git;\n'
        printf '  the repo stays LIVE). Analyze by default, apply with '\''go'\'' (-i per repo).\n'
        printf '  No path: EVERY registered submodule in the tree (matching st'\''s view).\n'
        printf '  A <path> scopes to one registered submodule anywhere in the tree.\n'
        exit 0 ;;
      go) _un_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _un_mode=analyze ;;
      -i|--interactive) _un_i=1; require_tty unsm ;;
      -R|--recursive) : ;;   # unsm is whole-tree by default; -R accepted (no-op) for muscle memory
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose) VERYVRB=1 ;;
      -D|--debug) DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      --) shift; break ;;
      -*) fatal "unsm: unknown option: $1" 64 ;;
      *) [ -n "$_un_scope_raw" ] && fatal "unsm: only one path argument is supported (got '$_un_scope_raw' and '$1')" 64
         _un_scope_raw=$1 ;;
    esac
    shift
  done
  if [ $# -gt 0 ]; then
    [ -n "$_un_scope_raw" ] && fatal "unsm: only one path argument is supported" 64
    _un_scope_raw=$1
  fi

  _un_tab=$(printf '\t')
  _un_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.unsm.XXXXXX"); : > "$_un_tmp"
  _un_where=""
  if [ -n "$_un_scope_raw" ]; then
    _un_abs=$(cd "$_un_scope_raw" 2>/dev/null && pwd -P) || { rm -f "$_un_tmp"; fatal "unsm: '$_un_scope_raw': no such directory" 1; }
    _un_parent=$( cd "$_un_abs/.." 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null )
    [ -n "$_un_parent" ] || { rm -f "$_un_tmp"; fatal "unsm: '$_un_scope_raw' has no enclosing git repo to de-register it from" 1; }
    _un_parent=$( cd "$_un_parent" && pwd -P )
    printf '%s\t%s\n' "$_un_parent" "${_un_abs#"$_un_parent"/}" >> "$_un_tmp"
    _un_where=$_un_parent
  else
    _un_top=$(git_toplevel_of "$PWD"); [ -n "$_un_top" ] || { rm -f "$_un_tmp"; fatal "unsm: not inside a git repo" 1; }
    _un_top=$( cd "$_un_top" && pwd -P )
    _unsm_discover "$_un_top" 1 >> "$_un_tmp"
    _un_where=$_un_top
  fi
  sort -o "$_un_tmp" "$_un_tmp"

  log_repo_context unsm "$_un_where" \
    "this repo's .gitmodules + index lose the registration; its .git receives the commit" \
    "${_un_scope_raw:+de-registering: $_un_scope_raw}" \
    "$([ -n "$_un_scope_raw" ] && printf 'chosen as the repo DIRECTLY enclosing the path -- the same one "sm <path> go" registered into' || printf 'whole-tree sweep: every registered submodule found below here')" \
    "each de-registered path keeps its history -- its gitdir is moved back to <path>/.git, never deleted"

  _un_n=$(grep -c . "$_un_tmp")
  if [ "$_un_n" -eq 0 ]; then
    rm -f "$_un_tmp"
    log_major "$_un_where: nothing to unsm (no registered submodule found in the tree)"
    exit 0
  fi

  log_major "$_un_where: unsm plan ($_un_n submodule(s) -> raw-nested-git)"
  while IFS="$_un_tab" read -r _p _s; do
    [ -n "$_s" ] || continue
    printf '  %s>> %s/%s   (de-register: drop .gitmodules + gitlink, de-absorb .git; repo stays LIVE)%s\n' "$C_BLUE" "$_p" "$_s" "$C_RESET"
  done < "$_un_tmp"

  if [ "$_un_mode" != go ]; then
    echo
    log_major "This was analyze-only — re-run with 'go' to apply:"
    printf '  %s>>   %s unsm go %s%s%s\n' "$C_BLUE" "$US" \
      "$([ "$_un_i" = 1 ] && printf -- '-i ')" "${_un_scope_raw:-}" "$C_RESET"
    rm -f "$_un_tmp"; exit 0
  fi

  _un_ok=0; _un_fail=0; _un_skip=0; _un_cur=""; _un_cur_pre=""; _un_cur_changed=0
  while IFS="$_un_tab" read -r _p _s; do
    [ -n "$_s" ] || continue
    if [ "$_p" != "$_un_cur" ]; then
      _unsm_flush_parent
      _un_cur=$_p
      _un_cur_pre=$( cd "$_p" 2>/dev/null && git diff --cached --name-only 2>/dev/null | head -1 )
      _un_cur_changed=0
    fi
    if [ "$_un_i" = 1 ]; then
      _prompt_ysa "\"$_p/$_s\" unsm: de-register from $_p (keep the repo live, history intact) ?"
      case $? in
        1) _un_skip=$((_un_skip + 1)); log_medium "skip  $_s"; continue ;;
        2) _unsm_flush_parent; log_major "aborted"; rm -f "$_un_tmp"; exit 77 ;;
        3) _un_i=0 ;;
      esac
    fi
    if _unsm_one "$_p" "$_s"; then
      log_ok "unsm $_s — now a raw-nested-git (live .git kept; de-registered from $_p)"
      _un_ok=$((_un_ok + 1)); _un_cur_changed=1
    else
      _un_fail=$((_un_fail + 1))
    fi
  done < "$_un_tmp"
  _unsm_flush_parent
  rm -f "$_un_tmp"
  log_major "unsm: $_un_ok de-registered$([ "$_un_skip" -gt 0 ] && printf ', %s skipped' "$_un_skip")$([ "$_un_fail" -gt 0 ] && printf ', %s FAILED' "$_un_fail")"
  [ "$_un_fail" -eq 0 ]
}

# ─── _sm_run_here: single-repo sm work (formerly cmd_submodules body) ────
_sm_run_here() {
  # Apply an SSH ConnectTimeout so unreachable hosts fail in seconds instead
  # of the OS default (75s+). Only set if user hasn't already chosen one.
  if [ -z "${GIT_SSH_COMMAND:-}" ]; then
    _sm_ct=${SM_SSH_CONNECT_TIMEOUT:-30}
    GIT_SSH_COMMAND="ssh -o ConnectTimeout=$_sm_ct -o BatchMode=no"
    export GIT_SSH_COMMAND
    log_dbg_med "GIT_SSH_COMMAND=$GIT_SSH_COMMAND"
  fi
  # Re-parse sm's argv (passed as $@).
  _sm_mode=analyze
  _sm_mode_set=0
  _sm_interactive=$INTERACTIVE
  _sm_verbose=$VRB
  _sm_force=0
  _sm_list_ignored=0
  _sm_clean_leftovers=0
  _sm_clean_stale=0
  _sm_sync_gitignore=0
  _sm_emit_gitignore=0
  _sm_unstage_embedded=0
  _sm_scope_path_raw=""

  while [ $# -gt 0 ]; do
    case "$1" in
      go)                    [ "$_sm_mode_set" -eq 0 ] && _sm_mode=go  && _sm_mode_set=1 ;;
      -T|--dry|--try|-n|--dry-run) [ "$_sm_mode_set" -eq 0 ] && _sm_mode=dry && _sm_mode_set=1 ;;
      -D|--debug)            DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg)         DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      -V|--verbose)          _sm_verbose=1; VRB=1 ;;
      -VV|--very-verbose)                   VERYVRB=1 ;;
      -i|--interactive)      _sm_interactive=1; require_tty submodules ;;
      --force)               _sm_force=1 ;;
      --list-ignored)        _sm_list_ignored=1 ;;
      --clean-leftovers)     _sm_clean_leftovers=1 ;;
      --clean-stale)         _sm_clean_stale=1 ;;
      --sync-gitignore)      _sm_sync_gitignore=1 ;;
      --emit-gitignore)      _sm_emit_gitignore=1 ;;
      --unstage-embedded)    _sm_unstage_embedded=1 ;;
      -R|--recursive)        RECURSIVE=1 ;;
      -h|--help)             show_help submodules; exit 0 ;;
      --)                    shift; break ;;
      -*)                    printf 'Unknown option: %s\n\n' "$1" >&2; show_help submodules >&2; exit 2 ;;
      # A single positional PATH scopes the whole run to just that one
      # nested repo (mirrors 'flatten <path>'). Works before OR after
      # 'go' ('sm sh/my-git go' == 'sm go sh/my-git'). Resolved to a
      # toplevel-relative path once the toplevel is known, below.
      *)                     [ -n "$_sm_scope_path_raw" ] && {
                               printf 'sm: only one path argument is supported (got %s and %s)\n\n' "$_sm_scope_path_raw" "$1" >&2
                               show_help submodules >&2; exit 2
                             }
                             _sm_scope_path_raw=$1 ;;
    esac
    shift
  done

  # ─── Retarget to the submodule's IMMEDIATE ENCLOSING repo ───
  # A PATH names a nested repo that belongs to the repo DIRECTLY enclosing it,
  # not necessarily the one you're standing in. Retarget there so
  # 'sm <deep/path> go' registers into the correct parent (and matches unsm,
  # which always de-registers from that same immediate enclosing repo). Done
  # BEFORE sidecar-detection / toplevel checks so they see the right repo.
  # No-op when the enclosing repo IS the current toplevel (a direct child).
  if [ -n "$_sm_scope_path_raw" ]; then
    _sm_scope_abs0=$(cd "$_sm_scope_path_raw" 2>/dev/null && pwd -P) || \
      fatal "sm: '$_sm_scope_path_raw': no such directory" 1
    # Capture the LOGICAL (symlink-preserving) form NOW — the retarget
    # below overwrites _sm_scope_path_raw with the resolved path, and
    # from then on there is no way back to what the person actually typed.
    _sm_scope_log=$(cd "$_sm_scope_path_raw" 2>/dev/null && pwd)
    _sm_encl=$( cd "$_sm_scope_abs0/.." 2>/dev/null && git -c safe.directory='*' rev-parse --show-toplevel 2>/dev/null )
    if [ -n "$_sm_encl" ] && [ "$_sm_encl" != "$(pwd -P)" ]; then
      log_medium "sm: '$_sm_scope_path_raw' belongs to $_sm_encl — registering there (its immediate enclosing repo)"
      cd "$_sm_encl" || fatal "sm: cannot cd to enclosing repo $_sm_encl" 1
      _sm_scope_path_raw=$_sm_scope_abs0   # absolute, so scope resolution below is CWD-independent
    fi
  fi

  # State plainly WHICH repo the registration lands in. "Is sm registering
  # into the parent or the root repo?" is the question this answers: it is
  # always the repo that DIRECTLY encloses the path, which for a deep path
  # is usually NOT the toplevel you invoked from.
  # Report the LOGICAL path (symlinks intact — /LINKS/... or /syst/...),
  # not the resolved one: that is what was typed and what the person is
  # looking at. git's --show-toplevel always resolves, so derive the
  # logical form by stripping the same trailing components from the
  # logical scope path that separate it from the resolved enclosing repo.
  _sm_disp=$(pwd -P)
  _sm_disp_scope=${_sm_scope_path_raw:-}
  if [ -n "${_sm_scope_log:-}" ]; then
    _sm_disp_scope=$_sm_scope_log
    _sm_sfx=${_sm_scope_abs0#"$(pwd -P)"}
    case "$_sm_scope_log" in
      *"$_sm_sfx") _sm_disp=${_sm_scope_log%"$_sm_sfx"} ;;
    esac
  fi
  log_repo_context sm "$_sm_disp" \
    "this repo's .gitmodules + index receive the registration, and its .git the commit" \
    "${_sm_disp_scope:+registering: $_sm_disp_scope}" \
    "chosen as the repo DIRECTLY enclosing the path -- not necessarily the toplevel you ran from" \
    "undo with: $US unsm ${_sm_disp_scope:-<path>}  (acts on this same repo)"

  # ─── Sidecar-awareness ───
  # If THIS scope's repo is a sidecar (GIT_SIDECAR_DIRNAME present, no
  # live .git), point git at it for the whole run — same idea as the
  # zshrc git() wrapper, but via GIT_DIR/GIT_WORK_TREE so every git call
  # here (bare or via _sm_safe_git) transparently operates on the
  # sidecar. UNSET first so a value leaked in from an OUTER sidecar
  # scope can't bleed into a child that has its own live .git (each
  # recursion re-enters _sm_run_here and re-detects). Verified: with
  # these set, 'git submodule add' registers correctly into a sidecared
  # parent's .git.real index + worktree .gitmodules.
  unset GIT_DIR GIT_WORK_TREE
  _sm_grd=${GIT_SIDECAR_DIRNAME:-.git.real}
  if [ -d "$_sm_grd" ] && [ ! -e ".git" ]; then
    GIT_DIR="$(pwd -P)/$_sm_grd"; GIT_WORK_TREE="$(pwd -P)"
    export GIT_DIR GIT_WORK_TREE
    log_dbg_med "sm: this scope is a SIDECAR — operating via GIT_DIR=$GIT_DIR GIT_WORK_TREE=$GIT_WORK_TREE"
  fi

  # ─── Super-repo sanity ───
  _sm_safe_git "$(pwd -P)" rev-parse --show-toplevel >/dev/null 2>&1 || {
    echo "error: not inside a Git repository (or safe.directory could not be set)" >&2
    exit 1
  }
  _sm_toplevel=$(git rev-parse --show-toplevel)
  if [ "$_sm_toplevel" != "$(pwd -P)" ]; then
    printf 'error: run this from the super-repo root (%s)\n' "$_sm_toplevel" >&2
    exit 1
  fi

  # Resolve a PATH argument (if given) to a CWD-relative, normalized
  # form for filtering the candidate list below. Accepts an absolute
  # path under the toplevel or a plain relative path; strips any leading
  # './' and trailing '/'. '_sm_scope_rel' empty means "whole repo".
  _sm_scope_rel=""
  if [ -n "$_sm_scope_path_raw" ]; then
    _sm_scope_abs=$(cd "$_sm_scope_path_raw" 2>/dev/null && pwd -P) || \
      fatal "sm: '$_sm_scope_path_raw': no such directory" 1
    case "$_sm_scope_abs" in
      "$_sm_toplevel")
        fatal "sm: '$_sm_scope_path_raw' is the super-repo root itself, not a nested repo" 64 ;;
      "$_sm_toplevel"/*)
        _sm_scope_rel=${_sm_scope_abs#"$_sm_toplevel"/} ;;
      *)
        fatal "sm: '$_sm_scope_path_raw' is not inside $_sm_toplevel" 64 ;;
    esac
    log_dbg_med "sm: scoped to path '$_sm_scope_rel'"
  fi

  # ─── leftovers / clean-leftovers ───
  if [ "$_sm_clean_leftovers" -eq 1 ]; then
    _leftovers=$(_sm_find_leftovers)
    if [ -z "$_leftovers" ]; then
      echo "No leftover directories found."
      exit 0
    fi
    printf '%s\n' "$_leftovers" | while IFS= read -r _lo; do
      _orig=${_lo%"${_sm_PREEXISTING_SUFFIX}"*}
      printf '\n--- leftover: %s\n' "$_lo"
      printf '    would pair with: %s\n' "$_orig"
      if [ -e "$_orig" ]; then
        printf '    note: "%s" currently exists — merging is NOT automatic\n' "$_orig"
        _ans=$(_sm_ask "    [K]eep (do nothing) / [D]elete leftover / [A]bort? [K/d/a]: ")
      else
        printf '    note: "%s" does not exist — leftover can be restored in place\n' "$_orig"
        _ans=$(_sm_ask "    [R]estore leftover to original / [D]elete / [K]eep / [A]bort? [R/d/k/a]: ")
      fi
      case "$_ans" in
        d|D) rm -rf -- "$_lo" && echo "    deleted." ;;
        r|R) [ ! -e "$_orig" ] && mv -- "$_lo" "$_orig" && echo "    restored." ;;
        a|A) echo "Aborted."; exit 77 ;;
        *)   echo "    kept." ;;
      esac
    done
    exit 0
  fi

  # ─── --clean-stale ───
  # Does ONLY stale-registration cleanup — nothing else 'sm go' does
  # (no adding new submodules, no rebinding moved ones, no ignore-marker
  # handling). For when a .gitmodules entry's on-disk path is gone and
  # that's ALL you want touched — 'sm go' as a whole is not scoped to
  # just that, and running it can trigger unrelated adds/rebinds you
  # may not want yet.
  #
  # Walks the WHOLE tree regardless of depth (same as --list-ignored
  # already does) — a stale entry can live in ANY nested repo's OWN
  # .gitmodules, not just the current directory's. E.g. an unregistered
  # 'src' (from this scope's point of view) can itself be a full repo
  # with its own .gitmodules and its own stale entries — those are
  # invisible if this only checked the current directory, which is
  # exactly what a plain single-repo scope would otherwise miss.
  _sm_clean_stale_here() {
    # Cleans ONLY the CURRENT directory's own .gitmodules — assumes
    # cwd is already the right repo. Returns the number removed via
    # stdout (so callers can total across repos); prints progress to
    # the real stdout/stderr as it goes.
    _cs_stale=$(list_stale_submodules "$(pwd -P)")
    [ -n "$_cs_stale" ] || { echo 0; return 0; }
    _cs_removed=0
    while IFS= read -r _cs_sp; do
      [ -n "$_cs_sp" ] || continue
      _cs_name=$(_sm_safe_git . config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
                   | awk -v p="$_cs_sp" '$2 == p {print $1}' \
                   | sed 's/^submodule\.//;s/\.path$//' | head -1)
      _cs_why="no directory on disk"
      [ -e "$_cs_sp/.git" ] || [ -e "$_cs_sp/${GIT_SIDECAR_DIRNAME:-.git.real}" ] \
        && _cs_why="the path lives INSIDE another registered submodule, so this entry is dead"
      printf '\nSTALE    %s/%s  (registered as name=%s, %s)\n' \
        "$(pwd -P)" "$_cs_sp" "$_cs_name" "$_cs_why" >&2
      if [ "$_sm_interactive" -eq 1 ]; then
        _ans=$(_sm_ask "    Remove stale registration? [Y]es / [S]kip / [A]bort: ")
        case "$_ans" in
          a|A) echo "Aborted by user." >&2; exit 77 ;;
          s|S|n|N) echo "    skipped." >&2; continue ;;
        esac
      fi
      printf '    removing .gitmodules entry, .git/config entry, index entry, .git/modules/%s\n' "$_cs_name" >&2
      run git config -f .gitmodules --remove-section "submodule.$_cs_name" 2>/dev/null || true
      run git config --remove-section "submodule.$_cs_name" 2>/dev/null || true
      run git update-index --force-remove -- "$_cs_sp" 2>/dev/null || true
      [ -n "$_cs_name" ] && rm -rf -- ".git/modules/$_cs_name" 2>/dev/null || true
      _cs_removed=$((_cs_removed + 1))
    done <<_CS_EOF
$_cs_stale
_CS_EOF
    if [ "$_cs_removed" -gt 0 ]; then
      if [ -f .gitmodules ] && ! git config -f .gitmodules --get-regexp '^submodule\..*\.path$' >/dev/null 2>&1; then
        run git update-index --force-remove -- .gitmodules 2>/dev/null || true
        run rm -f -- .gitmodules
      else
        run git add -- .gitmodules 2>/dev/null || true
      fi
      if git diff --cached --quiet 2>/dev/null; then
        printf '    nothing to commit in %s (no net diff vs HEAD)\n' "$(pwd -P)" >&2
      else
        run git commit -q -m "my-git sm --clean-stale: removed $_cs_removed stale registration(s)" || \
          { log_error "commit failed in $(pwd -P)"; echo 0; return 1; }
        printf '    committed in %s\n' "$(pwd -P)" >&2
      fi
    fi
    echo "$_cs_removed"
  }

  if [ "$_sm_clean_stale" -eq 1 ]; then
    _cs_repos_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.csrepos.XXXXXX")
    trace "find . -mindepth 2 -name .git   # discover nested repos (stale-registration scan)"
    {
      echo "."
      find . -mindepth 2 -name .git \( -type d -o -type f \) \
           -not -path "*${_sm_PREEXISTING_SUFFIX}*" 2>/dev/null | sed 's|/\.git$||'
    } > "$_cs_repos_tmp"
    _cs_total=0
    _cs_repos_touched=0
    while IFS= read -r _cs_repo; do
      [ -n "$_cs_repo" ] || continue
      [ -f "$_cs_repo/.gitmodules" ] || continue
      _cs_n=$( ( cd "$_cs_repo" 2>/dev/null && _sm_clean_stale_here ) )
      _cs_rc=$?
      [ "$_cs_rc" = 77 ] && { echo "Aborted by user." >&2; rm -f "$_cs_repos_tmp"; exit 77; }
      _cs_n=${_cs_n:-0}
      if [ "$_cs_n" -gt 0 ] 2>/dev/null; then
        _cs_total=$((_cs_total + _cs_n))
        _cs_repos_touched=$((_cs_repos_touched + 1))
      fi
    done < "$_cs_repos_tmp"
    rm -f "$_cs_repos_tmp"
    if [ "$_cs_total" -eq 0 ]; then
      echo "No stale registrations found (checked every nested repo's own .gitmodules)."
      exit 0
    fi
    echo "Removed $_cs_total stale registration(s) across $_cs_repos_touched repo(s)."
    exit 0
  fi

  _leftovers=$(_sm_find_leftovers)
  if [ -n "$_leftovers" ]; then
    echo "error: leftover aside-directories from a previous run detected:" >&2
    printf '%s\n' "$_leftovers" | sed 's/^/  /' >&2
    echo >&2
    echo "These were created when 'go' was interrupted mid-add. Resolve first:" >&2
    echo "  $US sm --clean-leftovers" >&2
    exit 3
  fi

  # ─── --list-ignored ───
  if [ "$_sm_list_ignored" -eq 1 ]; then
    echo "Ignored nested repos under $_sm_toplevel (marker: .git/$_sm_IGNORE_MARKER):"
    _n=0; _n_conflict=0
    _tmp=$(mktemp "${TMPDIR:-/tmp}/listign.XXXXXX")
    trace "find . -mindepth 2 -name .git   # discover nested repos (--list-ignored)"
    find . -mindepth 2 -name .git \( -type d -o -type f \) \
         -not -path "*${_sm_PREEXISTING_SUFFIX}*" | sort > "$_tmp"
    while IFS= read -r gp; do
      sp=${gp%/.git}; sp=${sp#./}
      _sm_is_ignored "$gp" "$sp" || continue
      printf '  %s\n' "$sp"
      _n=$((_n + 1))
      # Diagnostic remarks — an ignored repo is expected NOT to be in
      # .gitmodules. Flag any conflict so `sm go` can fix it.
      _cfg=$(_sm_resolve_cfg "$gp" "$sp")
      _url=''
      [ -f "$_cfg" ] && _url=$(git config -f "$_cfg" --get remote.origin.url 2>/dev/null || true)
      if _sm_is_registered_submodule "$sp"; then
        printf '    !! CONFLICT: also registered in .gitmodules at this same path\n'
        _n_conflict=$((_n_conflict + 1))
      elif [ -n "$_url" ]; then
        _regpath=$(_sm_registered_path_for_url "$_url" || true)
        if [ -n "$_regpath" ] && [ "$_regpath" != "$sp" ]; then
          printf '    !! CONFLICT: registered in .gitmodules at %s (path mismatch)\n' "$_regpath"
          printf '       run:  %s sm go -i   and choose [U]pdate path, or [R]emove marker\n' "$US"
          _n_conflict=$((_n_conflict + 1))
        fi
      fi
    done < "$_tmp"
    rm -f "$_tmp"
    printf '\nTotal ignored: %s' "$_n"
    [ "$_n_conflict" -gt 0 ] && printf ' (conflicts: %s)' "$_n_conflict"
    printf '\n'
    exit 0
  fi

  # ─── --unstage-embedded ───
  if [ "$_sm_unstage_embedded" -eq 1 ]; then
    _embedded=$(git ls-files -s 2>/dev/null | awk '$1 == "160000" {print}' \
                | cut -f2- | sort)
    if [ -z "$_embedded" ]; then
      echo "No embedded repo entries found in the index."
      exit 0
    fi
    _registered_list=''
    [ -f .gitmodules ] && _registered_list=$(
      git config -f .gitmodules --get-regexp "^submodule\..*\.path$" 2>/dev/null \
          | sed 's/^[^ ]* //'
    )
    _to_unstage=$(
      printf '%s\n' "$_embedded" | while IFS= read -r _p; do
        if ! printf '%s\n' "$_registered_list" | grep -Fxq "$_p"; then
          printf '%s\n' "$_p"
        fi
      done
    )
    if [ -z "$_to_unstage" ]; then
      echo "All mode-160000 entries are registered submodules — nothing to unstage."
      exit 0
    fi
    echo "Embedded (non-submodule) repos currently staged:"
    printf '%s\n' "$_to_unstage" | sed 's/^/  /'
    echo
    printf '%s\n' "$_to_unstage" | while IFS= read -r _p; do
      printf 'UNSTAGE  %s\n' "$_p"
      run git update-index --force-remove -- "$_p" >/dev/null 2>&1 || {
        printf 'WARN  git update-index --force-remove failed for %s\n' "$_p" >&2
      }
    done
    echo
    echo "Done. Working tree is unchanged."
    echo "Tip: run '$US sm --sync-gitignore' to prevent 'git add' from re-staging them."
    exit 0
  fi

  # ─── --sync-gitignore / --emit-gitignore ───
  if [ "$_sm_sync_gitignore" -eq 1 ] || [ "$_sm_emit_gitignore" -eq 1 ]; then
    _sgi_rc=0
    if [ "$_sm_emit_gitignore" -eq 1 ]; then
      _sm_emit_ignore_patterns
      _sgi_rc=$?
      [ "$_sgi_rc" -ne 0 ] && echo "No ignored nested repos found — nothing to emit."
    else
      _sm_sync_ignore_exclude
      _sgi_rc=$?
    fi
    exit "$_sgi_rc"
  fi

  # ─── Main analyze/dry/go flow ───
  _sm_super_branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo '(detached)')
  _sm_super_origin=$(git config --get remote.origin.url 2>/dev/null || echo '(no origin)')
  _sm_super_dirty=$(git status --porcelain --ignore-submodules=all 2>/dev/null | head -n1)

  log_dbg_med "sm mode=$_sm_mode debug=$DBG verbose=$_sm_verbose interactive=$_sm_interactive force=$_sm_force"

  _sm_tmpfile=$(mktemp "${TMPDIR:-/tmp}/submodscan.XXXXXX")
  _sm_plan=$(mktemp "${TMPDIR:-/tmp}/submodplan.XXXXXX")

  INFLIGHT_ORIG=""; INFLIGHT_TMP=""
  _sm_cleanup() {
    _rc=$?
    if [ -n "$INFLIGHT_TMP" ] && [ -e "$INFLIGHT_TMP" ]; then
      printf 'RECOVER  restoring %s <- %s\n' "$INFLIGHT_ORIG" "$INFLIGHT_TMP" >&2
      run rm -rf -- "$INFLIGHT_ORIG" 2>/dev/null || true
      run mv -- "$INFLIGHT_TMP" "$INFLIGHT_ORIG" 2>/dev/null || true
    fi
    rm -f "$_sm_tmpfile" "$_sm_plan" 2>/dev/null || true
    trap - EXIT
    exit "$_rc"
  }
  trap _sm_cleanup EXIT INT TERM HUP

  # ─── Sidecar → submodule pre-conversion ───
  # A sidecar (GIT_SIDECAR_DIRNAME) is normally "plain content, nothing
  # to register". But 'sm' can convert it INTO a submodule: restore it
  # live first ('unflatten --sidecar'), after which the normal
  # find/register flow below picks it up like any nested repo. A
  # LOCAL-ONLY sidecar (no remote) CANNOT be a submodule — git needs a
  # URL to record — so it's left as a sidecar with a clear note. In
  # analyze/dry mode nothing is restored; we just report what 'go' would
  # convert. Respects PATH-scoping (only the scoped sidecar, if any).
  _sm_sidecars=$(list_realized_dirs .)
  if [ -n "$_sm_scope_rel" ]; then
    _sm_sidecars=$(printf '%s\n' "$_sm_sidecars" | grep -Fx "$_sm_scope_rel" 2>/dev/null || true)
  fi
  if [ -n "$_sm_sidecars" ]; then
    printf '%s\n' "$_sm_sidecars" | while IFS= read -r _scp; do
      [ -n "$_scp" ] || continue
      _scp_url=$(git --git-dir="$_scp/$_sm_grd" config --get remote.origin.url 2>/dev/null)
      if [ -z "$_scp_url" ]; then
        log_major "sm: $_scp is a LOCAL-ONLY sidecar (no remote URL) — cannot become a submodule; left as a sidecar (⌂)"
        continue
      fi
      if [ "$_sm_mode" = go ]; then
        log_major "sm: converting sidecar $_scp → live .git (unflatten --sidecar) so it can be registered as a submodule (remote: $_scp_url)"
        _unfl_restore_sidecar "$_scp" || log_error "sm: could not restore sidecar $_scp — leaving it as-is"
      else
        log_major "sm: WOULD convert sidecar $_scp → submodule (has remote $_scp_url) — re-run with 'go'"
      fi
    done
  fi

  trace "find . -mindepth 2 -name .git   # discover nested repos to register (sm)"
  find . -mindepth 2 -name .git \( -type d -o -type f \) \
       -not -path "*${_sm_PREEXISTING_SUFFIX}*" | sort > "$_sm_tmpfile"
  # PATH-scoping: keep only the candidate AT the scoped path (its own
  # './<path>/.git') — descendants of it are that repo's own concern.
  if [ -n "$_sm_scope_rel" ]; then
    grep -Fx "./$_sm_scope_rel/.git" "$_sm_tmpfile" > "$_sm_tmpfile.scoped" 2>/dev/null || : > "$_sm_tmpfile.scoped"
    mv "$_sm_tmpfile.scoped" "$_sm_tmpfile"
  fi
  _sm_total=$(wc -l < "$_sm_tmpfile" | tr -d ' ')

  _sm_c_registered=0; _sm_c_ready=0; _sm_c_need_untrack=0; _sm_c_no_url=0; _sm_c_dirty=0
  _sm_c_broken_link=0   # .gitmodules entry whose index entry is NOT a gitlink
  _sm_c_prompt=0; _sm_c_nested=0; _sm_c_ignored=0; _sm_c_moved=0; _sm_c_ignored_mismatch=0
  _sm_c_stale=0

  _sm_show_header=1
  [ "$_sm_mode" = go ]      && [ "$_sm_verbose" -eq 0 ] && _sm_show_header=0
  [ "$_sm_mode" = analyze ] && [ "$_sm_verbose" -eq 0 ] && _sm_show_header=0
  [ "$_sm_mode" = dry ]     && [ "$_sm_verbose" -eq 0 ] && _sm_show_header=0

  if [ "$_sm_show_header" -eq 1 ]; then
    echo "============================================================"
    printf 'Super-repo : %s\n' "$_sm_toplevel"
    printf 'Branch     : %s\n' "$_sm_super_branch"
    printf 'Origin     : %s\n' "$_sm_super_origin"
    [ -n "$_sm_super_dirty" ] && printf 'Worktree   : DIRTY\n' || printf 'Worktree   : clean\n'
    if [ -f .gitmodules ]; then
      _reg_count=$(git config -f .gitmodules --get-regexp "^submodule\..*\.path$" 2>/dev/null | wc -l | tr -d ' ')
      printf '.gitmodules: present (%s entries)\n' "$_reg_count"
    else
      printf '.gitmodules: none\n'
    fi
    printf 'Candidates : %s nested .git found\n' "$_sm_total"
    printf 'Interactive: %s     Verbose: %s     Force: %s\n' \
      "$([ "$_sm_interactive" -eq 1 ] && echo on || echo off)" \
      "$([ "$_sm_verbose"     -eq 1 ] && echo on || echo off)" \
      "$([ "$_sm_force"       -eq 1 ] && echo on || echo off)"
    echo "============================================================"
    echo
  fi

  if [ "$_sm_total" -eq 0 ]; then
    echo "No nested Git repositories found below $_sm_toplevel."
    exit 0
  fi

  _sm_compact_header_printed=0
  _sm_maybe_print_compact_header() {
    [ "$_sm_verbose" -eq 1 ] && return 0
    [ "$_sm_compact_header_printed" -eq 1 ] && return 0
    [ "$_sm_mode" = go ] && return 0
    printf '%-8s %-2s  %-52s %s\n' "STATUS" "FL" "PATH" "INFO"
    _sm_compact_header_printed=1
  }

  # ─── Stale-registration pre-pass ───
  # Detect entries in .gitmodules whose on-disk path DOESN'T EXIST. These
  # are invisible to the main 'find .git' loop (which only sees real
  # directories), yet they clutter .gitmodules and cause 'git submodule
  # status' to list phantom entries. Typical cause: a submodule was moved
  # on disk without updating the registration (or the old entry wasn't
  # removed after a rename).
  # SKIPPED when PATH-scoped: 'sm <path> go' must touch ONLY <path> — a
  # tree-wide stale sweep is exactly the kind of unrelated maintenance
  # scoping is meant to suppress (use bare 'sm --clean-stale' for that).
  if [ -f .gitmodules ] && [ -z "$_sm_scope_rel" ]; then
    git config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
    | while IFS= read -r _stline; do
        _stkey=${_stline%% *}; _stpath=${_stline#* }
        [ -n "$_stpath" ] || continue
        # Present as a live repo (.git) OR a sidecar (GIT_SIDECAR_DIRNAME)
        # → NOT stale. A sidecared-but-still-registered submodule EXISTS;
        # flagging it "missing on disk" wrongly deregistered it.
        if [ -e "$_stpath/.git" ] || [ -e "$_stpath/${GIT_SIDECAR_DIRNAME:-.git.real}" ]; then
          continue
        fi
        # Extract the submodule name from the config key (submodule.<NAME>.path).
        _stname=${_stkey#submodule.}
        _stname=${_stname%.path}
        _sturl=$(git config -f .gitmodules --get "submodule.${_stname}.url" 2>/dev/null || true)
        printf 'stale-registration\t%s\t%s\t%s\n' "$_stpath" "$_sturl" "$_stname" >> "$_sm_plan"
        _sm_emit_compact STALE "" "$_stpath" "registered but missing on disk (name=$_stname)"
        _sm_c_stale=$((_sm_c_stale + 1))
      done
    # _sm_c_stale updates inside the pipe live in a subshell (POSIX sh).
    # Recover the count by counting lines we just wrote.
    _sm_c_stale=$(awk -F'\t' '$1=="stale-registration"' "$_sm_plan" 2>/dev/null | wc -l | tr -d ' ')
    [ -z "$_sm_c_stale" ] && _sm_c_stale=0
  fi

  # ─── Per-candidate analysis loop ───
  while IFS= read -r gitpath; do
    submod_path=${gitpath%/.git}
    submod_path=${submod_path#./}

    log_dbg_med "sm candidate: $submod_path"

    cfg=$(_sm_resolve_cfg "$gitpath" "$submod_path")
    url=''
    [ -f "$cfg" ] && url=$(git config -f "$cfg" --get remote.origin.url 2>/dev/null || true)

    ignored=0
    _sm_is_ignored "$gitpath" "$submod_path" && ignored=1

    registered=0
    _sm_is_registered_submodule "$submod_path" && registered=1

    enc=''
    [ "$registered" -eq 0 ] && enc=$(_sm_enclosing_submodule "$submod_path" || true)

    tracked=0
    [ "$registered" -eq 0 ] && _sm_is_tracked_in_index "$submod_path" && tracked=1

    clean=0
    _sm_nested_is_clean "$submod_path" && clean=1

    status_kw=unknown
    plan_action=''

    # A .gitmodules entry whose index entry is NOT a gitlink is a BROKEN
    # registration: git sees plain content there, so the submodule is not
    # functioning as one. Report it instead of counting it as healthy.
    if [ "$registered" -eq 1 ] && ! _sm_is_gitlink_in_index "$submod_path" \
       && _sm_is_tracked_in_index "$submod_path"; then
      status_kw='registered-not-gitlink'
      _sm_c_broken_link=$((_sm_c_broken_link + 1))
      # Repaired by exactly the route a never-registered path takes:
      # untrack the content, then add it back as a gitlink. The
      # .gitmodules entry is already correct, so only the index is wrong.
      plan_action=add-with-untrack
      printf '%s\t%s\t%s\n' "$plan_action" "$submod_path" "$url" >> "$_sm_plan"
    elif [ "$registered" -eq 1 ]; then
      status_kw=registered
      _sm_c_registered=$((_sm_c_registered + 1))
    elif [ -n "$enc" ]; then
      status_kw=nested
      _sm_c_nested=$((_sm_c_nested + 1))
    elif [ "$ignored" -eq 1 ] && [ "$_sm_force" -eq 0 ]; then
      # Ignored via marker — but check for a path-mismatch conflict first:
      # .gitmodules already registers this URL at a DIFFERENT path (typically
      # a stale "old" location that no longer exists on disk). That state is
      # inconsistent and should be surfaced, not silently skipped.
      _ig_regpath=''
      [ -n "$url" ] && _ig_regpath=$(_sm_registered_path_for_url "$url" || true)
      if [ -n "$_ig_regpath" ] && [ "$_ig_regpath" != "$submod_path" ]; then
        status_kw=ignored-mismatch
        _sm_c_ignored_mismatch=$((_sm_c_ignored_mismatch + 1))
        plan_action=resolve-ignored-mismatch
        printf '%s\t%s\t%s\t%s\n' \
          "$plan_action" "$submod_path" "$url" "$_ig_regpath" >> "$_sm_plan"
      else
        status_kw=ignored
        _sm_c_ignored=$((_sm_c_ignored + 1))
      fi
    else
      moved_from=''
      if [ -n "$url" ]; then
        moved_from=$(_sm_find_moved_submodule "$url" || true)
      fi
      if [ -n "$moved_from" ]; then
        status_kw=moved
        _sm_c_moved=$((_sm_c_moved + 1))
        plan_action=rebind-moved
        printf '%s\t%s\t%s\t%s\n' \
          "$plan_action" "$submod_path" "$url" "$moved_from" >> "$_sm_plan"
      elif [ -z "$url" ]; then
        if [ "$_sm_interactive" -eq 1 ] && [ "$_sm_mode" != analyze ]; then
          status_kw=will-prompt
          _sm_c_prompt=$((_sm_c_prompt + 1))
          [ "$tracked" -eq 1 ] && plan_action=prompt-url-untrack || plan_action=prompt-url
          printf '%s\t%s\t\n' "$plan_action" "$submod_path" >> "$_sm_plan"
        else
          status_kw=no-url
          _sm_c_no_url=$((_sm_c_no_url + 1))
        fi
      else
        if [ "$tracked" -eq 1 ]; then
          status_kw=ready-untrack
          _sm_c_need_untrack=$((_sm_c_need_untrack + 1))
          plan_action=add-with-untrack
        else
          status_kw=ready
          _sm_c_ready=$((_sm_c_ready + 1))
          plan_action=add
        fi
        if _sm_url_is_suspicious "$url" && [ "$status_kw" = ready ]; then
          status_kw=suspicious
        fi
        printf '%s\t%s\t%s\n' "$plan_action" "$submod_path" "$url" >> "$_sm_plan"
      fi
      [ "$clean" -eq 0 ] && [ -n "$plan_action" ] && _sm_c_dirty=$((_sm_c_dirty + 1))
    fi

    _fl_dirty='-'; [ "$clean" -eq 0 ] && _fl_dirty='D'
    _fl_track='-'; [ "$tracked" -eq 1 ] && _fl_track='T'
    _flags="${_fl_dirty}${_fl_track}"

    case "$status_kw" in
      registered)       _status_short='OK';       _info='registered' ;;
      registered-not-gitlink)
                        _status_short='BROKEN';   _info='in .gitmodules but staged as CONTENT, not a gitlink' ;;
      nested)           _status_short='NESTED';   _info="parent=$enc" ;;
      ignored)          _status_short='IGNORED';  _info='marker' ;;
      ignored-mismatch) _status_short='CONFLICT'; _info="marker here, registered as $_ig_regpath" ;;
      ready)            _status_short='READY';    _info="$url" ;;
      ready-untrack)    _status_short='READY+UT'; _info="$url" ;;
      will-prompt)      _status_short='PROMPT';   _info='(no origin URL)' ;;
      no-url)           _status_short='NO-URL';   _info='(no origin URL)' ;;
      suspicious)       _status_short='SUSPECT';  _info="$url" ;;
      moved)            _status_short='MOVED';    _info="was=$moved_from  url=$url" ;;
      *)                _status_short="$status_kw"; _info='' ;;
    esac

    if [ "$_sm_verbose" -eq 1 ]; then
      printf -- '--- %s\n' "$submod_path"
      if [ "$ignored" -eq 1 ]; then
        if [ "$_sm_force" -eq 1 ]; then
          printf '    ignore       : marker present, OVERRIDDEN by --force\n'
        else
          printf '    ignore       : marker present — ignored\n'
        fi
      fi
      [ ! -f "$cfg" ] && printf '    config       : MISSING (%s)\n' "$cfg"
      if [ -n "$url" ]; then
        if _sm_url_is_suspicious "$url"; then
          printf '    origin URL   : %s   [suspicious scheme]\n' "$url"
        else
          printf '    origin URL   : %s\n' "$url"
        fi
      else
        printf '    origin URL   : (none — nested repo has no remote.origin)\n'
      fi
      printf '    nested HEAD  : %s @ %s\n' \
        "$(_sm_nested_branch "$submod_path")" "$(_sm_nested_head "$submod_path")"
      [ "$clean" -eq 1 ] && printf '    nested tree  : clean\n' \
                        || printf '    nested tree  : DIRTY (uncommitted changes inside)\n'
      case "$status_kw" in
        registered)    printf '    status       : ALREADY a submodule (.gitmodules)\n' ;;
        nested)        printf '    status       : NESTED inside submodule "%s"\n' "$enc" ;;
        ignored)       printf '    status       : IGNORED via marker\n' ;;
        ignored-mismatch)
                       printf '    status       : CONFLICT — ignored here but registered at "%s"\n' "$_ig_regpath"
                       printf '    action       : sm go -i will prompt [U]pdate path / [R]emove marker\n' ;;
        ready)         printf '    status       : READY (will add)\n' ;;
        registered-not-gitlink)
                       printf '    index        : BROKEN registration -- .gitmodules lists it, but the index holds its FILES as content, not a 160000 gitlink. git does not treat it as a submodule.\n'
                       printf '                   fix: %s sm go %s   (untrack the content, restore the gitlink)\n' "$US" "$submod_path" ;;
        ready-untrack) printf '    index        : TRACKED as plain files — needs untrack\n'
                       printf '    status       : READY (will untrack, then add)\n' ;;
        will-prompt)   printf '    status       : WILL PROMPT for URL (interactive)\n' ;;
        no-url)        printf '    status       : CANNOT ADD — no URL to register against\n' ;;
        suspicious)    printf '    status       : READY but URL scheme is suspicious\n' ;;
        moved)         printf '    status       : MOVED from "%s" (same URL, old path missing)\n' "$moved_from"
                       printf '    action       : rename bookkeeping is manual; see note below\n' ;;
        *)             printf '    status       : %s\n' "$status_kw" ;;
      esac
    else
      if [ "$_sm_mode" != go ]; then
        _sm_maybe_print_compact_header
        _sm_emit_compact "$_status_short" "$_flags" "$submod_path" "$_info"
      fi
    fi
  done < "$_sm_tmpfile"

  # ─── Summary ───
  _sm_to_do=$((_sm_c_ready + _sm_c_need_untrack + _sm_c_prompt + _sm_c_moved + _sm_c_ignored_mismatch + _sm_c_stale + _sm_c_broken_link))

  if [ "$_sm_verbose" -eq 1 ] || [ "$_sm_mode" != go ]; then
    echo
    echo "============================================================"
    echo "Summary"
    echo "============================================================"
    printf '  already registered       : %s\n' "$_sm_c_registered"
    [ "$_sm_c_broken_link" -gt 0 ] && \
      printf '  %sBROKEN registration      : %s   (.gitmodules entry, but content in the index instead of a gitlink)%s\n' "$C_RED$C_BOLD" "$_sm_c_broken_link" "$C_RESET"
    printf '  ready to add             : %s\n' "$_sm_c_ready"
    printf '  ready (needs untrack)    : %s\n' "$_sm_c_need_untrack"
    printf '  missing origin URL       : %s\n' "$_sm_c_no_url"
    [ "$_sm_c_prompt"  -gt 0 ] && printf '  will prompt for URL      : %s\n' "$_sm_c_prompt"
    [ "$_sm_c_nested"  -gt 0 ] && printf '  nested in submodule      : %s   (belongs to parent)\n' "$_sm_c_nested"
    [ "$_sm_c_ignored" -gt 0 ] && printf '  ignored via marker       : %s%s\n' "$_sm_c_ignored" \
      "$([ "$_sm_force" -eq 1 ] && echo '   (overridden by --force)')"
    [ "$_sm_c_ignored_mismatch" -gt 0 ] && printf '  ignored + path mismatch  : %s   (CONFLICT — will prompt with -i)\n' "$_sm_c_ignored_mismatch"
    [ "$_sm_c_moved"   -gt 0 ] && printf '  moved (rename detected)  : %s   (will be rebound)\n' "$_sm_c_moved"
    [ "$_sm_c_stale"   -gt 0 ] && printf '  stale registrations      : %s   (in .gitmodules, no on-disk path — will be REMOVED)\n' "$_sm_c_stale"
    printf '  actionable with dirty WT : %s   (their changes preserved)\n' "$_sm_c_dirty"
    printf '  actions planned          : %s\n' "$_sm_to_do"
    echo
  fi

  if [ "$_sm_mode" = analyze ]; then
    if [ "$_sm_to_do" -gt 0 ]; then
      echo "Next: run '$US sm --dry' to preview, then '$US sm go' to apply."
      [ "$_sm_c_no_url"  -gt 0 ] && echo "Tip:  add -i/--interactive to be prompted for missing URLs."
      [ "$_sm_c_ignored" -gt 0 ] && echo "Tip:  '$US sm --list-ignored' to audit, or 'go --force' to override markers."
    else
      echo "Nothing to do."
    fi
    [ "$_sm_c_nested" -gt 0 ] && echo "Note: nested-in-submodule entries must be added from inside the parent submodule."
    if [ "$_sm_c_moved" -gt 0 ]; then
      echo "Note: MOVED entries are submodules whose on-disk path changed."
      echo "      'go' will rebind each: remove the old .gitmodules entry,"
      echo "      remove .git/modules/<OLD>/, untrack <OLD> from the index,"
      echo "      and add the submodule fresh at the new path via the"
      echo "      same URL.  Use -i to be warned about unpushed work."
    fi
    exit 0
  fi

  # Cross-submodule scan: find unregistered non-ignored nested repos that live
  # INSIDE registered submodules (sm can't register them from here — they
  # belong to their parent submodule — but it MUST mention them so the user
  # isn't left wondering why 'st' shows [raw-nested-git] that 'sm go' ignores).
  _sm_cross_tmp=$(mktemp "${TMPDIR:-/tmp}/smcross.XXXXXX")
  find_cross_submodule_unregistered "$(pwd -P)" > "$_sm_cross_tmp" 2>/dev/null || : > "$_sm_cross_tmp"
  _sm_c_cross=$(awk 'NF' "$_sm_cross_tmp" 2>/dev/null | wc -l | tr -d ' ')
  [ -z "$_sm_c_cross" ] && _sm_c_cross=0

  if [ "$_sm_to_do" -eq 0 ]; then
    # Always print a registration verdict so the user can tell "all fine" from
    # "nothing printed because silent". Structure: MILESTONE ' >>> ' first, then
    # '  >> ' elaborations.
    if [ "$_sm_c_ignored_mismatch" -gt 0 ]; then
      printf ' >>> sm: %s CONFLICT(s) — registered path disagrees with ignore marker\n' \
        "$_sm_c_ignored_mismatch"
      printf '  >> run:  %s sm --list-ignored\n' "$US"
      printf '  >> then: %s sm go -i     # to pick [U]pdate path or [R]emove marker\n' "$US"
    elif [ "$_sm_c_cross" -gt 0 ]; then
      printf ' >>> sm: %s unregistered nested repo(s) live INSIDE registered submodules\n' \
        "$_sm_c_cross"
      printf '  >> to register them, either pass -R to walk the whole tree:\n'
      printf '        %s sm -R go -i\n' "$US"
      printf '  >> or cd into each parent and run sm go there:\n'
      while IFS="$(printf '\t')" read -r _cpar _csub; do
        [ -n "$_cpar" ] || continue
        printf '        cd %s && %s sm go -i    # to register: %s\n' "$_cpar" "$US" "$_csub"
      done < "$_sm_cross_tmp"
    else
      printf ' >>> sm: all nested repos accounted for (registered: %s, ignored: %s' \
        "$_sm_c_registered" "$_sm_c_ignored"
      [ "$_sm_c_nested" -gt 0 ] && printf ', inside-submodule: %s' "$_sm_c_nested"
      printf ')\n'
      if [ "$_sm_c_nested" -gt 0 ]; then
        printf '  >> note: %s nested-in-submodule entry(ies) must be registered from inside their parent\n' \
          "$_sm_c_nested"
      fi
    fi
    rm -f "$_sm_cross_tmp"
    # Still reconcile the exclude file even when there's nothing to register —
    # users may have added/removed ignore markers by hand since the last run.
    [ "$_sm_mode" = go ] && _sm_sync_ignore_exclude quiet || true
    exit 0
  fi

  # ─── Sort the plan TOP-DOWN (parents before children) ───
  # Registration must be top-down: once a parent is registered as a submodule,
  # any nested candidate below it belongs to the parent, not the super-repo.
  # (This is the OPPOSITE order from 'mc', which is bottom-up so child commits
  # bubble up into the parent's gitlink.)
  _sm_plan_sorted=$(mktemp "${TMPDIR:-/tmp}/submodplansort.XXXXXX")
  awk -F'\t' -v OFS='\t' '{
    n = gsub(/\//, "/", $2)
    printf "%04d\t%s\n", n, $0
  }' "$_sm_plan" | LC_ALL=C sort -s -k1,1 -k3,3 | cut -f2- > "$_sm_plan_sorted"
  mv "$_sm_plan_sorted" "$_sm_plan"

  # ─── Dry ───
  if [ "$_sm_mode" = dry ]; then
    echo "Planned operations (dry run):"
    while IFS="$(printf '\t')" read -r action sp url old; do
      case "$action" in
        add-with-untrack)
          printf '  git ls-files -z -- %s | git update-index -z --force-remove --stdin\n' "$sp"
          printf '  git submodule add %s %s\n' "$url" "$sp"
          ;;
        add)
          printf '  git submodule add %s %s\n' "$url" "$sp"
          ;;
        prompt-url)
          printf '  [prompt for URL] git submodule add <url> %s\n' "$sp"
          ;;
        prompt-url-untrack)
          printf '  [prompt for URL] then:\n'
          printf '    git ls-files -z -- %s | git update-index -z --force-remove --stdin\n' "$sp"
          printf '    git submodule add <url> %s\n' "$sp"
          ;;
        rebind-moved)
          printf '  # REBIND moved submodule: %s -> %s\n' "$old" "$sp"
          printf '    (remove [submodule "%s"] from .gitmodules)\n' "$old"
          printf '    git update-index --force-remove -- %s\n' "$old"
          printf '    rm -rf -- .git/modules/%s\n' "$old"
          printf '    git submodule add %s %s\n' "$url" "$sp"
          ;;
        resolve-ignored-mismatch)
          printf '  # CONFLICT: %s has ignore marker, registered at %s\n' "$sp" "$old"
          printf '    (requires -i: prompts [U]pdate path / [R]emove marker / [S]kip / [A]bort)\n'
          ;;
        stale-registration)
          printf '  # STALE: %s is in .gitmodules but no directory exists\n' "$sp"
          printf '    git config -f .gitmodules --remove-section submodule.%s\n' "$old"
          printf '    git config --remove-section submodule.%s  2>/dev/null || true\n' "$old"
          printf '    git update-index --force-remove -- %s  2>/dev/null || true\n' "$sp"
          printf '    rm -rf -- .git/modules/%s  2>/dev/null || true\n' "$old"
          ;;
      esac
    done < "$_sm_plan"
    echo
    echo "Dry run complete. Re-run with 'go' to apply."
    exit 0
  fi

  # ─── Go — apply ───

  # _sm_swap_in_backup
  # Restore $_sp from the $_tmp backup made earlier by
  # _sm_try_add_with_prompts. Refuses to rm $_sp if $_tmp is missing —
  # otherwise a lost-backup bug would silently wipe the path. Used by
  # both success ("replace cloned content with user's original") and
  # failure ("undo partial submodule add") paths in that function.
  # Clears INFLIGHT_ORIG / INFLIGHT_TMP so the EXIT trap won't double-act.
  _sm_swap_in_backup() {
    if [ -z "${_sp:-}" ] || [ -z "${_tmp:-}" ]; then
      return 0
    fi
    if [ ! -e "$_tmp" ]; then
      log_error "_sm: backup '$_tmp' missing — refusing to rm '$_sp' (manual recovery needed)"
      INFLIGHT_ORIG=""; INFLIGHT_TMP=""
      return 1
    fi
    rm -rf -- "$_sp" 2>/dev/null || true
    mv -- "$_tmp" "$_sp" 2>/dev/null || \
      log_warn "_sm: mv '$_tmp' -> '$_sp' failed"
    INFLIGHT_ORIG=""; INFLIGHT_TMP=""
  }

  # _sm_check_untrack_safety <path> <target-url>
  #
  # Pre-flight check for the add-with-untrack / prompt-url-untrack
  # action (destructive: tracked content tree -> registered submodule).
  # Exists because the next steps (index clearing + git submodule add)
  # can silently wipe untracked or uncommitted changes inside the
  # nested repo if anything goes wrong — same family of silent loss as
  # 'git reset --hard' across a content<->gitlink shape change.
  #
  # Three checks, in order:
  #   (1) Pre-flight INSIDE the nested: 'git status --porcelain'. Any
  #       uncommitted/untracked content -> refuse with the list of at-
  #       risk paths and a hint (commit / stash / explicitly accept).
  #   (2) URL match: compare nested 'remote.origin.url' to <target-url>.
  #       Mismatch -> warn and prompt; Enter = abort, 'y' = proceed.
  #   (3) Optional backup: ask Y/N with a 'du -sh' size estimate. If
  #       'y', tar the directory into a known tmp path so the user has
  #       a persistent copy they can restore from later (independent of
  #       the mv-aside rollback _sm_try_add_with_prompts already does).
  #
  # Return:
  #   0  safe to proceed
  #   1  refuse / skip this item (not fatal to the run)
  #   2  user aborted the whole sm run
  _sm_check_untrack_safety() {
    _csp=$1; _curl=$2
    # (1) Pre-flight inside nested. Only meaningful if nested has a .git.
    if [ -d "$_csp/.git" ] || [ -f "$_csp/.git" ]; then
      _dirty=$(git -C "$_csp" status --porcelain 2>/dev/null)
      if [ -n "$_dirty" ]; then
        printf 'REFUSE   %s has uncommitted/untracked content:\n' "$_csp" >&2
        printf '%s\n' "$_dirty" | sed 's/^/           /' >&2
        printf '         commit, stash, or push inside %s first, then re-run.\n' "$_csp" >&2
        return 1
      fi
    fi
    # (2) URL match (only if nested has a .git and an origin).
    if [ -d "$_csp/.git" ] || [ -f "$_csp/.git" ]; then
      _rurl=$(git -C "$_csp" config remote.origin.url 2>/dev/null)
      if [ -n "$_rurl" ] && [ "$_rurl" != "$_curl" ]; then
        printf 'WARN     %s remote.origin.url = %s\n' "$_csp" "$_rurl" >&2
        printf '         about to register as       = %s\n' "$_curl" >&2
        if [ "$_sm_interactive" -eq 1 ]; then
          _ans=$(_sm_ask "         URLs differ. Proceed anyway? [y/N/a]: ")
          case "$_ans" in
            y|Y) : ;;
            a|A) return 2 ;;
            *)   echo "         refused — skipping." >&2; return 1 ;;
          esac
        else
          echo "         (non-interactive: refusing. Re-run with -i to override.)" >&2
          return 1
        fi
      fi
    fi
    # (3) Optional backup with size estimate + typed confirm.
    if [ "$_sm_interactive" -eq 1 ]; then
      _size=$(du -sh -- "$_csp" 2>/dev/null | awk '{print $1}')
      [ -z "$_size" ] && _size="?"
      _ans=$(_sm_ask "         create a persistent tar backup of $_csp ($_size) to /tmp before proceeding? [y/N]: ")
      case "$_ans" in
        y|Y)
          _bfile=$(mktemp -u "${TMPDIR:-/tmp}/${US}.sm-backup.$(printf '%s' "$_csp" | tr / _).XXXXXX").tar
          if tar -cf "$_bfile" -- "$_csp" 2>/dev/null; then
            printf 'BACKUP   %s -> %s\n' "$_csp" "$_bfile"
          else
            printf 'WARN     tar backup FAILED for %s (proceeding without backup)\n' "$_csp" >&2
            rm -f "$_bfile" 2>/dev/null
          fi
          ;;
        *) : ;;
      esac
    fi
    return 0
  }

  _sm_try_add_with_prompts() {
    _sp=$1; _url=$2
    _orig_url=$_url

    if [ "$_sm_interactive" -eq 1 ]; then
      while _sm_url_is_suspicious "$_url"; do
        printf '\n    The URL "%s" uses an unusual scheme that often fails.\n' "$_url"
        _ans=$(_sm_ask "    [U]se anyway / [E]dit / [S]kip / [I]gnore permanently / [A]bort? [U/e/s/i/a]: ")
        case "$_ans" in
          e|E)
            _new=$(_sm_ask "    New URL: ")
            _new=$(_sm_normalize_url "$_new")
            if [ -n "$_new" ] && [ "$_new" != "$_url" ]; then
              _pre_cfg=$(_sm_resolve_cfg "${_sp}/.git" "$_sp")
              _sm_persist_url_change "$_pre_cfg" "$_new" "$_orig_url" || true
              _url=$_new
            fi
            ;;
          s|S) return 1 ;;
          i|I)
            _gp=$(_sm_gitpath_for "$_sp")
            if [ -n "$_gp" ]; then
              _sm_mark_ignored "$_gp" "$_sp" && return 3 || return 1
            fi
            return 1 ;;
          a|A) return 2 ;;
          u|U|'') break ;;
          *) : ;;
        esac
      done
    fi

    # ─── .gitignore pre-check ─────────────────────────────────────────
    # Catch the 'ignored-path' case BEFORE invoking 'git submodule add'. A
    # .gitignore match is a deliberate user signal ("skip this"), not a
    # failure — handling it here avoids git's noisy "hint: Use -f if you
    # really want to add them." banner and the misleading ERROR line.
    _ignpath_force=0
    # Use -q for the verdict: exit 0 iff the path is effectively ignored.
    # 'check-ignore -v' alone is insufficient because it prints a line even
    # when the winning pattern is a NEGATION (!pat) — a false positive here.
    if git -C "$_sm_toplevel" check-ignore -q -- "$_sp" 2>/dev/null; then
      _ci=$(git -C "$_sm_toplevel" check-ignore -v -- "$_sp" 2>/dev/null | head -1)
    else
      _ci=""
    fi
    if [ -n "$_ci" ]; then
      _ci_lhs=$(printf '%s' "$_ci" | awk -F'\t' '{print $1}')
      _ci_src=${_ci_lhs%%:*}
      _ci_rest=${_ci_lhs#*:}
      _ci_lno=${_ci_rest%%:*}
      _ci_pat=${_ci_rest#*:}
      # Hint: the matching .gitignore may belong to an UNREGISTERED nested
      # repo of the super — in which case that nested repo is the real fix.
      _hint_dir=""
      if [ -n "$_ci_src" ]; then
        _reg_paths=$(git -C "$_sm_toplevel" config -f .gitmodules \
          --get-regexp '^submodule\..*\.path$' 2>/dev/null \
          | awk '{$1=""; sub(/^ /,""); print}')
        _d=$(dirname "$_ci_src")
        while [ -n "$_d" ] && [ "$_d" != "." ] && [ "$_d" != "/" ]; do
          if [ -e "$_sm_toplevel/$_d/.git" ]; then
            if ! printf '%s\n' "$_reg_paths" | grep -qxF "$_d"; then
              _hint_dir=$_d
              break
            fi
          fi
          _d=$(dirname "$_d")
        done
      fi
      # Compute path to append as a negation, relative to the matching
      # .gitignore's own directory (so it targets this file's scope).
      _gi_dir=$(dirname "$_ci_src")
      case "$_gi_dir" in
        ""|".") _rel_from_gi=$_sp ;;
        *)      _rel_from_gi=${_sp#"$_gi_dir"/} ;;
      esac

      if [ "$_sm_interactive" -ne 1 ]; then
        # Default: respect .gitignore silently. It IS the permanent marker
        # (no need for a parallel my-git.ignore file).
        if [ -n "$_ci_lhs" ]; then
          log_medium "respecting .gitignore for $_sp ($_ci_src:$_ci_lno pattern '$_ci_pat')"
        else
          log_medium "respecting .gitignore for $_sp"
        fi
        [ -n "$_hint_dir" ] && \
          log_medium "hint: $_hint_dir is itself an unregistered nested repo — register it first so its .gitignore stops leaking"
        return 1
      fi

      printf '\n    %s is matched by a .gitignore pattern.\n' "$_sp"
      if [ -n "$_ci_lhs" ]; then
        printf '      source:  %s:%s\n' "$_ci_src" "$_ci_lno"
        printf '      pattern: %s\n' "$_ci_pat"
      fi
      if [ -n "$_hint_dir" ]; then
        printf '      hint:    %s is itself an UNREGISTERED nested repo —\n' "$_hint_dir"
        printf '               register it first (%s sm go, accept %s)\n' "$US" "$_hint_dir"
        printf '               so its .gitignore stops leaking into this add.\n'
      fi
      printf '    Options:\n'
      printf '      [N]egate  append "!%s/" to %s (+ any excluded parent dir),\n' \
        "$_rel_from_gi" "$_ci_src"
      printf '                then register                      (keeps .gitignore honest)\n'
      printf '      [F]orce   git submodule add -f                (leaves .gitignore stale)\n'
      printf '      [S]kip    respect .gitignore                  (.gitignore IS the marker)\n'
      printf '      [A]bort\n'
      _ans=$(_sm_ask "    Choice? [N/f/s/a]: ")
      case "$_ans" in
        n|N|'')
          # Append !<rel>/ to the matching .gitignore, AND additionally
          # unignore every ancestor dir that is itself excluded. Git's
          # gitignore rule: "It is not possible to re-include a file if
          # a parent directory of that file is excluded." — so a sole
          # !<target>/ is silently no-op when the pattern matches the
          # parent dir (e.g. ',*/' matches ',archive/').
          _gi_file="$_sm_toplevel/$_ci_src"
          _sm_append_negation "$_gi_file" "$_rel_from_gi"
          _an_rc=$?
          case "$_an_rc" in
            0) printf '    appended "!%s/" to %s\n' "$_rel_from_gi" "$_ci_src"
               _sm_record_change "$_ci_src"
               _sm_negations_added=$((_sm_negations_added + 1)) ;;
            2) printf '    "!%s/" already present in %s\n' "$_rel_from_gi" "$_ci_src" ;;
            *) return 1 ;;
          esac
          # Walk up from the target; each ignored ancestor gets its own
          # negation (appended to whichever .gitignore ignores it, which
          # may differ from the target's). Deepest-first so parents open
          # up before we recheck.
          _neg_iter=0
          while [ "$_neg_iter" -lt 16 ]; do
            _neg_iter=$((_neg_iter + 1))
            if ! git -C "$_sm_toplevel" check-ignore -q -- "$_sp" 2>/dev/null; then
              break
            fi
            _anc=$_sp
            _found_anc=""
            while : ; do
              _parent=$(dirname "$_anc")
              case "$_parent" in ""|"."|"/") break ;; esac
              if git -C "$_sm_toplevel" check-ignore -q -- "$_parent" 2>/dev/null; then
                _anc=$_parent
                _found_anc=$_parent
              else
                break
              fi
            done
            [ -z "$_found_anc" ] && break
            _aci=$(git -C "$_sm_toplevel" check-ignore -v -- "$_found_anc" 2>/dev/null | head -1)
            [ -z "$_aci" ] && break
            _aci_lhs=$(printf '%s' "$_aci" | awk -F'\t' '{print $1}')
            _aci_src=${_aci_lhs%%:*}
            _aci_gi_file="$_sm_toplevel/$_aci_src"
            _aci_gi_dir=$(dirname "$_aci_src")
            case "$_aci_gi_dir" in
              ""|".") _aci_rel=$_found_anc ;;
              *)      _aci_rel=${_found_anc#"$_aci_gi_dir"/} ;;
            esac
            _sm_append_negation "$_aci_gi_file" "$_aci_rel"
            _an_rc=$?
            case "$_an_rc" in
              0) printf '    also appended "!%s/" to %s (parent dir was excluded)\n' "$_aci_rel" "$_aci_src"
                 _sm_record_change "$_aci_src"
                 _sm_negations_added=$((_sm_negations_added + 1)) ;;
              2) printf '    "!%s/" already present in %s — but parent still ignored, stopping\n' "$_aci_rel" "$_aci_src"
                 break ;;
              *) return 1 ;;
            esac
          done
          # Fall through — git submodule add will now succeed without -f.
          ;;
        f|F) _ignpath_force=1 ;;
        s|S) return 1 ;;
        a|A) return 2 ;;
        *)   return 1 ;;
      esac
    fi

    _tmp="${_sp}${_sm_PREEXISTING_SUFFIX}$$"
    INFLIGHT_ORIG="$_sp"; INFLIGHT_TMP="$_tmp"
    mv -- "$_sp" "$_tmp"

    while : ; do
      printf 'ADD      %s  <-  %s\n' "$_sp" "$_url"
      _errlog=$(mktemp "${TMPDIR:-/tmp}/submoderr.XXXXXX")
      if [ "$_ignpath_force" = 1 ]; then
        _sm_safe_git "$_sm_toplevel" submodule add -f "$_url" "$_sp" 2>"$_errlog"
      else
        _sm_safe_git "$_sm_toplevel" submodule add "$_url" "$_sp" 2>"$_errlog"
      fi
      _rc=$?

      if [ "$_rc" -eq 0 ]; then
        rm -f "$_errlog"
        _sm_swap_in_backup
        _sm_record_change ".gitmodules"
        _sm_record_change "$_sp"
        return 0
      fi

      cat "$_errlog" >&2
      _reason=other
      if   grep -q 'is in submodule' "$_errlog" 2>/dev/null; then _reason=in-submodule
      elif grep -q 'already exists in the index' "$_errlog" 2>/dev/null; then _reason=in-index
      elif grep -q 'A git directory for .* is found locally' "$_errlog" 2>/dev/null; then _reason=stale-gitdir
      elif grep -q 'following paths are ignored\|paths are ignored by one of your' "$_errlog" 2>/dev/null; then _reason=ignored-path
      elif grep -q 'Repository not found\|Could not read from remote\|does not appear to be a git repository\|Operation timed out\|Connection timed out\|Could not resolve host\|Name or service not known' "$_errlog" 2>/dev/null; then _reason=bad-url
      fi
      rm -f "$_errlog"

      printf 'ERROR  git submodule add failed for %s (reason: %s)\n' "$_sp" "$_reason" >&2

      if [ "$_reason" = in-submodule ]; then
        _sm_swap_in_backup
        if [ "$_sm_interactive" -ne 1 ]; then
          echo "    (path lives inside an existing submodule — skipping)" >&2
          return 1
        fi
        _enc=$(_sm_enclosing_submodule "$_sp" || true)
        printf '\n    %s lives inside an existing submodule%s.\n' \
          "$_sp" "$([ -n "$_enc" ] && printf ' (%s)' "$_enc")"
        printf '    Options: [S]kip / [P]arent-add / [I]gnore / [A]bort\n'
        _ans=$(_sm_ask "    Choice? [S/p/i/a]: ")
        case "$_ans" in
          p|P)
            [ -z "$_enc" ] && { echo "    (no enclosing submodule — skipping)" >&2; return 1; }
            _rel=${_sp#"$_enc"/}
            printf '\n    Run inside the enclosing submodule:\n'
            printf '        cd %s && git submodule add %s %s && cd -\n' "$_enc" "$_url" "$_rel"
            printf '        git add %s\n' "$_enc"
            printf '    Press Enter to continue (skipping for now)...'
            _sm_ask '' >/dev/null
            return 1 ;;
          i|I)
            _gp=$(_sm_gitpath_for "$_sp")
            [ -n "$_gp" ] && _sm_mark_ignored "$_gp" "$_sp" && return 3
            return 1 ;;
          a|A) return 2 ;;
          *)   return 1 ;;
        esac
      fi

      if [ "$_reason" = in-index ]; then
        echo "    (still in index; try: git ls-files -z -- $_sp | git update-index -z --force-remove --stdin, then re-run)" >&2
        _sm_swap_in_backup
        return 1
      fi

      if [ "$_reason" = ignored-path ]; then
        # Pathological: the pre-check missed this. Skip silently rather
        # than spew ERROR — the pre-check is authoritative, anything past
        # it is unexpected state we shouldn't annoy the user about.
        _sm_swap_in_backup
        return 1
      fi

      if [ "$_reason" = stale-gitdir ]; then
        _stale_gitdir="$_sm_toplevel/.git/modules/$_sp"
        _stale_url=''
        if [ -f "$_stale_gitdir/config" ]; then
          _stale_url=$(git config -f "$_stale_gitdir/config" --get remote.origin.url 2>/dev/null || true)
        fi
        if [ "$_sm_interactive" -ne 1 ]; then
          printf '    stale gitdir at %s (remote=%s) — skipping\n' \
            "$_stale_gitdir" "${_stale_url:-unknown}" >&2
          _sm_swap_in_backup
          return 1
        fi
        printf '\n    A stale submodule gitdir already exists:\n'
        printf '        %s\n' "$_stale_gitdir"
        [ -n "$_stale_url" ] && printf '        (remembers origin=%s)\n' "$_stale_url"
        printf '    This is leftover from an earlier interrupted run.\n'
        printf '    Options:\n'
        printf '      [R]euse   — pass --force to git submodule add (keeps existing gitdir)\n'
        printf '      [D]elete  — remove the stale gitdir, then retry fresh\n'
        printf '      [S]kip    — leave as-is for now\n'
        printf '      [I]gnore  — write ignore marker\n'
        printf '      [A]bort\n'
        _ans=$(_sm_ask "    Choice? [R/d/s/i/a]: ")
        case "$_ans" in
          r|R)
            printf 'ADD      %s  <-  %s   [--force reusing stale gitdir]\n' "$_sp" "$_url"
            _errlog=$(mktemp "${TMPDIR:-/tmp}/submoderr.XXXXXX")
            _sm_safe_git "$_sm_toplevel" submodule add --force "$_url" "$_sp" 2>"$_errlog"
            _rc=$?
            if [ "$_rc" -eq 0 ]; then
              rm -f "$_errlog"
              _sm_swap_in_backup
              _sm_record_change ".gitmodules"
              _sm_record_change "$_sp"
              return 0
            fi
            cat "$_errlog" >&2
            rm -f "$_errlog"
            printf 'ERROR  --force retry also failed for %s\n' "$_sp" >&2
            _sm_swap_in_backup
            return 1
            ;;
          d|D)
            printf '    removing %s\n' "$_stale_gitdir"
            rm -rf -- "$_stale_gitdir" || {
              echo "    (failed to remove — skipping)" >&2
              _sm_swap_in_backup
              return 1
            }
            _sm_remove_gitmodules_entry "$_sp" || true
            rm -rf -- "$_sp" 2>/dev/null || true
            continue
            ;;
          i|I)
            _sm_swap_in_backup
            _gp=$(_sm_gitpath_for "$_sp")
            [ -n "$_gp" ] && _sm_mark_ignored "$_gp" "$_sp" && return 3
            return 1
            ;;
          a|A)
            _sm_swap_in_backup
            return 2
            ;;
          *)
            _sm_swap_in_backup
            return 1
            ;;
        esac
      fi

      if [ "$_sm_interactive" -ne 1 ]; then
        # Unclassified failure (typically 'bad-url': unreachable host,
        # repo not found, auth failure, timeout) — skip THIS item and
        # continue with the rest of the plan, same as every other
        # reason branch above already does non-interactively. This
        # used to 'return 2' here, which every call site treats as
        # "user aborted the whole run" — but no user was ever involved
        # in a non-interactive run, and a single unreachable remote
        # anywhere in a large tree would silently kill everything still
        # queued after it, with a misleading "Aborted by user." message
        # blaming a decision nobody made.
        echo "    (non-interactive: skipping this item. Re-run with -i to retry/edit the URL.)" >&2
        _sm_swap_in_backup
        return 1
      fi

      _ans=$(_sm_ask "    [R]etry with new URL / [S]kip / [I]gnore / [A]bort? [R/s/i/a]: ")
      case "$_ans" in
        s|S) _sm_swap_in_backup; return 1 ;;
        i|I) _sm_swap_in_backup
             _gp=$(_sm_gitpath_for "$_sp")
             [ -n "$_gp" ] && _sm_mark_ignored "$_gp" "$_sp" && return 3
             return 1 ;;
        a|A) _sm_swap_in_backup; return 2 ;;
        *)
          _new=$(_sm_ask "    New URL: ")
          _new=$(_sm_normalize_url "$_new")
          if [ -z "$_new" ]; then
            _sm_swap_in_backup; return 1
          fi
          if [ -e "$_tmp/.git" ]; then
            _rt_cfg=$(_sm_resolve_cfg "$_tmp/.git" "$_tmp")
            _sm_persist_url_change "$_rt_cfg" "$_new" "$_orig_url" || true
          fi
          rm -rf -- "$_sp" 2>/dev/null || true
          _url=$_new
          _sm_remove_gitmodules_entry "$_sp" || true
          continue
          ;;
      esac
    done
  }

  [ "$_sm_verbose" -eq 1 ] && echo "Applying..."
  _sm_added=0; _sm_skipped=0; _sm_newly_ignored=0; _sm_rebound=0
  _sm_stale_removed=0
  _sm_skipped_nested_after=0
  # Reset the per-run list of paths my-git modified. See _sm_record_change.
  SM_COMMIT_PATHS=""
  _sm_negations_added=0
  while IFS="$(printf '\t')" read -r action sp url old; do
    # Top-down invariant: if a previous step in this run registered an
    # ancestor of $sp as a submodule, $sp no longer belongs to the super-repo.
    # Re-read .gitmodules NOW (it may have changed since analysis) and defer
    # to the parent submodule.
    case "$action" in
      add|add-with-untrack|prompt-url|prompt-url-untrack|resolve-ignored-mismatch|rebind-moved)
        _enc_now=$(_sm_enclosing_submodule "$sp" || true)
        if [ -n "$_enc_now" ]; then
          printf '\nSKIP     %s  (now nested inside registered submodule %s)\n' "$sp" "$_enc_now"
          printf '    register it from inside the parent:\n'
          printf '      cd %s && %s sm go\n' "$_enc_now" "$US"
          _sm_skipped_nested_after=$((_sm_skipped_nested_after + 1))
          _sm_skipped=$((_sm_skipped + 1))
          continue
        fi
        ;;
    esac
    case "$action" in
      stale-registration)
        # $old holds the submodule NAME (from the .gitmodules key), $sp the path.
        printf '\nSTALE    %s  (registered as name=%s, no directory on disk)\n' "$sp" "$old"
        if [ "$_sm_interactive" -eq 1 ]; then
          _ans=$(_sm_ask "    Remove stale registration? [Y]es / [S]kip / [A]bort: ")
          case "$_ans" in
            a|A) echo "Aborted by user." >&2; exit 77 ;;
            s|S|n|N) echo "    skipped."; _sm_skipped=$((_sm_skipped + 1)); continue ;;
          esac
        fi
        printf '    removing .gitmodules entry, .git/config entry, index entry, .git/modules/%s\n' "$old"
        git config -f .gitmodules --remove-section "submodule.$old" 2>/dev/null || true
        git config --remove-section "submodule.$old" 2>/dev/null || true
        git update-index --force-remove -- "$sp" 2>/dev/null || true
        if [ -n "$old" ]; then
          rm -rf -- ".git/modules/$old" 2>/dev/null || true
        fi
        _sm_record_change ".gitmodules"
        _sm_record_change "$sp"
        _sm_stale_removed=$((_sm_stale_removed + 1))
        continue
        ;;
      rebind-moved)
        printf '\nREBIND   %s -> %s\n' "$old" "$sp"
        printf '    url: %s\n' "$url"
        # Preferred path: rename .git/modules/<old> -> .git/modules/<sp>
        # and rewrite the gitdir pointer — no re-clone, preserves local
        # branches, unpushed commits, stashes, and uncommitted changes.
        if _sm_try_preserve_rebind "$old" "$sp" "$url"; then
          printf '    gitdir moved in-place (no re-clone; all local state kept)\n'
          _sm_rebound=$((_sm_rebound + 1))
          continue
        fi
        # Fall back to re-clone flow (below).
        _risk_msg=$(_sm_rebind_has_risky_state "$sp" || true)
        if [ -n "$_risk_msg" ]; then
          # Shortcut: if the only dirt is tracked-file modifications, just
          # commit -a + push before the rebind re-clones (user instruction).
          _sm_autocommit_if_safe "$sp"
          if [ $? -eq 0 ]; then
            _risk_msg=$(_sm_rebind_has_risky_state "$sp" || true)
          fi
        fi
        if [ -n "$_risk_msg" ]; then
          printf '    warning: nested repo at %s has: %s\n' "$sp" "$_risk_msg"
          printf '    The rebind re-clones from origin and would lose this.\n'
          if [ "$_sm_interactive" -eq 1 ]; then
            _ans=$(_sm_ask "    [P]roceed / [S]kip / [A]bort? [p/S/a]: ")
            case "$_ans" in
              p|P) : ;;
              a|A) echo "Aborted by user." >&2; exit 77 ;;
              *)   echo "    skipped."; _sm_skipped=$((_sm_skipped + 1)); continue ;;
            esac
          else
            echo "    skipped (re-run with -i to confirm, or push/commit first)."
            _sm_skipped=$((_sm_skipped + 1))
            continue
          fi
        fi
        if [ -f .gitmodules ]; then
          printf '    removing [submodule "%s"] from .gitmodules\n' "$old"
          _sm_remove_gitmodules_entry "$old" || {
            echo "    error: could not edit .gitmodules — skipping" >&2
            _sm_skipped=$((_sm_skipped + 1))
            continue
          }
          _sm_record_change ".gitmodules"
        fi
        if git ls-files --error-unmatch -- "$old" >/dev/null 2>&1; then
          printf '    git update-index --force-remove -- %s\n' "$old"
          git update-index --force-remove -- "$old" 2>/dev/null || true
          _sm_record_change "$old"
        fi
        _stale="$_sm_toplevel/.git/modules/$old"
        if [ -e "$_stale" ]; then
          printf '    rm -rf -- %s\n' "$_stale"
          rm -rf -- "$_stale"
        fi
        _sm_try_add_with_prompts "$sp" "$url"
        _rc=$?
        case "$_rc" in
          0) _sm_rebound=$((_sm_rebound + 1)) ;;
          1) _sm_skipped=$((_sm_skipped + 1)) ;;
          2) echo "Aborted by user." >&2; exit 77 ;;
          3) _sm_newly_ignored=$((_sm_newly_ignored + 1)) ;;
        esac
        continue
        ;;
      resolve-ignored-mismatch)
        printf '\nCONFLICT %s  (ignore marker present, registered in .gitmodules at %s)\n' "$sp" "$old"
        printf '    url: %s\n' "$url"
        if [ "$_sm_interactive" -ne 1 ]; then
          echo "    skipped (re-run with -i to resolve)." >&2
          _sm_skipped=$((_sm_skipped + 1))
          continue
        fi
        printf '    Options:\n'
        printf '      [U]pdate .gitmodules path (%s -> %s) AND remove the ignore marker,\n' "$old" "$sp"
        printf '          then rebind in place (preserves local branches / commits / changes)\n'
        printf '      [R]emove ignore marker only; leave .gitmodules entry as-is\n'
        printf '          (next "%s sm go" will treat this as a moved submodule)\n' "$US"
        printf '      [S]kip  / [A]bort\n'
        _ans=$(_sm_ask "    Choice? [U/r/s/a]: ")
        case "$_ans" in
          u|U|'')
            _gp=$(_sm_gitpath_for "$sp")
            if [ -n "$_gp" ]; then
              _mk=$(_sm_ignore_marker_path "$_gp" "$sp")
              if rm -f "$_mk" 2>/dev/null; then
                printf '    removed ignore marker: %s\n' "$_mk"
              else
                echo "    warning: could not remove ignore marker: $_mk" >&2
              fi
            fi
            # Try preserve-rebind first (no re-clone; keeps all local state).
            if _sm_try_preserve_rebind "$old" "$sp" "$url"; then
              printf '    .gitmodules path updated: %s -> %s\n' "$old" "$sp"
              printf '    gitdir moved in-place (no re-clone; all local state kept)\n'
              _sm_rebound=$((_sm_rebound + 1))
              continue
            fi
            # Preserve-rebind refused (usually because .git/modules/<old> is
            # absent). Fall back to the full re-clone rebind flow. Reuse the
            # rebind-moved code path by re-emitting the work here.
            _risk_msg=$(_sm_rebind_has_risky_state "$sp" || true)
            if [ -n "$_risk_msg" ]; then
              _sm_autocommit_if_safe "$sp"
              [ $? -eq 0 ] && _risk_msg=$(_sm_rebind_has_risky_state "$sp" || true)
            fi
            if [ -n "$_risk_msg" ]; then
              printf '    warning: nested repo at %s has: %s\n' "$sp" "$_risk_msg"
              printf '    The rebind re-clones from origin and would lose this.\n'
              _ans2=$(_sm_ask "    [P]roceed / [S]kip / [A]bort? [p/S/a]: ")
              case "$_ans2" in
                p|P) : ;;
                a|A) echo "Aborted by user." >&2; exit 77 ;;
                *)   echo "    skipped."; _sm_skipped=$((_sm_skipped + 1)); continue ;;
              esac
            fi
            if [ -f .gitmodules ]; then
              printf '    removing [submodule "%s"] from .gitmodules\n' "$old"
              _sm_remove_gitmodules_entry "$old" || {
                echo "    error: could not edit .gitmodules — skipping" >&2
                _sm_skipped=$((_sm_skipped + 1)); continue
              }
              _sm_record_change ".gitmodules"
            fi
            if git ls-files --error-unmatch -- "$old" >/dev/null 2>&1; then
              printf '    git update-index --force-remove -- %s\n' "$old"
              git update-index --force-remove -- "$old" 2>/dev/null || true
              _sm_record_change "$old"
            fi
            _stale="$_sm_toplevel/.git/modules/$old"
            if [ -e "$_stale" ]; then
              printf '    rm -rf -- %s\n' "$_stale"
              rm -rf -- "$_stale"
            fi
            _sm_try_add_with_prompts "$sp" "$url"
            _rc=$?
            case "$_rc" in
              0) _sm_rebound=$((_sm_rebound + 1)) ;;
              1) _sm_skipped=$((_sm_skipped + 1)) ;;
              2) echo "Aborted by user." >&2; exit 77 ;;
              3) _sm_newly_ignored=$((_sm_newly_ignored + 1)) ;;
            esac
            continue ;;
          r|R)
            _gp=$(_sm_gitpath_for "$sp")
            if [ -n "$_gp" ]; then
              _mk=$(_sm_ignore_marker_path "$_gp" "$sp")
              if rm -f "$_mk" 2>/dev/null; then
                printf '    removed ignore marker: %s\n' "$_mk"
                printf '    (next "%s sm go" will now detect this as a moved submodule)\n' "$US"
              else
                echo "    warning: could not remove ignore marker: $_mk" >&2
              fi
            fi
            _sm_skipped=$((_sm_skipped + 1))
            continue ;;
          a|A) echo "Aborted by user." >&2; exit 77 ;;
          *)   echo "    skipped."; _sm_skipped=$((_sm_skipped + 1)); continue ;;
        esac
        ;;
    esac

    case "$action" in
      prompt-url|prompt-url-untrack)
        printf '\n    No origin URL recorded for %s.\n' "$sp"
        if [ "$_sm_interactive" -eq 1 ]; then
          _ans=$(_sm_ask "    Enter URL, or [I]gnore permanently, [A]bort, or blank to skip: ")
        else
          _ans=$(_sm_ask "    Enter URL, or [A]bort, or blank to skip: ")
        fi
        case "$_ans" in
          i|I)
            _gp=$(_sm_gitpath_for "$sp")
            if [ -n "$_gp" ] && _sm_mark_ignored "$_gp" "$sp"; then
              _sm_newly_ignored=$((_sm_newly_ignored + 1))
            else
              _sm_skipped=$((_sm_skipped + 1))
            fi
            continue ;;
          a|A) echo "Aborted by user." >&2; exit 77 ;;
          '')  echo "    skipped."; _sm_skipped=$((_sm_skipped + 1)); continue ;;
          *)   url=$(_sm_normalize_url "$_ans") ;;
        esac
        ;;
    esac

    case "$action" in
      add-with-untrack|prompt-url-untrack)
        # Safety check BEFORE touching the index: refuse if nested has
        # uncommitted/untracked content, warn on URL mismatch, offer
        # optional persistent backup. See _sm_check_untrack_safety().
        _sm_check_untrack_safety "$sp" "$url"
        _csrc=$?
        case "$_csrc" in
          0) : ;;
          1) _sm_skipped=$((_sm_skipped + 1)); continue ;;
          2) echo "Aborted by user." >&2; exit 77 ;;
        esac
        printf 'UNTRACK  %s\n' "$sp"
        # Recursive index-entry removal without 'git rm' (forbidden as
        # implicit side effect; see feedback_my_git_no_implicit_rm.md).
        # 'git ls-files -z -- <sp>' enumerates every tracked entry under
        # <sp> (handles both a tracked content tree AND a single gitlink
        # entry), piped into 'git update-index -z --force-remove --stdin'
        # which removes those entries from the index without touching
        # the working tree. NOTE: '--stdin' must be the LAST flag —
        # 'git update-index --force-remove --stdin -z' silently errors
        # ("option 'stdin' must be the last argument") on some git
        # versions; this previously went unnoticed because the failure
        # was swallowed ('2>/dev/null || true'), leaving the stale
        # index entry in place and causing the NEXT step (add) to fail
        # with a confusing, unrelated-looking "already exists in the
        # index" error instead of surfacing the real cause.
        _sm_untrack_errlog=$(mktemp "${TMPDIR:-/tmp}/${US}.smuntrack.XXXXXX")
        if ! git ls-files -z -- "$sp" | git update-index -z --force-remove --stdin 2>"$_sm_untrack_errlog"; then
          log_error "sm: failed to untrack $sp from the index:"
          cat "$_sm_untrack_errlog" >&2
          rm -f "$_sm_untrack_errlog"
          _sm_skipped=$((_sm_skipped + 1))
          continue
        fi
        rm -f "$_sm_untrack_errlog"
        # Belt-and-suspenders: confirm it's actually gone before
        # proceeding to add — a mismatched exit code isn't the only
        # way this could silently fail to take effect.
        if git ls-files -s -- "$sp" 2>/dev/null | grep -q .; then
          log_error "sm: $sp still appears in the index after untrack — refusing to add (would fail anyway); please inspect manually"
          _sm_skipped=$((_sm_skipped + 1))
          continue
        fi
        _sm_record_change "$sp"
        ;;
    esac

    _sm_try_add_with_prompts "$sp" "$url"
    _rc=$?
    case "$_rc" in
      0) _sm_added=$((_sm_added + 1)) ;;
      1) _sm_skipped=$((_sm_skipped + 1)) ;;
      2) echo "Aborted by user." >&2; exit 77 ;;
      3) _sm_newly_ignored=$((_sm_newly_ignored + 1)) ;;
    esac
  done < "$_sm_plan"

  echo
  log_major "sm: summary"
  _sm_total=$((_sm_added + _sm_rebound + _sm_stale_removed + _sm_skipped + _sm_newly_ignored))
  _sm_parts=""
  [ "$_sm_added" -gt 0 ]         && _sm_parts="$_sm_parts added=$_sm_added"
  [ "$_sm_rebound" -gt 0 ]       && _sm_parts="$_sm_parts rebound=$_sm_rebound"
  [ "$_sm_stale_removed" -gt 0 ] && _sm_parts="$_sm_parts stale-removed=$_sm_stale_removed"
  [ "$_sm_skipped" -gt 0 ]       && _sm_parts="$_sm_parts skipped=$_sm_skipped"
  [ "$_sm_newly_ignored" -gt 0 ] && _sm_parts="$_sm_parts newly-ignored=$_sm_newly_ignored"
  [ -z "$_sm_parts" ] && _sm_parts=" (nothing to do)"
  printf '  %s>> total=%s:%s%s\n' "$C_BLUE" "$_sm_total" "$_sm_parts" "$C_RESET"
  if [ "$_sm_skipped_nested_after" -gt 0 ]; then
    printf '  %s>>   of skipped: %s became nested-in-parent after a rebind/add in this run —%s\n' \
      "$C_BLUE" "$_sm_skipped_nested_after" "$C_RESET"
    printf '  %s>>   register those from inside the parent submodule%s\n' \
      "$C_BLUE" "$C_RESET"
  fi
  # Cross-submodule: report unregistered nested repos found inside registered
  # submodules — they can only be registered from their parent, not from here.
  if [ "${_sm_c_cross:-0}" -gt 0 ] && [ -s "${_sm_cross_tmp:-/dev/null}" ]; then
    printf '\n >>> sm: %s unregistered nested repo(s) live INSIDE registered submodules\n' \
      "$_sm_c_cross"
    printf '  >> to register them, either pass -R to walk the whole tree:\n'
    printf '        %s sm -R go -i\n' "$US"
    printf '  >> or cd into each parent and run sm go there:\n'
    while IFS="$(printf '\t')" read -r _cpar _csub; do
      [ -n "$_cpar" ] || continue
      printf '        cd %s && %s sm go -i    # to register: %s\n' "$_cpar" "$US" "$_csub"
    done < "$_sm_cross_tmp"
  fi
  rm -f "${_sm_cross_tmp:-/dev/null}" 2>/dev/null || true
  # Always reconcile .git/info/exclude with the current set of ignored nested
  # repos so 'git status' in the super-repo doesn't show them as Untracked.
  _sm_sync_ignore_exclude quiet || true
  # ─── Commit ONLY the paths my-git touched in this run ──────────────────
  # Leaves any unrelated staged/unstaged changes the user had alone (e.g.
  # other submodule gitlink drift, unrelated .gitignore edits).
  if [ -n "$SM_COMMIT_PATHS" ] && [ "$_sm_mode" = "go" ]; then
    # Build positional args from the newline-separated list.
    _oldIFS=$IFS
    IFS="
"
    # shellcheck disable=SC2086
    set -- $SM_COMMIT_PATHS
    IFS=$_oldIFS
    # `git add -A` handles both modifications and deletions (e.g. when
    # $sp was rm-cached and no longer exists on disk). For sibling
    # .gitmodules edits made via `git config --remove-section` (which
    # doesn't auto-stage), this brings the worktree into the index.
    git add -A -- "$@" 2>/dev/null || true
    if git diff --cached --quiet -- "$@" 2>/dev/null; then
      printf '\n >>> sm: nothing to commit (paths my-git touched have no net diff vs HEAD)\n'
    else
      # Build a short, descriptive commit subject.
      _cm_parts=""
      [ "$_sm_added" -gt 0 ]         && _cm_parts="$_cm_parts registered=$_sm_added"
      [ "$_sm_rebound" -gt 0 ]       && _cm_parts="$_cm_parts rebound=$_sm_rebound"
      [ "$_sm_stale_removed" -gt 0 ] && _cm_parts="$_cm_parts stale-removed=$_sm_stale_removed"
      [ "${_sm_negations_added:-0}" -gt 0 ] && _cm_parts="$_cm_parts gitignore-negations=$_sm_negations_added"
      [ -n "$_cm_parts" ] || _cm_parts=" (misc)"
      _cm_subject="my-git sm:${_cm_parts}"
      _do_commit=1
      if [ "$_sm_interactive" -eq 1 ]; then
        printf '\n >>> sm: ready to commit my-git''s changes only:\n'
        printf '  >> message:  %s\n' "$_cm_subject"
        printf '  >> paths:\n'
        for _p in "$@"; do
          printf '       %s\n' "$_p"
        done
        _ans=$(_sm_ask "    [Y]es commit / [S]kip (leave staged) / [A]bort? [Y/s/a]: ")
        case "$_ans" in
          a|A) echo "Aborted by user." >&2; exit 77 ;;
          s|S|n|N)
            printf '  >> skipped — my-git''s changes remain staged for you to commit manually.\n'
            _do_commit=0 ;;
          *) : ;;
        esac
      fi
      if [ "$_do_commit" -eq 1 ]; then
        _cmlog=$(mktemp "${TMPDIR:-/tmp}/sm-commit.XXXXXX")
        _cmmsg=$(mktemp "${TMPDIR:-/tmp}/sm-msg.XXXXXX")
        {
          printf '%s\n\n' "$_cm_subject"
          printf '# Counts:\n'
          [ "$_sm_added" -gt 0 ]                && printf '#   registered:          %s\n' "$_sm_added"
          [ "$_sm_rebound" -gt 0 ]              && printf '#   rebound:             %s\n' "$_sm_rebound"
          [ "$_sm_stale_removed" -gt 0 ]        && printf '#   stale-removed:       %s\n' "$_sm_stale_removed"
          [ "${_sm_negations_added:-0}" -gt 0 ] && printf '#   gitignore-negations: %s\n' "$_sm_negations_added"
          printf '#\n# Paths touched (my-git sm edits only — user dirt left untouched):\n'
          for _p in "$@"; do
            printf '#   %s\n' "$_p"
          done
        } > "$_cmmsg"
        if git commit --only -F "$_cmmsg" -- "$@" >"$_cmlog" 2>&1; then
          _sha=$(git rev-parse --short HEAD 2>/dev/null)
          printf '\n >>> sm: committed my-git''s changes only (%s)\n' "$_sha"
          printf '  >> %s\n' "$_cm_subject"
          rm -f "$_cmlog" "$_cmmsg"
        else
          printf '\n >>> sm: commit failed — output:\n' >&2
          cat "$_cmlog" >&2
          rm -f "$_cmlog" "$_cmmsg"
        fi
      fi
    fi
  elif [ -n "$SM_COMMIT_PATHS" ] && [ "$_sm_mode" = "dry" ]; then
    printf '\n >>> sm: (dry-run) would commit %s path(s)\n' \
      "$(printf '%s' "$SM_COMMIT_PATHS" | grep -c . 2>/dev/null | head -1)"
  fi
}

