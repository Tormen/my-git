    _rt_ok "make a sidecar" _rt_my_git flatten go sc --sidecar || return 1
    # a properly-flattened sidecar audits clean for (E)
    _rt_ok "audit clean initially" _rt_my_git audit --sidecar "$PWD" || return 1
    _rt_not_contains "no untracked-content ISSUE yet" "$_rt_out" "NOT tracked by the parent" || return 1
    # BREAK: untrack the .status snapshot + add a brand-new untracked file
    git rm --cached -q -- sc/.git.real.status
    git commit -q -m "untrack status" -- sc/.git.real.status >/dev/null 2>&1
    echo "new" > sc/extra.txt
    _rt_ok "audit flags untracked content" _rt_my_git audit --sidecar "$PWD" || return 1
    _rt_contains "reports untracked sidecar files" "$_rt_out" "NOT tracked by the parent" || return 1
    _rt_contains "specifically calls out .status" "$_rt_out" ".git.real.status" || return 1
    # repair
    _rt_ok "repair --sidecar go" _rt_my_git repair --sidecar go "$PWD" || return 1
    [ -n "$(git ls-files -- sc/.git.real.status)" ] || { _rt_fail "repair did not track the .status snapshot"; return 1; }
    [ -n "$(git ls-files -- sc/extra.txt)" ] || { _rt_fail "repair did not track the new sidecar file"; return 1; }
    [ -z "$(git ls-files -- 'sc/.git.real/*')" ] || { _rt_fail "repair wrongly tracked .git.real internals"; return 1; }
    _rt_ok "re-audit clean" _rt_my_git audit --sidecar "$PWD" || return 1
    _rt_not_contains "no residual untracked-content ISSUE" "$_rt_out" "NOT tracked by the parent" || return 1
    return 0
  }

