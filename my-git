  test_claude_dest_mirrors_the_project_path_under_the_central_repo() {
    # The central repo lives INSIDE the tree it serves, and the layout
    # mirrors each project's path relative to THAT parent:
    #   <tree>/sh/proj  ->  <tree>/,claude-configs/sh/proj
    # Two bugs put migrated dirs elsewhere: paths were matched as STRINGS
    # (so /LINKS/global vs /syst/global -- one directory, two spellings --
    # missed entirely and fell through to misc/), and anchoring on a
    # GIT_REPOS root gave ',claude-configs/src/sh/proj', correct relative
    # to the wrong thing and matching no existing sibling.
    _rt_repo tree
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    mkdir -p tree/sh/proj tree/,claude-configs
