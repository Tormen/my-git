  test_push_reports_what_is_ahead_and_refuses_to_invent_an_upstream() {
    _rt_repo_file up_a a.md
    _rt_repo container
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    # Clone from a BARE copy: a real remote is bare, and git refuses to push
    # to a branch that is checked out in a non-bare one.
    git clone -q --bare up_a up_bare >/dev/null 2>&1
    ( cd container && git clone -q ../up_bare proj >/dev/null 2>&1 )
    cd container || return 1
    # One commit that is genuinely ahead of its upstream.
    _rt_before=$(git -C ../up_bare rev-list --count HEAD 2>/dev/null)
    printf 'more\n' >> proj/a.md
    git -C proj commit -q -am "local work" 2>/dev/null

    _rt_ok "push analyze" _rt_my_git push || return 1
    _rt_contains "names the repo that is ahead" "$_rt_out" "ahead 1" || return 1
    _rt_contains "and does not push in analyze mode" "$_rt_out" "would-push=1" || return 1
    [ "$(git -C ../up_bare rev-list --count HEAD 2>/dev/null)" = "$_rt_before" ] \
      || { _rt_fail "analyze mode PUSHED — it must be read-only"; return 1; }

    _rt_ok "push go" _rt_my_git push go || return 1
    [ "$(git -C ../up_bare rev-list --count HEAD 2>/dev/null)" = "$((_rt_before + 1))" ] \
      || { _rt_fail "push go did not publish the commit"; return 1; }

    # A branch with no upstream must be REPORTED, never guessed at.
    git -C proj checkout -q -b sidetrack 2>/dev/null
    printf 'x\n' >> proj/a.md
    git -C proj commit -q -am "on a branch with no upstream" 2>/dev/null
    _rt_ok "push analyze again" _rt_my_git push || return 1
    _rt_contains "reports the missing upstream" "$_rt_out" "NO upstream" || return 1
    _rt_contains "and spells out the command to set it" "$_rt_out" "push -u origin sidetrack" || return 1
    _rt_ok "push go with no upstream" _rt_my_git push go || return 1
    if git -C ../up_bare rev-parse -q --verify refs/heads/sidetrack >/dev/null 2>&1; then
      _rt_fail "push go created an upstream nobody asked for"; return 1
    fi
    _rt_ok "the branch was left alone" true || return 1
    return 0
  }

  test_pp_does_both_halves_across_the_tree() {
    # What pp is actually for on a tree: one repo has moved upstream and
    # needs pulling, another has local work and needs pushing. Neither half
    # alone settles it. (A repo that is ahead AND behind is diverged, which
    # pull refuses to fast-forward and push refuses to publish -- by design,
    # in both cases.)
    _rt_repo_file up_a a.md
    _rt_repo_file up_b b.md
    git clone -q --bare up_a up_a_bare >/dev/null 2>&1
    git clone -q --bare up_b up_b_bare >/dev/null 2>&1
    _rt_repo container
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd container && git clone -q ../up_a_bare behind >/dev/null 2>&1
                      git clone -q ../up_b_bare ahead  >/dev/null 2>&1 )

    # 'behind' falls behind: someone else publishes to its upstream.
    git clone -q up_a_bare other >/dev/null 2>&1
    printf 'theirs\n' >> other/a.md
    git -C other commit -q -am "upstream moved" 2>/dev/null
    git -C other push -q origin HEAD 2>/dev/null

    cd container || return 1
    # 'ahead' gains local work.
    printf 'ours\n' >> ahead/b.md
    git -C ahead commit -q -am "our work" 2>/dev/null

    _rt_b_before=$(git -C behind rev-list --count HEAD 2>/dev/null)
    _rt_u_before=$(git -C ../up_b_bare rev-list --count HEAD 2>/dev/null)

    _rt_ok "pp go" _rt_my_git pp go || return 1

    [ "$(git -C behind rev-list --count HEAD 2>/dev/null)" -gt "$_rt_b_before" ] \
      || { _rt_fail "pp go did not PULL the repo that was behind"; return 1; }
    [ "$(git -C ../up_b_bare rev-list --count HEAD 2>/dev/null)" -gt "$_rt_u_before" ] \
      || { _rt_fail "pp go did not PUSH the repo that was ahead"; return 1; }
    _rt_ok "both halves ran" true || return 1
    return 0
  }

  test_push_leaves_foreign_remotes_alone_but_never_on_a_blank_config() {
    # A tree holds upstreams you cloned to READ next to your own repos.
    # Pushing to someone else's project fails with 403 AFTER asking for
    # credentials, once per repo -- so classify before doing any of that.
    _rt_repo_file up_mine m.md
    _rt_repo_file up_theirs t.md
    git clone -q --bare up_mine  mine_bare   >/dev/null 2>&1
    git clone -q --bare up_theirs theirs_bare >/dev/null 2>&1
    _rt_repo container
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd container && git clone -q ../mine_bare   ours   >/dev/null 2>&1
                      git clone -q ../theirs_bare froeign_tmp >/dev/null 2>&1
                      mv froeign_tmp theirs )
    cd container || return 1
    printf 'a\n' >> ours/m.md   && git -C ours   commit -q -am "our work"   2>/dev/null
    printf 'b\n' >> theirs/t.md && git -C theirs commit -q -am "their repo" 2>/dev/null

    # "mine" = anything whose URL contains 'mine_bare'.
    # Exported, not an 'env' prefix: _rt_my_git is a shell function.
    # The pattern is a PREFIX, so use the real URL -- a substring of it
    # (which an earlier version of this test used) must not match.
    PUSH_REMOTE_SCOPE=mine
    MINE_URL_PATTERNS=$(git -C ours config --get remote.origin.url)
    export PUSH_REMOTE_SCOPE MINE_URL_PATTERNS
    _rt_ok "push analyze, scope=mine" _rt_my_git push || return 1
    _rt_contains "the foreign repo is named, not pushed" "$_rt_out" "FOREIGN remote" || return 1
    _rt_contains "and counted separately" "$_rt_out" "foreign=1" || return 1
    _rt_contains "while our own is still offered" "$_rt_out" "would-push=1" || return 1

    # A bare substring of the URL must NOT qualify: prefixes only.
    MINE_URL_PATTERNS=bare; export MINE_URL_PATTERNS
    _rt_ok "substring is not a prefix" _rt_my_git push || return 1
    _rt_contains "so both repos read as foreign" "$_rt_out" "foreign=2" || return 1
    MINE_URL_PATTERNS=$(git -C ours config --get remote.origin.url); export MINE_URL_PATTERNS

    _rt_before=$(git -C ../theirs_bare rev-list --count HEAD 2>/dev/null)
    _rt_ok "push go, scope=mine" _rt_my_git push go || return 1
    [ "$(git -C ../theirs_bare rev-list --count HEAD 2>/dev/null)" = "$_rt_before" ] \
      || { _rt_fail "pushed to a FOREIGN remote"; return 1; }

    # An empty pattern list matches nothing. It must NOT mean "everything is
    # foreign, publish nothing" -- a config written before these keys
    # existed would then silently stop pushing the user's own work.
    _rt_before_mine=$(git -C ../mine_bare rev-list --count HEAD 2>/dev/null)
    printf 'c\n' >> ours/m.md && git -C ours commit -q -am "more work" 2>/dev/null
    MINE_URL_PATTERNS=""; export MINE_URL_PATTERNS
    _rt_ok "push go with no patterns configured" _rt_my_git push go || return 1
    # log_warn writes to stderr, which the harness captures separately.
    _rt_contains "says the config predates the key" "$_rt_err" "MINE_URL_PATTERNS is empty" || return 1
    _rt_blank_ok=0
    [ "$(git -C ../mine_bare rev-list --count HEAD 2>/dev/null)" -gt "$_rt_before_mine" ] && _rt_blank_ok=1
    unset PUSH_REMOTE_SCOPE MINE_URL_PATTERNS
    [ "$_rt_blank_ok" = 1 ] \
      || { _rt_fail "a blank pattern list silently blocked the user's own push"; return 1; }
    return 0
  }

  test_push_adopts_an_existing_remote_branch_but_never_creates_one() {
    # Two branches with no upstream, and the difference is everything:
    # one already exists on origin (adopting it records a fact), the other
    # does not (pushing would CREATE it there -- publishing, and on a
    # foreign remote not even yours to do).
    _rt_repo_file up_a a.md
    git clone -q --bare up_a up_bare >/dev/null 2>&1
    _rt_repo container
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd container && git clone -q ../up_bare proj >/dev/null 2>&1 )

    # 'known' exists upstream; 'novel' does not.
    git clone -q up_bare seed >/dev/null 2>&1
    git -C seed checkout -q -b known 2>/dev/null
    printf 'k\n' >> seed/a.md && git -C seed commit -q -am "known branch" 2>/dev/null
    git -C seed push -q origin known 2>/dev/null

    cd container || return 1
    git -C proj fetch -q origin 2>/dev/null

    # Case 1: local branch matching a remote one, no tracking configured.
    git -C proj checkout -q -b known 2>/dev/null
    git -C proj branch --unset-upstream 2>/dev/null
    printf 'mine\n' >> proj/a.md && git -C proj commit -q -am "work on known" 2>/dev/null
    _rt_ok "push analyze adopts it" _rt_my_git push || return 1
    _rt_contains "adopted the branch that already existed" "$_rt_out" "ahead" || return 1
    [ -n "$(git -C proj rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" ] \
      || { _rt_fail "did not adopt origin/known, which already existed"; return 1; }

    # Case 1b: a STALE remote-tracking ref. The branch was deleted upstream
    # (or never existed there) but the local cache still names it. Adopting
    # that records an upstream that is not real.
    git -C proj checkout -q -b ghost 2>/dev/null
    git -C proj update-ref refs/remotes/origin/ghost HEAD 2>/dev/null
    printf 'g\n' >> proj/a.md && git -C proj commit -q -am "work on ghost" 2>/dev/null
    _rt_ok "push analyze with a stale tracking ref" _rt_my_git push || return 1
    if git -C proj rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then
      _rt_fail "adopted a STALE refs/remotes/origin/ghost — the remote has no such branch"
      return 1
    fi
    _rt_ok "stale cache was not mistaken for a real branch" true || return 1

    # Case 2: a branch origin has never heard of.
    git -C proj checkout -q -b novel 2>/dev/null
    printf 'n\n' >> proj/a.md && git -C proj commit -q -am "work on novel" 2>/dev/null
    _rt_before=$(git -C ../up_bare for-each-ref --format=x refs/heads/ | grep -c x)
    _rt_ok "push go leaves it alone" _rt_my_git push go || return 1
    _rt_contains "says why" "$_rt_out" "pushing would CREATE it" || return 1
    [ "$(git -C ../up_bare for-each-ref --format=x refs/heads/ | grep -c x)" = "$_rt_before" ] \
      || { _rt_fail "created a branch on the remote nobody asked for"; return 1; }
    return 0
  }

  test_paths_print_as_the_name_you_typed_not_the_resolved_one() {
    # sudo scrubs PWD, so the shell recomputes it with getcwd() -- the
    # PHYSICAL path -- and every row then names a tree the user has never
    # typed. Seen on the real tree: 'sudo my-git push' from /syst/global/src
    # printed 26 rows of /Users/MINE/system/global/src/... .
    mkdir -p real/proj 2>/dev/null
    ( cd real/proj && git init -q . && printf 'x\n' > a.md && git add a.md \
      && git -c user.name=T -c user.email=t@t commit -qm init ) >/dev/null 2>&1
    ln -s real link 2>/dev/null || { _rt_fail "setup: could not create the symlink"; return 1; }
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    # GIT_REPOS carries the LOGICAL form, which is what makes the mapping
    # possible at all.
    printf 'GIT_REPOS="%s/link/proj"\n' "$PWD" >> "$_rt_conf_path"

    _rt_phys=$(cd real/proj && pwd -P)
    # Reproduce the sudo condition: cwd is the physical path, PWD unset.
    _rt_out2=$(cd "$_rt_phys" && env -u PWD "$_rt_self" --config "$_rt_conf_path" st 2>&1)
    printf '%s' "$_rt_out2" > "$_rt_out"
    _rt_contains "prints the logical name" "$_rt_out" "/link/proj" || return 1
    if printf '%s' "$_rt_out2" | grep -q "$_rt_phys"; then
      _rt_fail "printed the resolved path $_rt_phys instead of the configured one"
      return 1
    fi
    _rt_ok "the resolved path never appears" true || return 1
    return 0
  }

  test_diff_writes_both_sides_with_names_that_say_which_is_which() {
    # During a conflict the worktree file holds NEITHER side -- it is the
    # merged text with <<<<<<< markers. 'diff' writes the two sides out so
    # they can be read as files, and the NAMES carry the answer to "which
    # one am I looking at", because left/right is not something to keep in
    # your head across four files.
    _rt_repo r
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    cd r || return 1
    printf 'a\nb\nc\n' > f.py; echo x > g.txt; git add -A; git commit -q -m base
    _rt_br=$(git rev-parse --abbrev-ref HEAD)      # whatever init.defaultBranch is
    git checkout -q -b feature
    printf 'a\nFEATURE\nc\n' > f.py; echo y-feature > g.txt; git commit -q -am feature
    git checkout -q "$_rt_br"
    printf 'a\nMASTER\nc\n' > f.py; echo y-master > g.txt; git commit -q -am mainline
    git merge feature >/dev/null 2>&1

    _rt_ok "diff over all conflicts" _rt_my_git diff --tool 'diff -u' || return 1
    _rt_contains "labels the sides in the header" "$_rt_out" "left=LOCAL_ours_$_rt_br" || return 1
    _rt_contains "names the incoming branch" "$_rt_out" "REMOTE_theirs_feature" || return 1
    _rt_contains "keeps the extension for syntax" "$_rt_out" "f.LOCAL_ours_$_rt_br.py" || return 1
    _rt_contains "does both files" "$_rt_out" "[2 of 2]" || return 1
    _rt_contains "says the copies are not the real file" "$_rt_out" "they are COPIES" || return 1

    # The two sides must hold the two VERSIONS -- not the conflicted file.
    _rt_dir=$(printf '%s\n' "$(cat "$_rt_out")" | sed -n 's|.*left : \(.*/my-git\.diff\.[^/]*\)/.*|\1|p' | head -n 1)
    [ -n "$_rt_dir" ] || { _rt_fail "could not find the temp dir in the output"; return 1; }
    grep -q MASTER  "$_rt_dir/f.LOCAL_ours_$_rt_br.py"    || { _rt_fail "ours side lacks our content"; return 1; }
    grep -q FEATURE "$_rt_dir/f.REMOTE_theirs_feature.py" || { _rt_fail "theirs side lacks their content"; return 1; }
    grep -q '<<<<' "$_rt_dir/f.LOCAL_ours_$_rt_br.py" \
      && { _rt_fail "the ours side still has conflict markers -- it is the merged file, not a side"; return 1; }

    # A path that is not conflicted must be refused, not silently ignored.
    _rt_my_git diff g.txt --tool 'diff -u' >/dev/null 2>&1 || true
    _rt_my_git diff README.none --tool 'diff -u' >"$_rt_out" 2>"$_rt_err"
    _rt_contains "refuses a non-conflicted path" "$_rt_err" "is not conflicted" || return 1
    return 0
  }

  test_diff_handles_a_side_that_does_not_exist() {
    # add/add has no ancestor and modify/delete has no :2 or no :3. Opening
    # a viewer on a mystery is worse than saying which side is missing.
    _rt_repo r
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    cd r || return 1
    echo base > keep.txt; git add -A; git commit -q -m base
    _rt_br=$(git rev-parse --abbrev-ref HEAD)
