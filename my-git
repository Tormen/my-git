  }

  test_rehydrate_leaves_the_restored_repo_clean_not_holding_its_own_marker() {
    # .git/info/exclude is the one place the marker exclusion can live -- it
    # must not be a tracked .gitignore, because that would be a commit in
    # someone else's project. But git never CLONES info/exclude, so a
    # rehydrated repo starts without it and reports its own marker as an
    # untracked file.
    #
    # Seen on the real tree: every one of ada's 17 rehydrated projects sat
    # at DIRTY [??:1], all of them for the marker alone, while the same
    # projects on the machine that had shadowed them were CLEAN.
    _rt_repo_file up_o a.md
    _rt_repo container
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd container && git clone -q ../up_o proj >/dev/null 2>&1 )
    cd container || return 1
    _rt_ok "shadow the project" _rt_my_git shadow go proj || return 1
    git commit -q -am "container state" 2>/dev/null || true

    git clone -q . ../fresh >/dev/null 2>&1
    cd ../fresh || return 1
    _rt_ok "rehydrate go" _rt_my_git rehydrate go || return 1

    # The marker is present in the worktree and tracked by the CONTAINER --
    # the restored repo must simply not see it.
    _rt_exists "the marker is still there" proj/.git.shadow.status || return 1
    _rt_contains "the restored repo excludes it locally" \
      proj/.git/info/exclude ".git.shadow.status" || return 1
    if [ -n "$(git -C proj status --porcelain 2>/dev/null)" ]; then
      _rt_fail "restored repo is dirty; it should not see its own marker: $(git -C proj status --porcelain 2>/dev/null | tr '\n' ' ')"
      return 1
    fi
    _rt_ok "restored repo is clean" true || return 1
    return 0
  }

  test_st_reheals_a_shadowed_repos_own_marker_exclusion() {
    # ada's 17 projects were rehydrated before rehydrate knew to re-apply the
    # exclusion, so they all sat at DIRTY [??:1] for their own marker. The
    # fix in rehydrate only helps FUTURE restores; the repos already on disk
    # need something that heals them in place, and the command people
    # actually run is 'st' -- which already re-derives the parent side of
    # exactly the same state.
    _rt_repo_file up_o a.md
    _rt_repo container
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd container && git clone -q ../up_o proj >/dev/null 2>&1 )
    cd container || return 1
    _rt_ok "shadow the project" _rt_my_git shadow go proj || return 1

    # Reproduce a repo that arrived without its info/exclude.
    : > proj/.git/info/exclude
    [ -n "$(git -C proj status --porcelain 2>/dev/null)" ] \
      || { _rt_fail "setup: the repo should be dirty with the exclusion gone"; return 1; }

    _rt_ok "st" _rt_my_git st || return 1
    _rt_contains "the exclusion is back" proj/.git/info/exclude ".git.shadow.status" || return 1
    if [ -n "$(git -C proj status --porcelain 2>/dev/null)" ]; then
      _rt_fail "st did not heal it: $(git -C proj status --porcelain 2>/dev/null | tr '\n' ' ')"
      return 1
    fi
    _rt_ok "the shadowed repo is clean again" true || return 1
    return 0
  }

