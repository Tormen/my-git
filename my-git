  test_st_says_old_checkout_not_dirty_when_nothing_was_edited() {
    # A worktree can differ from HEAD without a single local edit: files
    # from an older release attached to newer history diff as pages of
    # phantom "modifications" (squashfuse: 2014-2025 files vs a 2026 HEAD).
    # Reporting that as DIRTY [M:14] sends a person hunting for edits they
    # never made. If the worktree hashes to an EXISTING commit's tree, st
    # says OLD CHECKOUT and how far it lags -- and the moment a real edit
    # appears, it must go back to plain DIRTY.
    _rt_repo up_o
    ( cd up_o && echo v1 > f.txt && git add -A && git commit -q -m v1 \
        && echo v2 > f.txt && git commit -q -am v2 )
    _rt_repo par
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd par && git clone -q ../up_o old >/dev/null 2>&1 )
    cd par || return 1
    # Make the worktree EXACTLY the v1 tree while HEAD stays at v2.
    echo v1 > old/f.txt

    _rt_ok "st" _rt_my_git st old || return 1
    _rt_contains "reports an old checkout, not dirt" "$_rt_out" "OLD CHECKOUT" || return 1
    _rt_contains "says it lags and is safe" "$_rt_out" "lags HEAD by 1" || return 1
    _rt_contains "states no local edits" "$_rt_out" "NO local edits" || return 1
    _rt_not_contains "must not claim DIRTY" "$_rt_out" "DIRTY" || return 1

    # One genuine edit flips it straight back to DIRTY.
    echo v3-nothing-like-upstream > old/f.txt
    _rt_ok "st after a real edit" _rt_my_git st old || return 1
    _rt_contains "a real edit is DIRTY again" "$_rt_out" "DIRTY (1)" || return 1
