        && echo c > c.md && git add -A && git commit -q -m mine && git fetch -q )
    ( cd insync && git fetch -q )
    git -C diverged config --unset pull.rebase 2>/dev/null
    git -C insync   config --unset pull.rebase 2>/dev/null

    _rt_ok "st" _rt_my_git st diverged insync || return 1
    [ "$(git -C diverged config --local --get pull.rebase)" = false ] \
      || { _rt_fail "the DIVERGED repo was not healed"; return 1; }
    # The in-sync repo has no problem to fix, so it must be left alone.
    [ -z "$(git -C insync config --local --get pull.rebase)" ] \
      || { _rt_fail "healed a repo that was not diverged"; return 1; }
    return 0
  }

