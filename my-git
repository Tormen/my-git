    # tracked blobs in the OUTER repo's own history. Confirmed by
    # direct testing to happen with or without -f — this predates the
    # -f fix entirely and would have silently corrupted every prior
    # successful realize-then-track flatten run. After 'flatten go',
    # NOT ONE file under any '.git.real' directory may appear in the
    # outer repo's tracked file list — only the realized item's own
    # actual content (e.g. x.txt) should be tracked.
    _rt_repo_file sub-o x.txt
    _rt_repo global
    ( cd global && git clone -q ../sub-o myitem >/dev/null 2>&1 )
    cd global || return 1
    _rt_conf_path="$PWD/conf.ini"; _rt_conf_auto_emb "$_rt_conf_path"
    _rt_ok "flatten go: realize and track myitem" _rt_my_git flatten go || return 1
    _rt_isdir "myitem/.git.real created" myitem/.git.real || return 1
    _rt_gitlink_mode "myitem's own content correctly tracked" myitem/x.txt 100644 || return 1
