    _rt_repo_file up_o a.md
    _rt_repo container
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd container && git clone -q ../up_o proj >/dev/null 2>&1 )
    cd container || return 1
    _rt_ok "shadow the project" _rt_my_git shadow go proj || return 1
    # The container must carry the project's FILES.
    [ -n "$(git ls-files -- proj/a.md)" ] \
      || { _rt_fail "setup: the container does not mirror the project's files"; return 1; }
    git commit -q -am "container state" 2>/dev/null || true

    # Clone the container, exactly as a new machine would.
    _rt_home=$PWD
    git clone -q . ../fresh >/dev/null 2>&1
    cd ../fresh || return 1
    _rt_exists "the code came with the clone" proj/a.md || return 1
    [ -e proj/.git ] && { _rt_fail "a clone should NOT carry the project's .git"; return 1; }
    _rt_exists "but the marker did" proj/.git.shadow.status || return 1

    _rt_ok "rehydrate analyze finds it" _rt_my_git rehydrate || return 1
    _rt_contains "reports the missing repo" "$_rt_out" "have their files but no repo" || return 1
    _rt_ok "rehydrate go" _rt_my_git rehydrate go || return 1
    _rt_isdir "the project has its own .git again" proj/.git || return 1
    [ -n "$(git -C proj config --get remote.origin.url)" ] \
      || { _rt_fail "restored repo has no remote -- it still cannot push"; return 1; }
    [ "$(git -C proj rev-list --count HEAD 2>/dev/null)" -ge 1 ] \
      || { _rt_fail "restored repo has no history"; return 1; }
