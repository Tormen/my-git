    _rt_contains "offers go when fixable" "$_rt_out" "repair --sidecar go" || return 1
    _rt_ok "repair --sidecar go" _rt_my_git repair --sidecar go || return 1
    _rt_contains "reports FIXED" "$_rt_out" "FIXED" || return 1
    _rt_ok "re-analyze: clean again" _rt_my_git repair || return 1
    _rt_contains "clean again" "$_rt_out" "NOTHING to auto-repair" || return 1
