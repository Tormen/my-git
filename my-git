  test_flatten_go_refuses_dirty_index() {
    # A my-git commit must contain ONLY my-git's changes. flatten finishes with
    # a whole-index 'git commit', so it must REFUSE when the index already has
    # staged changes (else it would sweep the user's staged work into its own
    # commit). Unstaged/untracked changes are fine.
    _rt_repo_file kid_o k.txt
    _rt_repo top
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd top && git clone -q ../kid_o kid >/dev/null 2>&1 )
    cd top || return 1
    # an UNRELATED staged change
    echo secret > mysecret.txt; git add mysecret.txt
    _headbefore=$(git rev-parse HEAD)
    # forced --sidecar commits -> must be refused while the index is dirty
    if _rt_my_git flatten go kid --sidecar >"$_rt_out" 2>"$_rt_err"; then
      _rt_fail "flatten go with a dirty index should be refused"; return 1
    fi
    _rt_contains "refusal names STAGED changes" "$_rt_err" "STAGED changes" || return 1
    _rt_absent "kid NOT sidecared (refused)" kid/.git.real || return 1
    [ "$(git rev-parse HEAD)" = "$_headbefore" ] || { _rt_fail "no commit should have been made"; return 1; }
    [ -n "$(git diff --cached --name-only | grep -Fx mysecret.txt)" ] || { _rt_fail "the user's staged change must be left staged, untouched"; return 1; }
    # once the index is clean, flatten works and commits ONLY kid's content
    git commit -qm "my own commit" >/dev/null 2>&1
    _rt_ok "flatten go kid --sidecar (clean index)" _rt_my_git flatten go kid --sidecar || return 1
    _rt_isdir "kid now sidecared" kid/.git.real || return 1
    # the flatten commit must not contain mysecret.txt (it was already committed
    # separately) nor anything outside kid/ except flatten's own .gitignore
    _stray=$(git show --name-only --format='' HEAD | grep -v '^$' | grep -vE '^(kid/|\.gitignore$)')
