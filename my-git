#!/bin/sh
# my-git — multi-repo git dispatcher with recursive submodule support.
#
# Subcommands:  status|st|s   masscommits|mc|c   submodules|sub|sm   pull   sync
#               remote   flatten|unflatten   shadow|sh   unshadow|unsh
#               audit   repair
# Global opts:  -V|-VV   -D|-DD   --config FILE   --create-config   -h|--help
#
# See:  my-git --help   (or: my-git --help <subcommand>)

US=${0##*/}
ME=$(id -un 2>/dev/null || echo "$USER")

# ─── Dedicated trace channel (fd 3) ──────────────────────────────────────
# run()'s '-V' command trace must survive callers redirecting stderr to
# capture a command's own error output for diagnostics (e.g.
# 'run git commit ... 2>"$errlog"') — a plain '>&2' trace gets swallowed
# into that same redirect, silently. Duplicating stderr into fd 3 HERE,
# before any subcommand ever redirects fd 2 locally, gives run() a
# channel no later '2>...' on an individual command can touch. If the
# whole script's own stderr was itself redirected at invocation (e.g.
# 'my-git ... 2>logfile'), fd 3 correctly follows it there too — this
# duplicates whatever fd 2 already was, not literally the terminal.
exec 3>&2

# ─── Runtime flags ───────────────────────────────────────────────────────
VRB=0; VERYVRB=0; DBG=0; DEEPDBG=0
CONFIG_FILE=""
CONFIG_SEARCH_ORDER="/LINKS/default/my-git.conf $HOME/.my-git.conf /etc/my-git.conf /usr/local/etc/my-git.conf"
DRY_RUN=0
INTERACTIVE=0
RECURSIVE=0

# ─── Colors (TTY only) ───────────────────────────────────────────────────
# Mirrors my-appleRAID. Empty on non-TTY so no escape codes leak into
# pipes / log files / subshell captures.
if [ -t 1 ]; then
  C_BOLD=$(printf '\033[1m')
  C_DIM=$(printf '\033[2m')
  C_RED=$(printf '\033[31m')
  C_GREEN=$(printf '\033[32m')
  C_YELLOW=$(printf '\033[33m')
  C_BLUE=$(printf '\033[94m')    # bright blue (ANSI 94 vs plain 34 — better contrast on dark bg)
  C_CYAN=$(printf '\033[36m')
  C_RESET=$(printf '\033[0m')
else
  C_BOLD=''; C_DIM=''; C_RED=''; C_GREEN=''; C_YELLOW=''; C_BLUE=''; C_CYAN=''; C_RESET=''
fi

# ─── Logging ─────────────────────────────────────────────────────────────
# Convention: the ENTIRE line is colored (prefix + message). Color reset
# goes at the very end, right before \n — so pipes/paging that strip
# trailing whitespace still terminate the escape cleanly.
# MILESTONE / major info → bold cyan.
log_major()     { printf ' %s>>> %s%s\n' "$C_BOLD$C_CYAN" "$*" "$C_RESET"; }
# Medium info → bright blue, only at -V / -VV / -D / -DD.
log_medium()    { [ "$VRB"      = 1 ] && printf '  %s>> %s%s\n' "$C_BLUE" "$*" "$C_RESET"; return 0; }
# Minor detail → default color, only at -VV / -DD.
log_minor()     { [ "$VERYVRB"  = 1 ] && printf '    > %s\n' "$*"; return 0; }
# Debug output → dim/grey, stderr.
log_dbg_major() { [ "$DBG"      = 1 ] && printf ' %s~~~ %s%s\n' "$C_DIM" "$*" "$C_RESET" >&2; return 0; }
log_dbg_med()   { [ "$DBG"      = 1 ] && printf '  %s~~ %s%s\n'  "$C_DIM" "$*" "$C_RESET" >&2; return 0; }
log_dbg_minor() { [ "$DEEPDBG"  = 1 ] && printf '   %s~ %s%s\n'   "$C_DIM" "$*" "$C_RESET" >&2; return 0; }
log_warn()      { printf '%sWARN:  %s%s\n' "$C_YELLOW" "$*" "$C_RESET" >&2; }
log_error()     { printf '%sERROR: %s%s\n' "$C_RED"    "$*" "$C_RESET" >&2; }
# Outcome lines — green SUCCESS / red FAIL always come as a PAIR, so a
# result is unambiguous ("did it happen?") in both directions.
log_ok()        { printf ' %sSUCCESS:%s %s\n' "$C_BOLD$C_GREEN" "$C_RESET" "$*"; }
log_fail()      { printf ' %sFAIL:%s %s\n'    "$C_BOLD$C_RED"   "$C_RESET" "$*" >&2; }

# tracking_repo_of <path>
#   Print the repo that actually TRACKS <path>'s files right now, as a
#   logical (symlink-preserving) absolute path. Walks outward from the
#   path's own parent, because the answer is a fact about the index, not
#   about the directory layout: a nested repo can sit inside repo A while
#   its files are tracked by repo B further out.
#   Prints nothing when NO repo tracks it -- which is exactly how a stale
#   shadow marker is detected.
tracking_repo_of() {
  _tro_p=$1
  _tro_dir=$( cd "$_tro_p/.." 2>/dev/null && pwd ) || return 0
  while [ -n "$_tro_dir" ]; do
    if [ -e "$_tro_dir/.git" ] || [ -d "$_tro_dir/${GIT_SIDECAR_DIRNAME:-.git.real}" ]; then
      # CONTENT only -- a 160000 gitlink does NOT count. A submodule entry is
      # a POINTER to another repo, the exact opposite of a content mirror:
      # the parent stores one commit id and none of the files. Counting it as
      # "this repo tracks the path" made every registered submodule look like
      # a live shadow, so 'unshadow' refused to clean their stale markers and
      # sent you to a repo that was not mirroring anything.
      if [ -n "$( cd "$_tro_dir" 2>/dev/null \
                  && git -c safe.directory='*' ls-files -s -- "$_tro_p" 2>/dev/null \
                  | awk '$1 != 160000 { print; exit }' )" ]; then
        printf '%s\n' "$_tro_dir"
        return 0
      fi
    fi
    [ "$_tro_dir" = "/" ] && break
    _tro_dir=$( cd "$_tro_dir/.." 2>/dev/null && pwd ) || break
  done
  return 0
}

# related_repo_of <abs-path> <tag>
#   Print the OTHER git repo a path is in a relationship WITH, as a
#   logical absolute path — the repo whose index/.gitmodules/object DB
#   carries something on this path's behalf. Prints nothing for tags that
#   describe no relationship (a plain nested repo, a zipped git dir).
#
#   Why this exists: my-git tags say WHAT a path is ([merged], [shadowed],
#   [registered-sm]) but never said WITH WHICH repo. Once a middle repo is
#   introduced, flattened or brought back, "merged" is ambiguous — merged
#   into the parent, or into the one above it? The tag now carries '@repo'
#   so the answer is on the row, not inferred.
related_repo_of() {
  _rro_abs=$1
  _rro_tag=$2
  case "$_rro_tag" in
    shadowed)
      # ONLY what is true right now. Deliberately no fallback to the
      # marker's recorded 'shadowed-into-repo': that value is what WAS
      # true when the shadow was made, and trusting it here would paper
      # over exactly the case this is meant to expose — a marker whose
      # mirror is gone. The recorded value is used only to phrase the
      # STALE message at the call site.
      _rro_r=$(tracking_repo_of "$_rro_abs")
      ;;
    merged)
      # Prefer the repo recorded as holding the preserved history. Failing
      # that, recover it from the snapshot's own header, which names the
      # path RELATIVE TO the repo it was merged into — so walking up that
      # many components lands exactly on that repo, even for a snapshot
      # written long before any of this was recorded.
      _rro_r=$(sed -n 's|^preserved-in-repo: ||p' "$_rro_abs/.git.merged" 2>/dev/null | head -n 1)
      if [ -z "$_rro_r" ]; then
        _rro_rel=$(sed -n 's|^# my-git merge snapshot for \(.*\) -- written by.*|\1|p' "$_rro_abs/.git.merged" 2>/dev/null | head -n 1)
        if [ -n "$_rro_rel" ]; then
          _rro_r=$_rro_abs
          _rro_n=$(printf '%s' "$_rro_rel" | tr '/' '\n' | grep -c .)
          while [ "$_rro_n" -gt 0 ] && [ -n "$_rro_r" ]; do
            _rro_r=$( cd "$_rro_r/.." 2>/dev/null && pwd ) || break
            _rro_n=$((_rro_n - 1))
          done
        fi
      fi
      [ -n "$_rro_r" ] || _rro_r=$(tracking_repo_of "$_rro_abs")
      ;;
    reg|reg-ign|stale)
      # The repo whose .gitmodules carries the entry: the nearest enclosing
      # repo, since that is where 'sm' registers and 'unsm' de-registers.
      _rro_r=$( cd "$_rro_abs/.." 2>/dev/null && git_toplevel_of "$PWD" 2>/dev/null )
      ;;
    realized)
      _rro_r=$(tracking_repo_of "$_rro_abs")
      ;;
    *) _rro_r="" ;;
  esac
  [ -n "$_rro_r" ] && printf '%s\n' "$_rro_r"
  return 0
}

# log_repo_context <verb> <repo> <what-this-repo-gets> [<extra detail>...]
#   Every mutating command announces, up front and in plain words, WHICH
#   git repository it is about to read and write. my-git routinely acts on
#   a repo OTHER than the one you are standing in — it walks up to a
#   toplevel, or down to the repo that directly encloses a PATH — and the
#   whole class of "wait, which .git did that just commit to?" confusion
#   comes from that being implicit. So it is now never implicit.
#
#   <repo> is printed as the LOGICAL path (symlinks intact — /LINKS/...,
#   not the resolved /Users/... form) because that is what was typed.
#   Always at log_major level: this is not a -V detail, it is the single
#   most important fact about the command that is about to run.
log_repo_context() {
  _lrc_verb=$1; _lrc_repo=$2; _lrc_gets=$3; shift 3
  log_major "$_lrc_verb: TARGET REPO  $_lrc_repo"
  printf '    > %s\n' "$_lrc_gets"
  for _lrc_x in "$@"; do
    [ -n "$_lrc_x" ] && printf '    > %s\n' "$_lrc_x"
  done
  return 0
}

# _prompt_ysa <question> — the ONE per-item interactive gate used everywhere
# a repo-by-repo confirmation is needed (flatten's forced modes, unflatten,
# --zip). FULLY annotated, re-asks on invalid input. Returns:
#   0 = yes  (Enter / y)      — do this one
#   1 = skip (s)              — leave this one, ask about the next
#   2 = abort (a / EOF)       — stop entirely, do nothing more
#   3 = go   (g)              — do this one AND all remaining, stop asking
# The 's'/'a'/'g' letters match flatten's default (-i, no forced mode) choice
# prompt, so every interactive prompt in my-git offers the same vocabulary.
_prompt_ysa() {
  # $1 = question body, e.g. '[1 of 6] "path" [zip] restore .git ?'. Rendered
  # in the SAME bold-cyan ' >>> ' style as log_major's overview lines, then
  # the colored choices.
  while :; do
    printf ' %s>>> %s%s   %s[Y]es%s / %s[s]kip%s / %s[a]bort%s / %s[g]o%s (this + all rest): ' \
      "$C_BOLD$C_CYAN" "$1" "$C_RESET" \
      "$C_GREEN" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_RED" "$C_RESET" "$C_BOLD$C_GREEN" "$C_RESET" >/dev/tty
    IFS= read -r _pysa </dev/tty || return 2
    _pysa=$(printf '%s' "$_pysa" | tr -d '[:space:]')
    case "$_pysa" in
      ''|y|Y) return 0 ;;
      s|S)    return 1 ;;
      a|A)    return 2 ;;
      g|G)    return 3 ;;
      *) printf '     %s? please answer  Y=yes  s=skip  a=abort  g=go(all rest)%s\n' "$C_YELLOW" "$C_RESET" >/dev/tty ;;
    esac
  done
}

# ─── Command trace (run / show) — mirrors my-appleRAID ───────────────────
# run: echo command in grey at -V, then execute. Preserves exit code.
# show: print a "would run" command in grey (always shown at callsite —
#   callsite decides when to use it, e.g. for dry-run illustrations).
run() {
  # Trace goes to fd 3 (see 'exec 3>&2' near the top) — a dedicated
  # channel duplicated from stderr before startup, so it stays intact
  # even when the CALLER redirects fd 2 for this specific command (e.g.
  # to capture git's own error text into a temp file). Using plain
  # stderr here would get silently swallowed into that same redirect.
  # Keeps stdout clean either way, for $(...) callers.
  # Only visible at -VV (VERYVRB) and therefore -D, -DD — NOT at plain
  # -V. -V is the human "medium detail" axis (per-node status, remotes,
  # etc.) and is deliberately behaviour-changing; keeping the raw command
  # trace off it means -V output stays clean and -D (which implies -VV
  # but NOT -V) shows commands without triggering -V's behaviour changes.
  [ "$VERYVRB" = 1 ] && printf '%s$ %s%s\n' "$C_DIM" "$*" "$C_RESET" >&3
  "$@"
}
# runq — like run(), but the trace is gated on -D (DBG), not -VV.
# For INTERNAL "noise" commands (temp-file mktemp/rm, other bookkeeping
# that never touches the user's repo): kept OUT of the -VV command trace
# (which should read as the meaningful, repo-affecting command stream),
# but surfaced at -D and above so a debug run really does show EVERY
# external command my-git executes — including the noise — when you're
# hunting a problem. (-DD additionally turns on 'set -x' for full
# line-by-line shell tracing.) Same fd-3 channel + stdout-clean as run().
runq() {
  [ "$DBG" = 1 ] && printf '%s$ %s%s\n' "$C_DIM" "$*" "$C_RESET" >&3
  "$@"
}
# trace / traceq — emit a command to the -VV (trace) or -D (traceq) command
# stream WITHOUT executing it. For commands run() cannot wrap: pipelines and
# commands inside a subshell ( ... ) — e.g. the discovery 'find' that feeds a
# 'sed|grep' pipe. Keeps the -VV/-D command stream COMPLETE (every relevant
# external command shows up), which run() alone can't guarantee. Return 0 so
# these never affect the surrounding command's exit status.
trace()  { [ "$VERYVRB" = 1 ] && printf '%s$ %s%s\n' "$C_DIM" "$*" "$C_RESET" >&3; return 0; }
traceq() { [ "$DBG"     = 1 ] && printf '%s$ %s%s\n' "$C_DIM" "$*" "$C_RESET" >&3; return 0; }
show() {
  printf '%s$ %s%s\n' "$C_DIM" "$*" "$C_RESET"
}
# Inline status colorizers used inside longer strings.
c_green() { printf '%s%s%s' "$C_GREEN"  "$1" "$C_RESET"; }
c_yellow(){ printf '%s%s%s' "$C_YELLOW" "$1" "$C_RESET"; }
c_red()   { printf '%s%s%s' "$C_RED"    "$1" "$C_RESET"; }
c_dim()   { printf '%s%s%s' "$C_DIM"    "$1" "$C_RESET"; }

fatal() {
  _ec=${2:-1}
  log_error "$1"
  exit "$_ec"
}

# require_tty <subcommand-name>
# Used by every subcommand that supports -i/--interactive. Refuses to
# proceed if no TTY is available (interactive prompts would have nothing
# to read from / write to). Call right after arg parsing detects -i.
# The [ -r /dev/tty ] check is NOT reliable on macOS — the device node
# exists with read perms even when the process has no controlling tty,
# and open() fails with ENXIO. The only reliable probe is to actually
# try to open /dev/tty for reading AND writing.
require_tty() {
  if ! ( : </dev/tty ) 2>/dev/null || ! ( : >/dev/tty ) 2>/dev/null; then
    log_error "$1: -i / --interactive requires a TTY (none available)"
    exit 1
  fi
}

# ─── Config file handling ────────────────────────────────────────────────
_default_config_content() {
  cat <<'EOF'
# my-git.conf — configuration for the my-git CLI.
# Shell-syntax; sourced by my-git at startup.

# Space-delimited list of super-repos for fallback scope (used when my-git is
# invoked outside of any tracked repo and without explicit path arguments).
GIT_REPOS="/LINKS/global /LINKS/local /learn /LINKS/appData /LINKS/archive"

# ─── .claude setup enforcement (masscommits + claude-check) ──────────────
# 1 = audit+auto-fix; 0 = disable entirely
CHECK_CLAUDE_SETUP=1
# Central repo where all <project>/.claude directories live as real dirs.
# Each project's .claude must be a symlink into this tree.
CLAUDE_PROJECT_DIR_CENTRAL_REPO="/LINKS/src/,claude-configs"

# ─── Self-healing of derived local state ─────────────────────────────────
# These repair BOOKKEEPING, never project content, and write ONLY to files
# git never clones (.git/info/exclude, .git/config). Both default ON because
# the state they maintain cannot survive a fresh clone: something has to
# re-establish it, and the command people actually run is 'st'.
# 1 = heal; 0 = leave alone (st then only reports).
#
# Hide a nested SHADOWED repo from the repo that physically contains it.
AUTOHEAL_SHADOW_EXCLUDES=1
# Give a repo a pull strategy when it has none, so 'pull' on a diverged
# branch does not die with "Need to specify how to reconcile divergent
# branches". Only ever set when UNSET -- an existing choice is yours.
# The value IS the strategy; empty/no/off disables the healing entirely.
AUTOHEAL_PULL_STRATEGY=merge   # merge | rebase | ff-only | "" / no / off
# Give a branch its upstream when origin ALREADY has a branch of the same
# name -- purely local config recording something already true. my-git never
# creates a branch on a remote to satisfy this: that is publishing, and on
# someone else's project it is not yours to do.
AUTOHEAL_UPSTREAM=1


# ─── Running git as the repo owner ───────────────────────────────────────
# When my-git runs as root it drops to the owner of each repo's .git. Plain
# 'su' gives you the owner's identity but NOT their login keychain, which is
# unlocked per security session rather than per shell -- so an https remote
# asks for a username mid-run and ignores Ctrl-C. When the owner is the user
# at the console, 'launchctl asuser' joins their session and the credential
# helper works. Falls back to 'su' automatically when there is no graphical
# session (ssh-only host, logged out, cron).
#   1 = use launchctl asuser when possible (default)   0 = always plain su
XUSER_LAUNCHCTL=1

# ─── Which remotes 'push' will publish to ────────────────────────────────
# A tree can hold repos you cloned to READ (upstreams like winetricks or
# pulseaudio) alongside your own. Pushing to someone else's project does
# not merely fail -- it fails with a 403 AFTER prompting for credentials,
# once per repo. So decide it up front instead.
#   mine  publish only to remotes matching MINE_URL_PATTERNS (default)
#   all   try every repo that is ahead
PUSH_REMOTE_SCOPE=mine
# Which remote URLs are YOURS. Space-separated PREFIXES -- a URL belongs to
# you when it STARTS with one of them, so the ssh and https spellings of the
# same account are separate entries, and "github.com/Tormen/" cannot be
# matched accidentally inside someone else's URL.
#
# Not named after 'push': it states a fact about your remotes, and anything
# else that needs to tell yours from a third party's should ask the same
# question rather than growing its own list.
MINE_URL_PATTERNS="git@github.com:Tormen/ https://github.com/Tormen/ my-gits: gits4root: /LINKS/gits/"

# ─── Conflict viewer ('diff') ────────────────────────────────────────────
# Program that shows the two conflicting versions side by side. Receives
# exactly two file paths. vimdiff/nvim -d/opendiff/meld all work.
DIFF_TOOL=vimdiff

# ─── Auto-commit message template knobs ──────────────────────────────────
COMMIT_MSG_LAST_N=3
COMMIT_MSG_DIFF_MAX_FILES=10

# ─── mc: auto-include untracked files ────────────────────────────────────
# 1 = treat '??' porcelain entries (new files the user added but didn't
#     'git add' yet) as auto-committable along with my-git-caused dirt
#     (submodule gitlink bumps, .claude/.gitignore edits). Rationale:
#     new files are harmless to add; dragging the user through a prompt
#     for every new file is noise. Set 0 to prompt for untracked too.
MC_AUTO_COMMIT_UNTRACKED=1

# ─── st / sm: directory basenames to prune during unregistered-nested
#     discovery. Without this, walking from ~/ descends into package
#     caches that have tens of thousands of cloned .git dirs and takes
#     tens of seconds. These basenames are '-prune'd in the find walk.
#     Add more if you have other noisy cache/build roots.
ST_EXCLUDE_DIRS=".cache node_modules .npm .venv .tox __pycache__ .cargo .gradle .m2 .yarn Library .Trash"

# ─── Privilege: cross-user policy ───────────────────────────────────────
# Controls what happens when the current user differs from the repo's
# .git owner. Running as root ALWAYS just works (plain 'su <owner> -c ...',
# no password, no policy). These two policies apply only when the caller
# is a non-root user.
#
# Policy values:
#   sudo    - escalate via 'sudo su <owner> -c ...' (requires sudo rights;
#             macOS: caller must be in 'admin'/'wheel'/'sudo' group;
#             if no rights, behaves like 'fail')
#   fail    - ERROR and abort the whole run
#   ignore  - silently skip this repo, continue with the rest
#   warn    - print a warning and skip this repo, continue with the rest

# user (non-root) operating on a root-owned repo:
PRIV_POLICY_USER_TO_ROOT=warn

# user A (non-root) operating on user B's (non-root) repo:
PRIV_POLICY_USER_TO_USER=fail

# ─── Default verbosity / debug ──────────────────────────────────────────
# 1 = always behave as -V / -D (CLI flag can still raise the level)
DEFAULT_VERBOSE=0
DEFAULT_DEBUG=0

# ─── Submodules (sm) subcommand ─────────────────────────────────────────
SM_AUTO_SAFE_DIRECTORY=1
# SSH ConnectTimeout (seconds) applied to any clone/fetch ‘sm’ performs
# via SSH. Protects against half-minute+ default stalls when a host is
# unreachable. Applied via GIT_SSH_COMMAND at cmd_submodules start.
SM_SSH_CONNECT_TIMEOUT=30

# ─── flatten: registered-submodule -> self-contained conversion ─────────
# When flattening a REGISTERED submodule (not a plain embedded nested
# repo), its real git directory normally lives buried in the parent's
# own '.git/modules/<name>/' — history is kept, but only reachable
# through the parent, and lost if you ever copy/move the submodule path
# on its own. 'realize' (flatten -i choice 'r', or AUTO_SIDECAR_SUBMODULES
# below for bare 'go') instead relocates that real git dir INTO the
# submodule's own path, as a sibling of its content, self-contained and
# portable. Named by GIT_SIDECAR_DIRNAME rather than left as '.git' so it
# never needs the move-out/restore dance embedded repos require — once
# excluded, the parent never has to think about it again.
GIT_SIDECAR_DIRNAME=".git.real"
# 1 = bare 'flatten go' (no -i) also auto-realizes EVERY registered
#     submodule this way, the same way it already auto-flattens plain
#     embedded nested repos with no prompt. 0 (default) = bare go leaves
#     registered submodules untouched (existing behavior) — use
#     'flatten -i' to convert them one at a time instead.
AUTO_SIDECAR_SUBMODULES=0
# Same idea, but for plain EMBEDDED nested repos (not registered in
# .gitmodules). Embedded repos default to staying a live, working
# .git kept in place — 'cd nested && git pull' just works, nothing to
# configure. 1 = bare 'flatten go' instead realizes every embedded
# nested repo the same way registered submodules can be realized:
# relocate its .git to GIT_SIDECAR_DIRNAME, self-contained. 0 (default)
# = keep the existing default (live .git kept in place, no renaming).
AUTO_SIDECAR_EMBEDDED=0
EOF
}

load_config() {
  # Honour --config / $MY_GIT_CONFIG / search order.
  _cf=""
  if [ -n "$CONFIG_FILE" ]; then
    [ -f "$CONFIG_FILE" ] || fatal "--config: no such file: $CONFIG_FILE"
    _cf=$CONFIG_FILE
  elif [ -n "${MY_GIT_CONFIG:-}" ]; then
    [ -f "$MY_GIT_CONFIG" ] || fatal "\$MY_GIT_CONFIG: no such file: $MY_GIT_CONFIG"
    _cf=$MY_GIT_CONFIG
  else
    for _c in $CONFIG_SEARCH_ORDER; do
      if [ -f "$_c" ]; then _cf=$_c; break; fi
    done
  fi
  if [ -z "$_cf" ]; then
    log_major "no config file found"
    printf '  >> searched (in order):\n'
    for _c in $CONFIG_SEARCH_ORDER; do
      printf '    > %s\n' "$_c"
    done
    printf '  >> run:  my-git --create-config\n'
    printf '  >> or:   my-git --config /path/to/your.conf <subcommand>\n'
    exit 2
  fi
  log_dbg_med "config: $_cf"
  # All values come from the user's config. Defaults are NOT baked into
  # my-git at runtime — they live only inside _default_config_content(),
  # which --create-config writes to the config file. If the user's config
  # is missing variables that my-git depends on, that is the user's
  # responsibility: re-run --create-config (to a fresh path and diff) to
  # see what is expected.
  # shellcheck disable=SC1090
  . "$_cf"
  # Apply defaults from config to runtime flags (CLI flags can still escalate).
  [ "$DEFAULT_VERBOSE" = 1 ] && [ "$VRB" = 0 ] && VRB=1
  [ "$DEFAULT_DEBUG"   = 1 ] && [ "$DBG" = 0 ] && DBG=1
  # Back-compat defaults for vars newer than a user's existing config file.
  # New knobs: keep them conservative so upgrades don't surprise users.
  : "${MC_AUTO_COMMIT_UNTRACKED:=1}"
  : "${ST_EXCLUDE_DIRS:=.cache node_modules .npm .venv .tox __pycache__ .cargo .gradle .m2 .yarn Library .Trash}"
  # GIT_SIDECAR_DIRNAME: was GIT_REAL_DIRNAME before this variable was
  # renamed. A config file written before that rename (or missing the
  # var entirely) must NOT leave this empty — dozens of call sites
  # throughout flatten/unflatten compare directly against it (e.g. 'is
  # <path>/$GIT_SIDECAR_DIRNAME a directory?'), and an empty value makes
  # that check silently degrade to 'is <path>/ a directory?', which is
  # true for ANY existing path — a real, confirmed case where flatten
  # --merge on an ordinary live nested repo mistook it for an
  # already-converted sidecar and destroyed it instead of merging it.
  : "${GIT_SIDECAR_DIRNAME:=.git.real}"
}

create_config() {
  # --create-config           → print default config to stdout (CLI).
  # --create-config <path>    → write default config to <path> (refuse overwrite).
  _target=${1:-}
  if [ -z "$_target" ]; then
    _default_config_content
    exit 0
  fi
  if [ -e "$_target" ]; then
    log_error "--create-config: refusing to overwrite existing file: $_target"
    exit 3
  fi
  _dir=${_target%/*}
  case "$_target" in */*) : ;; *) _dir=. ;; esac
  [ -d "$_dir" ] || fatal "--create-config: parent directory does not exist: $_dir"
  [ -w "$_dir" ] || fatal "--create-config: parent directory not writable: $_dir"
  _default_config_content > "$_target" || fatal "could not write $_target"
  log_major "config written: $_target"
  log_medium "edit it, then:  my-git <subcommand>"
  exit 0
}

# ─── Generic helpers ────────────────────────────────────────────────────
shell_escape() {
  # Print argv as a single space-joined, single-quoted POSIX-safe string.
  _esc=""
  for _a in "$@"; do
    _q=$(printf '%s' "$_a" | sed "s/'/'\\\\''/g")
    _esc="$_esc '$_q'"
  done
  printf '%s' "${_esc# }"
}

file_owner() {
  # GNU and BSD/macOS stat differ — and NOT just in output: GNU '-f' means
  # "show FILESYSTEM status" (a completely different report), not "use
  # this format string". It succeeds (exit 0) with garbage rather than
  # failing, so trying BSD's '-f' first silently breaks on GNU (the '||'
  # fallback never fires). Try GNU's '-c' first instead: it exits
  # non-zero ("invalid option") on BSD/macOS stat, so the fallback to
  # BSD's '-f' only fires where it's actually needed.
  stat -c '%U' "$1" 2>/dev/null || stat -f '%Su' "$1" 2>/dev/null
}

is_managed_path() {
  # 0 = path is in GIT_REPOS (or a descendant); 1 = foreign.
  # "Managed" means: my-git is authorized to recursively discover
  # unregistered nested repos inside this scope. For foreign scopes
  # (e.g. ~/ which happens to be a git repo but is not in the config
  # list), my-git stays shallow — shows only the scope root itself,
  # does not descend looking for embedded / nested repos.
  # Match BOTH logical (symlink-preserving) and physical paths so a
  # caller's CWD of '/LINKS/src' matches a GIT_REPOS entry of
  # '/LINKS/global' via physical '/Users/MINE/system/global'.
  _im_p=$1
  _im_log=$(cd "$_im_p" 2>/dev/null && printf '%s' "$PWD") || return 1
  _im_phys=$(cd "$_im_p" 2>/dev/null && pwd -P) || return 1
  for _im_base in $GIT_REPOS; do
    [ -d "$_im_base" ] || continue
    _im_bl=$(cd "$_im_base" 2>/dev/null && printf '%s' "$PWD") || continue
    _im_bp=$(cd "$_im_base" 2>/dev/null && pwd -P) || continue
    # Equal or descendant test in both forms.
    case "$_im_log" in
      "$_im_bl"|"$_im_bl"/*) return 0 ;;
    esac
    case "$_im_phys" in
      "$_im_bp"|"$_im_bp"/*) return 0 ;;
    esac
  done
  return 1
}

is_pushable() {
  # 0 = push allowed, 1 = commit-only.
  # Push is allowed ONLY when the repo's absolute path matches one of
  # the entries in GIT_REPOS. Compare BOTH forms — logical (symlink-
  # preserving, e.g. '/LINKS/src') and physical (realpath, e.g.
  # '/Users/MINE/system/global/src') — on each side, so the match works
  # regardless of whether GIT_REPOS and the caller's CWD use symlink
  # or resolved form. Each super-repo in GIT_REPOS is meant to receive
  # pushes; submodules walked via -R that aren't in the list are not.
  _ip_r=$1
  _ip_log=$(cd "$_ip_r" 2>/dev/null && printf '%s' "$PWD") || return 1
  _ip_phys=$(cd "$_ip_r" 2>/dev/null && pwd -P) || return 1
  for _ip_base in $GIT_REPOS; do
    [ -d "$_ip_base" ] || continue
    _ip_base_log=$(cd "$_ip_base" 2>/dev/null && printf '%s' "$PWD") || continue
    _ip_base_phys=$(cd "$_ip_base" 2>/dev/null && pwd -P) || continue
    if [ "$_ip_log" = "$_ip_base_log" ] || [ "$_ip_phys" = "$_ip_base_phys" ]; then
      return 0
    fi
  done
  return 1
}

need_sudo_for() {
  # Echo 1 if repo's .git is not owned by current user; 0 otherwise.
  _r=$1
  _gd=$_r/.git
  [ -e "$_gd" ] || { echo 0; return; }
  _o=$(file_owner "$_gd")
  if [ -n "$_o" ] && [ "$_o" != "$ME" ]; then echo 1; else echo 0; fi
}

has_sudo_rights() {
  # True if the current user is entitled to sudo. Checks admin/wheel/sudo
  # group membership (covers macOS 'admin', Linux 'sudo'/'wheel'), then
  # falls back to a non-interactive 'sudo -n -v' probe (succeeds only if
  # credentials are cached OR NOPASSWD is configured — still a positive
  # signal). If neither indicator says yes, we say no.
  _me=${ME}
  _groups=$(id -Gn "$_me" 2>/dev/null | tr ' ' '\n')
  for _g in admin wheel sudo; do
    printf '%s\n' "$_groups" | grep -qx "$_g" && return 0
  done
  sudo -n -v 2>/dev/null && return 0
  return 1
}

# check_priv <repo>
#   Decide whether to proceed with an operation on <repo> given current
#   user, repo owner, and configured policy. Echoes ONE of:
#     exec        — proceed (direct exec or su/sudo under the hood)
#     skip        — policy=ignore: skip silently
#     warn        — policy=warn: WARN already printed to stderr; skip
#     fail:<msg>  — policy=fail (or sudo-without-rights, or bad policy
#                   value): caller must log_error+fatal
#   This function itself NEVER calls fatal() because it is usually invoked
#   inside $(...), where fatal's exit would only kill the subshell.
check_priv() {
  _repo=$1
  _gd=$_repo/.git
  [ -e "$_gd" ] || { echo exec; return; }
  _owner=$(file_owner "$_gd")
  if [ -z "$_owner" ] || [ "$_owner" = "$ME" ] || [ "$ME" = "root" ]; then
    echo exec; return
  fi
  if [ "$_owner" = "root" ]; then
    _pol=${PRIV_POLICY_USER_TO_ROOT:-fail}
    _polvar=PRIV_POLICY_USER_TO_ROOT
  else
    _pol=${PRIV_POLICY_USER_TO_USER:-fail}
    _polvar=PRIV_POLICY_USER_TO_USER
  fi
  case "$_pol" in
    sudo)
      if has_sudo_rights; then
        echo exec
      else
        echo "fail:$_repo: owned by $_owner; $_polvar=sudo but $ME has no sudo rights"
      fi
      ;;
    ignore)
      echo skip
      ;;
    warn)
      log_warn "$_repo: owned by $_owner — skipping ($_polvar=warn)"
      echo warn
      ;;
    fail)
      echo "fail:$_repo: owned by $_owner; $_polvar=fail"
      ;;
    *)
      echo "fail:$_polvar has invalid value '$_pol' (expected: sudo|fail|ignore|warn)"
      ;;
  esac
}

# priv_gate <repo>
#   Wrapper around check_priv that MUST be called in the PARENT shell
#   (not inside $()) so fatal() can exit the whole run. Sets the global
#   PRIV_ACTION to one of: exec | skip | warn. If the policy is 'fail',
#   calls fatal and terminates the process.
priv_gate() {
  PRIV_ACTION=$(check_priv "$1")
  case "$PRIV_ACTION" in
    fail:*) fatal "${PRIV_ACTION#fail:}" 13 ;;
    exec|skip|warn) : ;;
    *) fatal "internal: unknown priv action '$PRIV_ACTION'" 14 ;;
  esac
}

# _xuser_exec <target_user> <repo> <cmd...>
#   Execute a command in <repo> as <target_user>, picking the right
#   mechanism for the current user:
#     root -> user      : 'su <user> -c ...'        (no password, no sudo)
#     user -> other     : 'sudo su <user> -c ...'   (sudo prompts)
#     user -> same user : direct exec in subshell   (handled by callers)
# Is <user> the one at the console, and can we join their launchd session?
#   The login keychain is unlocked per SECURITY SESSION (a Mach bootstrap
#   namespace), not per shell -- which is why 'su' cannot reach it and why
#   'su -l' makes no difference: a login shell inherits the environment,
#   not the session. 'launchctl asuser <uid>' does join it, so an https
#   credential helper works from a root-run my-git.
#   Answered once per target: probing launchctl on every git call would
#   cost a fork per repo per command.
# Decided ONCE per run, from the parent shell -- see _xu_init_session. A
# memo inside this function would be useless: nearly every caller invokes it
# through run_as_owner_capture inside $(...), a subshell, so the cached
# answer dies with each command and the probe would run per git call
# (~150 of them on this tree).
_xu_session_uid() {
  [ -n "${_XU_SESSION_USER:-}" ] && [ "$1" = "$_XU_SESSION_USER" ] \
    && printf '%s' "${_XU_SESSION_UID:-}"
  return 0
}

# _xu_init_session
#   Who is at the console, and can we join their launchd session? Answered
#   once, before any subcommand runs, so the result is inherited by every
#   subshell below. Only meaningful as root: that is the only case where
#   my-git drops to another user at all.
_xu_init_session() {
  _XU_SESSION_USER=""; _XU_SESSION_UID=""
  [ "$ME" = root ] || return 0
  [ "${XUSER_LAUNCHCTL:-1}" = 1 ] || return 0
  _xui_u=$(file_owner /dev/console 2>/dev/null)
  [ -n "$_xui_u" ] && [ "$_xui_u" != root ] || return 0
  _xui_id=$(id -u "$_xui_u" 2>/dev/null)
  [ -n "$_xui_id" ] || return 0
  # No graphical session (ssh-only host, logged out) means the per-user
  # domain does not exist and asuser fails -- fall back to plain su.
  launchctl asuser "$_xui_id" true >/dev/null 2>&1 || return 0
  _XU_SESSION_USER=$_xui_u; _XU_SESSION_UID=$_xui_id
  log_dbg_med "session: $_xui_u (uid $_xui_id) is at the console — git will run in their launchd session (keychain reachable)"
  return 0
}

_xuser_exec() {
  _tgt=$1; _repo=$2; shift 2
  _cmdstr=$(shell_escape "$@")
  _repo_q=$(shell_escape "$_repo")
  if [ "$ME" = "root" ]; then
    _xu_uid=$(_xu_session_uid "$_tgt")
    if [ -n "$_xu_uid" ]; then
      log_dbg_med "launchctl asuser $_xu_uid sudo -u $_tgt sh -c \"cd $_repo && $_cmdstr\"  # joins $_tgt's session: keychain reachable"
      run launchctl asuser "$_xu_uid" sudo -u "$_tgt" sh -c "cd $_repo_q && $_cmdstr"
      return $?
    fi
    log_dbg_med "su $_tgt -c \"cd $_repo && $_cmdstr\"  # no console session for $_tgt: no keychain"
    run su "$_tgt" -c "cd $_repo_q && $_cmdstr"
  else
    log_dbg_med "sudo su $_tgt -c \"cd $_repo && $_cmdstr\""
    run sudo -p "[sudo for $_tgt @ $_repo] password: " su "$_tgt" -c "cd $_repo_q && $_cmdstr"
  fi
}

run_as_owner() {
  # run_as_owner <repo_worktree> <cmd> [args...]
  #   Runs cmd in $repo as the .git owner. Dispatch:
  #     same user:  direct exec
  #     caller=root: plain 'su <owner> -c ...' (always allowed)
  #     cross-user: governed by PRIV_POLICY_USER_TO_{ROOT,USER}
  #
  # Policy NOTE: run_as_owner itself does NOT call priv_gate — it is often
  # invoked inside $(...) (e.g. from list_direct_submodules), where
  # priv_gate's fatal() couldn't exit the whole run. Callers that drive
  # a repo (status_one, commit_one) must call priv_gate FIRST and only
  # invoke run_as_owner when PRIV_ACTION = exec. When called in a context
  # where the caller hasn't gated, cross-user access simply proceeds via
  # _xuser_exec (which may then fail naturally if it's not permitted).
  _repo=$1; shift
  _gitdir=$_repo/.git
  # Sidecar-aware: a sidecar has no '.git' but a GIT_SIDECAR_DIRNAME
  # holding the real git dir. Use it for the owner check so the command
  # still runs (the caller supplies --git-dir/--work-tree for the sidecar
  # where needed, e.g. remote_one / repo_is_local_only).
  [ -e "$_gitdir" ] || _gitdir=$_repo/${GIT_SIDECAR_DIRNAME:-.git.real}
  [ -e "$_gitdir" ] || { log_error "run_as_owner: no .git at $_repo"; return 1; }
  _owner=$(file_owner "$_gitdir")
  log_dbg_minor "run_as_owner: repo=$_repo owner=$_owner me=$ME cmd=$*"
  if [ -z "$_owner" ] || [ "$_owner" = "$ME" ]; then
    ( cd "$_repo" && run "$@" )
    return $?
  fi
  _xuser_exec "$_owner" "$_repo" "$@"
}

# Warn (ONCE per repo per run) that a read under run_as_owner_capture failed
# on ACCESS rather than legitimately returning nothing — the mixed-ownership
# trap: my-git runs git as the .git owner, but a TRACKED file (.gitmodules,
# an object, …) is owned by someone else, so that user gets Permission denied
# and my-git would otherwise silently UNDER-REPORT (e.g. submodules vanish;
# st tags real [registered-sm] repos as [raw-nested-git]). $$ is the top
# shell's PID — stable across the $(...) subshells this runs inside.
_mixed_ownership_warn() {
  _mow_repo=$1; _mow_owner=$2
  _mow_seen="${TMPDIR:-/tmp}/${US:-my-git}.mixedown.$$"
  if [ -f "$_mow_seen" ] && grep -qxF "$_mow_repo" "$_mow_seen" 2>/dev/null; then
    return 0
  fi
  printf '%s\n' "$_mow_repo" >> "$_mow_seen" 2>/dev/null || true
  log_warn "mixed ownership at $_mow_repo — my-git read it as owner '${_mow_owner:-?}' but hit Permission denied / dubious ownership; results here may UNDER-REPORT (submodules, etc.). Normalize, e.g.:  chown -R ${_mow_owner:-<owner>} $_mow_repo"
}

run_as_owner_capture() {
  # As run_as_owner, but captures stdout. Trailing newline stripped by $().
  # See run_as_owner for policy notes: no priv_gate call here.
  _repo=$1; shift
  _gitdir=$_repo/.git
  # Sidecar-aware (see run_as_owner): fall back to GIT_SIDECAR_DIRNAME so
  # the command still runs for a sidecared repo (no '.git' present).
  [ -e "$_gitdir" ] || _gitdir=$_repo/${GIT_SIDECAR_DIRNAME:-.git.real}
  [ -e "$_gitdir" ] || return 1
  _owner=$(file_owner "$_gitdir")
  # Route stderr through a temp so an ACCESS failure (mixed ownership) is
  # detected and warned about loudly instead of vanishing into an empty
  # result. stdout still flows straight to the caller's $() unchanged.
  _raoc_err=$(mktemp "${TMPDIR:-/tmp}/${US:-my-git}.raoc.XXXXXX" 2>/dev/null) || _raoc_err=""
  if [ -z "$_owner" ] || [ "$_owner" = "$ME" ]; then
    ( cd "$_repo" && run "$@" ) 2>"${_raoc_err:-/dev/null}"; _raoc_rc=$?
  else
    _xuser_exec "$_owner" "$_repo" "$@" 2>"${_raoc_err:-/dev/null}"; _raoc_rc=$?
  fi
  if [ -n "$_raoc_err" ]; then
    grep -qiE 'permission denied|dubious ownership' "$_raoc_err" 2>/dev/null \
      && _mixed_ownership_warn "$_repo" "$_owner"
    cat "$_raoc_err" >&2       # never swallow git's own message
    rm -f "$_raoc_err"
  fi
  return "$_raoc_rc"
}

is_git_repo() {
  # True if $1 contains a readable .git dir or file.
  [ -n "$1" ] && [ -e "$1/.git" ]
}

# is_git_repo_or_flattened <path>
#   True if <path> is a live repo (.git) OR a my-git sidecar
#   (GIT_SIDECAR_DIRNAME) OR a merged path (.git.merged). Used where a
#   PATH argument should be accepted even after flatten (a sidecar/merged
#   path is no longer a plain '.git' repo but IS a valid target for
#   st/rem/etc.).
is_git_repo_or_flattened() {
  [ -n "$1" ] || return 1
  [ -e "$1/.git" ] && return 0
  [ -d "$1/${GIT_SIDECAR_DIRNAME:-.git.real}" ] && return 0
  [ -f "$1/.git.merged" ] && return 0
  [ -f "$1/.git.real.zip" ] && return 0
  [ -f "$1/.git.zip" ] && return 0
  return 1
}

# flatten_marker_tag <path>
#   Echo the st tree tag for a path based on its flatten/archive marker:
#   'realized' (sidecar), 'merged', 'zipped' (git dir archived by 'gz'),
#   or '' (a live repo / anything else). A live '.git' always wins (so a
#   'gz -k' backup zip beside a live repo is NOT tagged zipped).
flatten_marker_tag() {
  [ -e "$1/.git" ] && return 0
  if [ -d "$1/${GIT_SIDECAR_DIRNAME:-.git.real}" ]; then
    echo realized
  elif [ -f "$1/.git.merged" ]; then
    echo merged
  elif [ -f "$1/.git.real.zip" ] || [ -f "$1/.git.zip" ]; then
    echo zipped
  fi
}

git_toplevel_of() {
  # Print the top-level of the git worktree containing $1, or empty.
  # Returns the LOGICAL (symlink-preserving) path — i.e. if $1 was
  # '/LINKS/src' (a symlink to /Users/MINE/system/global/src), the
  # output is '/LINKS/src', not the dereferenced physical path. This
  # keeps my-git's user-facing output speaking the same path the user
  # typed. Equality checks that need to dereference use pwd -P locally.
  #
  # Routed through _sm_safe_git rather than a bare 'git rev-parse': a
  # bare call here used to fail SILENTLY on "detected dubious
  # ownership" (stderr was discarded), so callers saw only a generic
  # "not inside a git repo" — the real cause was thrown away. Now the
  # dubious-ownership case is auto-fixed the same way 'sm' already
  # handles it (register the safe.directory exception, retry) when
  # SM_AUTO_SAFE_DIRECTORY=1; otherwise the real git error surfaces.
  _p=$1
  [ -d "$_p" ] || _p=${_p%/*}
  (
    cd "$_p" 2>/dev/null || exit 1
    _cdup=$(_sm_safe_git "$_p" rev-parse --show-cdup 2>/dev/null) || exit 1
    # Descend via the relative cdup — 'cd' is logical by default in
    # POSIX sh, so $PWD stays in the symlinked world.
    if [ -n "$_cdup" ]; then
      cd "$_cdup" 2>/dev/null || exit 1
    fi
    printf '%s\n' "$PWD"
  )
}

# fs_toplevel_of <dir>
#   Filesystem-only fallback for git_toplevel_of: walk UP from <dir>
#   looking for the nearest ancestor that contains a '.git' entry, using
#   a plain '[ -e ]' test (is_git_repo) — NO git command involved. This
#   finds an enclosing repo even when git's OWN detection can't, the
#   common case being a repo whose '.git' this user cannot READ (e.g. a
#   root-owned repo that a non-root user is standing inside): 'git
#   rev-parse' fails on it, but the '.git' entry is still visible on the
#   filesystem, so we can still identify the repo root and scope to it
#   (the privilege policy then decides skip/warn) instead of wandering
#   off to the whole $GIT_REPOS list. Preserves the LOGICAL path (walks
#   the string, cd is logical), same as git_toplevel_of. Prints the
#   toplevel or nothing.
fs_toplevel_of() {
  _ftp_d=$1
  [ -d "$_ftp_d" ] || _ftp_d=${_ftp_d%/*}
  # Normalise to an absolute logical path via a logical cd (no -P).
  _ftp_d=$(cd "$_ftp_d" 2>/dev/null && printf '%s' "$PWD") || return 0
  while [ -n "$_ftp_d" ] && [ "$_ftp_d" != / ]; do
    if is_git_repo "$_ftp_d"; then
      printf '%s\n' "$_ftp_d"
      return 0
    fi
    _ftp_d=${_ftp_d%/*}
  done
  is_git_repo / && printf '/\n'
  return 0
}

# ─── Submodule discovery ────────────────────────────────────────────────
# list_direct_submodules <repo>
#   Print paths (relative to $repo) of registered submodules whose worktree
#   exists at the expected location.
list_direct_submodules() {
  _r=$1
  [ -f "$_r/.gitmodules" ] || return 0
  run_as_owner_capture "$_r" git config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
    | awk '{$1=""; sub(/^ /,""); print}' \
    | while IFS= read -r _sub; do
        [ -n "$_sub" ] || continue
        [ -e "$_r/$_sub/.git" ] && printf '%s\n' "$_sub"
      done
}

# list_realized_dirs <repo>
#   Print paths (relative to $repo) of directories that contain a
#   $GIT_SIDECAR_DIRNAME (default '.git.real') — i.e. former registered
#   submodules already 'flatten -i' realized (or manually converted,
#   e.g. before this automation existed). From git's point of view
#   these are just plain tracked content; nothing to register or
#   flatten. Purely informational for 'st'.
list_realized_dirs() {
  _lrd_r=$1
  _lrd_collapse=${2:-}          # 'collapse' => keep only top-most of a nest
  [ -d "$_lrd_r" ] || return 0
  _lrd_grd=${GIT_SIDECAR_DIRNAME:-.git.real}
  trace "(cd $_lrd_r && find . -name $_lrd_grd -prune -print)   # discover sidecars"
  ( cd "$_lrd_r" 2>/dev/null || exit 0
    # PERF: prune the CONTENTS of every git-internal dir (.git, .git.merged,
    # and the sidecar dir itself) — none of them can contain a sidecar we're
    # looking for, but they hold big object databases (~37% of a real tree's
    # files live inside them), so descending in is pure waste. Verified to
    # give byte-identical results to a plain './.git'-only prune, ~3x faster.
    _pex="-path ./.git -o -name .git -o -name .git.merged"
    for _ed in ${ST_EXCLUDE_DIRS:-}; do
      _pex="$_pex -o -name $_ed"
    done
    # shellcheck disable=SC2086
    eval "find . \\( $_pex \\) -prune -o -name '$_lrd_grd' -prune -print 2>/dev/null"
  ) | sed -e 's|^\./||' -e "s|/${_lrd_grd}\$||" -e "s|^${_lrd_grd}\$||" \
    | grep -v '^$' | awk -F/ '{print NF, $0}' | sort -n -k1,1 -k2 | cut -d' ' -f2- \
    | { if [ "$_lrd_collapse" = collapse ]; then
          # Collapse-mode: keep only the TOP-MOST sidecar of each nest and
          # drop any sidecar sitting under an already-kept one. This is for
          # the 'st' tree renderer ONLY — it unions the top-level entries and
          # then recurses (walk_tree_lines) to surface deeper sidecars, so
          # listing the nested ones here too would DOUBLE them (once nested,
          # once flat at top level).
          awk '
            function is_under(arr, n, path,   i) {
              for (i = 1; i <= n; i++) { if (path == arr[i] || index(path, arr[i] "/") == 1) return 1 }
              return 0
            }
            { if (is_under(kept, nk, $0)) next; print; kept[++nk] = $0 }'
        else
          # Default: EVERY sidecar dir, deepest included. Sidecars legitimately
          # nest (src is a sidecar and so is src/sh/my-git) and consumers like
          # audit/repair, bulk unflatten and sm's sidecar pre-pass must see
          # them all — collapsing would silently skip nested sidecars.
          cat
        fi; }
}

# ensure_sidecar_exclude <repo>
#   Idempotently makes sure <repo>/.gitignore carries
#   '**/$GIT_SIDECAR_DIRNAME' whenever the checkout ACTUALLY HAS any
#   sidecar under it — not just right after this run realized one.
#   TRACKED .gitignore, not .git/info/exclude: an untracked local
#   exclude never travels with a clone, so a fresh clone (or a sidecar
#   restored onto one via a filesystem-level copy — the supported way
#   to carry its full history to a new machine, since a plain git clone
#   only brings the tracked files + .status snapshot, not the object
#   database itself) would show every .git.real as untracked clutter
#   until something re-adds the exclude by hand. A committed .gitignore
#   entry needs that done exactly once, ever, for the whole tree — no
#   self-healing logic required afterward. (.git.real.status itself
#   must stay OUT of this pattern — it's meant to be tracked.)
#   Stages + commits the change itself (its own dedicated commit,
#   my-git-caused, same convention as sm/mc's own auto-commits) when it
#   adds the entry — called from 'flatten' only (a write-capable
#   command already), not from read-only commands like 'st'.
ensure_sidecar_exclude() {
  _ese_repo=$1
  if [ ! -d "$_ese_repo/.git" ]; then
    log_dbg_med "ensure_sidecar_exclude: $_ese_repo has no .git DIRECTORY (bare/worktree/gitfile-pointer top?) — skipping tracked-.gitignore exclude"
    return 0
  fi
  _ese_grd=${GIT_SIDECAR_DIRNAME:-.git.real}
  if grep -qxF "**/$_ese_grd" "$_ese_repo/.gitignore" 2>/dev/null; then
    log_dbg_minor "ensure_sidecar_exclude: $_ese_repo already excludes **/$_ese_grd — nothing to do"
    return 0
  fi
  if [ -z "$(list_realized_dirs "$_ese_repo")" ]; then
    log_dbg_minor "ensure_sidecar_exclude: $_ese_repo has no sidecars on disk yet — not adding the exclude prematurely"
    return 0
  fi
  log_dbg_med "ensure_sidecar_exclude: $_ese_repo — adding '**/$_ese_grd' to tracked .gitignore and committing it"
  ( cd "$_ese_repo" || exit 0
    printf '**/%s\n' "$_ese_grd" >> .gitignore
    run git add -f -- .gitignore >/dev/null 2>&1
    run git commit -q -m "my-git: track **/$_ese_grd exclusion in .gitignore" -- .gitignore >/dev/null 2>&1
  )
}

# ── merge history preservation ────────────────────────────────────────
#   'flatten --merge' absorbs a nested repo's files into the parent as
#   ordinary content. It used to DELETE that repo's .git outright, so its
#   history was gone for good. It now TRANSPLANTS the whole object
#   database into the PARENT's object DB first and pins every ref under
#   $MERGED_REFS_ROOT/<path>/, which keeps the objects reachable (nothing
#   for 'git gc' to prune) and lets 'unflatten --merge' hand the history
#   back verbatim — original branch names, tags and all.
#
#   The deletion is GATED on this succeeding: preserve_merged_history
#   verifies the tip is readable from the parent afterwards, and every
#   caller must leave the nested .git alone when it returns non-zero.
#   Merge therefore never destroys anything. The ONE deliberately
#   destructive operation in my-git is 'flatten --rm-git', which deletes
#   nested .git dirs outright behind a spelled-out confirmation.
MERGED_REFS_ROOT=refs/my-git/merged

# merged_ref_ns <path>  — ref namespace holding <path>'s preserved history.
#   Git ref names forbid space ~ ^ : ? * [ \, a leading '.' in any
#   component and the sequence '..'; tree paths may legally contain those,
#   so they map to '-'. Deterministic, which is all unflatten needs to
#   find the namespace again from the same path.
merged_ref_ns() {
  printf '%s/%s\n' "$MERGED_REFS_ROOT" "$(printf '%s' "$1" \
    | sed -e 's/[^A-Za-z0-9._,+@=/-]/-/g' -e 's/\.\./-/g' -e 's|^\.|-|' -e 's|/\.|/-|g')"
}

# preserve_merged_history <parent-repo> <path> <gitdir>
#   Copy <gitdir>'s ENTIRE object database into <parent-repo>'s and pin
#   every ref under 'merged_ref_ns <path>'. Sets PRESERVED_NS,
#   PRESERVED_TIP and PRESERVED_NREFS on success.
#
#   Returns non-zero if the history did NOT demonstrably arrive — callers
#   MUST NOT delete <gitdir> in that case. Results come back in globals,
#   never on stdout: this logs, and a $(...) capture would swallow the
#   log lines into the data (the same trap documented on
#   _fl_transfer_one_sub_submodule).
preserve_merged_history() {
  _pmh_parent=$1
  _pmh_path=$2
  _pmh_gitdir=$3
  PRESERVED_NS=""
  PRESERVED_TIP=""
  PRESERVED_NREFS=0
  if [ -z "$_pmh_gitdir" ] || [ ! -e "$_pmh_gitdir" ]; then
    log_error "$_pmh_path: merge: no gitdir to preserve history from ('$_pmh_gitdir')"
    return 1
  fi
  _pmh_ns=$(merged_ref_ns "$_pmh_path")
  # A SHALLOW clone cannot be transplanted: git refuses to create refs whose
  # roots are grafted ("shallow roots are not allowed to be updated"), so the
  # objects arrive but NOTHING pins them. Refuse before touching anything and
  # say how to make it transplantable.
  if [ -f "$_pmh_gitdir/shallow" ]; then
    log_error "$_pmh_path: this is a SHALLOW clone — its history cannot be moved into another repo (git rejects refs with grafted roots, so nothing would pin the objects). Deepen it first:  git -C $_pmh_path fetch --unshallow"
    return 1
  fi
  _pmh_tip=$(git --git-dir="$_pmh_gitdir" rev-parse -q --verify HEAD 2>/dev/null)
  # A DETACHED head hangs off no ref at all, so the 'refs/*' refspec
  # below would sail straight past it. Pin it inside the doomed gitdir
  # first — this is the last moment that commit is reachable by name.
  if [ -n "$_pmh_tip" ] && ! git --git-dir="$_pmh_gitdir" symbolic-ref -q HEAD >/dev/null 2>&1; then
    log_dbg_med "preserve: $_pmh_path — HEAD is DETACHED at $_pmh_tip; pinning it as refs/my-git/detached-HEAD so the fetch below sees it"
    git --git-dir="$_pmh_gitdir" update-ref refs/my-git/detached-HEAD "$_pmh_tip" 2>/dev/null \
      || log_warn "$_pmh_path: could not pin the detached HEAD $_pmh_tip — it may not survive the merge"
  fi
  # A fetch spawns 'upload-pack' INSIDE the source gitdir, and that
  # chdir's to its core.worktree. Absorbed submodule gitdirs carry a
  # relative core.worktree ('../../../<name>') that is only valid from
  # where git normally invokes them, so upload-pack dies with "cannot
  # chdir to ..." and the transplant fails — taking a real repo's
  # history with it if the caller then deleted anyway. Unset it for the
  # duration and put it back afterwards; --file is used deliberately
  # (never 'git -C', which chdir's into that same broken path).
  _pmh_cfg="$_pmh_gitdir/config"
  _pmh_saved_wt=""
  if [ -f "$_pmh_cfg" ]; then
    _pmh_saved_wt=$(git config --file "$_pmh_cfg" --get core.worktree 2>/dev/null)
    [ -n "$_pmh_saved_wt" ] && {
      log_dbg_med "preserve: $_pmh_path — temporarily unsetting core.worktree='$_pmh_saved_wt' so upload-pack can run"
      git config --file "$_pmh_cfg" --unset core.worktree 2>/dev/null
    }
  fi
  log_dbg_med "preserve: $_pmh_path — transplanting '+refs/*:$_pmh_ns/*' from $_pmh_gitdir into $_pmh_parent"
  # 'refs/*' (not just refs/heads + refs/tags) deliberately: branches,
  # tags, remote-tracking refs, notes and any nested $MERGED_REFS_ROOT
  # from an earlier merge all come across in one go. Refs are cheap;
  # objects are shared, so the duplication costs nothing.
  ( cd "$_pmh_parent" 2>/dev/null \
    && run git fetch --no-tags -q "$_pmh_gitdir" "+refs/*:$_pmh_ns/*" )
  _pmh_rc=$?
  # Restore BEFORE reacting to the result: on failure the gitdir stays
  # on disk and must still work as the submodule it was.
  [ -n "$_pmh_saved_wt" ] && git config --file "$_pmh_cfg" core.worktree "$_pmh_saved_wt" 2>/dev/null
  if [ "$_pmh_rc" != 0 ]; then
    log_error "$_pmh_path: merge: could NOT transplant history into $_pmh_parent — leaving its .git in place (nothing deleted)"
    return 1
  fi
  # Verify rather than assume. This check is what AUTHORISES the caller to
  # delete the gitdir, so everything below reads the PARENT.
  #
  # Checking the object alone is NOT enough, and getting that wrong cost a
  # real repo: a shallow clone's objects were fetched fine while every ref
  # update was REJECTED, so 'cat-file -e' said yes, the gitdir was deleted,
  # and the objects were left unreferenced -- alive only until the next gc.
  # Refs are what make objects survive, so refs are what get verified.
  PRESERVED_NREFS=$( ( cd "$_pmh_parent" 2>/dev/null \
                       && git for-each-ref --format='%(refname)' "$_pmh_ns" 2>/dev/null ) | grep -c . )
  if [ "${PRESERVED_NREFS:-0}" -eq 0 ]; then
    log_error "$_pmh_path: merge: history transplant produced NO refs under $_pmh_ns — nothing would pin the objects, so they would be lost at the next gc. Leaving its .git in place (nothing deleted)."
    return 1
  fi
  if [ -n "$_pmh_tip" ]; then
    if ! ( cd "$_pmh_parent" 2>/dev/null && git cat-file -e "$_pmh_tip^{commit}" 2>/dev/null ); then
      log_error "$_pmh_path: merge: history transplant INCOMPLETE (tip $_pmh_tip is not readable from $_pmh_parent) — leaving its .git in place (nothing deleted)"
      return 1
    fi
    # ...and the tip must be REACHABLE from one of the refs we just pinned,
    # not merely present in the object database.
    if ! ( cd "$_pmh_parent" 2>/dev/null \
           && git merge-base --is-ancestor "$_pmh_tip" \
                "$(git for-each-ref --format='%(refname)' "$_pmh_ns" | head -n 1)" 2>/dev/null ) \
       && ! ( cd "$_pmh_parent" 2>/dev/null \
              && git for-each-ref --format='%(objectname)' "$_pmh_ns" 2>/dev/null | grep -qxF "$_pmh_tip" ); then
      log_error "$_pmh_path: merge: the tip $_pmh_tip is in $_pmh_parent but NOT reachable from any pinned ref — it would be pruned. Leaving its .git in place (nothing deleted)."
      return 1
    fi
  fi
  PRESERVED_NS=$_pmh_ns
  PRESERVED_TIP=$_pmh_tip
  log_medium "$_pmh_path: history preserved — $PRESERVED_NREFS ref(s) pinned under $_pmh_ns (tip ${_pmh_tip:-<none>})"
  return 0
}

# ensure_preserved_refspec <repo>
#   Preserved history lives OUTSIDE refs/heads, so neither a default
#   'git clone'/'git fetch' nor 'git push --all' touches it. Teach every
#   remote to carry it, so the parent stays portable: once a merge has
#   deleted a nested .git, $MERGED_REFS_ROOT is the ONLY copy of that
#   history, and a push that silently skips it is data loss on the next
#   machine. Idempotent; adds nothing until there is something to carry.
ensure_preserved_refspec() {
  _epr_repo=$1
  _epr_spec="+$MERGED_REFS_ROOT/*:$MERGED_REFS_ROOT/*"
  ( cd "$_epr_repo" 2>/dev/null || exit 0
    [ -n "$(git for-each-ref --format='%(refname)' "$MERGED_REFS_ROOT" 2>/dev/null)" ] || exit 0
    for _epr_r in $(git remote 2>/dev/null); do
      git config --get-all "remote.$_epr_r.fetch" 2>/dev/null | grep -qxF "$_epr_spec" \
        || { log_dbg_med "ensure_preserved_refspec: $_epr_repo — adding fetch refspec '$_epr_spec' to remote '$_epr_r'"
             git config --add "remote.$_epr_r.fetch" "$_epr_spec" 2>/dev/null; }
      # Setting ANY push refspec replaces git's default 'push the current
      # branch', so the heads spec has to be restated alongside ours.
      if ! git config --get-all "remote.$_epr_r.push" 2>/dev/null | grep -qxF "$_epr_spec"; then
        log_dbg_med "ensure_preserved_refspec: $_epr_repo — adding push refspecs to remote '$_epr_r'"
        git config --get-all "remote.$_epr_r.push" 2>/dev/null | grep -qxF '+refs/heads/*:refs/heads/*' \
          || git config --add "remote.$_epr_r.push" '+refs/heads/*:refs/heads/*' 2>/dev/null
        git config --add "remote.$_epr_r.push" "$_epr_spec" 2>/dev/null
      fi
    done
  )
}

# push_preserved_refs <repo>
#   'git push --all' means refs/heads/* ONLY — it does not honour a
#   configured push refspec and never carries $MERGED_REFS_ROOT. Every
#   place my-git pushes calls this straight afterwards so preserved
#   history reaches the remote too. No-op when there is none.
push_preserved_refs() {
  _ppr_repo=$1
  [ -n "$(run_as_owner_capture "$_ppr_repo" git for-each-ref --format='%(refname)' "$MERGED_REFS_ROOT" 2>/dev/null)" ] || return 0
  _ppr_remote=$(run_as_owner_capture "$_ppr_repo" git remote 2>/dev/null | grep -x origin || \
                run_as_owner_capture "$_ppr_repo" git remote 2>/dev/null | head -n 1)
  [ -n "$_ppr_remote" ] || return 0
  run_as_owner "$_ppr_repo" git push -q "$_ppr_remote" "+$MERGED_REFS_ROOT/*:$MERGED_REFS_ROOT/*" || {
    log_warn "$_ppr_repo: could not push $MERGED_REFS_ROOT/* to '$_ppr_remote' — merged history is still LOCAL-ONLY on this machine"
    return 1
  }
  log_medium "$_ppr_repo: pushed preserved merge history ($MERGED_REFS_ROOT/*) to '$_ppr_remote'"
  return 0
}

# list_merged_dirs <repo>
#   Print paths (relative to $repo) of directories carrying a
#   '.git.merged' file — a former submodule/embedded repo already
#   merged via 'flatten'/'--merge'. Its history lives on inside the
#   parent under $MERGED_REFS_ROOT (see preserve_merged_history); a
#   snapshot written before preservation existed has nothing behind it.
#   Same shape as list_realized_dirs,
#   but '.git.merged' is a plain FILE sitting directly under the path,
#   not a directory sibling — the only on-disk marker distinguishing
#   "used to be a nested repo, now merged" from "always plain content".
#
#   A LIVE .git (or sidecar) at the same path WINS: the path is a working
#   repo again and the .git.merged is a stale leftover — from an
#   'unflatten' that could not remove it, or a repo restored by hand from
#   a backup. Reporting such a path as [merged] is actively misleading:
#   'st' would hide a live repo's real state, and flatten/unflatten would
#   both try to act on it. Live artifact beats stale marker, always.
list_merged_dirs() {
  _lmd_r=$1
  [ -d "$_lmd_r" ] || return 0
  trace "(cd $_lmd_r && find . -name .git.merged -print)   # discover merged paths"
  ( cd "$_lmd_r" 2>/dev/null || exit 0
    # PERF: prune git-internal dir contents (see list_realized_dirs).
    _pex="-path ./.git -o -name .git -o -name ${GIT_SIDECAR_DIRNAME:-.git.real}"
    for _ed in ${ST_EXCLUDE_DIRS:-}; do
      _pex="$_pex -o -name $_ed"
    done
    # shellcheck disable=SC2086
    eval "find . \\( $_pex \\) -prune -o -name '.git.merged' -prune -print 2>/dev/null"
  ) | sed -e 's|^\./||' -e 's|/\.git\.merged$||' -e 's|^\.git\.merged$||' \
    | grep -v '^$' \
    | while IFS= read -r _lmd_p; do
        [ -n "$_lmd_p" ] || continue
        if [ -e "$_lmd_r/$_lmd_p/.git" ] || [ -e "$_lmd_r/$_lmd_p/${GIT_SIDECAR_DIRNAME:-.git.real}" ]; then
          log_dbg_med "list_merged_dirs: $_lmd_p has a LIVE .git/sidecar — treating its .git.merged as a stale leftover, not reporting it as merged"
          continue
        fi
        printf '%s\n' "$_lmd_p"
      done
}

# list_zipped_dirs <repo>
#   Print paths (relative to $repo) of directories whose git dir has been
#   ARCHIVED by the 'gz' shell helper — i.e. they carry a '.git.zip' (a
#   zipped plain '.git') or '.git.real.zip' (a zipped sidecar) FILE, and
#   no live '.git'/'.git.real' alongside. The worktree files are still on
#   disk; only the history is currently zipped up (restore with 'gu').
#   Same shape as list_merged_dirs. A dir that ALSO still has a live
#   '.git'/'.git.real' (e.g. 'gz -k' kept the original) is NOT reported —
#   it is still a normal live/sidecar repo, the zip is just a backup.
list_zipped_dirs() {
  _lzd_r=$1
  [ -d "$_lzd_r" ] || return 0
  _lzd_grd=${GIT_SIDECAR_DIRNAME:-.git.real}
  trace "(cd $_lzd_r && find . \\( -name .git.zip -o -name $_lzd_grd.zip \\) -print)   # discover zipped git dirs"
  ( cd "$_lzd_r" 2>/dev/null || exit 0
    # PERF: prune git-internal dir contents (see list_realized_dirs).
    _pex="-path ./.git -o -name .git -o -name $_lzd_grd -o -name .git.merged"
    for _ed in ${ST_EXCLUDE_DIRS:-}; do
      _pex="$_pex -o -name $_ed"
    done
    # shellcheck disable=SC2086
    eval "find . \\( $_pex \\) -prune -o \\( -name .git.zip -o -name .git.real.zip \\) -print 2>/dev/null"
  ) | sed -e 's|^\./||' -e 's|/\.git\.real\.zip$||' -e 's|/\.git\.zip$||' \
        -e 's|^\.git\.real\.zip$||' -e 's|^\.git\.zip$||' \
    | grep -v '^$' | sort -u | while IFS= read -r _lzd_d; do
        # Skip a dir that still has a LIVE git dir next to the zip (gz -k):
        # it is a working repo, not an archived one.
        [ -e "$_lzd_r/$_lzd_d/.git" ] && continue
        [ -d "$_lzd_r/$_lzd_d/$_lzd_grd" ] && continue
        printf '%s\n' "$_lzd_d"
      done
}

# list_shadowed_dirs <repo>
#   Print paths (relative to $repo) of directories that are SHADOWED — they
#   carry a '.git.shadow.status' marker file (written by 'shadow') AND still
#   have a live '.git' alongside. Shadow is a content-mirror: the nested repo
#   keeps its LIVE .git (IDE works) while the parent ALSO tracks its files, so
#   the live .git is what distinguishes it from a sidecar/merged/zipped path.
#   Same discovery shape as list_merged_dirs. A stray marker without a live
#   .git (e.g. the repo was later flattened) is NOT reported as shadowed.
# list_shadow_markers <repo>
#   Every path under <repo> carrying a .git.shadow.status, WHETHER OR NOT a
#   live .git sits beside it.
#
#   list_shadowed_dirs deliberately requires the live .git -- a marker alone
#   does not make a repo shadowed, and every other command wants that test.
#   'rehydrate' is the exception: a marker with NO .git beside it is exactly
#   what it exists to fix, so filtering those out left it reporting "nothing
#   to do" on a fresh clone where all 25 needed doing.
list_shadow_markers() {
  _lsm_r=$1
  [ -d "$_lsm_r" ] || return 0
  ( cd "$_lsm_r" 2>/dev/null || exit 0
    _pex="-path ./.git -o -name ${GIT_SIDECAR_DIRNAME:-.git.real} -o -name .git.merged"
    for _ed in ${ST_EXCLUDE_DIRS:-}; do
      _pex="$_pex -o -name $_ed"
    done
    # shellcheck disable=SC2086
    eval "find . \\( $_pex \\) -prune -o -name '.git.shadow.status' -print 2>/dev/null"
  ) | sed -e 's|^\./||' -e 's|/\.git\.shadow\.status$||' -e 's|^\.git\.shadow\.status$||' \
    | grep -v '^$' | sort -u
}

list_shadowed_dirs() {
  _lsh_r=$1
  [ -d "$_lsh_r" ] || return 0
  trace "(cd $_lsh_r && find . -name .git.shadow.status -print)   # discover shadowed repos"
  ( cd "$_lsh_r" 2>/dev/null || exit 0
    # PERF: prune git-internal dir contents (see list_realized_dirs).
    _pex="-path ./.git -o -name .git -o -name ${GIT_SIDECAR_DIRNAME:-.git.real} -o -name .git.merged"
    for _ed in ${ST_EXCLUDE_DIRS:-}; do
      _pex="$_pex -o -name $_ed"
    done
    # shellcheck disable=SC2086
    eval "find . \\( $_pex \\) -prune -o -name '.git.shadow.status' -prune -print 2>/dev/null"
  ) | sed -e 's|^\./||' -e 's|/\.git\.shadow\.status$||' -e 's|^\.git\.shadow\.status$||' \
    | grep -v '^$' | sort -u | while IFS= read -r _lsh_d; do
        # A marker only means "shadowed" while a LIVE .git sits beside it.
        [ -e "$_lsh_r/$_lsh_d/.git" ] || continue
        printf '%s\n' "$_lsh_d"
      done
}

# _zip_gitdir <path> <keep 0|1>
#   POSIX port of the 'gz' shell helper (my-git must not depend on any zsh
#   function/alias). Archive <path>'s git dir into a .zip beside it, then —
#   unless keep=1 — remove the live dir. Handles a plain '.git' -> '.git.zip'
#   and a sidecar '$GIT_SIDECAR_DIRNAME' -> '$GIT_SIDECAR_DIRNAME.zip' (folding
#   in a sibling '.status' snapshot). TRACKED worktree dotfiles (.gitignore,
#   .gitmodules, …) are always left in place. Verifies the archive
#   ('unzip -t') before deleting anything; on failure the partial zip is
#   removed and nothing is lost. Uses the real 'zip'/'unzip' binaries.
_zip_gitdir() {
  _zg_p=$1; _zg_keep=${2:-0}
  _zg_grd=${GIT_SIDECAR_DIRNAME:-.git.real}
  if [ -d "$_zg_p/.git" ]; then
    _zg_src=.git; _zg_zip=.git.zip; _zg_extra=""
  elif [ -d "$_zg_p/$_zg_grd" ]; then
    _zg_src=$_zg_grd; _zg_zip="$_zg_grd.zip"; _zg_extra=""
    [ -e "$_zg_p/$_zg_grd.status" ] && _zg_extra="$_zg_grd.status"
  else
    log_error "zip: $_zg_p: no .git or $_zg_grd directory to archive"
    return 1
  fi
  if [ -e "$_zg_p/$_zg_zip" ]; then
    log_error "zip: $_zg_p/$_zg_zip already exists — not overwriting"
    return 1
  fi
  log_dbg_med "zip: $_zg_p: archiving $_zg_src${_zg_extra:+ + $_zg_extra} -> $_zg_zip (keep=$_zg_keep)"
  ( cd "$_zg_p" || exit 1
    # shellcheck disable=SC2086
    if run zip -qr "$_zg_zip" "$_zg_src" $_zg_extra && run unzip -tqq "$_zg_zip"; then
      if [ "$_zg_keep" != 1 ]; then
        # shellcheck disable=SC2086
        run rm -rf "$_zg_src" $_zg_extra
      fi
    else
      log_error "zip: $_zg_p: zip failed (archive left untouched, originals kept)"
      rm -f "$_zg_zip"
      exit 1
    fi
  ) || return 1
  return 0
}

# _unzip_gitdir <path> <keep 0|1>
#   POSIX port of the 'gu' shell helper. Restore <path>'s archived git dir
#   from '.git.zip' or '$GIT_SIDECAR_DIRNAME.zip', then — unless keep=1 —
#   remove the .zip. Refuses to overwrite an existing live '.git'/sidecar.
_unzip_gitdir() {
  _ug_p=$1; _ug_keep=${2:-0}
  _ug_grd=${GIT_SIDECAR_DIRNAME:-.git.real}
  if [ -f "$_ug_p/$_ug_grd.zip" ]; then
    _ug_zip="$_ug_grd.zip"; _ug_restored=$_ug_grd
  elif [ -f "$_ug_p/.git.zip" ]; then
    _ug_zip=.git.zip; _ug_restored=.git
  else
    log_error "unzip: $_ug_p: no .git.zip or $_ug_grd.zip to restore"
    return 1
  fi
  if [ -e "$_ug_p/$_ug_restored" ]; then
    log_error "unzip: $_ug_p/$_ug_restored already exists — refusing to overwrite"
    return 1
  fi
  log_dbg_med "unzip: $_ug_p: restoring $_ug_restored from $_ug_zip (keep=$_ug_keep)"
  ( cd "$_ug_p" || exit 1
    if run unzip -q "$_ug_zip"; then
      [ "$_ug_keep" = 1 ] || run rm -f "$_ug_zip"
    else
      log_error "unzip: $_ug_p: unzip failed"
      exit 1
    fi
  ) || return 1
  return 0
}

# list_unregistered_nested <repo>
#   Print paths (relative to $repo) of DIRECT nested git repos that are NOT
#   registered in $repo/.gitmodules — i.e. embedded/unregistered repos. Skips
#   descendants of registered submodules (those are that sub's concern) and
#   any repo marked with .git/my-git.ignore (see 'sm' subcommand).
#   Also skips descendants of REALIZED directories (list_realized_dirs) —
#   a realized dir has no .git of its own, so a further-nested .git inside
#   it would otherwise surface here as a flat, mis-leveled path instead of
#   nested under the realized dir's own tree row.
#   Also dedupes: if an unregistered repo contains another nested repo, only
#   the shallower one is returned (descent into it happens via walk_tree_lines).
list_unregistered_nested() {
  _r=$1
  [ -d "$_r" ] || return 0
  _regtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.reg.XXXXXX")
  # No .gitmodules, no registrations -- and asking git anyway is not free:
  # as root this call is launchctl + sudo + git, three processes per repo,
  # to read a file that is absent in every repo of a tree with no
  # submodules. A file test answers it without forking at all.
  if [ -f "$_r/.gitmodules" ]; then
    run_as_owner_capture "$_r" git config -f .gitmodules \
      --get-regexp '^submodule\..*\.path$' 2>/dev/null \
      | awk '{$1=""; sub(/^ /,""); print}' > "$_regtmp" 2>/dev/null || : > "$_regtmp"
  else
    : > "$_regtmp"
  fi
  _realtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.real.XXXXXX")
  list_realized_dirs "$_r" > "$_realtmp" 2>/dev/null || : > "$_realtmp"
  trace "(cd $_r && find . -name .git -print)   # discover UNREGISTERED nested repos"
  ( cd "$_r" 2>/dev/null || exit 0
    # Prune:
    #   - './.git' (the scope root itself — we only want NESTED repos)
    #   - every basename in ST_EXCLUDE_DIRS (cache/build roots that
    #     otherwise contain thousands of cloned .git dirs and make a
    #     walk from ~/ take 30+ seconds).
    # IMPORTANT: use the root-repo exclusion as a -path, and cache
    # names as -name (match at any depth). Do NOT use -mindepth here:
    # -mindepth is a global filter applied before -prune, which means
    # any directory shallower than the mindepth is NEVER examined for
    # pruning and find happily descends into it.
    # PERF: prune the CONTENTS of found nested repos and sidecar/merged
    # markers (a .git we've found needs no descent — nested repos are its
    # siblings/worktree descendants, found separately; .git.real/.git.merged
    # hold object DBs, never a nested repo). '-name .git -prune -print'
    # still PRINTS every nested .git while skipping its internals. Verified
    # byte-identical to the old './.git'-only prune, ~3x faster on big trees.
    _pex="-path ./.git -o -name ${GIT_SIDECAR_DIRNAME:-.git.real} -o -name .git.merged"
    for _ed in ${ST_EXCLUDE_DIRS:-}; do
      _pex="$_pex -o -name $_ed"
    done
    # shellcheck disable=SC2086
    eval "find . \\( $_pex \\) -prune -o -name .git -prune -print 2>/dev/null"
  ) | sed -e 's|^\./||' -e 's|/\.git$||' \
    | awk -F/ '{print NF, $0}' | sort -n -k1,1 -k2 | cut -d' ' -f2- \
    | awk -v reg="$_regtmp" -v real="$_realtmp" '
      # Sorted by DEPTH first (shallowest paths first), not plain
      # lexicographic order — a plain sort would put e.g. "src/,foo"
      # before "src" itself (","=0x2C sorts below "."=0x2E), so a
      # shallow embedded repo boundary like "src" would never get the
      # chance to suppress its own deeper contents. Depth-first order
      # guarantees every path is checked only after any shallower
      # ancestor of it has already been classified.
      function is_under(arr, n, path,   i) {
        for (i = 1; i <= n; i++) {
          if (path == arr[i] || index(path, arr[i] "/") == 1) return 1
        }
        return 0
      }
      BEGIN {
        nr = 0
        while ((getline r < reg) > 0) if (r != "") registered[++nr] = r
        nz = 0
        while ((getline z < real) > 0) if (z != "") realized[++nz] = z
        nk = 0
      }
      {
        if (is_under(registered, nr, $0)) next
        if (is_under(realized, nz, $0)) next
        # Also suppressed by ANY shallower match already kept — not
        # just the immediately-preceding line — since depth-sorted
        # order can still interleave unrelated top-level entries.
        if (is_under(kept, nk, $0)) next
        print
        kept[++nk] = $0
      }' | while IFS= read -r _sub; do
    [ -n "$_sub" ] || continue
    printf '%s\n' "$_sub"
  done
  rm -f "$_regtmp" "$_realtmp"
}

# list_stale_submodules <repo>
#   Print paths (relative to $repo) of entries registered in $repo/.gitmodules
#   whose on-disk path doesn't exist (no .git file or dir at that path).
#   These are phantom registrations the user should clean up via 'sm go'.
list_stale_submodules() {
  _lsr_r=$1
  [ -d "$_lsr_r" ] || return 0
  [ -f "$_lsr_r/.gitmodules" ] || return 0
  # Collected once so each entry can be tested against the others below.
  _lsr_others=$(run_as_owner_capture "$_lsr_r" git config -f .gitmodules \
                  --get-regexp '^submodule\..*\.path$' 2>/dev/null \
                  | awk '{$1=""; sub(/^ /,""); print}')
  run_as_owner_capture "$_lsr_r" git config -f .gitmodules \
    --get-regexp '^submodule\..*\.path$' 2>/dev/null \
    | awk '{$1=""; sub(/^ /,""); print}' \
    | while IFS= read -r _p; do
        [ -n "$_p" ] || continue
        # Present on disk as a live repo (.git) OR a sidecar
        # (GIT_SIDECAR_DIRNAME) → NOT stale. A registered submodule that
        # was later sidecared still EXISTS (as a sidecar); treating it as
        # "no directory on disk" wrongly deregistered it.
        # An entry for a path that lives INSIDE another registered submodule
        # is dead too, even though the directory is right there: that path
        # belongs to the inner submodule's worktree, so git will never treat
        # this repo's entry as meaningful. Seen for real after src became a
        # submodule -- global kept an entry for a path now owned by src, and
        # --clean-stale reported "no stale registrations found".
        _lsr_inner=""
        for _lsr_o in $_lsr_others; do
          [ "$_lsr_o" = "$_p" ] && continue
          case "$_p" in "$_lsr_o"/*) _lsr_inner=$_lsr_o; break ;; esac
        done
        if [ -n "$_lsr_inner" ]; then
          printf '%s\n' "$_p"
          continue
        fi
        [ -e "$_lsr_r/$_p/.git" ] && continue
        [ -e "$_lsr_r/$_p/${GIT_SIDECAR_DIRNAME:-.git.real}" ] && continue
        printf '%s\n' "$_p"
      done
}

# list_live_repos_tree <root>
#   Absolute paths of <root> and EVERY live repo below it, parents before
#   children. This is the set 'st' displays, which is the set the user means
#   by "the tree": registered submodules and plain nested repos alike, plus
#   shadowed ones (they keep a live .git and are not submodules).
#
#   Not walk_submodules: that walks .gitmodules, so on a tree with no
#   submodules it returns the root and nothing else. That is why 'pull -R'
#   reported total=1 on a tree where 'st' showed 42.
#
#   Repos carrying the my-git.ignore marker are skipped along with anything
#   below them -- ignoring a repo means leaving it alone, not descending
#   through it. [merged] paths have no .git and never appear.
list_live_repos_tree() {
  _llr_q=$(mktemp "${TMPDIR:-/tmp}/${US}.llrq.XXXXXX") || return 1
  _llr_k=$(mktemp "${TMPDIR:-/tmp}/${US}.llrk.XXXXXX") || { rm -f "$_llr_q"; return 1; }
  printf '%s\n' "$1" > "$_llr_q"
  # A worklist, not recursion, and fd 9 rather than stdin. Both matter: the
  # discovery helpers run git through run_as_owner_capture -- su/sudo --
  # which READ STDIN, so a "| while read" walk loses every remaining entry
  # the moment it visits a repo owned by someone else. That failed silently:
  # 3 repos reported on a tree of 42, presented as a clean result.
  while [ -s "$_llr_q" ]; do
    _llr_cur=$(head -n 1 "$_llr_q")
    sed '1d' "$_llr_q" > "$_llr_q.t" 2>/dev/null && mv -f "$_llr_q.t" "$_llr_q"
    [ -n "$_llr_cur" ] || continue
    printf '%s\n' "$_llr_cur"
    { list_direct_submodules "$_llr_cur" 2>/dev/null
      list_unregistered_nested "$_llr_cur" 2>/dev/null
    } | sort -u > "$_llr_k"
    while IFS= read -r _llr_c <&9; do
      [ -n "$_llr_c" ] || continue
      [ -e "$_llr_cur/$_llr_c/.git" ] || continue
      is_nested_ignored "$_llr_cur" "$_llr_c" && continue
      # Queued rather than descended into here: list_unregistered_nested
      # collapses to the TOP-MOST repo of any chain (st's de-dup), so a repo
      # inside a nested repo is only reachable by asking THAT repo about its
      # own children.
      printf '%s\n' "$_llr_cur/$_llr_c" >> "$_llr_q"
    done 9< "$_llr_k"
  done
  rm -f "$_llr_q" "$_llr_q.t" "$_llr_k"
}

# select_tree_nodes <root> <sm 0|1> <shadowed 0|1>
#   The node list the tree-wide verbs (pull, push, mc) operate on. Default
#   is every live repo -- the set 'st' shows. The two filters narrow it:
#     --sm  the SUBMODULE tree only, git's own idea of nesting
#     --sh  the SHADOWED repos only (the ones with their own upstream)
#   Absolute paths, parents first; callers that need children first reverse.
select_tree_nodes() {
  _stn_r=$1; _stn_sm=${2:-0}; _stn_sh=${3:-0}
  if [ "$_stn_sm" = 1 ]; then
    # walk_submodules is post-order; reverse for parents-first.
    walk_submodules "$_stn_r" | awk '{a[NR]=$0} END{for(i=NR;i>=1;i--) print a[i]}'
  elif [ "$_stn_sh" = 1 ]; then
    # Every marker below <root>, at any depth -- list_shadowed_dirs already
    # finds nested ones and only reports those with a live .git.
    list_shadowed_dirs "$_stn_r" 2>/dev/null | while IFS= read -r _stn_d; do
      [ -n "$_stn_d" ] && printf '%s/%s\n' "$_stn_r" "$_stn_d"
    done
  else
    list_live_repos_tree "$_stn_r"
  fi
}

# _gated_subtree_hint <root>
#   The cross-user gate is per REPO, but skipping a root skips everything
#   below it -- so a user who owns src but not the global root above it sees
#   "nothing to do" for a tree of 26 repos that are entirely theirs. Until
#   the gate descends instead of aborting, at least say where the work went.
_gated_subtree_hint() {
  _gsh_r=$1
  printf '    > repos BELOW it are skipped too, even ones you own.\n'
  { list_direct_submodules "$_gsh_r" 2>/dev/null
    list_unregistered_nested "$_gsh_r" 2>/dev/null
  } | sort -u | while IFS= read -r _gsh_c; do
        [ -n "$_gsh_c" ] || continue
        [ -e "$_gsh_r/$_gsh_c/.git" ] || continue
        printf '    > run it there instead:  (cd %s/%s && %s%s ...)\n' \
          "$_gsh_r" "$_gsh_c" "$(_owner_cmd_prefix "$_gsh_r/$_gsh_c")" "$US"
      done
  printf '    > or as the owner:  sudo %s ...\n' "$US"
}

# is_nested_ignored <repo> <sub>
#   Return 0 if $repo/$sub has the my-git.ignore marker.
is_nested_ignored() {
  _ini_r=$1; _ini_sub=$2
  _ini_gd=$(_sm_resolve_gitdir "$_ini_r/$_ini_sub/.git" "$_ini_r/$_ini_sub")
  [ -e "$_ini_gd/$_sm_IGNORE_MARKER" ]
}

# find_cross_submodule_unregistered <repo>
#   Walk every REGISTERED submodule under <repo> and list unregistered
#   non-ignored nested git repos found inside them. These cannot be
#   registered from <repo> (they belong to their parent submodule); we list
#   them so 'sm' can tell the user where to run the actual registration.
#   Output: TAB-separated "<parent-submodule-abs-path>\t<unregistered-sub-rel-to-parent>".
find_cross_submodule_unregistered() {
  _fcu_r=$1
  [ -d "$_fcu_r" ] || return 0
  walk_submodules "$_fcu_r" | while IFS= read -r _fcu_node; do
    [ -n "$_fcu_node" ] || continue
    # Skip the root itself — sm already analyzed it directly.
    [ "$_fcu_node" = "$_fcu_r" ] && continue
    list_unregistered_nested "$_fcu_node" | while IFS= read -r _fcu_sub; do
      [ -n "$_fcu_sub" ] || continue
      is_nested_ignored "$_fcu_node" "$_fcu_sub" && continue
      printf '%s\t%s\n' "$_fcu_node" "$_fcu_sub"
    done
  done
}

# walk_submodules <repo>
#   Post-order DFS: prints absolute worktree paths, deepest first, root last.
# Defined as a subshell function (using '( )' not '{ }') so every recursive
# invocation runs in its own scope — otherwise _root/_subs/_sub leak across
# calls (POSIX sh has no 'local'), producing bogus concatenated paths.
walk_submodules() (
  _root=$1
  log_dbg_minor "walk_submodules: $_root"
  _subs=$(list_direct_submodules "$_root")
  if [ -n "$_subs" ]; then
    printf '%s\n' "$_subs" | while IFS= read -r _sub; do
      [ -n "$_sub" ] || continue
      walk_submodules "$_root/$_sub"
    done
  fi
  printf '%s\n' "$_root"
)

# depth_of <root> <node>  — relative depth (# of path components past root)
depth_of() {
  _root=$1; _node=$2
  _rel=${_node#"$_root"}
  _rel=${_rel#/}
  [ -z "$_rel" ] && { echo 0; return; }
  printf '%s\n' "$_rel" | awk -F/ '{print NF}'
}

indent_for() {
  # Print $1 * 3 spaces.
  _n=$1
  _i=0
  while [ "$_i" -lt "$_n" ]; do printf '   '; _i=$((_i + 1)); done
}

# ─── Scope resolution ───────────────────────────────────────────────────
# Echoes newline-separated list of super-repo roots to operate on.
# _logical_path <abs>
#   Map a physically-resolved path back to the logical name it is configured
#   and typed as: /Users/MINE/system/global/src -> /LINKS/global/src.
#
#   Normally $PWD carries the logical form, because 'cd' maintains it. Under
#   sudo it does not: sudo scrubs PWD from the environment, so the shell
#   recomputes it with getcwd() -- which returns the physical path -- and
#   the name the user actually typed is gone before my-git ever runs. Every
#   row then prints /Users/MINE/... for a tree the user knows as /LINKS/... .
_logical_path() {
  _lp_p=$1
  for _lp_r in ${GIT_REPOS:-}; do
    [ -d "$_lp_r" ] || continue
    _lp_real=$(cd "$_lp_r" 2>/dev/null && pwd -P) || continue
    { [ -n "$_lp_real" ] && [ "$_lp_real" != "$_lp_r" ]; } || continue
    case "$_lp_p" in
      "$_lp_real")   printf '%s' "$_lp_r"; return 0 ;;
      "$_lp_real"/*) printf '%s%s' "$_lp_r" "${_lp_p#"$_lp_real"}"; return 0 ;;
    esac
  done
  printf '%s' "$_lp_p"
}

resolve_scope() {
  # Returns LOGICAL (symlink-preserving) absolute paths — see git_toplevel_of.
  # If explicit paths passed, use them.
  if [ $# -gt 0 ]; then
    for _p in "$@"; do
      _abs=$(cd "$_p" 2>/dev/null && printf '%s' "$PWD") || { log_error "not a directory: $_p"; return 1; }
      # Accept a live repo, a sidecar, OR a merged path — so 'st <path>'
      # / 'rem <path>' work on a flattened path too, not just a plain .git.
      if ! is_git_repo_or_flattened "$_abs"; then
        log_error "not a git repo / sidecar / merged path: $_abs"
        return 1
      fi
      printf '%s\n' "$(_logical_path "$_abs")"
    done
    return 0
  fi
  # No args: try CWD via git's own detection first.
  _top=$(git_toplevel_of "$PWD")
  if [ -n "$_top" ]; then
    _top=$(_logical_path "$_top")
    log_dbg_med "scope: CWD-inferred $_top"
    printf '%s\n' "$_top"
    return 0
  fi
  # git couldn't resolve a toplevel (most often: an enclosing repo whose
  # .git this user can't READ — e.g. root-owned, run as non-root). Before
  # wandering off to the whole $GIT_REPOS list, do a filesystem walk-up:
  # if we ARE standing inside a repo, scope to it and let the privilege
  # policy decide skip/warn — don't silently widen scope to unrelated
  # trees just because we couldn't read this one's .git.
  _top=$(fs_toplevel_of "$PWD")
  if [ -n "$_top" ]; then
    _top=$(_logical_path "$_top")
    log_dbg_med "scope: CWD-inferred via filesystem walk-up (git could not read .git here): $_top"
    printf '%s\n' "$_top"
    return 0
  fi
  # Fallback to GIT_REPOS list — only when genuinely not inside any repo.
  log_dbg_med "scope: config fallback \$GIT_REPOS"
  for _r in $GIT_REPOS; do
    [ -d "$_r" ] || { log_warn "skipping missing repo from GIT_REPOS: $_r"; continue; }
    is_git_repo "$_r" || { log_warn "skipping non-git path from GIT_REPOS: $_r"; continue; }
    # Logical path: preserve the form written in GIT_REPOS (e.g. /LINKS/src).
    _abs=$(cd "$_r" 2>/dev/null && printf '%s' "$PWD")
    printf '%s\n' "$_abs"
  done
}

# ─── Status subcommand ──────────────────────────────────────────────────
# walk_tree_lines <abs_path> <display> <branch_prefix> <child_prefix> <tag>
#   Pre-order DFS emitting one TAB-separated line per node:
#     <branch_prefix>\t<abs_path>\t<display>\t<tag>
#   <branch_prefix> : box-drawing prefix printed before the display name.
#   <tag>           : "" for root, "reg" for registered submodule,
#                     "unreg" for embedded/unregistered nested git repo,
#                     "unreg-ign" for unregistered repo carrying the ignore
#                     marker (not descended — shown as leaf),
#                     "reg-ign" for the rare conflict state (registered AND
#                     marked ignore),
#                     "stale" for a .gitmodules entry with no directory on
#                     disk (shown as leaf; can't be descended).
#   Does NOT descend into repos that cross-user policy says we can't read.
walk_tree_lines() (
  _root=$1; _display=$2; _pfx=$3; _cpfx=$4; _tag=$5
  # Emit 3 TAB-sep fields: <pfx+display>\t<abs>\t<tag>. Combining pfx
  # and display up-front avoids POSIX 'read' eating a leading empty
  # field when _pfx is "" (read treats TAB as IFS-whitespace and
  # strips leading whitespace; so the root, with _pfx="", would have
  # its display shifted into the pfx slot downstream).
  printf '%s%s\t%s\t%s\n' "$_pfx" "$_display" "$_root" "$_tag"
  _action=$(check_priv "$_root")
  [ "$_action" = "exec" ] || return 0
  # Don't descend into a subtree marked as ignored (opt-out) or stale
  # (there's no directory on disk to descend into).
  case "$_tag" in
    *ign|stale) return 0 ;;
  esac
  _subs_reg=$(list_direct_submodules "$_root")
  # Sidecars (GIT_SIDECAR_DIRNAME) and merged paths (.git.merged) are
  # my-git's OWN markers and the whole point of the overview — so they're
  # ALWAYS discovered, even in a FOREIGN scope (a git repo not in
  # $GIT_REPOS, e.g. one you just cd'd into). Otherwise you'd stand
  # inside a tree full of sidecars and 'st' would show none of them.
  # Arbitrary UNREGISTERED nested repos, by contrast, are only
  # auto-discovered for MANAGED scopes (in $GIT_REPOS or a descendant) or
  # with -R — that walk can surface a lot of unrelated nested clones in a
  # big foreign tree, so it stays opt-in. Registered submodules are
  # always shown. (sm calls list_unregistered_nested directly and is NOT
  # gated by these flags — discovery IS sm's purpose.)
  _subs_realized=$(list_realized_dirs "$_root")
  _subs_merged=$(list_merged_dirs "$_root")
  _subs_zipped=$(list_zipped_dirs "$_root")
  # Shadowed dirs (content-mirror: live .git + '.git.shadow.status') are ALSO
  # my-git's own marker and always worth surfacing, like sidecars/merged/zipped.
  _subs_shadowed=$(list_shadowed_dirs "$_root")
  # realized / merged / zipped are all found by recursive find and CAN nest
  # inside one another (a sidecar's worktree can hold a merged or zipped repo,
  # you can 'gz' a sidecar that lives inside another sidecar, etc.). The
  # renderer unions TOP-LEVEL entries and RECURSES to surface deeper markers,
  # so keep only the top-most of each nest here — otherwise a deeper marker
  # shows up twice (once nested, once flat at the top). One collapse over all
  # three types also covers cross-type nesting (e.g. a zipped repo under a
  # sidecar), which a per-type collapse would miss.
  _markers=$(printf '%s\n%s\n%s\n' "$_subs_realized" "$_subs_merged" "$_subs_zipped" \
    | grep -v '^$' | awk -F/ '{print NF, $0}' | sort -n -k1,1 -k2 | cut -d' ' -f2- \
    | awk 'function is_under(a, n, p,   i) { for (i=1;i<=n;i++) if (p==a[i] || index(p, a[i] "/")==1) return 1; return 0 }
           { if (is_under(kept, nk, $0)) next; print; kept[++nk]=$0 }')
  if [ "${SCOPE_MANAGED:-1}" = 1 ] || [ "${RECURSIVE:-0}" = 1 ]; then
    _subs_unreg=$(list_unregistered_nested "$_root")
  else
    _subs_unreg=""
  fi
  _subs_stale=$(list_stale_submodules "$_root")
  # Shadowed dirs have a live .git, so a MANAGED scope already finds them via
  # _subs_unreg — but they're a my-git marker, so union them in explicitly to
  # surface them in a FOREIGN scope too (like sidecars/merged/zipped).
  _all=$(printf '%s\n%s\n%s\n%s\n%s\n' "$_subs_reg" "$_subs_unreg" "$_subs_stale" "$_markers" "$_subs_shadowed" | grep -v '^$' | sort -u)
  # Collapse the FULL set to top-most (same rule as _markers above, now applied
  # over everything): a nested repo — e.g. a [shadowed] one under a [merged]
  # parent, or a [zipped] one under a [shadowed] parent — is surfaced by
  # RECURSION into that parent, so it must NOT also appear flat at this level.
  # list_shadowed_dirs (recursive) and list_unregistered_nested (descending
  # through merged content that has no .git boundary) return such deep paths,
  # which previously double-listed: once nested, once flat at the top.
  _all=$(printf '%s\n' "$_all" | grep -v '^$' | awk -F/ '{print NF, $0}' | sort -n -k1,1 -k2 | cut -d' ' -f2- \
    | awk 'function is_under(a, n, p,   i) { for (i=1;i<=n;i++) if (p==a[i] || index(p, a[i] "/")==1) return 1; return 0 }
           { if (is_under(kept, nk, $0)) next; print; kept[++nk]=$0 }')
  [ -z "$_all" ] && return 0
  _total=$(printf '%s\n' "$_all" | grep -c .)
  _i=0
  printf '%s\n' "$_all" | while IFS= read -r _sub; do
    [ -n "$_sub" ] || continue
    _i=$((_i + 1))
    if [ "$_i" -eq "$_total" ]; then
      _my_pfx="${_cpfx}└── "
      _my_cpfx="${_cpfx}    "
    else
      _my_pfx="${_cpfx}├── "
      _my_cpfx="${_cpfx}│   "
    fi
    # Classification precedence: stale beats reg/unreg (no dir on disk means
    # we can't do anything else with it). realized beats unreg (a realized
    # dir has no .git of its own, so it would otherwise fall through to
    # unreg by default — but it's neither registered nor a plain embedded
    # repo, so it gets its own tag). Otherwise reg vs unreg by membership.
    if printf '%s\n' "$_subs_stale" | grep -qxF "$_sub"; then
      _ntag=stale
    elif printf '%s\n' "$_subs_reg" | grep -qxF "$_sub"; then
      _ntag=reg
    elif printf '%s\n' "$_subs_realized" | grep -qxF "$_sub"; then
      _ntag=realized
    elif printf '%s\n' "$_subs_merged" | grep -qxF "$_sub"; then
      _ntag=merged
    elif printf '%s\n' "$_subs_zipped" | grep -qxF "$_sub"; then
      _ntag=zipped
    elif printf '%s\n' "$_subs_shadowed" | grep -qxF "$_sub"; then
      # A shadowed dir has a live .git (would otherwise read as unreg) — its
      # '.git.shadow.status' marker gives it its own tag instead.
      _ntag=shadowed
    else
      _ntag=unreg
    fi
    if [ "$_ntag" != stale ] && [ "$_ntag" != realized ] && [ "$_ntag" != merged ] && [ "$_ntag" != zipped ] && [ "$_ntag" != shadowed ] && is_nested_ignored "$_root" "$_sub"; then
      _ntag="${_ntag}-ign"
    fi
    walk_tree_lines "$_root/$_sub" "$_sub" "$_my_pfx" "$_my_cpfx" "$_ntag"
  done
)

# repo_is_local_only <repo>
#   Exit 0 (true) if the repo has NO remote configured at all — i.e. it's
#   local-only, with no URL to publish to (case 2 "private" in the
#   three-cases model), as opposed to a repo WITH a remote (case 3
#   "published"). Used to render the ⌂ flag column in 'st'. Filesystem/
#   git-config only; no network. Returns 1 (false) on any repo that has
#   at least one remote, or that can't be read.
repo_is_local_only() {
  _rlo_r=$1
  _rlo_grd=${GIT_SIDECAR_DIRNAME:-.git.real}
  # Read 'git remote' from the RIGHT git dir: a live '.git', a sidecar
  # (GIT_SIDECAR_DIRNAME — its remote is the whole point of publishing
  # it), or, for a merged path (no git dir on disk), the remote recorded
  # in its .git.merged snapshot. Local-only = no remote in any of those.
  if [ -e "$_rlo_r/.git" ]; then
    _rlo_n=$(run_as_owner_capture "$_rlo_r" git remote 2>/dev/null | grep -c .)
    [ "${_rlo_n:-0}" -eq 0 ]
  elif [ -d "$_rlo_r/$_rlo_grd" ]; then
    _rlo_n=$(run_as_owner_capture "$_rlo_r" git --git-dir="$_rlo_grd" --work-tree=. remote 2>/dev/null | grep -c .)
    [ "${_rlo_n:-0}" -eq 0 ]
  elif [ -f "$_rlo_r/.git.merged" ]; then
    [ -z "$(sed -n 's/^remote\.origin\.url: //p' "$_rlo_r/.git.merged" 2>/dev/null | head -1)" ]
  else
    return 1
  fi
}

# _fl_keep_local_only [strip]  — reads a newline path list on stdin, prints
# only the LOCAL-ONLY ones (no remote — the ⌂ repos in 'st'). For flatten's
# generic --local-only filter. With strip=1, a trailing '/.git' is removed
# before the check (the embedded-repo list carries it). Paths are relative to
# the caller's CWD (flatten cd's to the toplevel first). Orphan gitlinks and
# never-cloned registrations have no local repo of their own, so they drop out
# (they aren't "local-only repos").
_fl_keep_local_only() {
  while IFS= read -r _flk_p; do
    [ -n "$_flk_p" ] || continue
    _flk_d=$_flk_p
    [ "${1:-0}" = 1 ] && _flk_d=$(printf '%s' "$_flk_p" | sed 's|/\.git$||')
    repo_is_local_only "$_flk_d" && printf '%s\n' "$_flk_p"
  done
}

# _repo_origin_url <repo>
#   Print the origin remote URL of a repo — live '.git', sidecar
#   (from GIT_SIDECAR_DIRNAME's config), or merged (from the .git.merged
#   snapshot). Empty if none. ('rem' has the full multi-remote/audit
#   view; this is the compact origin-only lookup for st's -V output.)
_repo_origin_url() {
  _rou_r=$1
  _rou_grd=${GIT_SIDECAR_DIRNAME:-.git.real}
  if [ -e "$_rou_r/.git" ]; then
    run_as_owner_capture "$_rou_r" git config --get remote.origin.url 2>/dev/null
  elif [ -d "$_rou_r/$_rou_grd" ]; then
    run_as_owner_capture "$_rou_r" git --git-dir="$_rou_grd" config --get remote.origin.url 2>/dev/null
  elif [ -f "$_rou_r/.git.merged" ]; then
    sed -n 's/^remote\.origin\.url: //p' "$_rou_r/.git.merged" 2>/dev/null | head -1
  fi
}

# status_summary <repo>
#   Print ONE compact line describing the repo's state. Handles cross-user
#   policy, errors, dirty counts, ahead/behind/diverged. Never multiline.
#   Does NOT include the ⌂ local-only flag — that's a separate aligned
#   COLUMN rendered by the layout code (see repo_is_local_only).
# wt_matches_commit <repo>
#   Print the commit whose TREE is bit-identical to <repo>'s current
#   worktree (tracked + untracked, minus ignored), or nothing.
#
#   This is the "did anyone actually EDIT something?" test. A worktree can
#   differ from HEAD without a single local edit: a folder of files from an
#   older release, later attached to (or fast-forwarded past by) upstream
#   history, diffs against HEAD as pages of phantom "modifications" -- seen
#   for real on squashfuse (files spanning 2014-2025 vs a 2026 HEAD) and
#   winetricks (a 2015-era checkout vs 2026). If the worktree tree hashes
#   identically to an existing commit's tree, NOTHING was hand-edited; the
#   state is an old checkout, and updating it cannot lose local work.
#
#   Cost: one temp-index 'add -A' + one rev walk comparing tree ids (no
#   diffs). Only called for DIRTY repos.
wt_matches_commit() {
  _wmc_r=$1
  [ -e "$_wmc_r/.git" ] || return 1
  _wmc_idx=$(mktemp "${TMPDIR:-/tmp}/${US}.wtidx.XXXXXX" 2>/dev/null) || return 1
  rm -f "$_wmc_idx"
  _wmc_tree=$(
    GIT_INDEX_FILE=$_wmc_idx git -c safe.directory='*' -C "$_wmc_r" add -A -- . >/dev/null 2>&1 \
      && GIT_INDEX_FILE=$_wmc_idx git -c safe.directory='*' -C "$_wmc_r" write-tree 2>/dev/null
  )
  rm -f "$_wmc_idx"
  [ -n "$_wmc_tree" ] || return 1
  _wmc_hit=$(git -c safe.directory='*' -C "$_wmc_r" log --all --format='%H %T' 2>/dev/null \
               | awk -v t="$_wmc_tree" '$2 == t { print $1; exit }')
  [ -n "$_wmc_hit" ] || return 1
  printf '%s\n' "$_wmc_hit"
}

status_summary() {
  _r=$1
  is_git_repo "$_r" || { echo "[ERROR no .git]"; return 1; }
  _action=$(check_priv "$_r")
  case "$_action" in
    fail:*) printf '[ERROR] %s\n' "${_action#fail:}"; return 1 ;;
    skip|warn) echo "[SKIPPED — cross-user policy]"; return 0 ;;
  esac
  # A '.git' DIRECTORY that git can't use as a repo (e.g. only a config, no
  # HEAD/objects/refs) makes git discovery WALK UP to the enclosing repo — so
  # 'git status' here would silently report THAT repo's state (dirty count,
  # branch) under this path. Let GIT be the judge: ask where the repo toplevel
  # actually resolves; if it isn't THIS path, git found an ancestor, not a repo
  # here. The cheap 'no HEAD' test is only a fast gate so valid repos (the vast
  # majority) never pay for the extra rev-parse. (A '.git' FILE / gitfile
  # pointer that doesn't resolve is handled on the git-status failure path.)
  if [ -d "$_r/.git" ] && [ ! -e "$_r/.git/HEAD" ]; then
    _ss_gittop=$(run_as_owner_capture "$_r" git rev-parse --show-toplevel 2>/dev/null)
    _ss_rabs=$(cd "$_r" 2>/dev/null && pwd -P)
    if [ "$_ss_gittop" != "$_ss_rabs" ]; then
      echo "[BROKEN .git — git finds no repo here; it resolves to the enclosing repo${_ss_gittop:+: $_ss_gittop}]"
      return 1
    fi
  fi
  # ONE git call for everything: '-b' adds a leading '## <branch>...
  # <upstream> [ahead N, behind M]' header, so status + branch + upstream
  # + ahead/behind all come back together — replacing the four separate
  # calls (status, rev-parse, branch -a, rev-list) this used to make per
  # repo. On a big tree that roughly halves st's git-subprocess count.
  _sb=$(run_as_owner_capture "$_r" git status -b --porcelain --ignore-submodules 2>/dev/null)
  _rc=$?
  if [ "$_rc" -ne 0 ]; then
    # Distinguish one specific, common cause: a lightweight gitfile
    # pointer whose target doesn't exist — most often because the
    # enclosing repo it runs through was realized (try substituting
    # GIT_SIDECAR_DIRNAME) or, if that ALSO doesn't resolve, because the
    # underlying history was already permanently deleted at some
    # earlier point (e.g. an 'sm --clean-stale' run). Surfacing this
    # here means it shows up just from running 'st', not only when
    # 'flatten' later tries (and fails) to realize it.
    _ssg=$_r/.git
    if [ -f "$_ssg" ] && [ ! -d "$_ssg" ]; then
      _ssptr=$(sed -n 's/^gitdir: *//p' "$_ssg" 2>/dev/null | head -1)
      if [ -n "$_ssptr" ]; then
        case "$_ssptr" in
          /*) _ssreal=$_ssptr ;;
          *)  _ssreal=$(cd "$_r" 2>/dev/null && cd "$_ssptr" 2>/dev/null && pwd -P) ;;
        esac
        if [ -z "$_ssreal" ] || [ ! -d "$_ssreal" ]; then
          case "$_ssptr" in
            */.git/*)
              _ssptrfb="${_ssptr%%/.git/*}/${GIT_SIDECAR_DIRNAME:-.git.real}/${_ssptr#*/.git/}"
              case "$_ssptrfb" in
                /*) _ssrealfb=$_ssptrfb ;;
                *)  _ssrealfb=$(cd "$_r" 2>/dev/null && cd "$_ssptrfb" 2>/dev/null && pwd -P) ;;
              esac
              if [ -n "$_ssrealfb" ] && [ -d "$_ssrealfb" ]; then
                echo "[BROKEN gitdir pointer — history recoverable via ${GIT_SIDECAR_DIRNAME:-.git.real}; run flatten to fix]"
                return 1
              fi
              ;;
          esac
          echo "[BROKEN gitdir pointer — history already gone (unresolvable); flatten/delete via flatten -i]"
          return 1
        fi
      fi
    fi
    echo "[ERROR git status failed]"
    return 1
  fi
  # First line is the '## ...' branch header; everything after is the
  # porcelain entry list (dirty files). Split with pure parameter
  # expansion (a literal-newline pattern) — no 'head -1'/'tail' pipe,
  # which both spawns subprocesses AND (when head closes early) leaves
  # the feeding printf writing to a broken pipe (harmless, but noisy on
  # stderr).
  _branchline=$_sb
  _porc=""
  case "$_sb" in
    *"
"*) _branchline=${_sb%%"
"*}
        _porc=${_sb#*"
"} ;;
  esac
  if [ -n "$_porc" ]; then
    _total=$(printf '%s\n' "$_porc" | grep -c .)
    _tally=$(printf '%s\n' "$_porc" | awk '
      /^\?\?/ { u++; next }
      {
        x=substr($0,1,1); y=substr($0,2,1)
        if (x=="M" || y=="M") m++
        else if (x=="A" || y=="A") a++
        else if (x=="D" || y=="D") d++
        else if (x=="R" || y=="R") r++
        else other++
      }
      END {
        s=""
        if (m) s=s" M:"m
        if (a) s=s" A:"a
        if (d) s=s" D:"d
        if (r) s=s" R:"r
        if (u) s=s" ??:"u
        if (other) s=s" ?:"other
        sub(/^ /,"",s)
        print s
      }')
    # Before crying DIRTY, check whether anything was actually EDITED.
    # If the whole worktree hashes to an existing commit's tree, this is
    # an OLD CHECKOUT: zero local edits, and fast-forwarding the files
    # to HEAD can lose nothing. Saying "DIRTY (15) [M:14]" for that state
    # sent a person hunting for modifications they never made.
    _wmc_c=$(wt_matches_commit "$_r")
    if [ -n "$_wmc_c" ]; then
      _wmc_short=$(git -c safe.directory='*' -C "$_r" rev-parse --short "$_wmc_c" 2>/dev/null)
      _wmc_date=$(git -c safe.directory='*' -C "$_r" log -1 --format=%ad --date=short "$_wmc_c" 2>/dev/null)
      if git -c safe.directory='*' -C "$_r" merge-base --is-ancestor "$_wmc_c" HEAD 2>/dev/null; then
        _wmc_lag=$(git -c safe.directory='*' -C "$_r" rev-list --count "$_wmc_c..HEAD" 2>/dev/null)
        printf 'OLD CHECKOUT (= %s %s, lags HEAD by %s — NO local edits; ff-safe)\n' \
          "$_wmc_short" "$_wmc_date" "${_wmc_lag:-?}"
      else
        printf 'OLD CHECKOUT (= %s %s, other branch — NO local edits)\n' \
          "$_wmc_short" "$_wmc_date"
      fi
      return 0
    fi
    printf 'DIRTY (%d)  [%s]\n' "$_total" "$_tally"
    return 0
  fi
  # Clean worktree — read branch/upstream/ahead/behind from the '## '
  # header ('## <branch>...<upstream> [ahead N, behind M]'; no '...' when
  # the branch has no upstream). Ahead/behind here are relative to the
  # ACTUAL configured upstream (more correct than assuming origin/<branch>
  # as the old code did — and free, since -b already computed it).
  case "$_branchline" in
    *'...'*)
      _up_ahead=$(printf '%s' "$_branchline" | sed -n 's/.*ahead \([0-9][0-9]*\).*/\1/p')
      _up_behind=$(printf '%s' "$_branchline" | sed -n 's/.*behind \([0-9][0-9]*\).*/\1/p')
      if [ -n "$_up_ahead" ] && [ -n "$_up_behind" ]; then
        printf 'DIVERGED (ahead %s, behind %s)\n' "$_up_ahead" "$_up_behind"
      elif [ -n "$_up_ahead" ]; then
        printf 'CLEAN, ahead %s\n' "$_up_ahead"
      elif [ -n "$_up_behind" ]; then
        printf 'CLEAN, behind %s\n' "$_up_behind"
      else
        printf 'CLEAN :))\n'
      fi
      ;;
    *)
      # No upstream tracking for this branch. If the repo has NO remote at
      # all → plain 'CLEAN :))' (the ⌂ flag column already conveys
      # local-only). If it HAS a remote but this branch just isn't tracked
      # yet → say so ('no upstream'), which is actionable.
      _branch=${_branchline#\#\# }
      _branch=${_branch%%.*}          # drop any '...' remainder (defensive)
      _branch=${_branch%% *}          # first token (branch name)
      if repo_is_local_only "$_r"; then
        printf 'CLEAN :))\n'
      else
        # Repo HAS a remote, but the CURRENT branch has no upstream. That's
        # usually benign (you're on a local branch like 'mine' while 'master'
        # tracks origin) — so find a branch that DOES track a remote and say
        # so, rather than implying the repo is disconnected.
        _track=$(run_as_owner_capture "$_r" git for-each-ref --format='%(refname:short)|%(upstream:short)' refs/heads 2>/dev/null \
                 | awk -F'|' '$2 != "" { print $1; exit }')
        if [ -n "$_track" ]; then
          printf 'CLEAN (branch "%s" has no upstream)\n' "$_branch"
        else
          printf 'CLEAN (no upstream for current branch "%s"; repo has a remote but no branch tracks it)\n' "$_branch"
        fi
      fi
      ;;
  esac
}

# Print porcelain status + branch divergence for a single repo, indented.
# Error codes 021-034 preserved from the original script where applicable.
status_one() {
  _r=$1; _depth=$2
  _ind=$(indent_for "$_depth")
  # Only run if the repo's .git is accessible to this process (via run_as_owner).
  is_git_repo "$_r" || { printf '%s > %s: [ERROR no .git]\n' "$_ind" "$_r"; return 1; }

  # Per-node cross-user policy check. status_one runs inside a pipeline
  # subshell, so fatal() can't abort the whole run from here — we treat
  # 'fail' at this depth as "print ERROR and skip this node" (root-level
  # fails are caught by priv_gate in cmd_status, which IS the parent).
  _action=$(check_priv "$_r")
  case "$_action" in
    fail:*)
      printf '%s > %s: [ERROR] %s\n' "$_ind" "$_r" "${_action#fail:}"
      return 1
      ;;
    skip|warn)
      printf '%s > %s: [SKIPPED — cross-user policy]\n' "$_ind" "$_r"
      return 0
      ;;
  esac

  _porc=$(run_as_owner_capture "$_r" git status --porcelain --ignore-submodules 2>&1)
  _rc=$?
  if [ "$_rc" -ne 0 ]; then
    printf '%s > %s:\n' "$_ind" "$_r"
    printf '%s   [ERROR] git status failed:\n' "$_ind"
    printf '%s\n' "$_porc" | sed -e "s|^|${_ind}     |"
    return 1
  fi

  # Local-only marker (see status_summary / the -V legend): ⌂ when the
  # repo has no remote configured at all.
  _n_remotes=$(run_as_owner_capture "$_r" git remote 2>/dev/null | grep -c .)
  _localmark=""
  [ "${_n_remotes:-0}" -eq 0 ] && _localmark='  ⌂'
  if [ -z "$_porc" ]; then
    # Clean worktree — check divergence.
    _branch=$(run_as_owner_capture "$_r" git rev-parse --abbrev-ref HEAD 2>/dev/null)
    _rem_ref=origin/$_branch
    _has_remote=$(run_as_owner_capture "$_r" git branch -a 2>/dev/null | grep -E "^\s*remotes/$_rem_ref$" || true)
    if [ -z "$_has_remote" ]; then
      if [ "${_n_remotes:-0}" -eq 0 ]; then
        printf '%s > %s: CLEAN :))%s\n' "$_ind" "$_r" "$_localmark"
      else
        _track=$(run_as_owner_capture "$_r" git for-each-ref --format='%(refname:short)|%(upstream:short)' refs/heads 2>/dev/null \
                 | awk -F'|' '$2 != "" { print $1; exit }')
        if [ -n "$_track" ]; then
          printf '%s > %s: CLEAN (branch "%s" has no upstream)\n' "$_ind" "$_r" "$_branch"
        else
          printf '%s > %s: CLEAN (no upstream for current branch "%s"; repo has a remote but no branch tracks it)\n' "$_ind" "$_r" "$_branch"
        fi
      fi
    else
      _div=$(run_as_owner_capture "$_r" git log "${_rem_ref}...${_branch}" 2>/dev/null)
      if [ -z "$_div" ]; then
        printf '%s > %s: CLEAN :))\n' "$_ind" "$_r"
      else
        printf '%s > %s: Local <-> Remote out of sync!\n' "$_ind" "$_r"
        printf '%s\n' "$_div" | sed -e "s|^|${_ind}        |"
      fi
    fi
  else
    printf '%s > %s:%s\n' "$_ind" "$_r" "$_localmark"
    printf '%s\n' "$_porc" | sed -e "s|^|${_ind}        |"
  fi
  # -V also surfaces the git SETUP — the origin remote URL (the most
  # useful missing bit), sidecar/merged-aware. Full multi-remote/audit
  # view is 'my-git rem'.
  _su_url=$(_repo_origin_url "$_r")
  if [ -n "$_su_url" ]; then
    printf '%s   remote: origin -> %s\n' "$_ind" "$_su_url"
  fi
}

cmd_status() {
  # Sub-option parse — accept global flags again and --help.
  _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help status; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose)          VERYVRB=1 ;;
      -D|--debug)   DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      -R|--recursive) RECURSIVE=1 ;;  # -R forces discovery in foreign scopes too
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "status: unknown option: $1" 64 ;;
      *)            _args="$_args $(shell_escape "$1")" ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"

  _roots=$(resolve_scope "$@") || exit 1
  [ -z "$_roots" ] && { log_error "no repositories to inspect"; exit 1; }

  # Iterate roots in the PARENT shell (via a for-loop over a tmpfile) so
  # that priv_gate's fatal() actually aborts the whole run on policy=fail.
  _rtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.roots.XXXXXX")
  # Per-repo state counts are collected into a separate tmp (one char
  # per repo: C=clean, A=ahead, B=behind, V=diverged, D=dirty, E=error/skip).
  _stcounts_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.stcounts.XXXXXX")
  # KIND is a separate axis from STATE. A shadowed repo has both: it is
  # shadowed AND it is clean or dirty. Counting them in one list made the
  # summary read as a partition of the total when it was not -- 25 rows
  # displayed DIRTY while the summary said DIRTY=1.
  _stkind_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.stkind.XXXXXX")
  # Parallel tallies for the flag column: publish state (L=local-only ⌂,
  # R=has-remote ↑) and the my-git.ignore marker (I). Counted in
  # the Summary. Only the default tree path fills these (the -V per-node view
  # renders no flag column).
  _stflag_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.stflag.XXXXXX")
  _stign_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.stign.XXXXXX")
  trap 'rm -f "$_rtmp" "$_stcounts_tmp" "$_stkind_tmp" "$_stflag_tmp" "$_stign_tmp"' EXIT INT TERM HUP
  printf '%s\n' "$_roots" > "$_rtmp"
  _first=1
  while IFS= read -r _root; do
    [ -n "$_root" ] || continue
    priv_gate "$_root"
    [ "$_first" = 1 ] || printf '\n'
    _first=0
    case "$PRIV_ACTION" in
      skip)
        echo E >> "$_stcounts_tmp"
        continue
        ;;
      warn)
        printf '%s  [SKIPPED — cross-user policy]\n' "$_root"
        _gated_subtree_hint "$_root"
        echo E >> "$_stcounts_tmp"
        continue
        ;;
    esac
    # A SHADOWED repo is half of a relationship, and standing inside one
    # shows only half the picture: its files are ALSO tracked by another
    # repo, and nothing on this screen would say so. Scope is deliberately
    # NOT widened (that would silently report on a repo the caller did not
    # ask about) -- the relationship is named, with the command to see it.
    # A marker records the remote 'rehydrate' will clone from. If the repo's
    # remote has since changed -- renamed upstream, switched to ssh -- the
    # marker still names the old one, and a restore on a fresh machine goes
    # to the wrong place or fails. Report it; do NOT rewrite it here: the
    # marker is a TRACKED file, so healing it from 'st' would dirty the
    # container repo, which is exactly what a status command must not do.
    while IFS= read -r _st_mk; do
      [ -n "$_st_mk" ] || continue
      _st_rec=$(sed -n 's|^remote\.origin\.url: ||p' "$_root/$_st_mk/.git.shadow.status" 2>/dev/null | head -n 1)
      _st_act=$(git -C "$_root/$_st_mk" config --get remote.origin.url 2>/dev/null)
      [ -n "$_st_act" ] || continue
      [ "$_st_rec" = "$_st_act" ] && continue
      log_warn "$_st_mk: its marker records remote '${_st_rec:-<none>}' but the repo now uses '$_st_act' — 'rehydrate' would clone the OLD one. Refresh with: $US shadow go $_st_mk"
    done <<_ST_MKEOF
$(list_shadowed_dirs "$_root" 2>/dev/null)
_ST_MKEOF
    if [ -f "$_root/.git.shadow.status" ]; then
      _st_shinto=$(tracking_repo_of "$_root")
      if [ -n "$_st_shinto" ]; then
        log_major "this repo is SHADOWED into $_st_shinto (mirroring its files there)"
        printf '    > its own .git (here) is the authoritative history; the mirror is a copy\n'
        printf '    > full tree:  %s st %s\n' "$US" "$_st_shinto"
      else
        _st_shwas=$(sed -n 's|^shadowed-into-repo: ||p' "$_root/.git.shadow.status" 2>/dev/null | head -n 1)
        log_warn "this repo carries a shadow marker naming ${_st_shwas:-<unknown>}, but NO repo mirrors its files any more — the marker is stale ('$US unshadow go' where it points, or delete it)"
      fi
    fi
    # Re-derive the nested-shadow excludes before reporting. This is the
    # ONE thing st changes, and only because it is derived state my-git
    # owns: computable from the markers on disk, idempotent, and written
    # exclusively to .git/info/exclude -- local, never cloned, so it can
    # never become a commit or reach a remote. It also cannot survive a
    # fresh clone, so something has to re-establish it, and the command
    # people actually run is 'st'. (Contrast the .claude check, which
    # wrote a TRACKED .gitignore and therefore had to stop enforcing.)
    # sort -u: a repo can be healed on both sides in one run (its own marker
    # AND the block hiding a repo nested inside it) and must count once.
    _st_fixed=$(shadow_sync_excludes "$_root" | sort -u)
    if [ -n "$_st_fixed" ]; then
      log_medium "st: refreshed nested-shadow excludes in $(printf '%s' "$_st_fixed" | grep -c .) repo(s) (local .git/info/exclude)"
    fi

    # Is this scope a managed repo (in GIT_REPOS or a descendant)?
    # If yes: walk registered submodules + auto-discover unregistered
    #         nested repos below. If no (e.g. $HOME happens to be a
    #         git repo but isn't in GIT_REPOS): stay shallow — show
    #         only the repo root, no discovery.
    if is_managed_path "$_root"; then SCOPE_MANAGED=1; else SCOPE_MANAGED=0; fi
    if [ "$VRB" = 1 ]; then
      # Verbose: original per-node porcelain output, indented by depth.
      _nodes=$(walk_submodules "$_root")
      # walk_submodules returns post-order (leaves first). For status we want
      # top-down readability: super first, then its children. Reverse.
      printf '%s\n' "$_nodes" | awk '{a[NR]=$0} END{for(i=NR;i>=1;i--) print a[i]}' \
        | while IFS= read -r _node; do
            [ -n "$_node" ] || continue
            _d=$(depth_of "$_root" "$_node")
            status_one "$_node" "$_d"
            # Classify for counters.
            _s=$(status_summary "$_node" 2>/dev/null)
            case "$_s" in
              "CLEAN :))"*)         echo C ;;
              "CLEAN, ahead"*)      echo A ;;
              "CLEAN, behind"*)     echo B ;;
              "DIVERGED"*)          echo V
                                  # A diverged branch is the ONLY state where a missing
                                  # pull strategy actually bites ("Need to specify how to
                                  # reconcile divergent branches"). Healing every repo cost
                                  # 0.3s per st to fix something almost none of them had;
                                  # healing here is free and lands exactly where it matters.
                                  autoheal_pull_strategy "$_node" >/dev/null 2>&1 || true ;;
              "OLD CHECKOUT"*)      echo O ;;
              "DIRTY"*)             echo D ;;
              "CLEAN (no upstream"*) echo C ;;
              "CLEAN (branch "*) echo C ;;
              *)                    echo E ;;
            esac >> "$_stcounts_tmp"
          done
    else
      # Default: compact one-line-per-repo tree. Output streams line-
      # by-line so the user sees progress in big trees instead of a
      # long stall followed by everything at once.
      #
      # Phase A (fast): structural walk only — gather every entry's
      #   (pfx+disp, mark, tag, abs) into a tmpfile. NO status calls;
      #   this is just 'find' + .gitmodules lookups.
      # Phase B (fast): compute the max display-widths of col1 and col2
      #   from the tmpfile (one awk pass) and emit each row with the
      #   LEFT side already padded so phase C just appends the state.
      # Phase C (slow, streaming): read the padded file line by line;
      #   for each row call status_summary (the expensive git call)
      #   and print '<padded-left>  <state>' immediately. User sees
      #   the tree fill in as status completes per repo.
      _rawtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.tree.raw.XXXXXX")
      _padtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.tree.pad.XXXXXX")

      # Phase A.  walk_tree_lines emits: <pfx+display>\t<abs>\t<tag>
      # Tag the ROOT itself if it's a sidecar/merged path (so 'st <sidecar>'
      # / 'st <merged>' render correctly instead of failing status_summary).
      _root_tag=$(flatten_marker_tag "$_root")
      walk_tree_lines "$_root" "$_root" "" "" "$_root_tag" \
        | while IFS="$(printf '\t')" read -r _left _abs _tag; do
            # Every tag that describes a RELATIONSHIP carries '@<repo>' —
            # the other git involved. Tags that describe the path alone
            # ([raw-nested-git], [zipped]) carry no '@', because there is
            # no second repo to name.
            _at=$(related_repo_of "$_abs" "$_tag")
            [ -n "$_at" ] && _at=" @$(basename "$_at")"
            _mark=""
            case "$_tag" in
              reg)       _mark="[registered-sm$_at]" ;;
              unreg)     _mark="[raw-nested-git]" ;;
              unreg-ign) _mark="[raw-nested-git, ignored]" ;;
              reg-ign)   _mark="[registered-sm$_at, ignored]" ;;
              stale)     _mark="[STALE REGISTRATION$_at]" ;;
              realized)  _mark="[sidecar$_at]" ;;
              merged)    _mark="[merged$_at]" ;;
              zipped)    _mark="[zipped]" ;;
              shadowed)  # A shadow is a relationship between two repos, so the
                         # mirroring repo is part of the tag. When NO repo tracks
                         # the files any more the marker is stale — say so loudly
                         # rather than imply a working mirror.
                         if [ -n "$_at" ]; then
                           _mark="[shadowed$_at]"
                         else
                           _shinto=$(sed -n 's|^shadowed-into-repo: ||p' "$_abs/.git.shadow.status" 2>/dev/null | head -n 1)
                           if [ -n "$_shinto" ] && [ "$_shinto" != "<unknown>" ]; then
                             _mark="[shadowed STALE: @$(basename "$_shinto") no longer tracks it]"
                           else
                             _mark="[shadowed STALE: no repo tracks it]"
                           fi
                         fi ;;
            esac
            # Columns for awk: <left> TAB <mark> TAB <tag> TAB <abs>
            printf '%s\t%s\t%s\t%s\n' "$_left" "$_mark" "$_tag" "$_abs" >> "$_rawtmp"
          done

      # Phase B — compute widths + emit each line with left-side padded.
      # Output to $_padtmp: "<padded-left><TAB><tag><TAB><abs>".
      awk -F'\t' '
        function dwidth(s,   n, w) {
          w = length(s)
          n = gsub(/│/, "", s); w -= 2 * n
          n = gsub(/├/, "", s); w -= 2 * n
          n = gsub(/└/, "", s); w -= 2 * n
          n = gsub(/─/, "", s); w -= 2 * n
          return w
        }
        # pass 1: gather max widths of col1 (name) and col2 (mark).
        # The ROOT row is an ABSOLUTE path and can be arbitrarily long;
        # letting it set the column width pads every child row out to it and
        # wraps the whole tree. Only tree rows (those carrying a box-drawing
        # glyph) get a vote.
        NR == FNR {
          d1 = dwidth($1); if ($1 ~ /[├└│]/ && d1 > m1) m1 = d1
          d2 = dwidth($2); if (d2 > m2) m2 = d2
          next
        }
        # pass 2: emit padded left + TAB + abs + TAB + tag.
        # Tag is LAST because it can be empty (root) and POSIX read
        # collapses consecutive separators for middle-whitespace fields;
        # a trailing empty field reads correctly as "".
        {
          # One deep path must not blow the table out either: cap the column
          # and let the rare long name run over rather than padding all of
          # them. p1 can go negative for the root row, which is not padded.
          cm1 = (m1 > 56 ? 56 : m1)
          d1 = dwidth($1); p1 = cm1 - d1; if (p1 < 0) p1 = 0
          if (m2 > 0) {
            d2 = dwidth($2); p2 = m2 - d2
            if (p2 < 0) p2 = 0
            left = sprintf("%s%*s  %s%*s", $1, p1, "", $2, p2, "")
          } else {
            left = sprintf("%s%*s", $1, p1, "")
          }
          printf "%s\t%s\t%s\n", left, $4, $3
        }
      ' "$_rawtmp" "$_rawtmp" > "$_padtmp"
      rm -f "$_rawtmp"

      # Phase C — stream status per line (progress visible).
      while IFS="$(printf '\t')" read -r _left _abs _tag; do
        [ -n "$_abs" ] || continue
        # ⌂ flag COLUMN — a single fixed-width slot placed right AFTER the
        # [tag] column and BEFORE the state, so every local-only repo's
        # house lines up vertically (blank slot otherwise). Computed for
        # LIVE repos AND sidecars/merged paths (a sidecar/merged can just
        # as well be local-only — repo_is_local_only reads the remote from
        # .git.real / .git.merged). Only 'stale' (no repo at all) has no
        # meaningful publish state.
        _flag=' '
        case "$_tag" in
          # Rows stay SHORT so the tree never wraps. Whatever needs more
          # than a few words -- what the state means, how to undo it, where
          # the history went -- belongs in the path's own .status file, which
          # is named here. One place to look, and it travels with the repo.
          stale)    _sum="[no dir on disk — 'sm --clean-stale']" ;;
          realized) _sum="(content — see ./${GIT_SIDECAR_DIRNAME:-.git.real}.status)"
                    if repo_is_local_only "$_abs"; then _flag='⌂'; else _flag='↑'; fi ;;
          merged)   # Only claim preservation when the snapshot actually records it
                    # AND those refs still exist. A snapshot written before
                    # preservation (or one whose refs were dropped) has NO object
                    # database behind it, and saying otherwise is the difference
                    # between "restorable" and "gone".
                    _mns=$(sed -n 's|^preserved-refs: ||p' "$_abs/.git.merged" 2>/dev/null | head -n 1 | sed -e 's|/$||')
                    _mrepo=$(sed -n 's|^preserved-in-repo: ||p' "$_abs/.git.merged" 2>/dev/null | head -n 1)
                    [ -n "$_mrepo" ] || _mrepo=$(tracking_repo_of "$_abs")
                    if [ -n "$_mns" ] && [ -n "$_mrepo" ] \
                       && [ -n "$( cd "$_mrepo" 2>/dev/null && git -c safe.directory='*' for-each-ref --format='%(refname)' "$_mns" 2>/dev/null | head -n 1 )" ]; then
                      _sum="(content — history in @$(basename "$_mrepo"); see ./.git.merged)"
                    else
                      _sum="(content — NO preserved history; see ./.git.merged)"
                    fi
                    if repo_is_local_only "$_abs"; then _flag='⌂'; else _flag='↑'; fi ;;
          zipped)   if [ -f "$_abs/.git.real.zip" ]; then _zname=.git.real.zip; else _zname=.git.zip; fi
                    _sum="(git dir archived — '$US unflatten --zip')" ;;
          *)        _sum=$(status_summary "$_abs")
                    if repo_is_local_only "$_abs"; then _flag='⌂'; else _flag='↑'; fi ;;
        esac
        printf '%s  %s  %s\n' "$_left" "$_flag" "$_sum"
        # Tally the flag column (before the state 'continue's below, since a
        # sidecar/merged row can also be local-only/has-remote) and the
        # ignore marker.
        case "$_flag" in '⌂') echo L >> "$_stflag_tmp" ;; '↑') echo R >> "$_stflag_tmp" ;; esac
        case "$_tag" in unreg-ign|reg-ign) echo I >> "$_stign_tmp" ;; esac
        case "$_tag" in
          # These two keep a LIVE .git, so they have a state as well as a
          # kind -- record the kind here and fall through to be classified.
          realized) echo R >> "$_stkind_tmp" ;;
          shadowed) echo H >> "$_stkind_tmp" ;;
          # These two have no .git at all: kind is the whole story.
          merged)   echo G >> "$_stkind_tmp"; echo G >> "$_stcounts_tmp"; continue ;;
          zipped)   echo Z >> "$_stkind_tmp"; echo Z >> "$_stcounts_tmp"; continue ;;
        esac
        case "$_sum" in
          "CLEAN :))"*)         echo C ;;
          "CLEAN, ahead"*)      echo A ;;
          "CLEAN, behind"*)     echo B ;;
          "DIVERGED"*)          echo V
                              # A diverged branch is the ONLY state where a missing
                              # pull strategy actually bites ("Need to specify how to
                              # reconcile divergent branches"). Healing every repo cost
                              # 0.3s per st to fix something almost none of them had;
                              # healing here is free and lands exactly where it matters.
                              autoheal_pull_strategy "$_abs" >/dev/null 2>&1 || true ;;
          "OLD CHECKOUT"*)      echo O ;;
          "DIRTY"*)             echo D ;;
          "CLEAN (no upstream"*) echo C ;;
          "CLEAN (branch "*) echo C ;;
          "[no directory"*)     echo E ;;
          *)                    echo E ;;
        esac >> "$_stcounts_tmp"
      done < "$_padtmp"
      rm -f "$_padtmp"
    fi
  done < "$_rtmp"
  rm -f "$_rtmp"

  # ─── Legend ──────────────────────────────────────────────────────────
  # The FULL legend (states/dirty/tags/flags) prints only at -V, keeping the
  # default view uncluttered. The flag column's meaning + counts are folded
  # into the Summary (below), so the default view needs no separate legend.
  _st_total=$(grep -c . "$_stcounts_tmp" 2>/dev/null | head -1)
  if [ "$VRB" = 1 ]; then
    echo
    log_major "Legend"
    printf '  %s>> state:   %sCLEAN :))%s  CLEAN, ahead/behind N  DIVERGED (ahead X, behind Y)  DIRTY (N) [...]  CLEAN (remote for "OTHER" but not for current branch "NAME")%s\n' \
      "$C_BLUE" "$C_RESET" "$C_BLUE" "$C_RESET"
    printf '  %s>> dirty:   M=modified  A=added  D=deleted  R=renamed  ??=untracked  ?=other  (counts inside [ ])%s\n' "$C_BLUE" "$C_RESET"
    printf '  %s>> tags:    [registered-sm]=nested git registered as a submodule in .gitmodules  [raw-nested-git]=nested git NOT registered as a submodule  [sidecar]=self-contained history relocated to ./%s  [merged]=absorbed into the parent, history preserved there (see ./.git.merged; restore: unflatten --merge)  [zipped]=git dir archived by gz (./.git.zip / ./.git.real.zip), restore with gu  [shadowed @R]=live .git KEPT + files also mirrored into repo R (see ./.git.shadow.status; undo: unshadow)  [shadowed STALE]=marker present but NO repo mirrors it any more   '@R' on ANY tag names the OTHER git involved  [STALE REGISTRATION]=.gitmodules entry, no dir%s\n' \
      "$C_BLUE" "${GIT_SIDECAR_DIRNAME:-.git.real}" "$C_RESET"
    printf '  %s>> flags (column after the tag): %s⌂%s = local-only (no remote configured — nothing to publish to);  %s↑%s = has a remote (publishable);  blank = n/a (zipped/stale)%s\n' \
      "$C_BLUE" "$C_RESET" "$C_BLUE" "$C_RESET" "$C_BLUE" "$C_RESET"
  fi
  # (The default view carries the same flag meaning + counts in the Summary
  # below, so no standalone legend line is printed there.)

  # ─── Summary ─────────────────────────────────────────────────────────
  if [ "$_st_total" -gt 1 ]; then
    _n_clean=$(grep -c '^C$' "$_stcounts_tmp" 2>/dev/null | head -1)
    _n_ahead=$(grep -c '^A$' "$_stcounts_tmp" 2>/dev/null | head -1)
    _n_behind=$(grep -c '^B$' "$_stcounts_tmp" 2>/dev/null | head -1)
    _n_div=$(grep -c '^V$' "$_stcounts_tmp" 2>/dev/null | head -1)
    _n_dirty=$(grep -c '^D$' "$_stcounts_tmp" 2>/dev/null | head -1)
    _n_oldco=$(grep -c '^O$' "$_stcounts_tmp" 2>/dev/null | head -1)
    _n_err=$(grep -c '^E$' "$_stcounts_tmp" 2>/dev/null | head -1)
    _n_realized=$(grep -c '^R$' "$_stkind_tmp" 2>/dev/null | head -1)
    _n_merged=$(grep -c '^G$' "$_stcounts_tmp" 2>/dev/null | head -1)
    _n_zipped=$(grep -c '^Z$' "$_stcounts_tmp" 2>/dev/null | head -1)
    _n_shadowed=$(grep -c '^H$' "$_stkind_tmp" 2>/dev/null | head -1)
    echo
    log_major "Summary"
    _parts=""
    [ "$_n_clean" -gt 0 ]    && _parts="$_parts $(c_green "CLEAN=$_n_clean")"
    [ "$_n_ahead" -gt 0 ]    && _parts="$_parts ahead=$_n_ahead"
    [ "$_n_behind" -gt 0 ]   && _parts="$_parts behind=$_n_behind"
    [ "$_n_div" -gt 0 ]      && _parts="$_parts $(c_yellow "diverged=$_n_div")"
    [ "$_n_dirty" -gt 0 ]    && _parts="$_parts $(c_yellow "DIRTY=$_n_dirty")"
    [ "$_n_oldco" -gt 0 ]    && _parts="$_parts old-checkout=$_n_oldco"
    [ "$_n_merged" -gt 0 ]   && _parts="$_parts merged=$_n_merged(no .git)"
    [ "$_n_zipped" -gt 0 ]   && _parts="$_parts zipped=$_n_zipped(no .git)"
    [ "$_n_err" -gt 0 ]      && _parts="$_parts $(c_red "err/skip=$_n_err")"
    printf '  %s>> total=%s:%s%s\n' "$C_BLUE" "$_st_total" "$_parts" "$C_RESET"
    # Kinds are a SEPARATE axis and overlap the states above -- a shadowed
    # repo is counted once as shadowed here and once as clean/dirty there.
    # Its own line, so the two are never read as adding up.
    _kparts=""
    [ "$_n_shadowed" -gt 0 ] && _kparts="$_kparts  shadowed=$_n_shadowed"
    [ "$_n_realized" -gt 0 ] && _kparts="$_kparts  sidecar=$_n_realized"
    [ "$_n_merged" -gt 0 ]   && _kparts="$_kparts  merged=$_n_merged"
    [ "$_n_zipped" -gt 0 ]   && _kparts="$_kparts  zipped=$_n_zipped"
    [ -n "$_kparts" ] && printf '  %s>> kinds: %s   (overlaps the states above)%s\n' \
      "$C_BLUE" "$_kparts" "$C_RESET"
    # Flag-column tally + inline meaning (default tree only; empty under -V,
    # where the -V legend already spells the flags out). Each part is shown
    # only when non-zero so the line stays terse.
    _n_localonly=$(grep -c '^L$' "$_stflag_tmp" 2>/dev/null | head -1)
    _n_remote=$(grep -c '^R$' "$_stflag_tmp" 2>/dev/null | head -1)
    _n_ignored=$(grep -c '^I$' "$_stign_tmp" 2>/dev/null | head -1)
    _fparts=""
    [ "${_n_localonly:-0}" -gt 0 ] && _fparts="$_fparts  ⌂ local-only(no remote)=$_n_localonly"
    [ "${_n_remote:-0}" -gt 0 ]    && _fparts="$_fparts  ↑ has-remote(publishable)=$_n_remote"
    [ "${_n_ignored:-0}" -gt 0 ]   && _fparts="$_fparts  ignored(my-git leaves it alone; not descended)=$_n_ignored"
    [ -n "$_fparts" ] && printf '  %s>> flags:%s%s\n' "$C_BLUE" "$_fparts" "$C_RESET"
  fi
  rm -f "$_stcounts_tmp" "$_stkind_tmp" "$_stflag_tmp" "$_stign_tmp"
}

# ─── Masscommits subcommand ─────────────────────────────────────────────
# Build auto-commit message body for a repo with changes.
# Prints (to stdout) the complete commit message.
# Args: <repo>
build_commit_message() {
  _r=$1
  _files=$(run_as_owner_capture "$_r" git status --porcelain 2>/dev/null | cut -c4-)
  _files_cnt=$(printf '%s\n' "$_files" | grep -c . || true)

  # Subject follows the project convention: "my-git <subcmd>: <what
  # was done>". Body below has the full file list + recent-log excerpt
  # as '#'-prefixed commented lines.
  _intro="my-git mc: MASSCOMMIT of $_files_cnt path(s)"

  # Diff / files block
  if [ "$_files_cnt" -gt "$COMMIT_MSG_DIFF_MAX_FILES" ]; then
    _diffs="
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
@@@@@ FILES @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

$(printf '%s\n' "$_files" | sed -e 's/^/    > /')
"
  else
    _diffs="
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
@@@@@ FILE DIFFS @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

$(printf '%s\n' "$_files" | sed -e 's/^/    > /')
$(printf '%s\n' "$_files" | while IFS= read -r _f; do
    [ -n "$_f" ] || continue
    printf '\n:::: %s ::::::::::::::::::::::::::::::::::::::::::::::::::::::\n\n' "$_f"
    run_as_owner_capture "$_r" git diff --cached -- "$_f" 2>/dev/null
  done)
"
  fi

  _cmtMsgs="
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
@@@@@ LAST $COMMIT_MSG_LAST_N COMMIT MESSAGES @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

$(run_as_owner_capture "$_r" git log "-${COMMIT_MSG_LAST_N}" 2>/dev/null)"

  # Final message: subject, blank line (proper git subject-body separator),
  # then the '#'-prefixed body with file list + recent-log excerpt.
  printf '%s\n\n' "$_intro"
  printf '%s%s\n' "$_diffs" "$_cmtMsgs" | sed -e 's/^/#   /'
}

# _mc_classify_dirt <repo> <porcelain>
# Reads porcelain via stdin (newline-separated) and prints 3 lines to
# stdout (each may be empty):
#    <bump-paths-space-sep>
#    <recorded-paths-space-sep>
#    <user-paths-space-sep>
# where:
#    bumps    = paths that appear in <repo>/.gitmodules (submodule gitlink bumps)
#    recorded = paths whose abs form is in MC_COMMIT_PATHS
#               (my-git-side edits to .gitignore, .claude, etc.)
#    user     = everything else (the user's own dirt)
_mc_classify_dirt() {
  _cd_r=$1
  _cd_submods=""
  if [ -f "$_cd_r/.gitmodules" ]; then
    _cd_submods=$(run_as_owner_capture "$_cd_r" git config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
                  | awk '{print $2}')
  fi
  _cd_bumps=""; _cd_recorded=""; _cd_user=""
  while IFS= read -r _cd_line; do
    [ -n "$_cd_line" ] || continue
    # Capture status prefix (first 2 chars) + path.
    _cd_st=${_cd_line%"${_cd_line#??}"}
    _cd_p=${_cd_line#???}
    # Strip rename "old -> new" — keep the new path only.
    case "$_cd_p" in *" -> "*) _cd_p=${_cd_p##*" -> "} ;; esac
    # Submodule gitlink?
    if [ -n "$_cd_submods" ] && printf '%s\n' "$_cd_submods" | grep -qxF "$_cd_p"; then
      _cd_bumps="$_cd_bumps $_cd_p"
      continue
    fi
    # Recorded by my-git this run?
    _cd_abs="$_cd_r/$_cd_p"
    case "
${MC_COMMIT_PATHS}
" in
      *"
${_cd_abs}
"*) _cd_recorded="$_cd_recorded $_cd_p" ; continue ;;
    esac
    # Untracked file with MC_AUTO_COMMIT_UNTRACKED=1 → treat as auto
    # (new files are harmless to add; don't make the user confirm each).
    if [ "$_cd_st" = "??" ] && [ "${MC_AUTO_COMMIT_UNTRACKED:-1}" = 1 ]; then
      _cd_recorded="$_cd_recorded $_cd_p"
      continue
    fi
    _cd_user="$_cd_user $_cd_p"
  done
  printf '%s\n%s\n%s\n' "${_cd_bumps# }" "${_cd_recorded# }" "${_cd_user# }"
}

# _mc_auto_commit_my_git_changes <repo>
# Phase-1 of commit_one (go mode only): detect dirt caused BY my-git
# (submodule gitlink bumps + paths in MC_COMMIT_PATHS) and commit it
# transparently via 'git commit --only' — NO user prompt.
# Returns 0 on success (including no-op), 1 on error.
_mc_auto_commit_my_git_changes() {
  _ac_r=$1
  [ "$DRY_RUN" = 1 ] && return 0
  _ac_porc=$(run_as_owner_capture "$_ac_r" git status --porcelain --ignore-submodules=dirty 2>/dev/null)
  [ -z "$_ac_porc" ] && return 0

  _ac_cls=$(printf '%s\n' "$_ac_porc" | _mc_classify_dirt "$_ac_r")
  _ac_bumps=$(printf '%s\n' "$_ac_cls" | sed -n '1p')
  _ac_recorded=$(printf '%s\n' "$_ac_cls" | sed -n '2p')

  # Nothing my-git-caused → nothing to auto-commit.
  [ -z "$_ac_bumps" ] && [ -z "$_ac_recorded" ] && return 0

  if [ -z "$_ac_bumps" ]; then _ac_bump_count=0; else _ac_bump_count=$(printf '%s' "$_ac_bumps" | awk '{print NF}'); fi
  if [ -z "$_ac_recorded" ]; then _ac_rec_count=0; else _ac_rec_count=$(printf '%s' "$_ac_recorded" | awk '{print NF}'); fi

  # Build positional args (paths) for --only.
  _ac_all="$_ac_bumps $_ac_recorded"
  log_major "$_ac_r: auto-commit my-git-caused (bumps=$_ac_bump_count recorded=$_ac_rec_count)"
  if [ "$VRB" = 1 ]; then
    for _ac_p in $_ac_all; do
      log_medium "  $_ac_p"
    done
  fi

  # Stage exactly those paths.
  # shellcheck disable=SC2086
  run_as_owner "$_ac_r" git add -- $_ac_all 2>/dev/null || {
    log_error "$_ac_r: auto-commit: git add failed"
    return 1
  }
  # Compose commit subject.
  _ac_cm="my-git mc: auto-commit (bumps=$_ac_bump_count recorded=$_ac_rec_count)"
  # Commit ONLY these paths; --only ignores any other staged changes
  # (which would be user-dirt that the user may later want to prompt on).
  # shellcheck disable=SC2086
  if ! run_as_owner "$_ac_r" git commit --only -m "$_ac_cm" -- $_ac_all >/dev/null 2>&1; then
    log_error "$_ac_r: auto-commit failed"
    return 1
  fi
  log_major "$_ac_r: $(c_green 'DONE :))') (auto-committed my-git changes)"
  MC_N_AUTOCOMMITTED=$((${MC_N_AUTOCOMMITTED:-0} + 1))

  # Push if pushable (gitlink bumps should propagate upstream).
  if is_pushable "$_ac_r"; then
    _ac_remotes=$(run_as_owner_capture "$_ac_r" git remote 2>/dev/null)
    if [ -n "$_ac_remotes" ]; then
      run_as_owner "$_ac_r" git push -q --all 2>/dev/null \
        || log_warn "$_ac_r: auto-commit push failed (commit kept locally)"
      push_preserved_refs "$_ac_r"
    fi
  fi
  return 0
}

# commit_one <repo>  — if dirty, add -A + commit + push; if ahead, push.
commit_one() {
  _r=$1
  MC_N_TOTAL=$((MC_N_TOTAL + 1))

  # Honor the 'my-git.ignore' marker: if a nested repo is
  # flagged as "leave alone" for sm, mc respects the same signal.
  # --force (MC_FORCE=1) overrides — matches 'sm --force' semantics.
  _gd_for_marker=$(_sm_resolve_gitdir "$_r/.git" "$_r" 2>/dev/null)
  if [ -n "$_gd_for_marker" ] && [ -e "$_gd_for_marker/$_sm_IGNORE_MARKER" ]; then
    if [ "${MC_FORCE:-0}" -eq 1 ]; then
      log_medium "$_r: ignore marker present, OVERRIDDEN by --force"
    else
      [ "$VRB" = 1 ] && log_medium "$_r: [ignored marker — skipping]"
      MC_N_IGNORED=$((MC_N_IGNORED + 1))
      return 0
    fi
  fi

  # Cross-user policy. Deep nodes run inside a pipeline subshell, so
  # fatal() can't abort the whole run from here — root-level fails are
  # caught by priv_gate in cmd_masscommits (parent shell). Deep fails
  # become per-node ERRORs.
  _action=$(check_priv "$_r")
  case "$_action" in
    fail:*)
      log_error "${_action#fail:}"
      MC_N_ERROR=$((MC_N_ERROR + 1))
      return 1
      ;;
    skip)
      MC_N_SKIPPED=$((MC_N_SKIPPED + 1))
      return 0
      ;;
    warn)
      log_major "$_r: [SKIPPED — cross-user policy]"
      MC_N_SKIPPED=$((MC_N_SKIPPED + 1))
      return 0
      ;;
  esac

  # .claude setup audit (before staging so auto-fixes are part of the commit).
  if [ "$CHECK_CLAUDE_SETUP" = 1 ]; then
    ensure_claude_setup "$_r" || {
      log_error "$_r: .claude setup check failed (see above)"
      MC_N_ERROR=$((MC_N_ERROR + 1))
      return 1
    }
  fi

  # --ignore-submodules=dirty: show gitlink BUMPS (new commits in
  # submodules) so -R bottom-up walk can catch them in the parent's
  # cleanup commit, but still suppress noise from uncommitted worktree
  # changes INSIDE submodules (those are the submodule's business, not
  # the super's). Using bare '--ignore-submodules' (aka =all) would
  # hide gitlink bumps too — bug: the super would falsely show CLEAN
  # after children committed under -R.
  # ONE call, as 'st' already does: '-b' prepends
  #   ## <branch>...<upstream> [ahead N, behind M]
  # so branch, whether an upstream exists, and how far ahead we are all
  # arrive with the status -- replacing the separate rev-parse,
  # 'branch -a' and 'log' this used to run per repo. 'branch -a' was the
  # worst of them: it enumerates every ref, including every remote one,
  # to answer a yes/no question. Under root each call is launchctl + sudo
  # + git, so three fewer calls per repo is nine fewer processes.
  _sb_mc=$(run_as_owner_capture "$_r" git status -b --porcelain --ignore-submodules=dirty 2>/dev/null)
  # Split header from entries with parameter expansion only (no head/tail
  # subprocess, and no broken-pipe noise) -- same idiom as status_one.
  _bline_mc=$_sb_mc
  _porc=""
  case "$_sb_mc" in
    *"
"*) _bline_mc=${_sb_mc%%"
"*}
        _porc=${_sb_mc#*"
"} ;;
  esac

  # Push is allowed only when BOTH conditions hold:
  #   (1) repo path matches an entry in GIT_REPOS (explicit allowlist), AND
  #   (2) at least one remote is configured ('git remote' non-empty).
  # Condition (1) protects against third-party-fork pushes; condition (2)
  # protects against repos with no upstream at all — trying to push would
  # fail with 'No configured push destination'.
  if is_pushable "$_r"; then
    _remotes=$(run_as_owner_capture "$_r" git remote 2>/dev/null)
    if [ -n "$_remotes" ]; then
      _pushable=1
      _nopush_reason=""
    else
      _pushable=0
      _nopush_reason="no remote configured"
    fi
  else
    _pushable=0
    _nopush_reason="not in GIT_REPOS"
  fi

  # ── Classify state ────────────────────────────────────────────────────
  #   state=clean-matched      CLEAN :))                  action: noop
  #   state=clean-no-remote    CLEAN (no remote)          action: noop
  #   state=clean-ahead        CLEAN, ahead=N             action: push  (if pushable) else noop
  #   state=dirty              DIRTY (N) [M:..  A:..  ??:..]  action: add+commit (+push if pushable)
  _state=""; _state_desc=""; _action=""
  if [ -z "$_porc" ]; then
    # '## main...origin/main [ahead 2, behind 1]' -> branch, upstream, ahead.
    # No upstream at all means no '...' in the header.
    _hdr_mc=${_bline_mc#\#\# }
    _branch=${_hdr_mc%%...*}
    _branch=${_branch%% *}
    case "$_hdr_mc" in
      *...*) _has_remote=1 ;;
      *)     _has_remote="" ;;
    esac
    _rem_ref=origin/$_branch
    if [ -z "$_has_remote" ]; then
      _state=clean-no-remote
      _state_desc="CLEAN (no remote for $_branch)"
      _action=noop
    else
      _ahead=0
      case "$_bline_mc" in
        *"[ahead "*) _ahead=${_bline_mc#*"[ahead "}; _ahead=${_ahead%%[!0-9]*} ;;
      esac
      [ -n "$_ahead" ] || _ahead=0
      if [ "$_ahead" -eq 0 ]; then
        _state=clean-matched
        _state_desc="CLEAN :))"
        _action=noop
      else
        _state=clean-ahead
        _state_desc="CLEAN, ahead=$_ahead"
        if [ "$_pushable" = 1 ]; then
          _action=push
        else
          # Clean-ahead but not pushable (either not in GIT_REPOS, or no
          # remote configured). Commits already local; nothing to push to.
          _state_desc="$_state_desc  ($_nopush_reason → no push)"
          _action=noop
        fi
      fi
    fi
  else
    # mc = MASS COMMIT: classic per-type porcelain counts; we'll
    # 'git add -A && git commit -a' everything in this repo.
    _n=$(printf '%s\n' "$_porc" | grep -c . 2>/dev/null | head -1)
    _state=dirty
    _m=$(printf '%s\n' "$_porc" | awk '{s=substr($0,1,2); if (s ~ /M/) m++} END{print m+0}')
    _a=$(printf '%s\n' "$_porc" | awk '{s=substr($0,1,2); if (s ~ /A/) a++} END{print a+0}')
    _d=$(printf '%s\n' "$_porc" | awk '{s=substr($0,1,2); if (s ~ /D/) d++} END{print d+0}')
    _u=$(printf '%s\n' "$_porc" | awk '{s=substr($0,1,2); if (s == "??") u++} END{print u+0}')
    _parts=""
    [ "$_m" -gt 0 ] && _parts="$_parts M:$_m"
    [ "$_a" -gt 0 ] && _parts="$_parts A:$_a"
    [ "$_d" -gt 0 ] && _parts="$_parts D:$_d"
    [ "$_u" -gt 0 ] && _parts="$_parts ??:$_u"
    _state_desc="DIRTY ($_n) [$(printf '%s' "$_parts" | sed 's/^ //')]"
    if [ "$_pushable" = 1 ]; then
      _action="add+commit+push"
    else
      _action="add+commit"
    fi
  fi

  # ── Analyze mode: print a single concise line per repo and bail ───────
  if [ "$DRY_RUN" = 1 ]; then
    printf ' >>> %-60s %-32s -> %s\n' "$_r" "$_state_desc" "$_action"
    if [ "$VRB" = 1 ] && [ "$_state" = dirty ]; then
      printf '%s\n' "$_porc" | while IFS= read -r _l; do
        printf '        %s\n' "$_l"
      done
    fi
    # Counters for analyze-mode summary.
    case "$_state" in
      clean-matched|clean-no-remote) MC_N_CLEAN=$((MC_N_CLEAN + 1)) ;;
      clean-ahead) [ "$_pushable" = 1 ] && MC_N_WOULD_PUSH=$((MC_N_WOULD_PUSH + 1)) \
                   || MC_N_CLEAN=$((MC_N_CLEAN + 1)) ;;
      dirty)       MC_N_WOULD_COMMIT=$((MC_N_WOULD_COMMIT + 1)) ;;
    esac
    return 0
  fi

  # ── go mode: perform the action ───────────────────────────────────────
  case "$_state" in
    clean-matched|clean-no-remote)
      log_major "$_r: $_state_desc"
      MC_N_CLEAN=$((MC_N_CLEAN + 1))
      return 0
      ;;
    clean-ahead)
      if [ "$_pushable" != 1 ]; then
        log_major "$_r: $_state_desc  ($_nopush_reason — no push)"
        MC_N_CLEAN=$((MC_N_CLEAN + 1))
        return 0
      fi
      log_major "$_r: $_state_desc — pushing"
      [ "$VRB" = 1 ] && log_minor "$_div"
      if [ "$INTERACTIVE" = 1 ]; then
        printf '%s\n' "$_div" | sed -e 's/^/        /'
        _ans=$(_sm_ask "    $_r: push $_ahead commit(s)? [Y]es / [S]kip / [A]bort [Y/s/a]: ")
        case "$_ans" in
          a|A) log_major "$_r: [ABORT requested]"; return 77 ;;
          s|S|n|N) log_major "$_r: skipped (push)"; MC_N_SKIPPED=$((MC_N_SKIPPED + 1)); return 0 ;;
        esac
      fi
      run_as_owner "$_r" git push -q --all || {
        log_error "$_r: git push failed"; MC_N_ERROR=$((MC_N_ERROR + 1)); return 1;
      }
      push_preserved_refs "$_r"
      log_major "$_r: DONE :)) (pushed)"
      MC_N_PUSHED=$((MC_N_PUSHED + 1))
      return 0
      ;;
  esac

  # Dirty — MASS COMMIT: git add -A + git commit -a (+push if pushable).
  # mc is intentionally simple: commit EVERYTHING currently dirty in
  # this repo as one mass commit. No auto/user split. If the user has
  # changes they don't want swept in, they should commit/stash them
  # outside mc (or use '-i' to review per repo).
  log_major "$_r: $_state_desc — $_action"
  [ "$VRB" = 1 ] && while IFS= read -r _l; do log_medium "$_l"; done <<_MC_EOF
$(printf '%s\n' "$_porc" | sed -e 's/^/        /')
_MC_EOF

  _msgfile=$(mktemp "${TMPDIR:-/tmp}/${US}.commit-msg.XXXXXX")
  build_commit_message "$_r" > "$_msgfile" || { log_error "$_r: message build failed"; rm -f "$_msgfile"; MC_N_ERROR=$((MC_N_ERROR + 1)); return 1; }

  if [ "$INTERACTIVE" = 1 ]; then
    # Show porcelain + proposed commit subject before acting.
    printf '%s\n' "$_porc" | sed -e 's/^/        /'
    _subject=$(sed -n '1p' "$_msgfile" 2>/dev/null)
    printf '    proposed commit subject: %s\n' "$_subject"
    _ans=$(_sm_ask "    $_r: $_action? [Y]es / [S]kip / [A]bort [Y/s/a]: ")
    case "$_ans" in
      a|A) rm -f "$_msgfile"; log_major "$_r: [ABORT requested]"; return 77 ;;
      s|S|n|N) rm -f "$_msgfile"; log_major "$_r: skipped"; MC_N_SKIPPED=$((MC_N_SKIPPED + 1)); return 0 ;;
    esac
  fi

  run_as_owner "$_r" git add -A || { log_error "$_r: git add -A failed"; rm -f "$_msgfile"; MC_N_ERROR=$((MC_N_ERROR + 1)); return 1; }

  # If we must run git as another user, msgfile needs readable perms + chown.
  _owner=$(file_owner "$_r/.git")
  if [ -n "$_owner" ] && [ "$_owner" != "$ME" ]; then
    if [ "$ME" = "root" ]; then
      chown "$_owner" "$_msgfile" 2>/dev/null || chmod 644 "$_msgfile"
    elif has_sudo_rights; then
      sudo chown "$_owner" "$_msgfile" 2>/dev/null || chmod 644 "$_msgfile"
    else
      chmod 644 "$_msgfile"
    fi
  fi

  # -F: literal message from file (no editor). -a: also include modified tracked files.
  run_as_owner "$_r" git commit -q -a -F "$_msgfile" || {
    log_error "$_r: git commit failed"
    rm -f "$_msgfile"
    MC_N_ERROR=$((MC_N_ERROR + 1))
    return 1
  }
  rm -f "$_msgfile"
  MC_N_COMMITTED=$((MC_N_COMMITTED + 1))
  if [ "$_pushable" = 1 ]; then
    run_as_owner "$_r" git push -q --all || {
      log_error "$_r: git push failed"; MC_N_ERROR=$((MC_N_ERROR + 1)); return 1;
    }
    push_preserved_refs "$_r"
    log_major "$_r: DONE :)) (mass-committed, pushed)"
  else
    log_major "$_r: DONE :)) (mass-committed — no push: $_nopush_reason)"
  fi
}

cmd_masscommits() {
  # mode: analyze (default, dry-like preview) vs go (actually add+commit+push).
  # Default is analyze to match 'sm' — only 'go' (or explicit alias) acts.
  _mc_mode=analyze
  MC_FORCE=0
  MC_SM_ONLY=0
  MC_SH_ONLY=0
  # Back-compat default for users whose existing config predates this var.
  MC_AUTO_COMMIT_UNTRACKED=${MC_AUTO_COMMIT_UNTRACKED:-1}
  _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help masscommits; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose)          VERYVRB=1 ;;
      -D|--debug)   DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      go)           _mc_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _mc_mode=analyze ;;
      -i|--interactive) INTERACTIVE=1; require_tty masscommits ;;
      --sm|--sub-modules|--submodules) MC_SM_ONLY=1 ;;
      --sh|--shadowed)                 MC_SH_ONLY=1 ;;
      --force)      MC_FORCE=1 ;;  # bypass per-repo my-git.ignore markers
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "masscommits: unknown option: $1" 64 ;;
      *)            _args="$_args $(shell_escape "$1")" ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"
  # Translate mode → DRY_RUN for commit_one (and friends).
  if [ "$_mc_mode" = "go" ]; then
    DRY_RUN=0
  else
    DRY_RUN=1
  fi

  _roots=$(resolve_scope "$@") || exit 1
  [ -z "$_roots" ] && { log_error "no repositories to commit"; exit 1; }

  # Per-run counters (summary at end). commit_one updates these globals
  # at each exit path. Analyze mode uses WOULD_* counters; go mode uses
  # the action counters.
  MC_N_TOTAL=0
  MC_N_CLEAN=0          # noop (already clean, matched remote or no remote)
  MC_N_PUSHED=0         # clean-ahead → pushed
  MC_N_COMMITTED=0      # dirty → mass-committed (go mode)
  MC_N_SKIPPED=0        # user said [S]kip under -i
  MC_N_IGNORED=0        # carries my-git.ignore marker → silent skip
  MC_N_ERROR=0          # per-repo error (non-fatal, continued)
  MC_N_WOULD_PUSH=0     # analyze: would push
  MC_N_WOULD_COMMIT=0   # analyze: would mass-commit

  # mc is the one command that writes to MANY repos: each repo commits to
  # ITS OWN .git (and pushes to ITS OWN remote). Name the roots and the
  # walk mode, so "which git did that commit go to" is answered up front.
  log_repo_context mc "$(printf '%s' "$_roots" | tr '\n' ' ')" \
    "EACH repo below commits to its OWN .git and pushes to its OWN remote -- no shared repo receives anything" \
    "$(if [ "$MC_SM_ONLY" = 1 ]; then
         printf -- '--sm: the SUBMODULE tree only, bottom-up (deepest committed first, so parent gitlinks can bump)'
       elif [ "$MC_SH_ONLY" = 1 ]; then
         printf -- '--sh: the SHADOWED repos only'
       else
         printf 'the whole tree below, bottom-up (deepest committed first, so parent gitlinks can bump)'
       fi)" \
    "$([ "$_mc_mode" != go ] && printf 'analyze only -- nothing is written')"

  _rc_total=0
  # File-redirected while keeps us in the parent shell so root-level
  # priv_gate fail aborts the whole run.
  _rtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.roots.XXXXXX")
  trap 'rm -f "$_rtmp"' EXIT INT TERM HUP
  printf '%s\n' "$_roots" > "$_rtmp"
  while IFS= read -r _root; do
    [ -n "$_root" ] || continue
    priv_gate "$_root"
    case "$PRIV_ACTION" in
      skip) continue ;;
      warn) log_major "$_root: [SKIPPED — cross-user policy]"
            _gated_subtree_hint "$_root"; continue ;;
    esac
    # The whole tree, like pull and push -- committing ONE repo is what
    # plain git already does. Deepest first, so a parent's gitlink can bump
    # to a child that was just committed.
    _nodes=$(select_tree_nodes "$_root" "$MC_SM_ONLY" "$MC_SH_ONLY" \
             | awk '{a[NR]=$0} END{for(i=NR;i>=1;i--) print a[i]}')
    # File-redirected while keeps this in the parent shell so an abort
    # signal from commit_one (via return 77) actually propagates.
    _ntmp=$(mktemp "${TMPDIR:-/tmp}/${US}.nodes.XXXXXX")
    printf '%s\n' "$_nodes" > "$_ntmp"
    _abort_requested=0
    # fd 9, not stdin: commit_one runs git through run_as_owner_capture
    # (su/sudo), which reads stdin and would swallow the remaining nodes.
    while IFS= read -r _node <&9; do
      [ -n "$_node" ] || continue
      if [ "$_abort_requested" = 1 ] && [ "$_node" != "$_root" ]; then
        # Post-abort: skip every remaining descendant so we can still
        # process the ROOT as a cleanup commit (capturing any gitlink
        # bumps from children that already committed before the abort).
        continue
      fi
      commit_one "$_node"
      _rc=$?
      case "$_rc" in
        0)  : ;;
        77) _abort_requested=1 ;;   # continue loop so root still runs
        *)  _rc_total=1 ;;
      esac
    done 9< "$_ntmp"
    rm -f "$_ntmp"
    if [ "$_abort_requested" = 1 ]; then
      # Abort propagates to the outer root loop too: remaining roots in
      # GIT_REPOS-fallback scope are NOT processed. Ctrl+C (SIGINT) still
      # exits immediately via signal; this is specifically for [A]bort.
      rm -f "$_rtmp"
      log_major "mc: ABORT requested — parent cleanup done, stopping."
      return 77
    fi
  done < "$_rtmp"
  rm -f "$_rtmp"

  # ─── Concise summary ────────────────────────────────────────────────
  # Detailed tree is intentionally left to 'my-git st' — summary gives
  # "what was done / what's left" in one screen.
  echo
  if [ "$_mc_mode" = "go" ]; then
    # What WAS done.
    log_major "mc: summary"
    _parts=""
    [ "$MC_N_CLEAN" -gt 0 ]          && _parts="$_parts clean=$MC_N_CLEAN"
    [ "$MC_N_PUSHED" -gt 0 ]         && _parts="$_parts pushed=$MC_N_PUSHED"
    [ "$MC_N_COMMITTED" -gt 0 ]      && _parts="$_parts committed=$MC_N_COMMITTED"
    [ "$MC_N_SKIPPED" -gt 0 ]        && _parts="$_parts skipped=$MC_N_SKIPPED"
    [ "$MC_N_IGNORED" -gt 0 ]        && _parts="$_parts ignored=$MC_N_IGNORED"
    [ "$MC_N_ERROR" -gt 0 ]          && _parts="$_parts $(c_red "errors=$MC_N_ERROR")"
    [ -z "$_parts" ] && _parts=" (nothing to do)"
    printf '  %s>> total=%s:%s%s\n' "$C_BLUE" "$MC_N_TOTAL" "$_parts" "$C_RESET"
    # What's LEFT to do.
    _left_hint=""
    [ "$MC_N_SKIPPED" -gt 0 ] && _left_hint="$MC_N_SKIPPED repo(s) skipped under -i"
    [ "$MC_N_IGNORED" -gt 0 ] && {
      [ -n "$_left_hint" ] && _left_hint="$_left_hint; "
      _left_hint="${_left_hint}$MC_N_IGNORED ignored (--force to override markers)"
    }
    [ "$MC_N_ERROR" -gt 0 ] && {
      [ -n "$_left_hint" ] && _left_hint="$_left_hint; "
      _left_hint="${_left_hint}$MC_N_ERROR error(s)"
    }
    [ -n "$_left_hint" ] && printf '  %s>> left to do: %s%s\n' "$C_BLUE" "$_left_hint" "$C_RESET"
    printf '  %s>> for details:  %s st%s%s\n' "$C_BLUE" "$US" \
      "$([ "$RECURSIVE" = 1 ] && echo ' -R')" "$C_RESET"
  else
    # Analyze mode: "what would be done".
    log_major "mc: analyze summary"
    _wparts=""
    [ "$MC_N_CLEAN" -gt 0 ]      && _wparts="$_wparts clean=$MC_N_CLEAN"
    [ "$MC_N_WOULD_PUSH" -gt 0 ] && _wparts="$_wparts would-push=$MC_N_WOULD_PUSH"
    [ "$MC_N_WOULD_COMMIT" -gt 0 ] && _wparts="$_wparts would-commit=$MC_N_WOULD_COMMIT"
    [ "$MC_N_IGNORED" -gt 0 ]    && _wparts="$_wparts ignored=$MC_N_IGNORED"
    [ -z "$_wparts" ] && _wparts=" (nothing to do)"
    printf '  %s>> total=%s:%s%s\n' "$C_BLUE" "$MC_N_TOTAL" "$_wparts" "$C_RESET"
    printf '  %s>> apply:       %s mc go%s%s\n' "$C_BLUE" "$US" \
      "$([ "$RECURSIVE" = 1 ] && echo ' -R')" "$C_RESET"
    printf '  %s>> for details: %s st%s%s\n' "$C_BLUE" "$US" \
      "$([ "$RECURSIVE" = 1 ] && echo ' -R')" "$C_RESET"
  fi
  return $_rc_total
}

# ═════════════════════════════════════════════════════════════════════════
# ═══ PULL / FETCH ════════════════════════════════════════════════════════
# ═════════════════════════════════════════════════════════════════════════
#
# my-git pull [go] [-R|-i|--force|--fetch-only] [paths...]
#
# Two-phase like mc/sm: default analyze, 'go' acts.
#   * fetches origin on every scoped repo (always, even in analyze — fetch
#     is read-only wrt the worktree)
#   * with 'go' AND when clean + behind: fast-forward merges
#   * clean + diverged → refuses (user resolves manually)
#   * dirty or ignored → skipped
# --fetch-only: stops after fetch; never merges. Use when you just want
#   refs updated.

# pull_one <repo>
# Returns:
#   0 = success (clean, ff'd, or noop)
#   1 = error (fetch failed / merge failed)
#  77 = abort requested via -i prompt
# push_one <repo>
#   Publish one repo's current branch. Never creates an upstream it was not
#   asked for: a branch with no tracking ref is REPORTED, not guessed at --
#   picking a remote for someone is how work lands in the wrong place.
# cmd_pullpush — 'pp': pull, then push. The tree-wide counterpart of the
#   'gpp' shell alias (git pull && git push).
#
#   Order is not arbitrary: a branch that is behind cannot be pushed, so
#   pulling first is what turns "rejected, non-fast-forward" into a push
#   that works. Both halves take the same flags and the same 'go'.
cmd_pullpush() {
  cmd_pull "$@"
  _pp_rc=$?
  echo
  cmd_push "$@"
  _pp_rc2=$?
  [ "$_pp_rc" = 0 ] && [ "$_pp_rc2" = 0 ] && return 0
  return 1
}

# _owner_cmd_prefix <repo>
#   The prefix a SUGGESTED command needs so the reader runs it as the repo
#   owner, or empty when they already are. my-git itself always goes through
#   run_as_owner; the commands it PRINTS were bare git, so pasting one as
#   root ran root's git in someone else's tree -- the exact thing that
#   leaves root-owned objects behind and breaks the owner's next commit.
_owner_cmd_prefix() {
  _ocp_gd=$1/.git
  [ -e "$_ocp_gd" ] || _ocp_gd=$1/${GIT_SIDECAR_DIRNAME:-.git.real}
  _ocp_o=$(file_owner "$_ocp_gd" 2>/dev/null)
  [ -n "$_ocp_o" ] && [ "$_ocp_o" != "$ME" ] && printf 'sudo -u %s ' "$_ocp_o"
}

push_one() {
  _r=$1
  PS_N_TOTAL=$((PS_N_TOTAL + 1))

  _gd_for_marker=$(_sm_resolve_gitdir "$_r/.git" "$_r" 2>/dev/null)
  if [ -n "$_gd_for_marker" ] && [ -e "$_gd_for_marker/$_sm_IGNORE_MARKER" ]; then
    if [ "${PS_FORCE:-0}" -eq 1 ]; then
      log_medium "$_r: ignore marker present, OVERRIDDEN by --force"
    else
      [ "$VRB" = 1 ] && log_medium "$_r: [ignored marker — skipping]"
      PS_N_IGNORED=$((PS_N_IGNORED + 1)); return 0
    fi
  fi

  # Local-only repos are the '⌂' rows in st. Not an error -- there is
  # simply nowhere to publish to.
  #
  # One 'git config --get' instead of 'git remote' AND a later
  # 'git remote get-url origin': as root each call is launchctl + sudo +
  # git, so a redundant one costs three processes per repo. Only when this
  # comes back empty do we ask the more expensive question, to tell "no
  # remotes at all" from "no remote named origin".
  _ps_url=$(run_as_owner_capture "$_r" git config --get remote.origin.url 2>/dev/null)
  if [ -z "$_ps_url" ] && [ -z "$(run_as_owner_capture "$_r" git remote 2>/dev/null)" ]; then
    [ "$VRB" = 1 ] && log_medium "$_r: [local-only (no remote) — nothing to publish]"
    PS_N_NOREMOTE=$((PS_N_NOREMOTE + 1)); return 0
  fi

  # ONE call for branch + upstream + ahead/behind, as pull, mc and st do.
  # '## <branch>...<upstream> [ahead N, behind M]', entries after.
  _sb_ps=$(run_as_owner_capture "$_r" git status -b --porcelain --ignore-submodules=dirty 2>/dev/null)
  _bline_ps=$_sb_ps
  case "$_sb_ps" in
    *"
"*) _bline_ps=${_sb_ps%%"
"*} ;;
  esac
  _hdr_ps=${_bline_ps#\#\# }
  _branch=${_hdr_ps%%...*}
  _branch=${_branch%% *}
  case "$_hdr_ps" in
    # Detached HEAD reads '## HEAD (no branch)'.
    "HEAD"*) _branch=HEAD ;;
  esac
  if [ -z "$_branch" ] || [ "$_branch" = HEAD ]; then
    log_warn "$_r: detached HEAD — not pushing"
    PS_N_SKIPPED=$((PS_N_SKIPPED + 1)); return 0
  fi
  _up=""
  case "$_hdr_ps" in
    *...*) _up=${_hdr_ps#*...}; _up=${_up%% *} ;;
  esac
  if [ -z "$_up" ]; then
    # Heal ONLY the safe half. If origin/<same-name> already exists, setting
    # tracking records a fact that is already true -- local config, nothing
    # leaves the machine. If it does NOT exist, a push would CREATE a branch
    # on the remote, which is publishing, not healing, and on a foreign
    # remote is not even yours to do. That half stays a human decision.
    # Ask the REMOTE, not refs/remotes/origin/*. A remote-tracking ref is a
    # cache of a past fetch and can outlive the branch by years: this repo
    # carries refs/remotes/origin/with-progress-bar and origin/master while
    # the remote has only main and progress-bar. Trusting the cache adopted
    # an upstream that does not exist -- which is how this comment got
    # written.
    if [ "${AUTOHEAL_UPSTREAM:-1}" = 1 ] \
       && [ -n "$(run_as_owner_capture "$_r" git ls-remote --heads origin "$_branch" 2>/dev/null)" ]; then
      # Fetch just that branch so the tracking ref exists to point at.
      run_as_owner "$_r" git fetch -q origin \
        "refs/heads/$_branch:refs/remotes/origin/$_branch" >/dev/null 2>&1
      if run_as_owner "$_r" git branch --set-upstream-to="origin/$_branch" "$_branch" >/dev/null 2>&1; then
        log_medium "$_r: tracked origin/$_branch (it already exists there; nothing published)"
        _up="origin/$_branch"
        # The header we parsed was read BEFORE the upstream existed, so its
        # ahead/behind is 0 by definition. Re-read it -- one extra call, and
        # only on the rare run that actually adopts a branch.
        _sb_ps=$(run_as_owner_capture "$_r" git status -b --porcelain --ignore-submodules=dirty 2>/dev/null)
        case "$_sb_ps" in
          *"
"*) _bline_ps=${_sb_ps%%"
"*} ;;
          *)   _bline_ps=$_sb_ps ;;
        esac
      fi
    fi
  fi
  if [ -z "$_up" ]; then
    log_major "$(printf '%-60s %s' "$_r" "branch \"$_branch\" has NO upstream -> skip")"
    printf '    > origin has no "%s" — pushing would CREATE it there, so my-git will not.\n' "$_branch"
    printf '    > publish it yourself:  %sgit -C %s push -u origin %s\n' \
      "$(_owner_cmd_prefix "$_r")" "$_r" "$_branch"
    PS_N_NOUPSTREAM=$((PS_N_NOUPSTREAM + 1)); return 0
  fi

  # Whose remote is it? Decided BEFORE any network work: pushing to a
  # project that is not yours fails with 403 after asking for credentials.
  # An empty pattern list matches nothing, which would silently reclassify
  # EVERY repo as foreign and refuse to push at all -- a config written
  # before these keys existed would quietly stop publishing your own work.
  # Say so once and behave as 'all' rather than blocking on a blank.
  if [ "${PUSH_REMOTE_SCOPE:-mine}" != all ] && [ -z "${MINE_URL_PATTERNS:-}" ]; then
    [ "${_ps_warned_patterns:-0}" = 1 ] || {
      log_warn "PUSH_REMOTE_SCOPE=mine but MINE_URL_PATTERNS is empty — your config predates it. Treating every remote as yours; add the key (see '$US --create-config') to filter foreign upstreams."
      _ps_warned_patterns=1
    }
  elif [ "${PUSH_REMOTE_SCOPE:-mine}" != all ]; then
    _ps_mine=0
    for _ps_pat in ${MINE_URL_PATTERNS:-}; do
      # Prefix, not substring: "https://github.com/Tormen/" must not match
      # "https://github.com/someone/fork-of-Tormen/...".
      case "$_ps_url" in "$_ps_pat"*) _ps_mine=1; break ;; esac
    done
    if [ "$_ps_mine" = 0 ]; then
      _ps_a=0
      case "$_bline_ps" in
        *"[ahead "*) _ps_a=${_bline_ps#*"[ahead "}; _ps_a=${_ps_a%%[!0-9]*} ;;
      esac
      if [ "${_ps_a:-0}" -gt 0 ]; then
        log_major "$(printf '%-60s %s' "$_r" "FOREIGN remote, $_ps_a local commit(s) -> not pushed")"
        printf '    > %s is not yours. Contribute deliberately when ready:\n' "$_ps_url"
        printf '        cd %s && %sgh pr create\n' "$_r" "$(_owner_cmd_prefix "$_r")"
        printf '    > or publish here anyway:  PUSH_REMOTE_SCOPE=all %s push go\n' "$US"
      else
        [ "$VRB" = 1 ] && log_medium "$_r: foreign remote, nothing local — skipping"
      fi
      PS_N_FOREIGN=$((PS_N_FOREIGN + 1)); return 0
    fi
  fi

  # Already in the status header -- no extra call.
  _ahead=0; _behind=0
  case "$_bline_ps" in
    *"[ahead "*) _ahead=${_bline_ps#*"[ahead "}; _ahead=${_ahead%%[!0-9]*} ;;
  esac
  case "$_bline_ps" in
    *"behind "*) _behind=${_bline_ps#*"behind "}; _behind=${_behind%%[!0-9]*} ;;
  esac
  [ -n "$_ahead" ] || _ahead=0
  [ -n "$_behind" ] || _behind=0

  if [ "$_ahead" -eq 0 ]; then
    [ "$VRB" = 1 ] && log_medium "$_r: up to date with $_up"
    PS_N_UPTODATE=$((PS_N_UPTODATE + 1)); return 0
  fi
  # Behind as well as ahead: pushing would be rejected as non-fast-forward.
  # Say so instead of letting git fail one repo at a time.
  if [ "$_behind" -gt 0 ]; then
    log_major "$(printf '%-60s %s' "$_r" "DIVERGED ($_ahead ahead, $_behind behind) -> skip")"
    printf '    > pull first:  %s pull go\n' "$US"
    PS_N_DIVERGED=$((PS_N_DIVERGED + 1)); return 0
  fi

  if [ "$DRY_RUN" = 1 ]; then
    log_major "$(printf '%-60s %s' "$_r" "ahead $_ahead -> would push to $_up")"
    PS_N_WOULD=$((PS_N_WOULD + 1)); return 0
  fi

  if [ "$INTERACTIVE" = 1 ]; then
    _ans=$(_sm_ask "    $_r: push $_ahead commit(s) to $_up? [Y]es / [S]kip / [A]bort [Y/s/a]: ")
    case "$_ans" in
      a|A) log_major "$_r: [ABORT requested]"; return 77 ;;
      s|S|n|N) log_major "$_r: skipped (push)"; PS_N_SKIPPED=$((PS_N_SKIPPED + 1)); return 0 ;;
    esac
  fi
  # GIT_TERMINAL_PROMPT=0: an https remote with no credential helper makes
  # git stop and ask "Username for 'https://github.com':" -- in the middle
  # of a tree-wide run, on a repo the user may not even have been thinking
  # about, with 20 more waiting behind it. Fail that repo loudly and keep
  # going instead of blocking the whole tree on a prompt.
  if _ps_err=$(run_as_owner "$_r" env GIT_TERMINAL_PROMPT=0 git push 2>&1); then
    log_ok "push: $_r — $_ahead commit(s) published to $_up"
    PS_N_PUSHED=$((PS_N_PUSHED + 1)); return 0
  fi
  log_fail "push: $_r — git push to $_up FAILED"
  case "$_ps_err$_ps_url" in
    *terminal\ prompts\ disabled*|*Authentication\ failed*|*could\ not\ read\ Username*)
      printf '    > %s needs credentials my-git will not stop and ask for.\n' "$_ps_url"
      printf '    > ssh already works here; switch this repo over:\n'
      printf '        %sgit -C %s remote set-url origin %s\n' "$(_owner_cmd_prefix "$_r")" "$_r" \
        "$(printf '%s' "$_ps_url" | sed -e 's|^https://github.com/|git@github.com:|')" ;;
    *) printf '    > %s\n' "$(printf '%s' "$_ps_err" | tail -n 2 | tr '\n' ' ')"
       printf '    > if the remote moved on: %s pull go\n' "$US" ;;
  esac
  PS_N_ERROR=$((PS_N_ERROR + 1)); return 1
}

cmd_push() {
  _ps_mode=analyze
  PS_FORCE=0
  PS_SM_ONLY=0
  PS_SH_ONLY=0
  _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help push; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose) VERYVRB=1 ;;
      -D|--debug)   DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      go)           _ps_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _ps_mode=analyze ;;
      -i|--interactive) INTERACTIVE=1; require_tty push ;;
      --sm|--sub-modules|--submodules) PS_SM_ONLY=1 ;;
      --sh|--shadowed)                 PS_SH_ONLY=1 ;;
      --force)      PS_FORCE=1 ;;
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "push: unknown option: $1" 64 ;;
      *)            _args="$_args $(shell_escape "$1")" ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"
  if [ "$_ps_mode" = "go" ]; then DRY_RUN=0; else DRY_RUN=1; fi

  _roots=$(resolve_scope "$@") || exit 1
  [ -z "$_roots" ] && { log_error "no repositories to push"; exit 1; }

  PS_N_TOTAL=0; PS_N_PUSHED=0; PS_N_WOULD=0; PS_N_UPTODATE=0
  PS_N_NOREMOTE=0; PS_N_NOUPSTREAM=0; PS_N_DIVERGED=0
  PS_N_SKIPPED=0; PS_N_IGNORED=0; PS_N_ERROR=0; PS_N_FOREIGN=0

  _rc_total=0
  _rtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.psroots.XXXXXX")
  trap 'rm -f "$_rtmp"' EXIT INT TERM HUP
  printf '%s\n' "$_roots" > "$_rtmp"
  while IFS= read -r _root <&8; do
    [ -n "$_root" ] || continue
    priv_gate "$_root"
    case "$PRIV_ACTION" in
      skip) continue ;;
      warn) log_major "$_root: [SKIPPED — cross-user policy]"
            _gated_subtree_hint "$_root"; continue ;;
    esac
    _nodes=$(select_tree_nodes "$_root" "$PS_SM_ONLY" "$PS_SH_ONLY")
    _ntmp=$(mktemp "${TMPDIR:-/tmp}/${US}.psnodes.XXXXXX")
    printf '%s\n' "$_nodes" > "$_ntmp"
    # fd 9: git push through su/sudo reads stdin (see the pull loop).
    _abort_requested=0
    while IFS= read -r _node <&9; do
      [ -n "$_node" ] || continue
      [ "$_abort_requested" = 1 ] && continue
      push_one "$_node"
      case "$?" in
        0)  : ;;
        77) _abort_requested=1 ;;
        *)  _rc_total=1 ;;
      esac
    done 9< "$_ntmp"
    rm -f "$_ntmp"
  done 8< "$_rtmp"
  rm -f "$_rtmp"

  echo
  if [ "$DRY_RUN" = 1 ]; then
    log_major "push: analyze summary"
  else
    log_major "push: summary"
  fi
  _p=""
  [ "$PS_N_WOULD"      -gt 0 ] && _p="$_p would-push=$PS_N_WOULD"
  [ "$PS_N_PUSHED"     -gt 0 ] && _p="$_p pushed=$PS_N_PUSHED"
  [ "$PS_N_UPTODATE"   -gt 0 ] && _p="$_p up-to-date=$PS_N_UPTODATE"
  [ "$PS_N_NOREMOTE"   -gt 0 ] && _p="$_p local-only=$PS_N_NOREMOTE"
  [ "$PS_N_NOUPSTREAM" -gt 0 ] && _p="$_p no-upstream=$PS_N_NOUPSTREAM"
  [ "$PS_N_DIVERGED"   -gt 0 ] && _p="$_p diverged=$PS_N_DIVERGED"
  [ "$PS_N_FOREIGN"    -gt 0 ] && _p="$_p foreign=$PS_N_FOREIGN"
  [ "$PS_N_IGNORED"    -gt 0 ] && _p="$_p ignored=$PS_N_IGNORED"
  [ "$PS_N_SKIPPED"    -gt 0 ] && _p="$_p skipped=$PS_N_SKIPPED"
  [ "$PS_N_ERROR"      -gt 0 ] && _p="$_p FAILED=$PS_N_ERROR"
  [ -z "$_p" ] && _p=" (nothing to do)"
  printf '  %s>> total=%s:%s%s\n' "$C_BLUE" "$PS_N_TOTAL" "$_p" "$C_RESET"
  if [ "$DRY_RUN" = 1 ] && [ "$PS_N_WOULD" -gt 0 ]; then
    printf '  %s>> apply:       %s push go%s\n' "$C_BLUE" "$US" "$C_RESET"
  fi
  printf '  %s>> for details: %s st%s\n' "$C_BLUE" "$US" "$C_RESET"
  return $_rc_total
}

pull_one() {
  _r=$1
  PL_N_TOTAL=$((PL_N_TOTAL + 1))

  # Before pulling, make sure this repo CAN pull: since git 2.27 a diverged
  # branch aborts with "Need to specify how to reconcile divergent
  # branches" unless a strategy is configured. Only fills the gap when
  # there is one -- an existing preference is an answer, and is left alone.
  _pl_healed=$(autoheal_pull_strategy "$_r")
  [ -n "$_pl_healed" ] && log_medium "$_r: set pull strategy to ${AUTOHEAL_PULL_STRATEGY-merge} (none was configured)"

  # Honor the ignore marker.
  _gd_for_marker=$(_sm_resolve_gitdir "$_r/.git" "$_r" 2>/dev/null)
  if [ -n "$_gd_for_marker" ] && [ -e "$_gd_for_marker/$_sm_IGNORE_MARKER" ]; then
    if [ "${PL_FORCE:-0}" -eq 1 ]; then
      log_medium "$_r: ignore marker present, OVERRIDDEN by --force"
    else
      [ "$VRB" = 1 ] && log_medium "$_r: [ignored marker — skipping]"
      PL_N_IGNORED=$((PL_N_IGNORED + 1))
      return 0
    fi
  fi

  # No remote → nothing to fetch.
  _remotes=$(run_as_owner_capture "$_r" git remote 2>/dev/null)
  if [ -z "$_remotes" ]; then
    [ "$VRB" = 1 ] && log_medium "$_r: [no remote — skipping]"
    PL_N_NOREMOTE=$((PL_N_NOREMOTE + 1))
    return 0
  fi

  # Fetch (always runs — read-only).
  if [ "$_pl_mode" = "go" ] || [ "${PL_FETCH_ONLY:-0}" = 1 ] || [ "$DRY_RUN" != 1 ]; then
    # In analyze mode we also fetch so the ff/diverged/behind status
    # reflects the real upstream — otherwise analyze is meaningless
    # when stale. Only skipped when user asks for pure no-network mode
    # (not currently exposed; all modes fetch).
    if ! run_as_owner "$_r" git fetch --quiet --all --prune 2>/dev/null; then
      log_error "$_r: git fetch failed"
      PL_N_ERROR=$((PL_N_ERROR + 1))
      return 1
    fi
  fi

  # ONE call for all four questions -- branch, does an upstream exist, how
  # far ahead/behind, and is the worktree dirty. '-b' prepends
  #   ## <branch>...<upstream> [ahead N, behind M]
  # and the entries follow. This replaced rev-parse + 'branch -a' +
  # rev-list + status; 'branch -a' in particular enumerated every ref,
  # remote ones included, to answer one yes/no. Same shape st and mc use.
  _sb_pl=$(run_as_owner_capture "$_r" git status -b --porcelain --ignore-submodules=dirty 2>/dev/null)
  _bline_pl=$_sb_pl
  _porc=""
  case "$_sb_pl" in
    *"
"*) _bline_pl=${_sb_pl%%"
"*}
        _porc=${_sb_pl#*"
"} ;;
  esac
  _hdr_pl=${_bline_pl#\#\# }
  _branch=${_hdr_pl%%...*}
  _branch=${_branch%% *}
  _rem_ref=origin/$_branch
  case "$_hdr_pl" in
    *...*) _has_remote=1 ;;
    *)     _has_remote="" ;;
  esac
  if [ -z "$_has_remote" ]; then
    _desc="fetched; no origin/$_branch tracking ref"
    _action=noop
  else
    _ahead=0; _behind=0
    case "$_bline_pl" in
      *"[ahead "*) _ahead=${_bline_pl#*"[ahead "}; _ahead=${_ahead%%[!0-9]*} ;;
    esac
    case "$_bline_pl" in
      *"behind "*) _behind=${_bline_pl#*"behind "}; _behind=${_behind%%[!0-9]*} ;;
    esac
    [ -n "$_ahead" ] || _ahead=0
    [ -n "$_behind" ] || _behind=0
    if [ -n "$_porc" ]; then
      _desc="DIRTY (${_ahead:-0}/${_behind:-0} ahead/behind)"
      _action="skip (worktree dirty)"
    elif [ "${_behind:-0}" -gt 0 ] && [ "${_ahead:-0}" -gt 0 ]; then
      _desc="DIVERGED (ahead=$_ahead behind=$_behind)"
      _action="skip (manual merge needed)"
    elif [ "${_behind:-0}" -gt 0 ]; then
      _desc="behind=$_behind"
      _action="ff-merge"
    elif [ "${_ahead:-0}" -gt 0 ]; then
      _desc="ahead=$_ahead"
      _action="noop (nothing to pull)"
    else
      _desc="CLEAN :))"
      _action=noop
    fi
  fi

  # Analyze mode — print and bail.
  if [ "$DRY_RUN" = 1 ]; then
    printf ' >>> %-60s %-32s -> %s\n' "$_r" "$_desc" "$_action"
    case "$_action" in
      noop*|"skip (worktree dirty)"|"skip (manual merge needed)")
        PL_N_CLEAN=$((PL_N_CLEAN + 1)) ;;
      ff-merge)
        PL_N_WOULD_FF=$((PL_N_WOULD_FF + 1)) ;;
    esac
    return 0
  fi

  # go mode.
  case "$_action" in
    noop*)
      log_major "$_r: $_desc"
      PL_N_CLEAN=$((PL_N_CLEAN + 1))
      return 0
      ;;
    "skip (worktree dirty)")
      log_major "$_r: $_desc (dirty — commit or stash, then re-run)"
      PL_N_SKIPPED=$((PL_N_SKIPPED + 1))
      return 0
      ;;
    "skip (manual merge needed)")
      log_major "$_r: $_desc (resolve manually: git merge / git rebase)"
      PL_N_SKIPPED=$((PL_N_SKIPPED + 1))
      return 0
      ;;
  esac

  # ff-merge.
  if [ "${PL_FETCH_ONLY:-0}" = 1 ]; then
    log_major "$_r: fetched ($_desc), --fetch-only → not merging"
    PL_N_CLEAN=$((PL_N_CLEAN + 1))
    return 0
  fi
  if [ "$INTERACTIVE" = 1 ]; then
    _ans=$(_sm_ask "    $_r: fast-forward $_behind commit(s)? [Y]es / [S]kip / [A]bort [Y/s/a]: ")
    case "$_ans" in
      a|A) log_major "$_r: [ABORT requested]"; return 77 ;;
      s|S|n|N) log_major "$_r: skipped (ff-merge)"; PL_N_SKIPPED=$((PL_N_SKIPPED + 1)); return 0 ;;
    esac
  fi
  if run_as_owner "$_r" git merge --ff-only --quiet "$_rem_ref" 2>/dev/null; then
    log_major "$_r: $(c_green 'DONE :))') (fast-forwarded $_behind commit(s))"
    PL_N_FFD=$((PL_N_FFD + 1))
    return 0
  else
    log_error "$_r: ff-merge failed"
    PL_N_ERROR=$((PL_N_ERROR + 1))
    return 1
  fi
}

cmd_pull() {
  _pl_mode=analyze
  PL_FORCE=0
  PL_FETCH_ONLY=0
  PL_SM_ONLY=0
  PL_SH_ONLY=0
  _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help pull; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose)          VERYVRB=1 ;;
      -D|--debug)   DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      go)           _pl_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _pl_mode=analyze ;;
      -i|--interactive) INTERACTIVE=1; require_tty pull ;;
      --sm|--sub-modules|--submodules) PL_SM_ONLY=1 ;;
      --sh|--shadowed)                 PL_SH_ONLY=1 ;;
      --force)          PL_FORCE=1 ;;
      --fetch-only)     PL_FETCH_ONLY=1 ;;
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "pull: unknown option: $1" 64 ;;
      *)            _args="$_args $(shell_escape "$1")" ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"
  if [ "$_pl_mode" = "go" ]; then DRY_RUN=0; else DRY_RUN=1; fi

  _roots=$(resolve_scope "$@") || exit 1
  [ -z "$_roots" ] && { log_error "no repositories to pull"; exit 1; }

  PL_N_TOTAL=0; PL_N_CLEAN=0; PL_N_FFD=0; PL_N_WOULD_FF=0
  PL_N_SKIPPED=0; PL_N_IGNORED=0; PL_N_NOREMOTE=0; PL_N_ERROR=0

  _rc_total=0
  _rtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.roots.XXXXXX")
  trap 'rm -f "$_rtmp"' EXIT INT TERM HUP
  printf '%s\n' "$_roots" > "$_rtmp"
  while IFS= read -r _root; do
    [ -n "$_root" ] || continue
    priv_gate "$_root"
    case "$PRIV_ACTION" in
      skip) continue ;;
      warn) log_major "$_root: [SKIPPED — cross-user policy]"
            _gated_subtree_hint "$_root"; continue ;;
    esac
    # The whole tree by default. Pulling ONE repo is what plain git already
    # does; my-git exists for the multitude, and 'st' -- the command people
    # read first -- has always been tree-wide. A single-level pull on a tree
    # of 42 repos reported "total=1" and looked like a no-op success.
    # Parents first either way, so a submodule's gitlink target resolves
    # before we reach it.
    _nodes=$(select_tree_nodes "$_root" "$PL_SM_ONLY" "$PL_SH_ONLY")
    _ntmp=$(mktemp "${TMPDIR:-/tmp}/${US}.nodes.XXXXXX")
    printf '%s\n' "$_nodes" > "$_ntmp"
    _abort_requested=0
    # Read the node list on fd 9, not stdin. pull_one runs git through
    # run_as_owner_capture -- su/sudo -- which read stdin; on stdin they
    # swallow the remaining nodes and the walk ends early with no error at
    # all. It looked like a clean "total=3" on a tree of 42.
    while IFS= read -r _node <&9; do
      [ -n "$_node" ] || continue
      [ "$_abort_requested" = 1 ] && continue
      pull_one "$_node"
      _rc=$?
      case "$_rc" in
        0)  : ;;
        77) _abort_requested=1 ;;
        *)  _rc_total=1 ;;
      esac
    done 9< "$_ntmp"
    rm -f "$_ntmp"
    if [ "$_abort_requested" = 1 ]; then
      rm -f "$_rtmp"
      log_major "pull: ABORT requested — stopping."
      return 77
    fi
  done < "$_rtmp"
  rm -f "$_rtmp"

  # Summary.
  echo
  if [ "$_pl_mode" = "go" ]; then
    log_major "pull: summary"
    _p=""
    [ "$PL_N_CLEAN" -gt 0 ]    && _p="$_p clean=$PL_N_CLEAN"
    [ "$PL_N_FFD" -gt 0 ]      && _p="$_p fast-forwarded=$PL_N_FFD"
    [ "$PL_N_SKIPPED" -gt 0 ]  && _p="$_p skipped=$PL_N_SKIPPED"
    [ "$PL_N_IGNORED" -gt 0 ]  && _p="$_p ignored=$PL_N_IGNORED"
    [ "$PL_N_NOREMOTE" -gt 0 ] && _p="$_p no-remote=$PL_N_NOREMOTE"
    [ "$PL_N_ERROR" -gt 0 ]    && _p="$_p $(c_red "errors=$PL_N_ERROR")"
    [ -z "$_p" ] && _p=" (nothing to do)"
    printf '  %s>> total=%s:%s%s\n' "$C_BLUE" "$PL_N_TOTAL" "$_p" "$C_RESET"
  else
    log_major "pull: analyze summary"
    _p=""
    [ "$PL_N_CLEAN" -gt 0 ]    && _p="$_p clean=$PL_N_CLEAN"
    [ "$PL_N_WOULD_FF" -gt 0 ] && _p="$_p would-ff=$PL_N_WOULD_FF"
    [ "$PL_N_IGNORED" -gt 0 ]  && _p="$_p ignored=$PL_N_IGNORED"
    [ "$PL_N_NOREMOTE" -gt 0 ] && _p="$_p no-remote=$PL_N_NOREMOTE"
    [ "$PL_N_ERROR" -gt 0 ]    && _p="$_p $(c_red "errors=$PL_N_ERROR")"
    [ -z "$_p" ] && _p=" (nothing to do)"
    printf '  %s>> total=%s:%s%s\n' "$C_BLUE" "$PL_N_TOTAL" "$_p" "$C_RESET"
    printf '  %s>> apply:       %s pull go%s\n' "$C_BLUE" "$US" "$C_RESET"
    printf '  %s>> for details: %s st%s\n' "$C_BLUE" "$US" "$C_RESET"
  fi
  return $_rc_total
}

# ═════════════════════════════════════════════════════════════════════════
# ═══ FLATTEN (merge nested git repos into outer as content) ═════════════
# ═════════════════════════════════════════════════════════════════════════
#
# my-git flatten [go|-T] [-i] [--rm-git]
#
# Converts every nested .git under the current super-repo into plain
# content of the super. Default mode keeps each nested .git INTACT
# (briefly moves .git outside the worktree, commits the content, moves
# each .git back); --rm-git irreversibly deletes the nested .git dirs.
# Must run from the repo's toplevel.
cmd_flatten() {
  # _fl_build_paths_argv: compute the list of paths flatten ACTUALLY
  # touches — strip '/.git' from each nested entry (so 'it/foo/.git'
  # becomes 'it/foo', the directory containing the files we want to
  # add), then union with orphan gitlink paths (already without /.git),
  # dedup, and build a shell-escaped argv string in $_fl_argv.
  # Used by the add/commit phase so we pass ONLY flatten's paths to
  # 'git add --' and 'git commit --only --', leaving any unrelated
  # user changes untouched.
  # _fl_build_paths_argv sets:
  #   $_fl_paths_raw  — newline-separated list of unique paths (for
  #                     iteration in error-restore and empty-dir filter)
  #   $_fl_argv       — shell-escaped argv string for 'eval git ...'
  _fl_build_paths_argv() {
    _fl_paths_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.flpaths.XXXXXX") || return 1
    {
      printf '%s\n' "$_fl_nested" | sed 's|/\.git$||'
      printf '%s\n' "$_fl_orphan"
      printf '%s\n' "${_fl_realized:-}"
    } | grep -v '^$' | sort -u > "$_fl_paths_tmp"
    _fl_paths_raw=$(cat "$_fl_paths_tmp")
    _fl_argv=""
    while IFS= read -r _p; do
      [ -n "$_p" ] || continue
      _fl_argv="$_fl_argv $(shell_escape "$_p")"
    done < "$_fl_paths_tmp"
    rm -f "$_fl_paths_tmp"
    [ -n "$_fl_argv" ]
  }

  # After 'git add', some paths may have staged nothing (e.g. a nested
  # repo dir that contained ONLY .git and no other files — once .git is
  # moved out, the dir is empty; git tracks no empty dirs). Filter
  # $_fl_paths_raw / $_fl_argv down to paths that have at least one
  # staged entry under them. Without this, 'git commit --only -- <dir>'
  # errors 'pathspec did not match any file(s) known to git' for empty
  # nested dirs and the whole flatten rolls back.
  _fl_filter_to_staged() {
    _fl_keep_raw=""
    _fl_keep_argv=""
    while IFS= read -r _p; do
      [ -n "$_p" ] || continue
      if git diff --cached --name-only -- "$_p" 2>/dev/null | grep -q .; then
        _fl_keep_raw="$_fl_keep_raw$_p
"
        _fl_keep_argv="$_fl_keep_argv $(shell_escape "$_p")"
      fi
    done <<_EOF
$_fl_paths_raw
_EOF
    _fl_paths_raw=$_fl_keep_raw
    _fl_argv=$_fl_keep_argv
  }

  # _fl_add_paths_robust
  # Adds each path in $_fl_paths_raw INDIVIDUALLY rather than one
  # atomic batch command — a single problematic path must not sink
  # every other path in the same run. The most common individual
  # failure: a deeply-nested item whose ENCLOSING parent is itself
  # still an intact, untouched repo boundary (e.g. 'src' was left as
  # 'skip' while 'src/,github/my-otr/my-otr' was chosen 'realize') —
  # git correctly refuses ("fatal: Pathspec '...' is in submodule
  # '...'") since it can't add into another repo's boundary from
  # outside it. That's expected here, not a bug: the per-item
  # filesystem action (e.g. realize's rename to GIT_SIDECAR_DIRNAME)
  # already happened and stands on its own regardless; only "track it
  # as content in THIS repo's index right now" isn't possible until
  # the enclosing parent is itself flattened/realized/deleted — after
  # which a follow-up flatten run picks it up normally. Sets
  # $_fl_paths_raw / $_fl_argv to just the paths that DID stage
  # successfully, for the rest of the flow (_fl_filter_to_staged,
  # commit) to use. Returns 1 only if EVERY path failed.
  _fl_add_paths_robust() {
    _fl_add_ok_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.fladdok.XXXXXX") || return 1
    _fl_add_failed_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.fladdfail.XXXXXX") || return 1
    : > "$_fl_add_ok_tmp"; : > "$_fl_add_failed_tmp"
    while IFS= read -r _fap; do
      [ -n "$_fap" ] || continue
      if [ -e "$_fap/.git" ]; then
        # Still its own live, untouched embedded repo — e.g. an orphan
        # gitlink path that's ALSO ignore-marked/skip-chosen, present
        # in $_fl_paths_raw only for the earlier unstage bookkeeping,
        # never individually realized/flattened (which always renames
        # or removes .git). Never 'git add' such a path: at best git
        # would just re-stage it as a fresh gitlink (undoing the
        # unstage this same run just did), at worst it's the exact
        # embedded-repo conflict this whole function exists to avoid.
        # Simply not part of this run's content set — skip silently.
        continue
      fi
      _fap_errlog=$(mktemp "${TMPDIR:-/tmp}/${US}.fladderr.XXXXXX")
      # CRITICAL: exclude every GIT_SIDECAR_DIRNAME found anywhere under
      # this path before adding. GIT_SIDECAR_DIRNAME isn't literally named
      # '.git', so git does NOT recognize it as a repository boundary —
      # left unexcluded, 'git add' walks straight into it and stages
      # its ENTIRE git database (HEAD, objects/, refs/, config,
      # the lot) as ordinary tracked blobs in THIS repo's own history.
      # This is not hypothetical: confirmed by direct testing, and it
      # happens with or without -f — a pre-existing gap, not something
      # -f introduced. Enumerate actual on-disk GIT_SIDECAR_DIRNAME
      # directories rather than relying on a glob pathspec: '**' does
      # not reliably match zero intervening path segments here, so a
      # glob-only exclusion would miss the exact case of $_fap being
      # the realized item itself (the most common case).
      _fl_realdirs_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.flrealdirs.XXXXXX")
      find "$_fap" -type d -name "$GIT_SIDECAR_DIRNAME" 2>/dev/null > "$_fl_realdirs_tmp"
      # advice.addEmbeddedRepo=false: the content being added can contain a
      # further nested live repo — silence git's long embedded-repo hint
      # (my-git handles nesting deliberately). See shadow for the same.
      set -- run git -c advice.addEmbeddedRepo=false add -f -- "$_fap"
      while IFS= read -r _fl_rd; do
        [ -n "$_fl_rd" ] || continue
        set -- "$@" ":(exclude)$_fl_rd"
      done < "$_fl_realdirs_tmp"
      rm -f "$_fl_realdirs_tmp"
      # -f: a path reaching this point is a DELIBERATE flatten/realize
      # target — the person (or AUTO_SIDECAR_EMBEDDED) already decided
      # its content should become tracked. A .gitignore rule matching
      # it (common for paths that were previously embedded/nested —
      # people often .gitignore exactly the directories they don't
      # expect git to see directly) must not silently block that
      # decision; 'skip' is the mechanism for genuinely excluding a
      # path, not an incidental .gitignore match on one just chosen
      # for flatten/realize.
      if "$@" 2>"$_fap_errlog"; then
        printf '%s\n' "$_fap" >> "$_fl_add_ok_tmp"
      else
        printf '%s\n' "$_fap" >> "$_fl_add_failed_tmp"
        if grep -q "is in submodule" "$_fap_errlog" 2>/dev/null; then
          log_warn "$_fap: still lives inside an untouched enclosing repo — skipped for now (its own change, if any, already happened on disk; re-run flatten after sidecaring/flattening the enclosing repo to pick this up)"
        else
          log_warn "$_fap: git add failed —"
          sed 's/^/    /' "$_fap_errlog" >&2
        fi
      fi
      rm -f "$_fap_errlog"
    done <<_FL_ADD_EOF
$_fl_paths_raw
_FL_ADD_EOF
    _fl_paths_raw=$(cat "$_fl_add_ok_tmp")
    _fl_argv=""
    while IFS= read -r _p; do
      [ -n "$_p" ] || continue
      _fl_argv="$_fl_argv $(shell_escape "$_p")"
    done < "$_fl_add_ok_tmp"
    _fl_n_add_failed=$(grep -c . "$_fl_add_failed_tmp" 2>/dev/null)
    _fl_n_add_ok=$(grep -c . "$_fl_add_ok_tmp" 2>/dev/null)
    rm -f "$_fl_add_ok_tmp" "$_fl_add_failed_tmp"
    [ "$_fl_n_add_ok" -gt 0 ]
  }


  # _fl_write_msg_file <subject>
  # Composes the commit message file: subject line, blank line, then a
  # '#'-prefixed body listing the nested repos merged (or deleted) and
  # the orphan gitlinks unstaged. Sets _fl_msgfile to the tmp path.
  _fl_write_msg_file() {
    _fl_msgfile=$(mktemp "${TMPDIR:-/tmp}/${US}.flmsg.XXXXXX") || return 1
    {
      printf '%s\n\n' "$1"
      if [ -n "${_fl_realized:-}" ]; then
        printf '# Nested repo(s) sidecared (git history relocated to <path>/%s,\n' "$GIT_SIDECAR_DIRNAME"
        printf '# self-contained and portable — no live .git left, no longer dependent\n'
        printf '# on this parent'\''s .git):\n'
        printf '%s\n' "$_fl_realized" | while IFS= read -r _r; do
          [ -n "$_r" ] && printf '#   %s\n' "$_r"
        done
      fi
      if [ "$_fl_n_nested" -gt 0 ]; then
        [ -n "${_fl_realized:-}" ] && printf '#\n'
        if [ "$_fl_rmgit" = 1 ]; then
          printf '# Nested repos merged as content (child .git DELETED):\n'
        else
          printf '# Nested repos merged as content (child .git kept on disk):\n'
        fi
        printf '%s\n' "$_fl_nested" | sed 's|/\.git$||' | while IFS= read -r _n; do
          [ -n "$_n" ] && printf '#   %s\n' "$_n"
        done
      fi
      if [ "$_fl_n_orphan" -gt 0 ]; then
        [ "$_fl_n_nested" -gt 0 ] && printf '#\n'
        printf '# Orphan gitlinks unstaged (had 160000 index entries but no .gitmodules record):\n'
        printf '%s\n' "$_fl_orphan" | while IFS= read -r _p; do
          [ -n "$_p" ] && printf '#   %s\n' "$_p"
        done
      fi
    } > "$_fl_msgfile"
  }

  # _fl_submodule_initialized <path>
  # A registered submodule that was never 'init'ed/cloned has no .git
  # file/dir at all in its path. Nothing to realize or flatten there —
  # callers must offer skip/deregister instead.
  _fl_submodule_initialized() {
    [ -e "$1/.git" ]
  }

  # _fl_write_sidecar_status <path> <gitdir> <was-submodule 0|1> [<sub-name>] [<sub-url>]
  # Writes <path>/$GIT_SIDECAR_DIRNAME.status — an ORDINARY, parent-tracked
  # text file (lives directly under <path>, so 'flatten's own 'git add -f
  # -- <path>' sweeps it up like any other file; it is NOT inside
  # $GIT_SIDECAR_DIRNAME itself, which stays excluded from the parent's
  # index). $GIT_SIDECAR_DIRNAME is already the authoritative git history —
  # this file exists purely so a human browsing the parent tree can see
  # the sidecar's live state without '--git-dir' tricks. Restoring
  # core.worktree/core.bare is NOT this file's job: 'unflatten --sidecar'
  # just unsets both unconditionally (correct once relocated back to a
  # plain <path>/.git — see _unfl_restore_sidecar for why the values
  # realize touches aren't meaningful to carry forward).
  # last-published-to-parent starts equal to sidecar-since; the 'ga' shell
  # alias bumps it whenever it force-adds new content under a sidecar path.
  # _fl_capture_and_remove_gitfiles <path>
  # Captures AND removes every '.git*'-prefixed regular file directly
  # under <path> — '.gitignore', '.gitattributes', '.gitmodules', or any
  # other such convention file that happens to exist — EXCEPT the
  # git-dir/sidecar/snapshot names themselves (GIT_SIDECAR_DIRNAME,
  # GIT_SIDECAR_DIRNAME.status, .git.merged), which are never ordinary
  # content and are handled elsewhere entirely. Deliberately generic
  # rather than a hand-picked list: whatever git-config-like dotfile
  # shows up here, it gets captured either way.
  # ALWAYS captures AND removes together, never one without the other —
  # capturing something that stays live would just create a stale
  # second copy for no reason (this is why _fl_write_sidecar_status,
  # which never removes these files, does NOT call this at all: nothing
  # is being finalized there, so there's nothing to capture yet).
  # Only called from _fl_write_merge_snapshot: these files govern a live
  # git identity that no longer exists here, so their old rules (e.g. an
  # inherited .gitignore silently blocking future files under plain
  # 'git add -A' forever) must not survive as silent, unexplained
  # leftovers. Captured first, so nothing is actually lost by removing
  # them. NOTE: if the path had its own registered sub-submodules,
  # removing its .gitmodules is harmless in practice — a nested
  # .gitmodules is already inert to any OTHER repo's git (only ever read
  # at a repo's own toplevel), and the sub-submodule's own data lives at
  # its own path on disk, entirely independent of this one's index.
  _fl_capture_and_remove_gitfiles() {
    _cgf_path=$1
    # NOTE: usually called inside a '{ ... } > .git.merged' redirect, so
    # the header/cat output below lands in the snapshot file. log_dbg_med
    # writes to stderr (>&2), so DBG lines here are safe — they never
    # leak into the captured file.
    for _cgf_f in "$_cgf_path"/.git*; do
      [ -f "$_cgf_f" ] || continue
      _cgf_base=$(basename "$_cgf_f")
      case "$_cgf_base" in
        .git.merged) log_dbg_minor "capture: skip $_cgf_f (it IS the snapshot file)"; continue ;;
        "$GIT_SIDECAR_DIRNAME"|"$GIT_SIDECAR_DIRNAME.status")
          log_dbg_minor "capture: skip $_cgf_f (sidecar dir/status — handled separately)"; continue ;;
      esac
      log_dbg_med "capture+remove $_cgf_f (folding its content into .git.merged, then deleting so it can't govern a now-defunct git identity)"
      printf -- '--- %s content at this time ---\n' "$_cgf_base"
      cat "$_cgf_f" 2>/dev/null
      printf '\n'
      run rm -f -- "$_cgf_f"
    done
  }

  _fl_write_sidecar_status() {
    _sst_path=$1
    _sst_gitdir=$2
    _sst_was_sub=$3
    _sst_sub_name=$4
    _sst_sub_url=$5
    _sst_file="$_sst_path/$GIT_SIDECAR_DIRNAME.status"
    _sst_now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    _sst_branch=$(run git --git-dir="$_sst_gitdir" symbolic-ref --short -q HEAD 2>/dev/null)
    _sst_commit=$(run git --git-dir="$_sst_gitdir" rev-parse HEAD 2>/dev/null)
    if [ -z "$_sst_commit" ]; then
      log_warn "$_sst_path: sidecar status — could not read HEAD commit from gitdir '$_sst_gitdir' (is it a valid git dir?); snapshot will record empty branch/commit"
    fi
    log_dbg_med "sidecar status: $_sst_path (gitdir=$_sst_gitdir branch='$_sst_branch' commit=$_sst_commit was_sub=$_sst_was_sub) -> $_sst_file"
    [ -n "$_sst_branch" ] || _sst_branch="(detached) $_sst_commit"
    _sst_subject=$(run git --git-dir="$_sst_gitdir" log -1 --pretty=%s 2>/dev/null)
    _sst_remote=$(run git --git-dir="$_sst_gitdir" config --get remote.origin.url 2>/dev/null)
    _sst_dirty=no
    [ -n "$(run git --git-dir="$_sst_gitdir" --work-tree="$_sst_path" status --porcelain 2>/dev/null)" ] && _sst_dirty=yes
    {
      printf '# my-git sidecar snapshot for %s -- written by "flatten --sidecar".\n' "$_sst_path"
      printf '# %s is the authoritative git history; this file is an ordinary,\n' "$GIT_SIDECAR_DIRNAME"
      printf '# parent-tracked record of its live state -- quick reference without\n'
      printf '# --git-dir tricks, and what "unflatten --sidecar" needs to restore it.\n'
      printf '# Point-in-time except last-published-to-parent (bumped by the ga alias).\n\n'
      printf '# Undo with:  %s unflatten --sidecar %s\n\n' "$US" "$_sst_path"
      printf 'sidecar-gitdir: %s/%s/%s\n' "$_fl_top" "$_sst_path" "$GIT_SIDECAR_DIRNAME"
      printf 'content-tracked-by-repo: %s\n' "$_fl_top"
      printf '#   ^ sidecar-gitdir holds this repo OWN history; content-tracked-by-repo\n'
      printf '#     is the OTHER repo whose index carries these files as plain content.\n\n'
      printf 'sidecar-since: %s\n' "$_sst_now"
      printf 'last-published-to-parent: %s\n\n' "$_sst_now"
      printf 'branch: %s\n' "$_sst_branch"
      printf 'commit: %s\n' "$_sst_commit"
      printf 'commit-subject: %s\n' "$_sst_subject"
      printf 'worktree-dirty-at-sidecar-time: %s\n\n' "$_sst_dirty"
      printf 'remote.origin.url: %s\n\n' "$_sst_remote"
      if [ "$_sst_was_sub" = 1 ]; then
        printf 'was-submodule: yes\n'
        printf 'submodule-name: %s\n' "$_sst_sub_name"
        printf 'submodule-url: %s\n\n' "$_sst_sub_url"
      else
        printf 'was-submodule: no\n\n'
      fi
      printf -- '--- full local git config at sidecar time (git config --local --list) ---\n'
      run git --git-dir="$_sst_gitdir" config --local --list 2>/dev/null
      # Deliberately NOT capturing .gitignore/.gitattributes/.gitmodules
      # here: sidecar mode never removes them (they stay live, ordinary
      # tracked content) — duplicating their content into this snapshot
      # would just create a stale second copy for no reason. Capture
      # only belongs where removal also happens (_fl_write_merge_snapshot).
    } > "$_sst_file" 2>/dev/null || log_warn "$_sst_path: could not write $_sst_file (cosmetic only, not fatal)"
  }

  # _fl_write_merge_snapshot <path> <gitdir> <was-submodule 0|1> [<sub-name>] [<sub-url>]
  # Writes <path>/.git.merged — an ORDINARY, parent-tracked text file,
  # captured from <gitdir> just BEFORE it is permanently deleted (merge
  # mode's "delete" choice, including --merge's forced mapping — see
  # _fl_build_forced_choices). UNLIKE a sidecar's GIT_SIDECAR_DIRNAME,
  # there is no preserved object database behind this file once <gitdir>
  # is gone — it is a point-in-time record only, for two purposes:
  # (a) 'my-git unflatten --merge' (git subtree split from this repo's
  # OWN commits) has a starting reference to sanity-check against, and
  # (b) 'my-git st' can show this path was actually merged (see
  # list_merged_dirs), not indistinguishable from content that was
  # simply always there.
  # _fl_transfer_one_sub_submodule <sub-full-path> <name> <parent-gitdir-abs> <gitmodules-file> <sub-rel-path>
  # Extracted into its OWN function rather than inlined in the loop that
  # calls it (_fl_transfer_sub_submodules) — required by the bash 3.2
  # parser gotcha documented under Extending: a case/esac written inline
  # inside a loop that itself sits inside a $(...) can fail to parse.
  # Realizes ONE sub-submodule if (and only if) its real gitdir currently
  # lives INSIDE <parent-gitdir-abs> — i.e. it would be destroyed the
  # instant the parent's own .git is deleted. Already-self-contained
  # sub-submodules (already their own sidecar, or registered somewhere
  # else entirely) are left alone; nothing to do for them. On success,
  # prints '<name>\t<sub-rel-path>\t<url>' (for the caller to fold into
  # .git.merged); prints nothing otherwise.
  # Resolution reuses _fl_resolve_gitfile_pointer (GIT_SIDECAR_DIRNAME
  # fallback included) rather than a plain literal-path lookup: a DIRECT
  # sidecar->merge conversion runs this against a parent that's already
  # been sidecared, so a sub-submodule's pointer here is routinely of
  # the already-broken kind _fl_resolve_gitfile_pointer exists to
  # recover — found by direct testing, the literal-only lookup silently
  # treated that as "nothing to transfer" and left the pointer dangling.
  # The machine-readable transfer record is APPENDED to <outfile> (arg
  # 6), NOT printed to stdout — this function also emits a user-facing
  # log_medium line, and log_medium writes to stdout, so a stdout-return
  # would let that log line corrupt the captured data under -V/-D (a
  # real bug found in review). Keeping the two channels separate lets
  # the log stay visible while the data stays clean.
  _fl_transfer_one_sub_submodule() {
    _fos_sub=$1
    _fos_name=$2
    _fos_parent_gitdir_abs=$3
    _fos_gitmodules=$4
    _fos_subrel=$5
    _fos_outfile=$6
    # Each 'return 0' below is a deliberate SKIP (this sub-submodule is
    # already safe / not our concern). Because a wrong skip here is
    # exactly how history silently vanished before this safety net
    # existed, every skip logs WHY under -D — so a future regression is
    # visible at the decision point, not just in the damaged aftermath.
    if ! _fl_resolve_gitfile_pointer "$_fos_sub"; then
      log_dbg_med "sub-submodule $_fos_sub: skip — no resolvable gitfile pointer (not an absorbed submodule, or history already gone)"
      return 0
    fi
    _fos_real=$_fl_resolved_gitdir
    if [ -z "$_fos_real" ] || [ ! -d "$_fos_real" ]; then
      log_dbg_med "sub-submodule $_fos_sub: skip — resolved gitdir '$_fos_real' is not a directory"
      return 0
    fi
    case "$_fos_real" in
      "$_fos_parent_gitdir_abs"/*) : ;;
      *)
        log_dbg_med "sub-submodule $_fos_sub: skip — its gitdir '$_fos_real' is NOT inside the parent gitdir '$_fos_parent_gitdir_abs' about to be deleted (already self-contained; nothing at risk)"
        return 0 ;;
    esac
    _fos_dst="$_fos_sub/$GIT_SIDECAR_DIRNAME"
    if [ -e "$_fos_dst" ]; then
      log_dbg_med "sub-submodule $_fos_sub: skip — destination sidecar '$_fos_dst' already exists"
      return 0
    fi
    _fos_url=$(_sm_safe_git . config -f "$_fos_gitmodules" --get "submodule.$_fos_name.url" 2>/dev/null)
    log_dbg_med "sub-submodule $_fos_sub: AT RISK — gitdir '$_fos_real' lives inside the doomed parent gitdir; relocating to '$_fos_dst' (url=$_fos_url)"
    log_medium "transfer $_fos_sub  (sub-submodule of a path about to lose its own .git — realizing it first so its history survives)"
    run rm -f -- "$_fos_sub/.git" || { log_warn "sub-submodule $_fos_sub: rm of old .git pointer failed — leaving untouched"; return 0; }
    run mv -- "$_fos_real" "$_fos_dst" || { log_warn "sub-submodule $_fos_sub: mv of gitdir '$_fos_real' -> '$_fos_dst' failed — history NOT relocated"; return 0; }
    run git config --file "$_fos_dst/config" core.worktree ".." || { log_warn "sub-submodule $_fos_sub: could not set core.worktree on the new sidecar"; return 0; }
    run git config --file "$_fos_dst/config" --unset core.bare 2>/dev/null || true
    run mkdir -p "$_fos_dst/info" 2>/dev/null
    printf '%s\n%s.status\n' "$GIT_SIDECAR_DIRNAME" "$GIT_SIDECAR_DIRNAME" >> "$_fos_dst/info/exclude" 2>/dev/null
    printf '%s\t%s\t%s\n' "$_fos_name" "$_fos_subrel" "$_fos_url" >> "$_fos_outfile"
  }

  # _fl_transfer_sub_submodules <path> <gitdir-abs> <outfile>
  # Called BEFORE <path>'s own git dir is deleted (merge mode, including
  # a direct sidecar->merge conversion). <path> may have its OWN
  # registered submodules whose real gitdir lives inside <gitdir-abs>'s
  # own 'modules/' — about to be destroyed right along with <path>'s git
  # identity, silently losing that sub-submodule's ENTIRE history (its
  # checked-out FILES survive as plain content; its history does not —
  # confirmed by direct testing: a dangling gitfile pointer is all
  # that's left otherwise). Relocates each one to
  # <path>/<subpath>/GIT_SIDECAR_DIRNAME first — a sidecar, entirely
  # independent of <path>'s own git dir going forward. Implicit and
  # automatic: no separate 'sm go' step required, and this covers a
  # DIRECT sidecar->merge conversion too (an existing .git.real sidecar
  # may itself already hold an unrealized sub-submodule from before this
  # safeguard existed).
  # Appends one line per module actually transferred to <outfile>,
  # '<name>\t<subpath>\t<url>' (see the log-channel note above for why a
  # file, not stdout).
  _fl_transfer_sub_submodules() {
    _ftm_path=$1
    _ftm_gitdir_abs=$2
    _ftm_outfile=$3
    if [ ! -f "$_ftm_path/.gitmodules" ]; then
      log_dbg_med "sub-submodule scan: $_ftm_path has no .gitmodules — no registered sub-submodules to protect"
      return 0
    fi
    # Guard: an EMPTY parent gitdir would make the containment test
    # ("$_fos_parent_gitdir_abs"/*) degrade to '/*', which matches EVERY
    # absolute path — wrongly relocating sub-submodules that live
    # anywhere on disk. Only ever happens if the caller's gitdir didn't
    # resolve; bail rather than risk a spurious mass-transfer.
    if [ -z "$_ftm_gitdir_abs" ]; then
      log_warn "$_ftm_path: sub-submodule scan skipped — parent gitdir did not resolve to an absolute path; cannot safely determine which sub-submodules are at risk"
      return 0
    fi
    _ftm_list_tmp=$(runq mktemp "${TMPDIR:-/tmp}/${US}.ftmlist.XXXXXX") || { log_warn "$_ftm_path: mktemp failed for sub-submodule scan — skipping"; return 0; }
    _sm_safe_git . config -f "$_ftm_path/.gitmodules" --get-regexp '^submodule\..*\.path$' 2>/dev/null > "$_ftm_list_tmp"
    log_dbg_med "sub-submodule scan: $_ftm_path has $(grep -c . "$_ftm_list_tmp" 2>/dev/null) registered sub-submodule(s) in .gitmodules; checking each against doomed gitdir '$_ftm_gitdir_abs'"
    while IFS=' ' read -r _ftm_key _ftm_subpath; do
      [ -n "$_ftm_key" ] || continue
      _ftm_name=$(printf '%s' "$_ftm_key" | sed 's/^submodule\.//;s/\.path$//')
      _fl_transfer_one_sub_submodule "$_ftm_path/$_ftm_subpath" "$_ftm_name" "$_ftm_gitdir_abs" "$_ftm_path/.gitmodules" "$_ftm_subpath" "$_ftm_outfile"
    done < "$_ftm_list_tmp"
    runq rm -f "$_ftm_list_tmp"
  }

  _fl_write_merge_snapshot() {
    _msn_path=$1
    _msn_gitdir=$2
    _msn_was_sub=$3
    _msn_sub_name=$4
    _msn_sub_url=$5
    _msn_file="$_msn_path/.git.merged"
    _msn_gitdir_abs=$(cd "$_msn_gitdir" 2>/dev/null && pwd -P)
    if [ -z "$_msn_gitdir_abs" ]; then
      log_warn "$_msn_path: merge snapshot — gitdir '$_msn_gitdir' did not resolve to an absolute path; sub-submodule protection cannot run and recorded commit info may be empty"
    fi
    log_dbg_med "merge snapshot: $_msn_path (gitdir=$_msn_gitdir abs=$_msn_gitdir_abs was_sub=$_msn_was_sub) -> $_msn_file"
    # Transfer any at-risk sub-submodules FIRST, collecting the
    # machine-readable record into a temp file (NOT via $(...) capture —
    # the transfer emits user-facing log_medium lines to stdout that
    # would otherwise corrupt the captured data; see the note on
    # _fl_transfer_one_sub_submodule).
    # If mktemp fails, still run the transfer (targeting /dev/null): the
    # history-preserving MOVE is far more important than recording it in
    # the snapshot — silently skipping the safety net on a mktemp hiccup
    # would risk exactly the data loss it exists to prevent.
    _msn_xfer_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.msnxfer.XXXXXX" 2>/dev/null) || _msn_xfer_tmp=""
    _msn_xfer_out=${_msn_xfer_tmp:-/dev/null}
    log_dbg_med "merge-snapshot: $_msn_path — checking for at-risk sub-submodules (gitdir=$_msn_gitdir_abs)"
    _fl_transfer_sub_submodules "$_msn_path" "$_msn_gitdir_abs" "$_msn_xfer_out"
    if [ -n "$_msn_xfer_tmp" ] && [ -s "$_msn_xfer_tmp" ]; then
      _msn_transferred=$(cat "$_msn_xfer_tmp")
      log_dbg_med "merge-snapshot: $_msn_path — transferred $(printf '%s\n' "$_msn_transferred" | grep -c .) sub-submodule(s) to their own sidecar"
    else
      _msn_transferred=""
      [ -z "$_msn_xfer_tmp" ] && log_warn "$_msn_path: mktemp failed for sub-submodule transfer record — any transfer still happened, but is not recorded in .git.merged"
    fi
    [ -n "$_msn_xfer_tmp" ] && runq rm -f "$_msn_xfer_tmp"
    _msn_now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    _msn_branch=$(run git --git-dir="$_msn_gitdir" symbolic-ref --short -q HEAD 2>/dev/null)
    _msn_commit=$(run git --git-dir="$_msn_gitdir" rev-parse HEAD 2>/dev/null)
    [ -n "$_msn_branch" ] || _msn_branch="(detached) $_msn_commit"
    _msn_subject=$(run git --git-dir="$_msn_gitdir" log -1 --pretty=%s 2>/dev/null)
    _msn_remote=$(run git --git-dir="$_msn_gitdir" config --get remote.origin.url 2>/dev/null)

    # Transplant the object database into the PARENT before anything is
    # deleted. On failure this returns 1 WITHOUT writing the snapshot:
    # no .git.merged means the caller leaves the live .git alone, so a
    # failed preserve degrades to "nothing happened", never to data loss.
    PRESERVED_NS=""; PRESERVED_TIP=""; PRESERVED_NREFS=0
    if ! preserve_merged_history "." "$_msn_path" "$_msn_gitdir"; then
      log_error "$_msn_path: merge ABORTED for this path — its history could not be preserved, so nothing was deleted. To absorb the files and DISCARD the history on purpose, use: $US flatten go --rm-git $_msn_path"
      return 1
    fi

    {
      printf '# my-git merge snapshot for %s -- written by "flatten --merge"\n' "$_msn_path"
      printf '# (or the embedded/registered "delete" choice) just before its .git\n'
      printf '# was removed from this path. The history is NOT lost: this repo'"'"'s\n'
      printf '# entire object database was transplanted into the PARENT repo and\n'
      printf '# every ref pinned under the namespace named below, so nothing can\n'
      printf '# be garbage-collected. "unflatten --merge" hands it straight back;\n'
      printf '# "my-git st" reads this file to tag the path as merged.\n\n'
      printf 'merged-at: %s\n\n' "$_msn_now"
      printf 'branch: %s\n' "$_msn_branch"
      printf 'commit: %s\n' "$_msn_commit"
      printf 'commit-subject: %s\n' "$_msn_subject"
      printf 'remote.origin.url: %s\n\n' "$_msn_remote"
      if [ "$_msn_was_sub" = 1 ]; then
        printf 'was-submodule: yes\n'
        printf 'submodule-name: %s\n' "$_msn_sub_name"
        printf 'submodule-url: %s\n\n' "$_msn_sub_url"
      else
        printf 'was-submodule: no\n\n'
      fi
      if [ -n "$PRESERVED_NS" ]; then
        printf 'history-preserved: yes\n'
        printf 'preserved-in-repo: %s\n' "$(cd . 2>/dev/null && pwd)"
        printf '#   ^ the repo whose object database now holds this history.\n'
        printf 'preserved-refs: %s/\n' "$PRESERVED_NS"
        printf 'preserved-ref-count: %s\n' "$PRESERVED_NREFS"
        printf 'preserved-tip: %s\n\n' "$PRESERVED_TIP"
        printf -- '--- restoring this path ---\n'
        printf -- 'my-git unflatten --merge %s\n' "$_msn_path"
        printf -- 'Those refs live in the PARENT repo. A default clone/fetch does\n'
        printf -- 'NOT carry %s/* -- my-git adds the fetch+push\n' "$MERGED_REFS_ROOT"
        printf -- 'refspecs to every remote so its own push/pull do. To pick them up\n'
        printf -- 'in a fresh clone made by hand:\n'
        printf -- '  git config --add remote.origin.fetch "+%s/*:%s/*" && git fetch origin\n\n' "$MERGED_REFS_ROOT" "$MERGED_REFS_ROOT"
      fi
      if [ -n "$_msn_transferred" ]; then
        printf -- '--- sub-submodule(s) transferred to their own sidecar (would otherwise have lost their history along with this .git) ---\n'
        printf '%s\n' "$_msn_transferred"
        printf '\n'
      fi
      printf -- '--- full local git config at merge time (git config --local --list) ---\n'
      run git --git-dir="$_msn_gitdir" config --local --list 2>/dev/null
      printf '\n'
      # Merge mode has no live-repo future to preserve (unlike a
      # sidecar, which might be unflattened back to active development)
      # — so every '.git*' convention file found gets captured AND
      # removed here (remove=1), not just recorded. This is what makes
      # merge mode's "no special ga() treatment needed" true: the CAUSE
      # (a stale .gitignore/.gitattributes/etc. silently blocking future
      # files or governing rules for a git identity that no longer
      # exists here) is gone, not just worked around.
      _fl_capture_and_remove_gitfiles "$_msn_path"
    } > "$_msn_file" 2>/dev/null || log_warn "$_msn_path: could not write $_msn_file (cosmetic only, not fatal)"
    # Reached only when the history is safe (preserved, or deliberately
    # trashed) — this return is what authorises the caller to delete.
    return 0
  }

  # _fl_merge_sidecar_path <path>
  # Converts an ALREADY-SIDECARED path (GIT_SIDECAR_DIRNAME present, no
  # live .git) straight to merge mode — the direct route, no
  # 'unflatten --sidecar' + 'flatten --merge' round trip needed. Simpler
  # than the embedded/registered cases: GIT_SIDECAR_DIRNAME is already a
  # normal, directly-addressable git dir (no move-out dance, no
  # .gitmodules/pointer resolution), and its content is ALREADY tracked
  # by the parent (nothing new to stage except .git.merged itself and
  # the removal of the old .status file it supersedes).
  # Reads was-submodule/name/url back out of the existing .status file
  # (written by the original 'flatten --sidecar') so that provenance
  # isn't lost just because the path went through sidecar mode first.
  # Returns 0 on success, 1 on failure; caller handles staging/commit.
  _fl_merge_sidecar_path() {
    _fms_path=$1
    _fms_gitreal="$_fms_path/$GIT_SIDECAR_DIRNAME"
    _fms_status="$_fms_gitreal.status"
    [ -d "$_fms_gitreal" ] || { log_error "$_fms_path: no $GIT_SIDECAR_DIRNAME here to merge"; return 1; }
    _fms_was_sub=0
    _fms_sub_name=""
    _fms_sub_url=""
    if [ -f "$_fms_status" ]; then
      case "$(sed -n 's/^was-submodule: //p' "$_fms_status" | head -1)" in
        yes) _fms_was_sub=1
             _fms_sub_name=$(sed -n 's/^submodule-name: //p' "$_fms_status" | head -1)
             _fms_sub_url=$(sed -n 's/^submodule-url: //p' "$_fms_status" | head -1) ;;
      esac
    else
      log_dbg_med "direct sidecar->merge: $_fms_path has no $GIT_SIDECAR_DIRNAME.status — provenance (was-submodule/name/url) will be recorded as unknown"
    fi
    log_dbg_med "direct sidecar->merge: $_fms_path (was_sub=$_fms_was_sub name='$_fms_sub_name' url='$_fms_sub_url'); writing .git.merged from $_fms_gitreal, then removing it"
    # No snapshot (history not preserved) => no removal. The sidecar is
    # left exactly as it was, so the path stays a working sidecar repo.
    _fl_write_merge_snapshot "$_fms_path" "$_fms_gitreal" "$_fms_was_sub" "$_fms_sub_name" "$_fms_sub_url" || {
      log_warn "$_fms_path: left as a sidecar ($GIT_SIDECAR_DIRNAME kept) — nothing was deleted"
      return 1
    }
    run rm -rf -- "$_fms_gitreal" || { log_error "$_fms_path: rm -rf $_fms_gitreal failed"; return 1; }
    [ -f "$_fms_status" ] && { run git rm -q -- "$_fms_status" >/dev/null 2>&1 || run rm -f -- "$_fms_status"; }
    return 0
  }

  # _fl_shield_dir_nested <dir> <save-root> <manifest>
  # Move every nested repo (a '.git' dir OR gitfile pointer at depth >= 2
  # under <dir>) aside into <save-root>, recording 'orig<TAB>saved' lines
  # in <manifest>, so a subsequent 'git add -A -- <dir>' sees only plain
  # content and CANNOT choke on an embedded/uninitialized nested repo.
  # This is the direct sidecar->merge path's self-contained equivalent of
  # the main pipeline's _fl_shield_nested_within_addpaths — needed because
  # a sidecar can itself contain further nested repos (embedded, or
  # registered-but-not-yet-realized), and 'git add' recursing into one
  # with no commit checked out fails FATALLY ("does not have a commit
  # checked out"), staging nothing and leaving the merge half-done. The
  # nested repos are restored verbatim afterward by _fl_unshield_dir, so
  # they stay exactly as they were — their own untouched repos, merged
  # around, not into, the parent. GIT_SIDECAR_DIRNAME dirs are NOT matched
  # (they're named '.git.real', not '.git', and are excluded content, not
  # repos git would recurse into).
  _fl_shield_dir_nested() {
    _sdn_dir=$1
    _sdn_save=$2
    _sdn_manifest=$3
    _sdn_raw=$(mktemp "${TMPDIR:-/tmp}/${US}.sdnraw.XXXXXX") || return 1
    find "$_sdn_dir" -mindepth 2 \( -name .git -a \( -type d -o -type f \) \) -print 2>/dev/null \
      | sed 's|/\.git$||' > "$_sdn_raw"
    _sdn_n=$(grep -c . "$_sdn_raw" 2>/dev/null)
    log_dbg_med "shield: $_sdn_dir has $_sdn_n nested repo(s) to move aside before 'git add' (so an embedded/uninitialized one can't fail the add)"
    # Dedup: keep shallowest, drop any entry that's a descendant of one
    # already kept (moving the shallower dir carries its deeper repos too).
    _sdn_dedup=$(mktemp "${TMPDIR:-/tmp}/${US}.sdndedup.XXXXXX") || { rm -f "$_sdn_raw"; return 1; }
    sort -u "$_sdn_raw" | awk -F/ '{print NF, $0}' | sort -n -k1,1 -k2 | cut -d' ' -f2- \
      | awk 'function under(p,  i){for(i=1;i<=nk;i++)if(index(p,kept[i]"/")==1)return 1;return 0}
             {if(!under($0)){print;kept[++nk]=$0}}' > "$_sdn_dedup"
    runq rm -f "$_sdn_raw"
    _sdn_i=0
    while IFS= read -r _sdn_en; do
      [ -n "$_sdn_en" ] && [ -e "$_sdn_en" ] || continue
      _sdn_i=$((_sdn_i + 1))
      _sdn_dst="$_sdn_save/$_sdn_i"
      printf '%s\t%s\n' "$_sdn_en" "$_sdn_dst" >> "$_sdn_manifest"
      log_medium "shield (nested repo inside merged path, left untouched) $_sdn_en  ->  moved aside"
      run mv -- "$_sdn_en" "$_sdn_dst" || log_warn "shield: mv aside failed for $_sdn_en (git add may still choke on it)"
    done < "$_sdn_dedup"
    runq rm -f "$_sdn_dedup"
    return 0
  }

  # _fl_unshield_dir <manifest>
  # Restore every nested repo shielded by _fl_shield_dir_nested, deepest
  # first (so a nested-inside-nested repo lands back before its parent).
  _fl_unshield_dir() {
    _usd_manifest=$1
    [ -s "$_usd_manifest" ] || return 0
    awk '{lines[NR]=$0} END{for(i=NR;i>=1;i--) print lines[i]}' "$_usd_manifest" \
      | while IFS="$(printf '\t')" read -r _usd_orig _usd_saved; do
          [ -e "$_usd_saved" ] || continue
          [ -e "$_usd_orig" ] && run rm -rf -- "$_usd_orig" 2>/dev/null
          run mv -- "$_usd_saved" "$_usd_orig" 2>/dev/null \
            || log_warn "unshield: restore failed: $_usd_saved -> $_usd_orig (nested repo left in the save dir — recover it by hand)"
        done
  }

  # _fl_realize_submodule <path> <name>
  # Converts a REGISTERED submodule into a self-contained "realized"
  # form: relocates its real git directory (normally buried in the
  # parent's own .git/modules/<name>/) into <path>/$GIT_SIDECAR_DIRNAME —
  # a sibling of its own content — then fixes core.worktree so the
  # result is addressable with just 'git --git-dir=<path>/$GIT_SIDECAR_DIRNAME'
  # (no --work-tree needed). Does NOT touch .gitmodules/index — the
  # caller (_fl_interactive_apply / the AUTO_SIDECAR_SUBMODULES go path)
  # is responsible for deregistering first, same as the flatten/delete
  # choices already do.
  # On success, <path> is left as a plain directory: its tracked content
  # is unchanged, plus the new $GIT_SIDECAR_DIRNAME sibling (self-contained,
  # portable git history — moves/copies with <path> as a unit).
  # Returns 0 on success, 1 on failure (and logs why); does not roll
  # back partial moves itself — caller decides how to handle failure.
  _fl_realize_submodule() {
    _rz_path=$1
    _rz_name=$2
    _rz_dst="$_rz_path/$GIT_SIDECAR_DIRNAME"
    [ -e "$_rz_dst" ] && { log_error "sidecar: $_rz_path: $_rz_dst already exists — refusing to overwrite"; return 1; }

    # A registered submodule's on-disk '.git' is normally a lightweight
    # FILE (a pointer: 'gitdir: .../.git/modules/<name>') — the modern,
    # "absorbed" layout, where the real history lives in the parent's
    # own .git/modules/<name>/. But OLDER submodules (or ones set up by
    # hand, pre-dating absorption, or ones an older git/tool created)
    # instead have a full, REAL '.git' DIRECTORY directly at the
    # submodule's own path — nothing useful to pull from
    # .git/modules/<name>/ in that case; the actual history is already
    # sitting right there. Blindly assuming the modern layout here
    # previously caused real damage: 'rm' of a directory silently
    # failed (non-fatal warning, so the run continued), the parent's
    # own .git/modules/<name>/ got moved as if it were current (whether
    # or not it actually was), and the ORIGINAL '.git' was left behind
    # — so a subsequent 'git add' saw a directory that still contained
    # a live '.git' and re-created a bare gitlink instead of adding
    # plain content, while the .gitmodules deregistration had ALREADY
    # been staged — net result: a submodule with no .gitmodules entry
    # left behind as an orphan gitlink, silently, no error surfaced.
    if [ -d "$_rz_path/.git" ]; then
      _rz_parent_gitdir=$(_sm_safe_git . rev-parse --absolute-git-dir 2>/dev/null) || { log_error "sidecar: $_rz_path: git rev-parse --absolute-git-dir failed"; return 1; }
      if [ -e "$_rz_parent_gitdir/modules/$_rz_name" ]; then
        # Both a real .git AT the path AND a populated .git/modules/<n>
        # exist simultaneously — genuinely ambiguous which is
        # authoritative (they may have diverged). Refuse rather than
        # guess; nothing has been touched yet at this point.
        log_error "sidecar: $_rz_path: BOTH $_rz_path/.git (a real directory) AND $_rz_parent_gitdir/modules/$_rz_name exist — ambiguous which is current. Not touched; please resolve by hand (compare their history, remove whichever is stale, then re-run)."
        return 1
      fi
      # Old-style / self-contained: the real history is already AT the
      # path itself — same handling as a plain embedded repo, just an
      # in-place rename. Nothing to pull from .git/modules/<n> at all.
      log_medium "sidecar  $_rz_path  (old-style submodule, .git already self-contained -> $_rz_dst)"
      if ! run mv -- "$_rz_path/.git" "$_rz_dst"; then
        log_error "sidecar: $_rz_path: mv $_rz_path/.git -> $_rz_dst failed"
        return 1
      fi
    else
      _rz_parent_gitdir=$(_sm_safe_git . rev-parse --absolute-git-dir 2>/dev/null) || { log_error "sidecar: $_rz_path: git rev-parse --absolute-git-dir failed"; return 1; }
      _rz_src="$_rz_parent_gitdir/modules/$_rz_name"
      [ -d "$_rz_src" ] || { log_error "sidecar: $_rz_path: no such gitdir at $_rz_src. If this was never initialized, run 'git submodule update --init' first. Otherwise this usually means the underlying git history genuinely no longer exists (e.g. it was already permanently removed by an earlier 'sm --clean-stale' or a manual deregistration) — not something 'sidecar' can recover. Choose 'flatten' instead to track the current on-disk files as plain content, or 'delete' to also remove the dead registration."; return 1; }
      log_medium "sidecar  $_rz_path  ($_rz_src -> $_rz_dst)"
      run rm -f -- "$_rz_path/.git" || { log_error "sidecar: $_rz_path: removing gitfile pointer failed unexpectedly"; return 1; }
      if ! run mv -- "$_rz_src" "$_rz_dst"; then
        log_error "sidecar: $_rz_path: mv $_rz_src -> $_rz_dst failed"
        return 1
      fi
    fi

    # Fix core.worktree via 'git config --file' (edits the ini file
    # directly, no repo-discovery involved) — going through
    # '--git-dir=... config ...' instead fails here, because the OLD
    # core.worktree value (relative to the .git/modules/<name>/ location
    # it just moved FROM) is stale and git tries to resolve/chdir into
    # it as part of ordinary repository setup, before the config
    # subcommand even runs. NOTE: this OLD value is not worth capturing
    # for 'unflatten' to restore later — it was only ever correct for
    # the .git/modules/<name>/ location, meaningless once relocated
    # anywhere else (including back to a plain <path>/.git — see
    # _unfl_restore_sidecar, which just unsets both instead).
    run git config --file "$_rz_dst/config" core.worktree ".." || {
      log_error "sidecar: $_rz_path: fixing core.worktree failed"
      return 1
    }
    run git config --file "$_rz_dst/config" --unset core.bare 2>/dev/null || true

    # The realized dir must ignore itself (else 'git --git-dir=$_rz_dst
    # status', run from inside $_rz_path, reports $GIT_SIDECAR_DIRNAME as
    # an untracked file every time).
    # Some older/hand-built .git dirs never got an info/ subdir (git
    # normally creates it on init, but not universally) — mkdir -p
    # first so this never fails with a shell-level redirection error.
    run mkdir -p "$_rz_dst/info" 2>/dev/null
    if ! grep -qxF "$GIT_SIDECAR_DIRNAME" "$_rz_dst/info/exclude" 2>/dev/null; then
      printf '%s\n%s.status\n' "$GIT_SIDECAR_DIRNAME" "$GIT_SIDECAR_DIRNAME" >> "$_rz_dst/info/exclude" 2>/dev/null || \
        log_warn "sidecar: $_rz_path: could not write self-exclude (cosmetic only, not fatal)"
    fi

    _rz_url=$(_sm_safe_git . config -f .gitmodules --get "submodule.$_rz_name.url" 2>/dev/null)
    _fl_write_sidecar_status "$_rz_path" "$_rz_dst" 1 "$_rz_name" "$_rz_url"

    return 0
  }

  # _fl_resolve_gitfile_pointer <path>
  # Resolves <path>/.git (a lightweight gitfile pointer: 'gitdir: ...')
  # to the real gitdir it points to. Tries the literal recorded path
  # first, then falls back to substituting the first '.git' path
  # segment with GIT_SIDECAR_DIRNAME — for when the ENCLOSING repo the
  # pointer runs through has itself already been realized (its own
  # .git renamed away; the data isn't gone, just sitting at a renamed
  # path the pointer's literal text doesn't know about).
  # On success: sets _fl_resolved_gitdir to the real path and
  # _fl_resolved_via_fallback to 1 if the fallback was needed (0 if
  # the literal path worked directly), returns 0.
  # On failure: returns 1. Two distinct failure reasons, both leave
  # _fl_resolved_gitdir empty:
  #   - <path>/.git isn't a gitfile pointer at all (not a file, or a
  #     file with no parseable 'gitdir:' line) — not this function's
  #     concern; the caller should treat <path>/.git as a plain
  #     directory instead, or report an unparseable-file error.
  #   - it IS a pointer, but neither the literal path nor the
  #     GIT_SIDECAR_DIRNAME-substituted path resolves to anything on
  #     disk — almost always because the underlying history was
  #     already permanently deleted at some earlier point (e.g. an
  #     'sm --clean-stale' run), not something recoverable.
  # Callers that need to distinguish these two failure cases can check
  # [ -f "<path>/.git" ] && [ ! -d "<path>/.git" ] themselves first.
  _fl_resolve_gitfile_pointer() {
    _frp_path=$1
    _frp_git="$_frp_path/.git"
    _fl_resolved_gitdir=""
    _fl_resolved_via_fallback=0
    [ -f "$_frp_git" ] && [ ! -d "$_frp_git" ] || return 1
    _frp_ptr=$(sed -n 's/^gitdir: *//p' "$_frp_git" 2>/dev/null | head -1)
    [ -n "$_frp_ptr" ] || return 1
    case "$_frp_ptr" in
      /*) _frp_real=$_frp_ptr ;;
      *)  _frp_real=$(cd "$_frp_path" 2>/dev/null && cd "$_frp_ptr" 2>/dev/null && pwd -P) ;;
    esac
    if [ -n "$_frp_real" ] && [ -d "$_frp_real" ]; then
      _fl_resolved_gitdir=$_frp_real
      return 0
    fi
    case "$_frp_ptr" in
      */.git/*)
        _frp_ptr_fb="${_frp_ptr%%/.git/*}/$GIT_SIDECAR_DIRNAME/${_frp_ptr#*/.git/}"
        case "$_frp_ptr_fb" in
          /*) _frp_real_fb=$_frp_ptr_fb ;;
          *)  _frp_real_fb=$(cd "$_frp_path" 2>/dev/null && cd "$_frp_ptr_fb" 2>/dev/null && pwd -P) ;;
        esac
        if [ -n "$_frp_real_fb" ] && [ -d "$_frp_real_fb" ]; then
          _fl_resolved_gitdir=$_frp_real_fb
          _fl_resolved_via_fallback=1
          return 0
        fi
        ;;
    esac
    return 1
  }

  # _fl_realize_would_fail <path>
  # Dry-run check, no side effects: true (0) if <path>/.git is a
  # gitfile pointer whose target is genuinely unresolvable (realize
  # WOULD fail here with the "does not resolve" error) — used to warn
  # BEFORE the person picks 'realize', not just after. False (1) if
  # .git is a real directory (nothing to resolve, realize will work
  # via the simple rename path) or if the pointer resolves fine.
  _fl_realize_would_fail() {
    _rwf_path=$1
    _rwf_git="$_rwf_path/.git"
    [ -f "$_rwf_git" ] && [ ! -d "$_rwf_git" ] || return 1
    _fl_resolve_gitfile_pointer "$_rwf_path" && return 1
    return 0
  }

  # _fl_realize_embedded <path>
  # Converts a plain EMBEDDED nested repo (not registered as a
  # submodule FROM THIS SCOPE) into the same self-contained "realized"
  # form as _fl_realize_submodule. Two layouts to handle, same
  # distinction as _fl_realize_submodule and for the same reason:
  #   - <path>/.git is a real DIRECTORY: a standalone repo (plain
  #     'git init'/'git clone') — simple in-place rename.
  #   - <path>/.git is a lightweight FILE ('gitdir: <path>'): this
  #     nested repo is itself a registered submodule of some
  #     ENCLOSING repo (e.g. 'my-otr' registered by 'src's own
  #     .gitmodules) — merely "embedded" from THIS scope's point of
  #     view. The real gitdir lives wherever the pointer says
  #     (typically the enclosing repo's own .git/modules/<name>/, NOT
  #     inside <path> at all) — move THAT, not the tiny pointer file.
  # Returns 0 on success, 1 on failure; does not touch the index/tree —
  # caller adds <path> as plain content afterward, same as the
  # submodule case.
  _fl_realize_embedded() {
    _rze_path=$1
    _rze_src="$_rze_path/.git"
    _rze_dst="$_rze_path/$GIT_SIDECAR_DIRNAME"
    _rze_was_sub=0
    [ -e "$_rze_dst" ] && { log_error "sidecar: $_rze_path: $_rze_dst already exists — refusing to overwrite"; return 1; }

    if [ -f "$_rze_src" ] && [ ! -d "$_rze_src" ]; then
      _rze_was_sub=1
      if ! _fl_resolve_gitfile_pointer "$_rze_path"; then
        _rze_ptr=$(sed -n 's/^gitdir: *//p' "$_rze_src" 2>/dev/null | head -1)
        if [ -z "$_rze_ptr" ]; then
          log_error "sidecar: $_rze_path: .git is a file but not a recognizable gitdir pointer"
        else
          log_error "sidecar: $_rze_path: gitdir pointer '$_rze_ptr' does not resolve to an existing directory, even after substituting '$GIT_SIDECAR_DIRNAME'. This usually means the underlying git history genuinely no longer exists (e.g. it was already permanently removed by an earlier 'sm --clean-stale' or a manual deregistration, before this enclosing repo was ever sidecared) — not something 'sidecar' can recover, since there's nothing left to relocate. Choose 'flatten' instead to track the current on-disk files as plain content (the dead pointer is harmless and can stay), or 'delete' to also remove it."
        fi
        return 1
      fi
      _rze_real=$_fl_resolved_gitdir
      [ "$_fl_resolved_via_fallback" = 1 ] && \
        log_medium "sidecar  $_rze_path  (pointer's enclosing repo was already sidecared — resolved via $GIT_SIDECAR_DIRNAME instead)"
      log_medium "sidecar  $_rze_path  (gitfile pointer -> $_rze_real -> $_rze_dst)"
      log_warn "$_rze_path: this was a submodule of its OWN enclosing repo (not this scope) — that enclosing repo's own .gitmodules/index entry for it will now be inconsistent (its git history moved out from under it) unless the enclosing repo is also flattened/sidecared"
      run rm -f -- "$_rze_src" || { log_error "sidecar: $_rze_path: removing gitfile pointer failed"; return 1; }
      if ! run mv -- "$_rze_real" "$_rze_dst"; then
        log_error "sidecar: $_rze_path: mv $_rze_real -> $_rze_dst failed"
        return 1
      fi
    elif [ -d "$_rze_src" ]; then
      log_medium "sidecar  $_rze_path  ($_rze_src -> $_rze_dst)"
      if ! run mv -- "$_rze_src" "$_rze_dst"; then
        log_error "sidecar: $_rze_path: mv $_rze_src -> $_rze_dst failed"
        return 1
      fi
    else
      log_error "sidecar: $_rze_path: no .git at $_rze_src (already converted?)"
      return 1
    fi

    run git config --file "$_rze_dst/config" core.worktree ".." || {
      log_error "sidecar: $_rze_path: fixing core.worktree failed"
      return 1
    }
    run git config --file "$_rze_dst/config" --unset core.bare 2>/dev/null || true

    run mkdir -p "$_rze_dst/info" 2>/dev/null
    if ! grep -qxF "$GIT_SIDECAR_DIRNAME" "$_rze_dst/info/exclude" 2>/dev/null; then
      printf '%s\n%s.status\n' "$GIT_SIDECAR_DIRNAME" "$GIT_SIDECAR_DIRNAME" >> "$_rze_dst/info/exclude" 2>/dev/null || \
        log_warn "sidecar: $_rze_path: could not write self-exclude (cosmetic only, not fatal)"
    fi

    _fl_write_sidecar_status "$_rze_path" "$_rze_dst" "$_rze_was_sub" "" ""

    return 0
  }


  # Print a warning block listing registered submodules that flatten
  # deliberately did NOT touch. Called from analyze (before bail) and
  # after a successful 'go'. Safe to call when _fl_n_registered = 0
  # (becomes a no-op).
  _fl_warn_registered() {
    [ "${_fl_n_registered:-0}" -gt 0 ] || return 0
    echo
    if [ "${AUTO_SIDECAR_SUBMODULES:-0}" = 1 ]; then
      log_major "$_fl_n_registered registered submodule(s) will be AUTO-REALIZED by 'go' (AUTO_SIDECAR_SUBMODULES=1):"
      printf '%s\n' "$_fl_registered" | while IFS= read -r _r; do
        [ -n "$_r" ] && printf '       %s  ->  %s/%s\n' "$_r" "$_r" "$GIT_SIDECAR_DIRNAME"
      done
      printf '  %s>> set AUTO_SIDECAR_SUBMODULES=0, or use %s flatten go -i to choose.%s\n' "$C_BLUE" "$US" "$C_RESET"
    else
      # A FORCED mode (--merge/--sidecar/--zip) overrides the
      # leave-registered-alone default and DOES act on them. Saying
      # "LEFT UNTOUCHED" here while 'go' then converted every one of them
      # is how ten repos with remotes got merged instead of shadowed --
      # the plan has to describe the run that is actually about to happen.
      if [ -n "$_fl_forced_mode" ]; then
        log_major "$_fl_n_registered registered submodule(s) WILL BE CONVERTED by --$_fl_forced_mode (a forced mode overrides the leave-them-alone default):"
        printf '%s\n' "$_fl_registered" | while IFS= read -r _r; do
          [ -n "$_r" ] && printf '       %s\n' "$_r"
        done
        printf '  %s>> they are de-registered from .gitmodules and treated like any other nested repo.%s\n' "$C_YELLOW" "$C_RESET"
        printf '  %s>> to leave them registered, drop --%s and use %s flatten go -i instead.%s\n' "$C_BLUE" "$_fl_forced_mode" "$US" "$C_RESET"
      else
        log_major "$_fl_n_registered registered submodule(s) LEFT UNTOUCHED:"
        printf '%s\n' "$_fl_registered" | while IFS= read -r _r; do
          [ -n "$_r" ] && printf '       %s\n' "$_r"
        done
        printf '  %s>> these are listed in .gitmodules — a bare flatten will not touch them.%s\n' "$C_BLUE" "$C_RESET"
        printf '  %s>> use %s flatten go -i (choose per item, incl. sidecar into %s)%s\n' "$C_BLUE" "$US" "$GIT_SIDECAR_DIRNAME" "$C_RESET"
      fi
    fi
  }

  # _fl_interactive_collect <choices-file>
  # Per-item prompt for every item (registered subs + embedded nested +
  # orphan gitlinks). Writes one line per item to <choices-file>:
  #     <type>\t<path>\t<choice>
  # where:
  #   type   = registered | embedded | orphan
  #   choice = skip | flatten | delete | unstage
  # Defaults (Enter pressed) match what bare 'flatten go' would do for
  # each type — so all-Enter ≡ same outcome as plain 'go'. Choices that
  # only -i can pick are tagged [-i EXCLUSIVE CHOICE] in the prompt.
  # Returns non-zero (77) if the user picks 'a' (abort).
  # _fl_parse_ans <answer>
  # A per-item answer is applied to THIS item only, except:
  #   'g' (lowercase) — GLOBAL: stop asking about EVERYTHING remaining, in
  #        every type; finish the rest exactly like plain non-interactive 'go'.
  # The destructive MODE letters are UPPERCASE on purpose (S/M/Z) — pressing
  # shift is a small, deliberate act of will, so you can't flatten/zip/merge a
  # repo with a careless lowercase keypress. Safe actions stay lowercase
  # (k=skip, a=abort, g=go). To apply ONE mode to MANY repos at once, use the
  # forced-mode command instead: 'flatten go --sidecar|--merge|--zip'.
  # Sets _fl_ans_letter (the raw letter, case preserved) and _fl_ans_mode.
  _fl_parse_ans() {
    _fl_ans_mode=single
    _fl_ans_letter=$1
    case "$1" in
      g) _fl_ans_mode=global ;;
    esac
  }

  _fl_interactive_collect() {
    _fl_choices_file=$1
    : > "$_fl_choices_file"
    _fl_total=$((_fl_n_registered + _fl_n_nested + _fl_n_orphan))
    _fl_idx=0
    _fl_reg_bulk=""; _fl_reguninit_bulk=""; _fl_emb_bulk=""; _fl_orp_bulk=""
    _fl_global_go=0
    # Registered submodules. Using heredoc (not pipe) so _fl_idx updates
    # persist across iterations — piped 'while' runs in a subshell.
    while IFS= read -r _p; do
      [ -n "$_p" ] || continue
      _fl_idx=$((_fl_idx + 1))
      _name=$(_sm_safe_git . config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
                | awk -v p="$_p" '$2 == p {print $1}' \
                | sed 's/^submodule\.//;s/\.path$//' | head -1)
      if ! _fl_submodule_initialized "$_p"; then
        printf '\n%s[%s/%s] Submodule registered in .gitmodules but NEVER INITIALIZED (no .git present): %s%s\n' \
          "$C_BOLD" "$_fl_idx" "$_fl_total" "$_p" "$C_RESET" >/dev/tty
        if [ "$_fl_global_go" = 1 ]; then
          _ch=skip
          printf 'registered\t%s\t%s\n' "$_p" "$_ch" >> "$_fl_choices_file"
          continue
        fi
        if [ -n "$_fl_reguninit_bulk" ]; then
          _ch=$_fl_reguninit_bulk
          printf "  (bulk choice in effect: %s)\n" "$_ch" >/dev/tty
          printf 'registered\t%s\t%s\n' "$_p" "$_ch" >> "$_fl_choices_file"
          continue
        fi
        printf "  's' skip        — leave the .gitmodules registration as-is (default)\n" >/dev/tty
        printf "  'x' deregister  — remove the .gitmodules/index registration; nothing to flatten/sidecar (no clone exists)    [-i EXCLUSIVE CHOICE]\n" >/dev/tty
        printf "  'a' abort       — cancel the whole flatten\n" >/dev/tty
        printf "  'g' go          — GO: apply the choices made so far NOW; every remaining undecided item is ignored (stops asking; a final Y/n confirm follows)\n" >/dev/tty
        _ch=""
        while [ -z "$_ch" ]; do
          printf '  choice: ' >/dev/tty
          IFS= read -r _ans </dev/tty || _ans=a
          _fl_parse_ans "$_ans"
          if [ "$_fl_ans_mode" = global ]; then
            _ch=skip
          else
          case "$_fl_ans_letter" in
            s)     _ch=skip ;;
            x)     _ch=deregister ;;
            a)     printf '  -> abort\n' >/dev/tty; return 77 ;;
            *)     printf "  ? unrecognized: '%s' — please answer s, x, a, or g\n" "$_ans" >/dev/tty ;;
          esac
          fi
        done
        [ "$_fl_ans_mode" = typebulk ] && _fl_reguninit_bulk=$_ch
        [ "$_fl_ans_mode" = global ]   && _fl_global_go=1
        printf 'registered\t%s\t%s\n' "$_p" "$_ch" >> "$_fl_choices_file"
        continue
      fi
      printf '\n%s[%s/%s] Submodule registered in .gitmodules: %s%s\n' \
        "$C_BOLD" "$_fl_idx" "$_fl_total" "$_p" "$C_RESET" >/dev/tty
      if [ "$_fl_global_go" = 1 ]; then
        _ch=skip
        printf 'registered\t%s\t%s\n' "$_p" "$_ch" >> "$_fl_choices_file"
        continue
      fi
      printf "  'S' sidecar  — absorb files into the parent, RELOCATE git history into %s/%s (self-contained, portable, no parent-side bookkeeping)    [-i EXCLUSIVE CHOICE]\n" "$_p" "$GIT_SIDECAR_DIRNAME" >/dev/tty
      printf "  'M' merge    — absorb files into the parent, DELETE nested git history under .git/modules/%s/ (a .git.merged snapshot is written first)    [-i EXCLUSIVE CHOICE]\n" "$_name" >/dev/tty
      printf "  'i' ignore   — leave the submodule registered, untouched (default for registered subs)\n" >/dev/tty
      printf "  'a' abort    — cancel the whole flatten\n" >/dev/tty
      printf "  'g' go       — GO: apply the choices made so far NOW; every remaining undecided item is ignored (stops asking; a final Y/n confirm follows)\n" >/dev/tty
      printf "  %s(modes are UPPERCASE on purpose — shift = a deliberate choice; to apply one mode to ALL: '%s flatten go --sidecar|--merge')%s\n" "$C_DIM" "$US" "$C_RESET" >/dev/tty
      _ch=""
      while [ -z "$_ch" ]; do
        printf '  choice: ' >/dev/tty
        IFS= read -r _ans </dev/tty || _ans=a
        _fl_parse_ans "$_ans"
        if [ "$_fl_ans_mode" = global ]; then
          _ch=skip
        else
        case "$_fl_ans_letter" in
          S)     _ch=sidecar ;;
          M)     _ch=delete ;;   # 'merge' = delete history AFTER writing a .git.merged snapshot
          i)     _ch=skip ;;     # 'ignore' = leave the submodule registered, untouched
          a)     printf '  -> abort\n' >/dev/tty; return 77 ;;
          s|m)   printf "  ? modes are UPPERCASE (shift): use '%s' — lowercase is not accepted for a destructive mode\n" "$(printf '%s' "$_ans" | tr 'a-z' 'A-Z')" >/dev/tty ;;
          *)     printf "  ? unrecognized: '%s' — answer S, M (mode), or i, a, g\n" "$_ans" >/dev/tty ;;
        esac
        fi
      done
      [ "$_fl_ans_mode" = global ]   && _fl_global_go=1
      printf 'registered\t%s\t%s\n' "$_p" "$_ch" >> "$_fl_choices_file"
    done <<_FL_REG_EOF
$_fl_registered
_FL_REG_EOF
    # Embedded nested
    while IFS= read -r _np_git; do
      [ -n "$_np_git" ] || continue
      _fl_idx=$((_fl_idx + 1))
      _p=$(printf '%s' "$_np_git" | sed 's|/\.git$||')
      printf '\n%s[%s/%s] Embedded nested git repo (not registered): %s%s\n' \
        "$C_BOLD" "$_fl_idx" "$_fl_total" "$_p" "$C_RESET" >/dev/tty
      _fl_item_dead=0
      _fl_realize_would_fail "$_p" && _fl_item_dead=1
      if [ "$_fl_item_dead" = 1 ]; then
        printf "  %s⚠ this item's git history is already gone (its gitdir pointer doesn't resolve, even via %s) — 'S' sidecar will fail here; use 'M' merge instead%s\n" \
          "$C_YELLOW" "$GIT_SIDECAR_DIRNAME" "$C_RESET" >/dev/tty
      fi
      if [ "$_fl_global_go" = 1 ]; then
        _ch=skip
        printf 'embedded\t%s\t%s\n' "$_p" "$_ch" >> "$_fl_choices_file"
        continue
      fi
      printf "  'S' sidecar  — absorb files into the parent, RELOCATE history into %s/%s (self-contained, no live .git left)    [-i EXCLUSIVE CHOICE]\n" "$_p" "$GIT_SIDECAR_DIRNAME" >/dev/tty
      printf "  'M' merge    — absorb files into the parent AND move this repo's history into it (objects transplanted, refs pinned under %s/; the nested .git then goes away, restore it with 'unflatten --merge')\n" "$MERGED_REFS_ROOT" >/dev/tty
      printf "  'Z' zip      — ARCHIVE the nested .git into %s/.git.zip and commit ONLY that archive (history kept, compressed; worktree files left as-is; restore with 'unflatten --zip')    [-i EXCLUSIVE CHOICE]\n" "$_p" >/dev/tty
      printf "  'i' ignore   — leave this repo alone    [-i EXCLUSIVE CHOICE]\n" >/dev/tty
      printf "  'a' abort    — cancel the whole flatten\n" >/dev/tty
      printf "  'g' go       — GO: apply the choices made so far NOW; every remaining undecided item is ignored (stops asking; a final Y/n confirm follows)\n" >/dev/tty
      printf "  %s(modes are UPPERCASE on purpose — shift = a deliberate choice; to apply one mode to ALL: '%s flatten go --sidecar|--merge|--zip')%s\n" "$C_DIM" "$US" "$C_RESET" >/dev/tty
      _ch=""
      while [ -z "$_ch" ]; do
        printf '  choice: ' >/dev/tty
        IFS= read -r _ans </dev/tty || _ans=a
        _fl_parse_ans "$_ans"
        if [ "$_fl_ans_mode" = global ]; then
          _ch=skip
        else
        case "$_fl_ans_letter" in
          S)     _ch=sidecar ;;
          M)     _ch=delete ;;   # 'merge' = delete .git AFTER writing a .git.merged snapshot
          Z)     _ch=zip ;;
          i)     _ch=skip ;;     # 'ignore' = leave this repo alone
          a)     printf '  -> abort\n' >/dev/tty; return 77 ;;
          s|m|z) printf "  ? modes are UPPERCASE (shift): use '%s' — lowercase is not accepted for a destructive mode\n" "$(printf '%s' "$_ans" | tr 'a-z' 'A-Z')" >/dev/tty ;;
          *)     printf "  ? unrecognized: '%s' — answer S, M, Z (mode), or i, a, g\n" "$_ans" >/dev/tty ;;
        esac
        fi
      done
      [ "$_fl_ans_mode" = global ]   && _fl_global_go=1
      if { [ "$_ch" = sidecar ] || [ "$_ch" = zip ]; } && [ "$_fl_item_dead" = 1 ]; then
        printf "  (this item's history is already gone — %s would fail; applying 'merge' here instead)\n" "$_ch" >/dev/tty
        _ch=delete
      fi
      printf 'embedded\t%s\t%s\n' "$_p" "$_ch" >> "$_fl_choices_file"
    done <<_FL_EMB_EOF
$_fl_nested
_FL_EMB_EOF
    # Orphan gitlinks
    while IFS= read -r _p; do
      [ -n "$_p" ] || continue
      _fl_idx=$((_fl_idx + 1))
      printf '\n%s[%s/%s] Orphan gitlink (path is 160000 in index but missing from .gitmodules): %s%s\n' \
        "$C_BOLD" "$_fl_idx" "$_fl_total" "$_p" "$C_RESET" >/dev/tty
      if grep -qF "$(printf 'embedded\t%s\tsidecar' "$_p")" "$_fl_choices_file" 2>/dev/null; then
        # Moot: 'sidecar' was already chosen for this exact path above,
        # which clears this stale gitlink unconditionally — asking here
        # would offer a choice that doesn't actually do anything, so
        # don't ask at all; just say so and move on.
        printf "  %s(already handled — 'sidecar' above clears this stale gitlink automatically)%s\n" \
          "$C_YELLOW" "$C_RESET" >/dev/tty
        printf 'orphan\t%s\tunstage\n' "$_p" >> "$_fl_choices_file"
        continue
      fi
      if [ "$_fl_global_go" = 1 ]; then
        _ch=skip
        printf 'orphan\t%s\t%s\n' "$_p" "$_ch" >> "$_fl_choices_file"
        continue
      fi
      if [ -n "$_fl_orp_bulk" ]; then
        _ch=$_fl_orp_bulk
        printf "  (bulk choice in effect: %s)\n" "$_ch" >/dev/tty
        printf 'orphan\t%s\t%s\n' "$_p" "$_ch" >> "$_fl_choices_file"
        continue
      fi
      printf "  'u' unstage   — remove the gitlink from the parent index (standard 'go')\n" >/dev/tty
      printf "  's' skip      — leave gitlink in place    [-i EXCLUSIVE CHOICE]\n" >/dev/tty
      printf "  'a' abort     — cancel the whole flatten\n" >/dev/tty
      printf "  'g' go        — GO: apply the choices made so far NOW; every remaining undecided item is ignored (stops asking; a final Y/n confirm follows)\n" >/dev/tty
      _ch=""
      while [ -z "$_ch" ]; do
        printf '  choice: ' >/dev/tty
        IFS= read -r _ans </dev/tty || _ans=a
        _fl_parse_ans "$_ans"
        if [ "$_fl_ans_mode" = global ]; then
          _ch=skip
        else
        case "$_fl_ans_letter" in
          u)     _ch=unstage ;;
          s)     _ch=skip ;;
          a)     printf '  -> abort\n' >/dev/tty; return 77 ;;
          *)     printf "  ? unrecognized: '%s' — please answer u, s, a, or g\n" "$_ans" >/dev/tty ;;
        esac
        fi
      done
      [ "$_fl_ans_mode" = typebulk ] && _fl_orp_bulk=$_ch
      [ "$_fl_ans_mode" = global ]   && _fl_global_go=1
      printf 'orphan\t%s\t%s\n' "$_p" "$_ch" >> "$_fl_choices_file"
    done <<_FL_ORP_EOF
$_fl_orphan
_FL_ORP_EOF
    return 0
  }

  # _fl_interactive_summary_confirm <choices-file>
  # Print a grouped summary of choices, then prompt Proceed? [Y/a].
  # Returns 0 to proceed, 77 to abort.
  _fl_interactive_summary_confirm() {
    _fl_choices_file=$1
    echo
    log_major "Summary of your choices:"
    for combo in "registered:sidecar:sidecar registered submodule (self-contained $GIT_SIDECAR_DIRNAME, history preserved)" \
                 "registered:flatten:flatten registered submodule (keep .git/modules backup)" \
                 "registered:delete:flatten registered submodule + DELETE .git/modules" \
                 "registered:deregister:deregister never-initialized submodule (nothing to flatten/sidecar)" \
                 "registered:skip:keep registered submodule untouched (default)" \
                 "embedded:flatten:flatten embedded nested (preserve .git)" \
                 "embedded:sidecar:sidecar embedded nested (self-contained $GIT_SIDECAR_DIRNAME, no live .git left)" \
                 "embedded:delete:merge embedded nested + DELETE .git (.git.merged snapshot first)" \
                 "embedded:zip:zip embedded nested (.git -> .git.zip, history archived)" \
                 "embedded:skip:ignore embedded nested (left alone)" \
                 "orphan:unstage:unstage orphan gitlink (default)" \
                 "orphan:skip:skip orphan gitlink"
    do
      _t=$(printf '%s' "$combo" | cut -d: -f1)
      _c=$(printf '%s' "$combo" | cut -d: -f2)
      _label=$(printf '%s' "$combo" | cut -d: -f3-)
      _matches=$(awk -F'\t' -v t="$_t" -v c="$_c" '$1==t && $3==c {print $2}' "$_fl_choices_file")
      [ -z "$_matches" ] && continue
      _n=$(printf '%s' "$_matches" | grep -c .)
      printf '  %s>> %s× %s:%s\n' "$C_BLUE" "$_n" "$_label" "$C_RESET"
      printf '%s\n' "$_matches" | while IFS= read -r _x; do
        printf '       %s\n' "$_x"
      done
    done
    echo
    # If any delete-style choices are present, require an extra typed
    # confirmation listing EXACTLY what will be destroyed. rm-class
    # operations get a "type 'yes' literally" gate because they are
    # irreversible (same UX as the existing --rm-git flow).
    _fl_delete_nested=$(awk -F'\t' '$1=="embedded" && $3=="delete" {print $2}' "$_fl_choices_file")
    _fl_delete_regmod=$(awk -F'\t' '$1=="registered" && $3=="delete" {print $2}' "$_fl_choices_file")
    if [ -n "$_fl_delete_nested" ] || [ -n "$_fl_delete_regmod" ]; then
      echo
      printf '%s!!! IRREVERSIBLE DELETIONS the following will be rm -rf'\''d:%s\n' \
        "$C_RED$C_BOLD" "$C_RESET"
      if [ -n "$_fl_delete_nested" ]; then
        printf '%s  nested .git dirs/files inside:%s\n' "$C_YELLOW" "$C_RESET"
        printf '%s\n' "$_fl_delete_nested" | while IFS= read -r _x; do
          [ -n "$_x" ] && printf '    %s%s/.git%s\n' "$C_YELLOW" "$_x" "$C_RESET"
        done
      fi
      if [ -n "$_fl_delete_regmod" ]; then
        printf '%s  submodule history directories under parent .git/modules/:%s\n' "$C_YELLOW" "$C_RESET"
        printf '%s\n' "$_fl_delete_regmod" | while IFS= read -r _x; do
          [ -n "$_x" ] && continue
        done
        # Resolve each path to its .gitmodules name for the preview.
        printf '%s\n' "$_fl_delete_regmod" | while IFS= read -r _x; do
          [ -n "$_x" ] || continue
          _n=$(_sm_safe_git . config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
                 | awk -v p="$_x" '$2 == p {print $1}' \
                 | sed 's/^submodule\.//;s/\.path$//' | head -1)
          printf '    %s.git/modules/%s/%s    (submodule path: %s)\n' "$C_YELLOW" "$_n" "$C_RESET" "$_x"
        done
      fi
      printf '\n%sEach listed directory'\''s git HISTORY WILL BE LOST (unrecoverable unless backed up).%s\n' \
        "$C_RED$C_BOLD" "$C_RESET"
      printf '%sType exactly '\''yes'\'' to proceed with these deletions, anything else to abort:%s ' \
        "$C_RED$C_BOLD" "$C_RESET" >/dev/tty
      IFS= read -r _fl_confirm </dev/tty || _fl_confirm=''
      if [ "$_fl_confirm" != "yes" ]; then
        log_major "deletions NOT confirmed (expected literal 'yes', got: '$_fl_confirm') — aborting"
        return 77
      fi
      echo
    fi
    printf '  Proceed with these choices?  %s[Y]es%s / %s[a]bort%s: ' \
      "$C_GREEN" "$C_RESET" "$C_RED" "$C_RESET" >/dev/tty
    IFS= read -r _ans </dev/tty || _ans=a
    case "$_ans" in
      a|A) echo "Aborted." >&2; return 77 ;;
      *)   return 0 ;;
    esac
  }

  # _fl_build_forced_choices <choices-file> <sidecar|merge>
  # Synthesizes the exact same '<type>\t<path>\t<choice>' format
  # _fl_interactive_collect produces by prompting a TTY — but by DIRECT
  # MAPPING, no TTY involved. Used whenever --sidecar/--merge forces one
  # mode across every item currently in scope ($_fl_registered/
  # $_fl_nested/$_fl_orphan, already narrowed by $_fl_scope_path if a
  # PATH argument was given). Fed straight into the existing, unchanged
  # _fl_interactive_apply — forcing a mode doesn't need its own apply
  # logic, only its own way of deciding the choice per item.
  # _fbc_gate <path> <intended-choice> <mode> — apply the --local-only filter
  # and the -i per-item prompt to a forced-mode item. Sets _FBC_CHOICE to the
  # choice to actually record: the intended one, or 'skip' when the item has a
  # remote (under --local-only) or is declined (-i skip). Returns 2 to signal
  # ABORT (-i abort). ('skip' leaves the item untouched — see the apply's
  # per-type 'skip' cases.)
  _fbc_gate() {
    _FBC_CHOICE=$2
    if [ "$_fl_local_only" = 1 ] && ! repo_is_local_only "$1"; then
      _FBC_CHOICE=skip
      log_dbg_med "flatten --$3: $1 has a remote (or no local repo) — skipped by --local-only"
      return 0
    fi
    if [ "$_fl_interactive" = 1 ]; then
      _FBC_I=$((${_FBC_I:-0} + 1))
      _prompt_ysa "[$_FBC_I of $_FBC_TOTAL] \"$1\" [--$3] flatten  ->  into $_fl_top ?"
      case $? in
        1) _FBC_CHOICE=skip; log_medium "skip  $1" ;;
        2) return 2 ;;
        3) _fl_interactive=0 ;;   # go: this one + all remaining, no more asking
      esac
    fi
    return 0
  }
  _fl_build_forced_choices() {
    _fbc_file=$1
    _fbc_mode=$2
    : > "$_fbc_file"
    _FBC_I=0
    _FBC_TOTAL=$((_fl_n_registered + _fl_n_nested + _fl_n_orphan))
    while IFS= read -r _p; do
      [ -n "$_p" ] || continue
      if ! _fl_submodule_initialized "$_p"; then
        # No clone exists — nothing to sidecar or merge from. Same
        # 'skip' default -i itself falls back to for this case.
        printf 'registered\t%s\tskip\n' "$_p" >> "$_fbc_file"
        continue
      fi
      if [ "$_fbc_mode" = sidecar ]; then _ch=sidecar; else _ch=delete; fi
      _fbc_gate "$_p" "$_ch" "$_fbc_mode" || return 2
      printf 'registered\t%s\t%s\n' "$_p" "$_FBC_CHOICE" >> "$_fbc_file"
    done <<_FBC_REG_EOF
$_fl_registered
_FBC_REG_EOF
    while IFS= read -r _np_git; do
      [ -n "$_np_git" ] || continue
      _p=$(printf '%s' "$_np_git" | sed 's|/\.git$||')
      if [ "$_fbc_mode" = sidecar ]; then
        if _fl_realize_would_fail "$_p"; then
          _ch=flatten
          log_warn "$_p: history already gone — sidecaring would fail; using 'flatten' here instead"
        else
          _ch=sidecar
        fi
      else
        # merge mode means no separate git identity survives — .git
        # gets deleted (with a .git.merged snapshot written first), not
        # just kept live in place. That's the actual difference from
        # bare 'go's embedded default, which already keeps it live with
        # no flag needed.
        _ch=delete
      fi
      _fbc_gate "$_p" "$_ch" "$_fbc_mode" || return 2
      printf 'embedded\t%s\t%s\n' "$_p" "$_FBC_CHOICE" >> "$_fbc_file"
    done <<_FBC_EMB_EOF
$_fl_nested
_FBC_EMB_EOF
    while IFS= read -r _p; do
      [ -n "$_p" ] || continue
      _fbc_gate "$_p" unstage "$_fbc_mode" || return 2
      printf 'orphan\t%s\t%s\n' "$_p" "$_FBC_CHOICE" >> "$_fbc_file"
    done <<_FBC_ORP_EOF
$_fl_orphan
_FBC_ORP_EOF
  }

  # _fl_interactive_apply <choices-file>
  # Apply the user's choices BEFORE the main flatten flow runs. This:
  #   - For registered+flatten/delete: removes the .gitmodules entry,
  #     force-removes the gitlink from the index, and adds the path to
  #     _fl_nested so the main flow handles the .git move-out / content
  #     staging like an embedded nested.
  #   - For registered+delete: also adds .git/modules/<name>/ to a list
  #     deleted after the commit succeeds.
  #   - For embedded+skip: removes from _fl_nested.
  #   - For embedded+delete: adds path to _fl_nested_delete (per-item
  #     --rm-git semantics for this one path).
  #   - For orphan+skip: removes from _fl_orphan.
  # Mutates: _fl_nested, _fl_n_nested, _fl_orphan, _fl_n_orphan,
  #          _fl_registered, _fl_n_registered, _fl_nested_delete,
  #          _fl_modules_delete, _fl_index_touched.
  _fl_interactive_apply() {
    _fl_choices_file=$1
    _fl_nested_delete=""   # paths whose .git get rm -rf'd before main flow
    _fl_nested_zip=""      # paths whose .git get archived to .git.zip before main flow
    _fl_modules_delete=""  # .git/modules/<name>/ paths to rm -rf after commit
    _fl_realized=""        # paths successfully realized (self-contained .git.real) — added to content directly, NOT via the move-out/restore dance
    # Pass 1: registered subs
    while IFS="$(printf '\t')" read -r _t _p _c; do
      [ "$_t" = registered ] || continue
      _name=$(_sm_safe_git . config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
                | awk -v pa="$_p" '$2 == pa {print $1}' \
                | sed 's/^submodule\.//;s/\.path$//' | head -1)
      case "$_c" in
        skip) : ;;  # keep in _fl_registered, no action
        deregister)
          _sm_safe_git . config -f .gitmodules --remove-section "submodule.$_name" >/dev/null 2>&1 || true
          run git update-index --force-remove -- "$_p" >/dev/null 2>&1 || \
            log_warn "update-index --force-remove failed for $_p"
          _fl_index_touched=1
          _fl_registered=$(printf '%s\n' "$_fl_registered" | grep -Fxv "$_p")
          ;;
        sidecar)
          # Attempt the actual relocation FIRST, deregister only on
          # success — a failed sidecar (e.g. the ambiguous dual-.git
          # case) must leave .gitmodules/index exactly as they were,
          # not half-deregistered with nothing to show for it.
          if _fl_realize_submodule "$_p" "$_name"; then
            _sm_safe_git . config -f .gitmodules --remove-section "submodule.$_name" >/dev/null 2>&1 || true
            run git update-index --force-remove -- "$_p" >/dev/null 2>&1 || \
              log_warn "update-index --force-remove failed for $_p"
            _fl_index_touched=1
            _fl_realized="$_fl_realized
$_p"
            _fl_registered=$(printf '%s\n' "$_fl_registered" | grep -Fxv "$_p")
          else
            log_error "sidecar failed for $_p — left as an untouched registered submodule; please inspect manually"
          fi
          ;;
        flatten|delete)
          if [ "$_c" = delete ]; then
            # Snapshot from the real gitdir BEFORE --remove-section (still
            # needed for the URL) and before the gitdir is scheduled for
            # removal below. Modern absorbed submodules keep it in the
            # parent's .git/modules/<name>/; OLD-STYLE ones have a real
            # .git DIRECTORY at the path itself instead. Try both so a
            # .git.merged marker is always written (else 'st' can't tag
            # it [merged] and bulk 'unflatten --merge' can't find it).
            # A snapshot that FAILS means the history could not be moved
            # into the parent — downgrade this item to plain 'flatten'
            # (files absorbed, .git left LIVE) rather than delete it.
            _fl_del_url=$(_sm_safe_git . config -f .gitmodules --get "submodule.$_name.url" 2>/dev/null)
            if [ -d ".git/modules/$_name" ]; then
              log_dbg_med "registered delete: $_p — snapshotting from absorbed gitdir .git/modules/$_name"
              _fl_write_merge_snapshot "$_p" ".git/modules/$_name" 1 "$_name" "$_fl_del_url" || _c=flatten
            elif [ -d "$_p/.git" ]; then
              log_dbg_med "registered delete: $_p — snapshotting from old-style real .git dir at $_p/.git (no .git/modules/$_name present)"
              _fl_write_merge_snapshot "$_p" "$_p/.git" 1 "$_name" "$_fl_del_url" || _c=flatten
            else
              log_warn "$_p: registered submodule 'delete' — no gitdir found (neither .git/modules/$_name nor $_p/.git); no .git.merged snapshot written, so 'st' won't tag it [merged] and bulk 'unflatten --merge' can't discover it"
            fi
            [ "$_c" = flatten ] && \
              log_warn "$_p: kept as a live nested repo (files still absorbed as parent content) — nothing was deleted"
          fi
          _sm_safe_git . config -f .gitmodules --remove-section "submodule.$_name" >/dev/null 2>&1 || true
          run git update-index --force-remove -- "$_p" >/dev/null 2>&1 || \
            log_warn "update-index --force-remove failed for $_p"
          _fl_index_touched=1
          _fl_nested="$_fl_nested
$_p/.git"
          if [ "$_c" = delete ]; then
            _fl_nested_delete="$_fl_nested_delete
$_p/.git"
            _fl_modules_delete="$_fl_modules_delete
.git/modules/$_name"
          fi
          # Drop from _fl_registered (no longer "left untouched")
          _fl_registered=$(printf '%s\n' "$_fl_registered" | grep -Fxv "$_p")
          ;;
      esac
    done < "$_fl_choices_file"
    # Pass 2: embedded — 'realize' is DEFERRED to _fl_realize_emb_paths
    # (collected here, acted on afterward in depth-DESCENDING order).
    # flatten/delete/skip have no such ordering fragility and still
    # apply inline. Reason for the deferral: if a shallow embedded item
    # (e.g. 'src') is realized (its .git renamed to GIT_SIDECAR_DIRNAME)
    # BEFORE a deeper child inside it (e.g. 'src/myotr', whose .git is
    # a gitfile POINTER resolving up into src's own .git/modules/) gets
    # its turn, the child's pointer becomes unresolvable — the path it
    # points to no longer exists once the parent's .git is gone.
    # Processing deepest-first guarantees every child resolves its own
    # pointer before anything above it can invalidate that path.
    _fl_realize_emb_paths=""
    while IFS="$(printf '\t')" read -r _t _p _c; do
      [ "$_t" = embedded ] || continue
      case "$_c" in
        flatten) : ;;
        sidecar)
          _fl_realize_emb_paths="$_fl_realize_emb_paths
$_p"
          _fl_nested=$(printf '%s\n' "$_fl_nested" | grep -Fxv "$_p/.git")
          ;;
        delete)
          # A snapshot that FAILS means the history could not be moved
          # into the parent — keep the live .git (its files are still
          # absorbed as parent content) instead of deleting it anyway.
          _fl_del_ok=1
          if [ -d "$_p/.git" ]; then
            log_dbg_med "embedded delete: $_p — snapshotting from real .git dir at $_p/.git"
            _fl_write_merge_snapshot "$_p" "$_p/.git" 0 || _fl_del_ok=0
          elif _fl_resolve_gitfile_pointer "$_p"; then
            log_dbg_med "embedded delete: $_p — snapshotting from gitfile-pointer target $_fl_resolved_gitdir (via_fallback=$_fl_resolved_via_fallback)"
            _fl_write_merge_snapshot "$_p" "$_fl_resolved_gitdir" 1 || _fl_del_ok=0
          else
            log_warn "$_p: embedded 'delete' — no resolvable gitdir (.git is neither a dir nor a working pointer); no .git.merged snapshot written"
          fi
          if [ "$_fl_del_ok" = 1 ]; then
            _fl_nested_delete="$_fl_nested_delete
$_p/.git"
          else
            log_warn "$_p: kept as a live nested repo (files still absorbed as parent content) — nothing was deleted"
          fi ;;
        zip)
          # archive the live .git into <path>/.git.zip (history kept, compressed).
          # No merge snapshot — the .zip IS the preserved history. ZIP does NOT
          # absorb the repo's worktree files: only the .git.zip is committed (the
          # main zip loop stages just that). So REMOVE it from _fl_nested — it
          # must not go through the move-out / whole-path 'git add' pipeline.
          _fl_nested_zip="$_fl_nested_zip
$_p/.git"
          _fl_nested=$(printf '%s\n' "$_fl_nested" | grep -Fxv "$_p/.git") ;;
        skip)
          _fl_nested=$(printf '%s\n' "$_fl_nested" | grep -Fxv "$_p/.git")
          ;;
      esac
    done < "$_fl_choices_file"

    # Now actually REALIZE every collected embedded path, deepest
    # first — see the comment above Pass 2 for why order matters here.
    _fl_realize_emb_paths=$(printf '%s\n' "$_fl_realize_emb_paths" | grep -v '^$' \
      | awk -F/ '{print NF, $0}' | sort -rn -k1,1 | cut -d' ' -f2-)
    while IFS= read -r _p; do
      [ -n "$_p" ] || continue
      if _fl_realize_embedded "$_p"; then
        _fl_realized="$_fl_realized
$_p"
        # A path can be BOTH an embedded repo AND an orphan gitlink
        # simultaneously (stale 160000 index entry left over from an
        # old half-converted submodule, alongside the actual on-disk
        # .git). Once realized, any such entry for this exact path is
        # definitely stale — clear it here rather than leaving it
        # dependent on how the separate orphan prompt for the same
        # path was answered; otherwise 'skip' there silently masks the
        # realized content from ever being tracked as real files (git
        # status shows clean while the actual content stays
        # untracked/uncommittable — a real historical bug this
        # closes, not just cosmetic).
        if printf '%s\n' "$_fl_orphan" | grep -Fxq "$_p"; then
          run git update-index --force-remove -- "$_p" >/dev/null 2>&1 || \
            log_warn "update-index --force-remove failed for $_p"
          _fl_index_touched=1
          _fl_orphan=$(printf '%s\n' "$_fl_orphan" | grep -Fxv "$_p")
        fi
      else
        log_error "sidecar failed for $_p — left as an untouched embedded repo; please inspect manually"
      fi
    done <<_FL_EMB_REALIZE_EOF
$_fl_realize_emb_paths
_FL_EMB_REALIZE_EOF

    # Pass 3: orphan
    while IFS="$(printf '\t')" read -r _t _p _c; do
      [ "$_t" = orphan ] || continue
      case "$_c" in
        unstage) : ;;
        skip)
          _fl_orphan=$(printf '%s\n' "$_fl_orphan" | grep -Fxv "$_p")
          ;;
      esac
    done < "$_fl_choices_file"
    # Recount
    _fl_nested=$(printf '%s\n' "$_fl_nested" | grep -v '^$' | sort -u)
    _fl_orphan=$(printf '%s\n' "$_fl_orphan" | grep -v '^$' | sort -u)
    _fl_registered=$(printf '%s\n' "$_fl_registered" | grep -v '^$' | sort -u)
    _fl_nested_delete=$(printf '%s\n' "$_fl_nested_delete" | grep -v '^$' | sort -u)
    _fl_nested_zip=$(printf '%s\n' "$_fl_nested_zip" | grep -v '^$' | sort -u)
    _fl_modules_delete=$(printf '%s\n' "$_fl_modules_delete" | grep -v '^$' | sort -u)
    _fl_realized=$(printf '%s\n' "$_fl_realized" | grep -v '^$' | sort -u)
    _fl_n_nested=$(printf '%s' "$_fl_nested" | grep -c .)
    _fl_n_orphan=$(printf '%s' "$_fl_orphan" | grep -c .)
    _fl_n_registered=$(printf '%s' "$_fl_registered" | grep -c .)
    # .gitmodules cleanup: if we removed sections (flatten/delete), the
    # file is either empty (no remaining [submodule] sections) or
    # modified (some sections remain). Either way it needs to land in
    # the upcoming commit.
    if [ -f .gitmodules ] && ! _sm_safe_git . config -f .gitmodules \
         --get-regexp '^submodule\..*\.path$' >/dev/null 2>&1; then
      # No submodule sections remain → remove .gitmodules entirely.
      run git update-index --force-remove -- .gitmodules >/dev/null 2>&1 || \
        log_warn ".gitmodules: update-index --force-remove failed"
      run rm -f -- .gitmodules
    elif [ -f .gitmodules ]; then
      # Some sections remain → stage the modified .gitmodules.
      run git add -- .gitmodules >/dev/null 2>&1 || \
        log_warn ".gitmodules: git add failed"
    fi
  }

  _fl_mode=analyze
  _fl_interactive=0
  _fl_rmgit=0
  _fl_force=0
  _fl_forced_mode=""
  _fl_scope_path_raw=""
  _fl_keep=0
  _fl_local_only=0
  _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help flatten; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose)          VERYVRB=1 ;;
      -D|--debug)   DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      go)           _fl_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _fl_mode=analyze ;;
      -i|--interactive) _fl_interactive=1; require_tty flatten ;;
      --rm-git)     _fl_rmgit=1 ;;
      --force)      _fl_force=1 ;;
      # --sidecar / --merge / --zip: force ONE of flatten's THREE EQUAL modes
      # (see 'my-git --help flatten' / README) instead of the normal per-item
      # defaults. With 'go' alone: bulk-applies
      # that ONE mode across scope, no prompting. With '-i' too: the forced
      # mode replaces per-item prompting entirely (nothing left to ask once a
      # mode is forced everywhere). With a PATH: scopes to just that one repo.
      # All three keep the nested files as parent content and differ only in
      # what happens to the git dir: --merge leaves/deletes it, --sidecar
      # relocates it to GIT_SIDECAR_DIRNAME, --zip archives it to a .zip.
      --sidecar)
        [ -n "$_fl_forced_mode" ] && [ "$_fl_forced_mode" != sidecar ] && \
          fatal "flatten: --sidecar / --merge / --zip are mutually exclusive" 64
        _fl_forced_mode=sidecar ;;
      --merge)
        [ -n "$_fl_forced_mode" ] && [ "$_fl_forced_mode" != merge ] && \
          fatal "flatten: --sidecar / --merge / --zip are mutually exclusive" 64
        _fl_forced_mode=merge ;;
      --zip)
        [ -n "$_fl_forced_mode" ] && [ "$_fl_forced_mode" != zip ] && \
          fatal "flatten: --zip is mutually exclusive with --sidecar/--merge" 64
        _fl_forced_mode=zip ;;
      -k|--keep)    _fl_keep=1 ;;
      # There is deliberately NO "merge but throw the history away"
      # flag: that is exactly what --rm-git does, and one destructive
      # operation with one confirmation beats two doing the same thing.
      --trash-history|--no-history|--drop-history)
        fatal "flatten: there is no $1 — '--merge' always keeps the history (it moves into this repo).
  To absorb the files and DISCARD each nested history instead, use the one destructive mode:
     $US flatten go --rm-git
  It lists exactly what it will delete and requires you to type 'I am sure'." 64 ;;
      # --local-only: restrict to repos with NO remote configured — the ones
      # 'st' marks with the house icon (⌂). Works with any mode; the common
      # use is 'flatten --zip --local-only' to archive only the unpublished
      # sidecars. (--house is an alias, for the icon.)
      --local-only|--house|--houses) _fl_local_only=1 ;;
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "flatten: unknown option: $1" 64 ;;
      # A single positional PATH restricts the whole run (analyze, go,
      # -i, forced-mode alike) to just that one nested repo instead of
      # every nested repo under the toplevel. Resolved to a
      # toplevel-relative path once $_fl_top is known, below.
      *)
        [ -n "$_fl_scope_path_raw" ] && \
          fatal "flatten: only one path argument is supported (got '$_fl_scope_path_raw' and '$1')" 64
        _fl_scope_path_raw=$1 ;;
    esac
    shift
  done

  # Use logical toplevel (symlink-preserving). 'git rev-parse
  # --show-toplevel' dereferences symlinks, which confuses the user
  # who typed '/LINKS/src' but would then see '/Users/MINE/...'.
  _fl_top=$(git_toplevel_of "$PWD")
  [ -n "$_fl_top" ] || fatal "flatten: not inside a git repo" 1
  # ONLY when actually applying — analyze mode must change nothing on
  # disk, and ensure_sidecar_exclude writes+stages+commits a .gitignore
  # entry when it finds sidecars without the exclude. Gating it here
  # (not inside the helper) keeps analyze truly read-only; the go-path
  # call sites below (direct sidecar->merge, and post-realize in the
  # main pipeline) still add the exclude when a run actually applies.
  # (Real bug: a plain 'flatten --merge <path>' analyze staged a
  # .gitignore change on a tree that had sidecars but not yet the rule.)
  [ "$_fl_mode" = go ] && ensure_sidecar_exclude "$_fl_top"
  # Without an explicit PATH argument, flatten operates on the WHOLE
  # repo (never path-scoped) — same as 'st' resolving scope from CWD, it
  # auto-jumps to the toplevel rather than requiring the caller to cd
  # there first. Note when this actually happens so the caller isn't
  # surprised the plan covers more than the subdir they were sitting in.
  if [ "$(cd "$PWD" 2>/dev/null && pwd -P)" != "$(cd "$_fl_top" 2>/dev/null && pwd -P)" ]; then
    log_major "flatten: scoping to repo toplevel ($_fl_top) — called from a subdir"
  fi

  # Resolve a PATH argument (if given) to a $_fl_top-relative path WHILE
  # STILL in the caller's original CWD — 'cd "$_fl_scope_path_raw"'
  # handles both absolute and CWD-relative input the same way every
  # other path-taking part of my-git does.
  _fl_scope_path=""
  if [ -n "$_fl_scope_path_raw" ]; then
    _fl_scope_abs=$(cd "$_fl_scope_path_raw" 2>/dev/null && pwd -P) || \
      fatal "flatten: '$_fl_scope_path_raw': no such directory" 1
    _fl_top_abs=$(cd "$_fl_top" 2>/dev/null && pwd -P)
    case "$_fl_scope_abs" in
      "$_fl_top_abs")
        fatal "flatten: '$_fl_scope_path_raw' is the repo toplevel itself, not a nested repo — omit the path to act on the whole repo" 64 ;;
      "$_fl_top_abs"/*)
        _fl_scope_path=${_fl_scope_abs#"$_fl_top_abs"/} ;;
      *)
        fatal "flatten: '$_fl_scope_path_raw' is not inside $_fl_top" 64 ;;
    esac
  fi

  cd "$_fl_top" || fatal "flatten: cannot cd to $_fl_top" 1

  # Say WHICH repo this run reads and writes, before doing anything.
  # flatten always acts on the toplevel of wherever you are standing --
  # never on a nested repo's own .git as the committer -- so name it.
  # Build the mode line FIRST. A multi-line 'case' inside "$( ... )" is a
  # runtime parse error even though 'sh -n' accepts the file, because the
  # substitution body is only parsed when it is expanded.
  _fl_modeline=""
  case "$_fl_forced_mode" in
    merge)   _fl_modeline="each nested history is transplanted INTO the parent git (refs pinned under $MERGED_REFS_ROOT/<path>/); a record is written to  <path>/.git.merged  naming the repo that now holds it" ;;
    sidecar) _fl_modeline="each nested .git is relocated to  <path>/$GIT_SIDECAR_DIRNAME ; a record is written to  <path>/$GIT_SIDECAR_DIRNAME.status  naming the repo that tracks the content" ;;
    zip)     _fl_modeline="each nested .git is archived to  <path>/.git.zip  and ONLY that archive is committed (no status file; nothing else about the parent changes)" ;;
  esac
  _fl_rmline=""
  [ "$_fl_rmgit" = 1 ] && _fl_rmline="--rm-git: each nested .git is DELETED -- the parent git is then the only one left"
  # --zip is the exception: it commits ONLY the archive and does NOT absorb
  # the nested worktree files, so it must not claim otherwise.
  if [ "$_fl_forced_mode" = zip ]; then
    _fl_contentline="the nested worktree files are NOT absorbed -- only the .git.zip archive is committed"
  else
    _fl_contentline="the nested files become that parent git's own ordinary content"
  fi
  log_repo_context flatten "$_fl_top" \
    "the commit goes to the PARENT git shown above -- $_fl_top/.git" \
    "$_fl_contentline" \
    "${_fl_scope_path:+scoped to: $_fl_scope_path (only this nested repo is touched)}" \
    "$_fl_modeline" \
    "$_fl_rmline"

  log_dbg_med "flatten: top=$_fl_top scope='${_fl_scope_path:-<whole repo>}' forced_mode='${_fl_forced_mode:-<none>}' mode=$_fl_mode interactive=$_fl_interactive rmgit=$_fl_rmgit force=$_fl_force keep=$_fl_keep sidecar_dirname=$GIT_SIDECAR_DIRNAME"

  # flatten needs a MODE. 'go' with no --sidecar/--merge/--zip and no -i is
  # refused: flattening means DISPOSING of the nested .git (relocate / delete /
  # archive). The old bare-'go' default only committed the files while keeping
  # .git live — a content-mirror, not a flatten — so it's gone (a dedicated
  # 'mirror' command can bring it back if ever needed). Analyze ('flatten'
  # without 'go') still works and shows what a mode WOULD do.
  if [ "$_fl_mode" = go ] && [ -z "$_fl_forced_mode" ] && [ "$_fl_interactive" != 1 ] \
     && [ "${AUTO_SIDECAR_EMBEDDED:-0}" != 1 ] && [ "${AUTO_SIDECAR_SUBMODULES:-0}" != 1 ]; then
    fatal "flatten go needs a mode — flattening disposes of each nested .git:
   --sidecar   relocate it into a self-contained $GIT_SIDECAR_DIRNAME (history kept)
   --merge     absorb it into THIS repo (history kept — objects move into this
               repo's object DB, refs pinned under $MERGED_REFS_ROOT/<path>/)
   --zip       archive it into a .zip (history kept, compressed)
  or choose per repo:   $US flatten go -i
  (bare 'flatten go' no longer just mirrors files while keeping .git live.)" 64
  fi

  # ── --zip mode ────────────────────────────────────────────────────────
  # Archive git dirs into a .zip (the 'gz' operation, ported here so my-git
  # never depends on a shell function). With a PATH: that one repo/sidecar.
  # Bulk (no PATH): every SIDECAR (.git.real -> .git.real.zip) AND every plain
  # live nested repo (.git -> .git.zip) under the toplevel — EXCEPT shadowed
  # repos, whose live .git is being actively used (never bulk-zip those; zip
  # one on purpose by naming its path if you really mean it). Pair with
  # --local-only to archive just the no-remote (⌂) ones. Analyze by default.
  if [ "$_fl_forced_mode" = zip ]; then
    if [ -n "$_fl_scope_path" ]; then
      is_git_repo_or_flattened "$_fl_scope_path" || \
        fatal "flatten --zip: '$_fl_scope_path' is not a git repo or sidecar" 1
      if [ -f "$_fl_scope_path/.git.zip" ] || [ -f "$_fl_scope_path/$GIT_SIDECAR_DIRNAME.zip" ]; then
        log_major "flatten --zip: $_fl_scope_path is already zipped — nothing to do"
        return 0
      fi
      _fl_zip_targets=$_fl_scope_path
    else
      # Sidecars (.git.real) + plain live nested repos (.git), MINUS shadowed
      # repos (their live .git is in active use — never bulk-zip those).
      _fl_zip_shadowed=$(list_shadowed_dirs "$_fl_top")
      _fl_zip_live=$(list_unregistered_nested "$_fl_top" | while IFS= read -r _fl_zl; do
        [ -n "$_fl_zl" ] || continue
        printf '%s\n' "$_fl_zip_shadowed" | grep -qxF "$_fl_zl" && continue
        printf '%s\n' "$_fl_zl"
      done)
      _fl_zip_targets=$(printf '%s\n%s\n' "$(list_realized_dirs "$_fl_top")" "$_fl_zip_live" \
                          | grep -v '^$' | sort -u)
      if [ -z "$_fl_zip_targets" ]; then
        log_major "flatten --zip: no sidecars or plain live nested repos under $_fl_top to archive"
        log_medium "(shadowed repos are skipped in bulk — zip one on purpose by naming its path)"
        return 0
      fi
    fi

    # --local-only: keep only the repos with NO remote (⌂ in 'st').
    if [ "$_fl_local_only" = 1 ]; then
      _fl_zip_targets=$(printf '%s\n' "$_fl_zip_targets" | while IFS= read -r _fl_zt; do
        [ -n "$_fl_zt" ] || continue
        repo_is_local_only "$_fl_zt" && printf '%s\n' "$_fl_zt"
      done)
      if [ -z "$_fl_zip_targets" ]; then
        log_major "flatten --zip --local-only: no local-only (⌂) repo/sidecar under $_fl_top to archive"
        return 0
      fi
    fi

    if [ "$_fl_mode" != go ]; then
      log_major "$_fl_top: flatten --zip plan$([ "$_fl_local_only" = 1 ] && printf ' (--local-only: ⌂ only)')"
      printf '%s\n' "$_fl_zip_targets" | while IFS= read -r _fl_zt; do
        [ -n "$_fl_zt" ] || continue
        if [ -d "$_fl_zt/.git" ]; then _fl_zwhat=".git -> .git.zip"; else _fl_zwhat="$GIT_SIDECAR_DIRNAME -> $GIT_SIDECAR_DIRNAME.zip"; fi
        printf '  %s>> %s   (%s%s)%s\n' "$C_BLUE" "$_fl_zt" "$_fl_zwhat" "$([ "$_fl_keep" = 1 ] && printf ', keep original')" "$C_RESET"
      done
      echo
      log_major "This was analyze-only — re-run with 'go' to apply:"
      printf '  %s>>   %s flatten go --zip%s%s %s%s\n' "$C_BLUE" "$US" "$([ "$_fl_keep" = 1 ] && printf ' -k')" "$([ "$_fl_local_only" = 1 ] && printf ' --local-only')" "${_fl_scope_path:-}" "$C_RESET"
      [ "$_fl_interactive" = 1 ] && log_medium "(-i: 'go -i' will ask [Y]es/[s]kip/[a]bort per repo)"
      return 0
    fi

    # go: apply. Split targets on newlines into positional args.
    _fl_oifs=$IFS; IFS='
'
    # shellcheck disable=SC2086
    set -- $_fl_zip_targets
    IFS=$_fl_oifs
    _fl_zip_ok=0; _fl_zip_fail=0; _fl_zip_skip=0
    _fl_zip_total=$#; _fl_zip_i=0
    for _fl_zt in "$@"; do
      [ -n "$_fl_zt" ] || continue
      _fl_zip_i=$((_fl_zip_i + 1))
      # -i: ask per repo (one by one), FULLY annotated.
      if [ "$_fl_interactive" = 1 ]; then
        _prompt_ysa "[$_fl_zip_i of $_fl_zip_total] \"$_fl_zt\" [zip] archive .git in place (no repo is committed to) ?"
        case $? in
          1) _fl_zip_skip=$((_fl_zip_skip + 1)); log_medium "skip  $_fl_zt"; continue ;;
          2) log_major "aborted (${_fl_zip_ok} already archived)"; return 77 ;;
          3) _fl_interactive=0 ;;   # go: this one + all remaining, no more asking
        esac
      fi
      if _zip_gitdir "$_fl_zt" "$_fl_keep"; then
        _fl_zip_ok=$((_fl_zip_ok + 1))
        log_ok "flatten --zip: archived $_fl_zt$([ "$_fl_keep" = 1 ] && printf ' (original kept)')"
      else
        _fl_zip_fail=$((_fl_zip_fail + 1))
      fi
    done
    [ "$_fl_zip_fail" = 0 ] || log_fail "flatten --zip: $_fl_zip_fail target(s) failed"
    log_major "flatten --zip: $_fl_zip_ok archived, $_fl_zip_fail failed$([ "$_fl_zip_skip" -gt 0 ] && printf ', %s skipped' "$_fl_zip_skip")"
    [ "$_fl_zip_fail" = 0 ]
    return
  fi

  # Direct sidecar -> merge conversion: if the PATH argument already IS
  # a sidecar (GIT_SIDECAR_DIRNAME present, no live .git) and --merge
  # was explicitly requested, handle it here and exit — simpler than
  # the embedded/registered pipeline below (no move-out dance, no
  # .gitmodules involved, content already tracked by the parent), and
  # doesn't need an 'unflatten --sidecar' round trip first.
  if [ -n "$_fl_scope_path" ] && [ "$_fl_forced_mode" = merge ] && [ -d "$_fl_scope_path/$GIT_SIDECAR_DIRNAME" ]; then
    log_dbg_med "flatten: taking DIRECT sidecar->merge path for '$_fl_scope_path' ($_fl_scope_path/$GIT_SIDECAR_DIRNAME exists + --merge forced)"
    if [ "$_fl_mode" != "go" ]; then
      log_major "$_fl_top: flatten plan"
      printf '  %s>> %s  (already a sidecar — merge directly: %s removed, .git.merged written, no live .git needed first)%s\n' \
        "$C_BLUE" "$_fl_scope_path" "$GIT_SIDECAR_DIRNAME" "$C_RESET"
      echo
      log_major "This was analyze-only — re-run with 'go' to apply:"
      printf '  %s>>   %s flatten go %s --merge%s\n' "$C_BLUE" "$US" "$_fl_scope_path" "$C_RESET"
      exit 0
    fi
    _fl_merge_sidecar_path "$_fl_scope_path" || fatal "flatten: merging sidecar $_fl_scope_path failed" 1
    # May have created a FRESH sidecar via the sub-submodule safety net
    # (an existing sidecar can itself harbor an unrealized sub-submodule
    # — see _fl_transfer_sub_submodules) — make sure it's excluded
    # before staging, same as the main pipeline does.
    ensure_sidecar_exclude "$_fl_top"
    # Shield any nested repos STILL inside the scope path (embedded, or
    # registered-but-unrealized) before 'git add -A'. A sidecar can
    # itself contain further nested repos; 'git add' recursing into one
    # with no commit checked out fails FATALLY ("does not have a commit
    # checked out"), staging nothing — which previously left the merge
    # half-done (.git.real already gone, .git.merged uncommitted) while
    # still reporting success. Must run AFTER _fl_merge_sidecar_path so
    # the sub-submodule transfer inside it could resolve pointers first.
    # (Real bug found merging a production sidecar that contained
    # src/,bewerbungen [embedded] and src/py/my-books [no commit].)
    _fms_shield_save=$(mktemp -d "${TMPDIR:-/tmp}/${US}.dmshield.XXXXXX") \
      || fatal "flatten: mktemp -d for shield failed" 1
    _fms_shield_manifest="$_fms_shield_save/.manifest"; : > "$_fms_shield_manifest"
    _fl_shield_dir_nested "$_fl_scope_path" "$_fms_shield_save" "$_fms_shield_manifest"
    if ! run git add -A -- "$_fl_scope_path"; then
      log_error "flatten: 'git add' failed for $_fl_scope_path even after shielding nested repos — leaving the merge staged for manual inspection (nothing committed)"
      _fl_unshield_dir "$_fms_shield_manifest"; runq rm -rf "$_fms_shield_save"
      fatal "flatten: could not stage merged content for $_fl_scope_path" 1
    fi
    if run git diff --cached --quiet -- "$_fl_scope_path" 2>/dev/null; then
      _fl_unshield_dir "$_fms_shield_manifest"; runq rm -rf "$_fms_shield_save"
      log_major "$_fl_top: $_fl_scope_path merged (nothing left to commit — it was already fully tracked as a sidecar)"
      exit 0
    fi
    if ! run git commit -q -m "my-git flatten --merge: $_fl_scope_path converted directly from sidecar (.git.merged written)" -- "$_fl_scope_path"; then
      _fl_unshield_dir "$_fms_shield_manifest"; runq rm -rf "$_fms_shield_save"
      fatal "flatten: commit for merged sidecar $_fl_scope_path failed" 1
    fi
    # Restore the shielded nested repos, exactly as they were.
    _fl_unshield_dir "$_fms_shield_manifest"
    runq rm -rf "$_fms_shield_save"
    log_major "$_fl_top: $(c_green 'DONE :))') ($_fl_scope_path merged directly from sidecar; .git.merged snapshot written; nested repos inside it left untouched; unrelated changes left untouched)"
    exit 0
  fi

  # All nested .git (dirs AND files — submodule-pointer .git files).
  # Depth-first order (shortest path first) — NOT plain lexicographic:
  # a plain sort would put e.g. 'src/,foo' before 'src' itself
  # (','=0x2C sorts below '.'=0x2E) — this ordering doesn't affect
  # correctness here (see below), but keeps output stable/readable.
  trace "(cd $_fl_top && find . -name .git -print)   # discover nested git repos to flatten"
  _fl_nested_all_raw=$(find . -path ./.git -prune -o \( -name .git -a \( -type d -o -type f \) \) -print 2>/dev/null | sed -e 's|^\./||' -e 's|/\.git$||')
  # SHADOWED repos (live .git + .git.shadow.status) are a DELIBERATE content-
  # mirror — flattening one would silently need an unshadow first, which we
  # never do implicitly. Drop them from discovery entirely and remember which,
  # so the plan can say "skipped — unshadow first to flatten".
  _fl_shadowed_dirs=$(list_shadowed_dirs "$_fl_top")
  _fl_shadowed_skipped=""
  if [ -n "$_fl_shadowed_dirs" ]; then
    _fl_shadowed_skipped=$(printf '%s\n' "$_fl_nested_all_raw" | while IFS= read -r _fl_sn; do
      [ -n "$_fl_sn" ] || continue
      printf '%s\n' "$_fl_shadowed_dirs" | grep -qxF "$_fl_sn" && printf '%s\n' "$_fl_sn"
    done)
    if [ -n "$_fl_shadowed_skipped" ]; then
      _fl_nested_all_raw=$(printf '%s\n' "$_fl_nested_all_raw" | while IFS= read -r _fl_sn; do
        [ -n "$_fl_sn" ] || continue
        printf '%s\n' "$_fl_shadowed_skipped" | grep -qxF "$_fl_sn" && continue
        printf '%s\n' "$_fl_sn"
      done)
    fi
  fi
  _fl_nested_all=$(printf '%s\n' "$_fl_nested_all_raw" | awk -F/ '{print NF, $0}' | sort -n -k1,1 -k2 | cut -d' ' -f2- | sed 's|$|/.git|')

  # Registered submodule paths (from .gitmodules).
  _fl_reg=''
  [ -f .gitmodules ] && _fl_reg=$(
    _sm_safe_git . config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
      | sed 's/^[^ ]* //')

  # _fl_is_under_registered <path>
  # True if <path> IS a registered submodule path (in THIS scope's own
  # .gitmodules), or lives under one. Deliberately does NOT also
  # exclude descendants of other, unregistered embedded boundaries
  # (e.g. an unregistered 'src' that itself contains further nested
  # repos) — every nested repo, at any depth, is still offered as its
  # own independent per-item choice under 'flatten -i', regardless of
  # what encloses it. An earlier version of this function also
  # excluded those, to avoid a git-level failure at apply time
  # ("Pathspec '...' is in submodule '...'") — but that traded a
  # crash for silently taking away the user's ability to decide the
  # fate of each deeply-nested item individually, which is the entire
  # point of 'flatten -i' for a tree like this. The git constraint is
  # instead handled per-path at apply time (see the git-add loop
  # below): a path that can't be staged because its enclosing parent
  # is still an intact repo boundary is skipped with a clear message,
  # not treated as a reason to hide the choice or abort the whole run.
  _fl_is_under_registered() {
    _fur_p=$1
    printf '%s\n' "$_fl_reg" | awk -v p="$_fur_p" '
      $0 == p || index(p, $0 "/") == 1 { found=1 }
      END { exit(found ? 0 : 1) }
    '
  }

  _fl_nested=$(printf '%s\n' "$_fl_nested_all" | while IFS= read -r _n; do
    [ -n "$_n" ] || continue
    _np=$(printf '%s' "$_n" | sed 's|/\.git$||')
    if ! _fl_is_under_registered "$_np"; then
      printf '%s\n' "$_n"
    fi
  done)
  _fl_registered=$(printf '%s\n' "$_fl_nested_all" | while IFS= read -r _n; do
    [ -n "$_n" ] || continue
    _np=$(printf '%s' "$_n" | sed 's|/\.git$||')
    if printf '%s\n' "$_fl_reg" | grep -Fxq "$_np"; then
      printf '%s\n' "$_np"
    fi
  done)

  # Orphan gitlinks (160000 in index but not in .gitmodules) — same
  # registered-only exclusion as above.
  _fl_embedded=$(_sm_safe_git . ls-files -s 2>/dev/null | awk '$1 == "160000" {print}' | cut -f2- | sort)
  _fl_orphan=$(printf '%s\n' "$_fl_embedded" | while IFS= read -r _p; do
    [ -n "$_p" ] || continue
    if ! _fl_is_under_registered "$_p"; then
      printf '%s\n' "$_p"
    fi
  done)

  # Respect the 'my-git.ignore' marker (same as sm/mc): a
  # nested repo carrying it is left ENTIRELY untouched by default —
  # flatten previously had no awareness of this marker at all, unlike
  # sm/mc which have always honored it. --force includes them anyway,
  # same convention as sm/mc's own --force.
  _fl_ignored_nested=""
  _fl_ignored_registered=""
  if [ "$_fl_force" != 1 ]; then
    _fl_ign_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.flign.XXXXXX") || fatal "flatten: mktemp failed" 1
    _fl_keep_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.flkeep.XXXXXX") || fatal "flatten: mktemp failed" 1
    : > "$_fl_ign_tmp"; : > "$_fl_keep_tmp"
    while IFS= read -r _n; do
      [ -n "$_n" ] || continue
      _np=$(printf '%s' "$_n" | sed 's|/\.git$||')
      if is_nested_ignored . "$_np"; then
        printf '%s\n' "$_n" >> "$_fl_ign_tmp"
      else
        printf '%s\n' "$_n" >> "$_fl_keep_tmp"
      fi
    done <<_FL_IGNCHK_EOF
$_fl_nested
_FL_IGNCHK_EOF
    _fl_ignored_nested=$(cat "$_fl_ign_tmp")
    _fl_nested=$(cat "$_fl_keep_tmp")
    rm -f "$_fl_ign_tmp" "$_fl_keep_tmp"

    _fl_ignreg_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.flignreg.XXXXXX") || fatal "flatten: mktemp failed" 1
    _fl_keepreg_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.flkeepreg.XXXXXX") || fatal "flatten: mktemp failed" 1
    : > "$_fl_ignreg_tmp"; : > "$_fl_keepreg_tmp"
    while IFS= read -r _np; do
      [ -n "$_np" ] || continue
      if is_nested_ignored . "$_np"; then
        printf '%s\n' "$_np" >> "$_fl_ignreg_tmp"
      else
        printf '%s\n' "$_np" >> "$_fl_keepreg_tmp"
      fi
    done <<_FL_IGNCHK_REG_EOF
$_fl_registered
_FL_IGNCHK_REG_EOF
    _fl_ignored_registered=$(cat "$_fl_ignreg_tmp")
    _fl_registered=$(cat "$_fl_keepreg_tmp")
    rm -f "$_fl_ignreg_tmp" "$_fl_keepreg_tmp"

    _fl_ignorph_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.flignorph.XXXXXX") || fatal "flatten: mktemp failed" 1
    _fl_keeporph_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.flkeeporph.XXXXXX") || fatal "flatten: mktemp failed" 1
    : > "$_fl_ignorph_tmp"; : > "$_fl_keeporph_tmp"
    while IFS= read -r _np; do
      [ -n "$_np" ] || continue
      if is_nested_ignored . "$_np"; then
        printf '%s\n' "$_np" >> "$_fl_ignorph_tmp"
      else
        printf '%s\n' "$_np" >> "$_fl_keeporph_tmp"
      fi
    done <<_FL_IGNCHK_ORPH_EOF
$_fl_orphan
_FL_IGNCHK_ORPH_EOF
    _fl_orphan=$(cat "$_fl_keeporph_tmp")
    rm -f "$_fl_ignorph_tmp" "$_fl_keeporph_tmp"
  fi

  # PATH argument: narrow every list down to just that one nested repo —
  # including the ignored-marker lists, so an unrelated ignore-marked
  # repo elsewhere in the tree doesn't show up in the plan/report at all
  # when the caller only asked about one specific path.
  # Applied after ignore-marker filtering so a --force'd, explicitly
  # named path still overrides an ignore marker on itself, same as it
  # would for a whole-repo run.
  if [ -n "$_fl_scope_path" ]; then
    _fl_nested=$(printf '%s\n' "$_fl_nested" | awk -v p="$_fl_scope_path/.git" '$0==p')
    _fl_registered=$(printf '%s\n' "$_fl_registered" | awk -v p="$_fl_scope_path" '$0==p')
    _fl_orphan=$(printf '%s\n' "$_fl_orphan" | awk -v p="$_fl_scope_path" '$0==p')
    _fl_ignored_nested=$(printf '%s\n' "$_fl_ignored_nested" | awk -v p="$_fl_scope_path/.git" '$0==p')
    _fl_ignored_registered=$(printf '%s\n' "$_fl_ignored_registered" | awk -v p="$_fl_scope_path" '$0==p')
    if [ -z "$(printf '%s%s%s' "$_fl_nested" "$_fl_registered" "$_fl_orphan" | tr -d '\n')" ]; then
      if printf '%s\n' "$_fl_shadowed_skipped" | grep -qxF "$_fl_scope_path"; then
        fatal "flatten: '$_fl_scope_path_raw' is SHADOWED — a deliberate content-mirror with a LIVE .git. Flattening it would have to undo the shadow first, which flatten won't do implicitly. Run 'my-git unshadow $_fl_scope_path' first, then flatten." 64
      fi
      if [ -n "$(printf '%s%s' "$_fl_ignored_nested" "$_fl_ignored_registered" | tr -d '\n')" ]; then
        fatal "flatten: '$_fl_scope_path_raw' is marked my-git.ignore — pass --force to include it" 64
      fi
      fatal "flatten: '$_fl_scope_path_raw' is not a nested repo (embedded, registered, or orphan gitlink) under $_fl_top" 64
    fi
  fi

  # --local-only: a GENERIC filter over everything flatten does. Applied to the
  # discovered candidate lists HERE, so all downstream logic (counts, the
  # by-mode overview, the plan, and every mode's apply) sees only the
  # local-only (⌂, no-remote) subset — not just --zip.
  if [ "$_fl_local_only" = 1 ]; then
    _fl_nested=$(printf '%s\n' "$_fl_nested" | _fl_keep_local_only 1)
    _fl_registered=$(printf '%s\n' "$_fl_registered" | _fl_keep_local_only 0)
    _fl_orphan=$(printf '%s\n' "$_fl_orphan" | _fl_keep_local_only 0)
  fi

  _fl_n_nested=$(printf '%s' "$_fl_nested" | grep -c .)
  _fl_n_orphan=$(printf '%s' "$_fl_orphan" | grep -c .)
  _fl_n_registered=$(printf '%s' "$_fl_registered" | grep -c .)

  if [ "$_fl_n_nested" -eq 0 ] && [ "$_fl_n_orphan" -eq 0 ] \
     && { [ "$_fl_n_registered" -eq 0 ] || { [ "$_fl_interactive" != 1 ] && [ -z "$_fl_forced_mode" ] && [ "${AUTO_SIDECAR_SUBMODULES:-0}" != 1 ]; }; }; then
    _fl_n_ign_nested=$(printf '%s' "$_fl_ignored_nested" | grep -c .)
    _fl_n_ign_reg=$(printf '%s' "$_fl_ignored_registered" | grep -c .)
    # flatten has THREE equal modes. --sidecar and --merge convert a nested
    # LIVE repo (none found — that's why we're here); --zip additionally
    # archives an existing SIDECAR. So present all three on equal footing,
    # with counts, rather than "nothing to flatten" (which is only true for
    # --sidecar/--merge) plus --zip as an afterthought.
    # --local-only filters the archivable sidecars too (their remote is
    # readable via .git.real). Zipped dirs can't be checked (git dir is
    # zipped), so the restore count is not filtered.
    if [ "$_fl_local_only" = 1 ]; then
      _fl_hint_sc=$(list_realized_dirs "$_fl_top" | _fl_keep_local_only 0 | grep -c .)
    else
      _fl_hint_sc=$(list_realized_dirs "$_fl_top" | grep -c .)
    fi
    _fl_hint_zip=$(list_zipped_dirs "$_fl_top" | grep -c .)
    _fl_ign_total=$((_fl_n_ign_nested + _fl_n_ign_reg))
    _fl_n_shadowed=$(printf '%s' "$_fl_shadowed_skipped" | grep -c .)
    # 'go'/'-i' asked to DO something, but flatten can only ACT on a nested LIVE
    # repo (none here) or a SIDECAR to zip (_fl_hint_sc). If neither, say plainly
    # there's nothing to flatten — a concise status + doc pointers, NOT the
    # analyze overview plus a PICK-A-MODE wall. (Plain 'flatten' analyze keeps
    # the full by-mode overview below, unchanged.)
    if [ "$_fl_mode" = go ] && [ "${_fl_hint_sc:-0}" -eq 0 ]; then
      log_major "Nothing to flatten."
      log_major "Current status: flatten — by mode$([ "$_fl_local_only" = 1 ] && printf ' (--local-only: ⌂ only)')"
      printf '  %s>> --merge   :  0   convert a nested live repo   (none found here)%s\n' "$C_BLUE" "$C_RESET"
      printf '  %s>> --sidecar :  0   convert a nested live repo   (none found here)%s\n' "$C_BLUE" "$C_RESET"
      printf '  %s>> --zip     :  0   archive a repo/sidecar       (none found here)%s\n' "$C_BLUE" "$C_RESET"
      [ "$_fl_n_shadowed" -gt 0 ] && printf '  %s>> (%s SHADOWED repo(s) skipped — content-mirror with a live .git; '\''unshadow <path>'\'' first to flatten/zip one)%s\n' \
        "$C_BLUE" "$_fl_n_shadowed" "$C_RESET"
      [ "$_fl_ign_total" -gt 0 ] && printf '  %s>> (%s nested repo(s) marked my-git.ignore, left untouched — --force to include)%s\n' \
        "$C_BLUE" "$_fl_ign_total" "$C_RESET"
      echo
      if [ "$_fl_n_shadowed" -gt 0 ] || [ "${_fl_hint_zip:-0}" -gt 0 ]; then
        log_major "As all nested gits are already either flattened or shadowed."
      else
        log_major "There are no nested git repos here to flatten."
      fi
      log_major "Please see '$US flatten --help' and '$US shadow --help' for more information."
      [ "$_fl_n_registered" -gt 0 ] && _fl_warn_registered
      exit 0
    fi
    if [ "${_fl_hint_sc:-0}" -eq 0 ] && [ "${_fl_hint_zip:-0}" -eq 0 ]; then
      # Truly nothing — no candidates for ANY mode.
      if [ "$_fl_ign_total" -gt 0 ]; then
        log_major "$_fl_top: nothing to flatten ($_fl_ign_total marked my-git.ignore, left untouched — --force to include)"
      else
        log_major "$_fl_top: nothing to flatten (no nested live repos, no sidecars)"
      fi
      [ "$_fl_n_registered" -gt 0 ] && _fl_warn_registered
      exit 0
    fi
    log_major "$_fl_top: flatten — by mode$([ "$_fl_local_only" = 1 ] && printf ' (--local-only: ⌂ only)')"
    printf '  %s>> --merge   :  0   convert a nested live repo   (none found here)%s\n' "$C_BLUE" "$C_RESET"
    printf '  %s>> --sidecar :  0   convert a nested live repo   (none found here)%s\n' "$C_BLUE" "$C_RESET"
    if [ "${_fl_hint_sc:-0}" -gt 0 ]; then
      printf '  %s>> --zip     : %2s   archive existing sidecar(s)  ->  %s flatten --zip go   (or: flatten --zip <path>)%s\n' \
        "$C_BLUE" "$_fl_hint_sc" "$US" "$C_RESET"
    else
      printf '  %s>> --zip     :  0   archive a repo/sidecar       (none found here)%s\n' "$C_BLUE" "$C_RESET"
    fi
    if [ -n "$_fl_shadowed_skipped" ]; then
      printf '  %s>> (%s SHADOWED repo(s) skipped — content-mirror with a live .git; '\''unshadow <path>'\'' first to flatten/zip one)%s\n' \
        "$C_BLUE" "$(printf '%s' "$_fl_shadowed_skipped" | grep -c .)" "$C_RESET"
    fi
    if [ "$_fl_ign_total" -gt 0 ]; then
      printf '  %s>> (%s nested repo(s) marked my-git.ignore, left untouched — --force to include)%s\n' \
        "$C_BLUE" "$_fl_ign_total" "$C_RESET"
    fi
    if [ "${_fl_hint_zip:-0}" -gt 0 ]; then
      echo
      log_major "$_fl_top: unflatten — by mode"
      printf '  %s>> --zip     : %2s   restore zipped dir(s)        ->  %s unflatten --zip go   (or: unflatten --zip <path>)%s\n' \
        "$C_BLUE" "$_fl_hint_zip" "$US" "$C_RESET"
    fi
    # If the user actually typed 'go' (asked to DO something) but no mode was
    # actionable, say so LOUDLY and echo the exact command — 'go' with no mode
    # only touches nested LIVE repos (none here); --local-only is a FILTER, not
    # a mode, so it can't act on its own.
    if [ "$_fl_mode" = go ]; then
      echo
      log_major "Nothing changed — 'go' needs you to PICK A MODE ('go' alone only"
      log_major "converts nested LIVE repos, and there are none here; --local-only is"
      log_major "only a filter, not a mode). Pick one:"
      _fl_sugg=""
      [ "$_fl_local_only" = 1 ]  && _fl_sugg="$_fl_sugg --local-only"
      [ "$_fl_interactive" = 1 ] && _fl_sugg="$_fl_sugg -i"
      [ "${_fl_hint_sc:-0}" -gt 0 ] && \
        printf '  %s>>   --zip   ->  %s flatten go --zip%s     (archive the %s sidecar(s) above)%s\n' \
          "$C_BLUE" "$US" "$_fl_sugg" "$_fl_hint_sc" "$C_RESET"
      printf '  %s>>   --sidecar / --merge  act on nested LIVE repos (none here)%s\n' "$C_BLUE" "$C_RESET"
      [ "${_fl_hint_zip:-0}" -gt 0 ] && \
        printf '  %s>>   (to RESTORE:  %s unflatten go --zip%s   — the %s zipped dir(s) above)%s\n' \
          "$C_BLUE" "$US" "$([ "$_fl_interactive" = 1 ] && printf ' -i')" "$_fl_hint_zip" "$C_RESET"
    fi
    [ "$_fl_n_registered" -gt 0 ] && _fl_warn_registered
    exit 0
  fi

  log_major "$_fl_top: flatten plan"
  if [ -z "$_fl_scope_path" ] && [ -n "$_fl_shadowed_skipped" ]; then
    _fl_n_shadowed=$(printf '%s' "$_fl_shadowed_skipped" | grep -c .)
    printf '  %s>> %s SHADOWED repo(s) SKIPPED — already a content-mirror (live .git kept). flatten leaves them alone; run '\''unshadow <path>'\'' first if you really want to flatten one:%s\n' \
      "$C_BLUE" "$_fl_n_shadowed" "$C_RESET"
    printf '%s\n' "$_fl_shadowed_skipped" | while IFS= read -r _n; do
      [ -n "$_n" ] && printf '       %s\n' "$_n"
    done
  fi
  _fl_n_ign_nested=$(printf '%s' "$_fl_ignored_nested" | grep -c .)
  _fl_n_ign_reg=$(printf '%s' "$_fl_ignored_registered" | grep -c .)
  if [ "$((_fl_n_ign_nested + _fl_n_ign_reg))" -gt 0 ]; then
    printf '  %s>> %s marked my-git.ignore — left untouched (--force to include):%s\n' \
      "$C_BLUE" "$((_fl_n_ign_nested + _fl_n_ign_reg))" "$C_RESET"
    printf '%s\n' "$_fl_ignored_nested" | while IFS= read -r _n; do
      [ -n "$_n" ] && printf '       %s\n' "$(printf '%s' "$_n" | sed 's|/\.git$||')"
    done
    printf '%s\n' "$_fl_ignored_registered" | while IFS= read -r _n; do
      [ -n "$_n" ] && printf '       %s\n' "$_n"
    done
  fi
  # Plan details: always visible (not -V-gated) — the user needs to see
  # WHAT would be touched before deciding whether to run 'go'. Git jargon
  # is explained inline so a non-git-expert can follow.
  if [ "$_fl_n_nested" -gt 0 ]; then
    if [ "${AUTO_SIDECAR_EMBEDDED:-0}" = 1 ]; then
      printf '  %s>> %s Nested git repos to REALIZE (self-contained %s, no live .git left) — AUTO_SIDECAR_EMBEDDED=1:%s\n' \
        "$C_BLUE" "$_fl_n_nested" "$GIT_SIDECAR_DIRNAME" "$C_RESET"
      if [ "$_fl_rmgit" = 1 ]; then
        printf '  %s>> --rm-git only applies to any that FAIL to sidecar (rare) — it does not delete successfully sidecared ones.%s\n' \
          "$C_BLUE" "$C_RESET"
      fi
    elif [ "$_fl_rmgit" = 1 ]; then
      printf '  %s>> %s Nested .git dirs to DELETE (irreversible):%s\n' \
        "$C_BLUE" "$_fl_n_nested" "$C_RESET"
    else
      printf '  %s>> %s Nested git repos to add to parent as content, ignoring these .git dirs:%s\n' \
        "$C_BLUE" "$_fl_n_nested" "$C_RESET"
    fi
    printf '%s\n' "$_fl_nested" | while IFS= read -r _n; do
      [ -z "$_n" ] && continue
      _n_bare=$(printf '%s' "$_n" | sed 's|/\.git$||')
      if _fl_realize_would_fail "$_n_bare"; then
        printf '       %s  %s(⚠ history already gone — sidecar will fail; flatten/delete only)%s\n' "$_n" "$C_YELLOW" "$C_RESET"
      else
        printf '       %s\n' "$_n"
      fi
    done
    if [ "$_fl_rmgit" != 1 ] && [ "${AUTO_SIDECAR_EMBEDDED:-0}" != 1 ]; then
      # Describe what happens to each .git — MODE-AWARE, so it never claims
      # ".git kept" when --merge/--zip/--sidecar will actually dispose of it.
      case "$_fl_forced_mode" in
        sidecar) printf '  %s>> --sidecar: each .git is RELOCATED to ./%s (history kept; restore with %s unflatten --sidecar). cd + git keep working via the sidecar.%s\n' "$C_BLUE" "$GIT_SIDECAR_DIRNAME" "$US" "$C_RESET" ;;
        merge)   printf '  %s>> --merge: each nested .git is absorbed into THIS repo — its objects are transplanted here and its refs pinned under %s/<path>/, so the history is KEPT (restore any of them with %s unflatten --merge). cd + git STOP working in those dirs until you do. To absorb the files and DISCARD the history instead, use --rm-git.%s\n' "$C_BLUE" "$MERGED_REFS_ROOT" "$US" "$C_RESET" ;;
        zip)     printf '  %s>> --zip: each .git is ARCHIVED to ./.git.zip (restore with %s unflatten --zip). cd + git will not work until restored.%s\n' "$C_BLUE" "$US" "$C_RESET" ;;
        *)       printf '  %s>> the live .git is untouched for now — but '\''go'\'' needs a mode, and each disposes of the .git differently: --sidecar keeps history (./%s), --merge DELETES it, --zip archives it (or -i to choose per repo; AUTO_SIDECAR_EMBEDDED=1 sidecars all).%s\n' "$C_BLUE" "$GIT_SIDECAR_DIRNAME" "$C_RESET" ;;
      esac
    fi
  fi
  if [ "$_fl_n_orphan" -gt 0 ]; then
    printf '  %s>> %s Orphan gitlinks to remove:%s\n' \
      "$C_BLUE" "$_fl_n_orphan" "$C_RESET"
    printf '%s\n' "$_fl_orphan" | while IFS= read -r _p; do
      [ -n "$_p" ] && printf '       %s\n' "$_p"
    done
  fi

  _fl_warn_registered

  # analyze mode — print plan and bail. NOTHING is changed until 'go'.
  if [ "$_fl_mode" != "go" ]; then
    echo
    log_major "This was analyze-only — re-run with 'go' AND a mode to apply:"
    printf '  %s>>   %s flatten go --sidecar    (relocate each .git -> %s)%s\n' "$C_BLUE" "$US" "$GIT_SIDECAR_DIRNAME" "$C_RESET"
    printf '  %s>>   %s flatten go --merge      (absorb each .git INTO this repo; history kept)%s\n' "$C_BLUE" "$US" "$C_RESET"
    printf '  %s>>   %s flatten go --rm-git      (DELETE each .git; history NOT kept — asks you to type "I am sure")%s\n' "$C_BLUE" "$US" "$C_RESET"
    printf '  %s>>   %s flatten go --zip         (archive each .git -> .zip)%s\n' "$C_BLUE" "$US" "$C_RESET"
    printf '  %s>>   %s flatten go -i            (choose --sidecar/--merge/--zip per repo)%s\n' "$C_BLUE" "$US" "$C_RESET"
    exit 0
  fi

  # SAFETY: flatten finishes with a plain 'git commit' (whole index). Refuse to
  # start if the index ALREADY has staged changes — otherwise a flatten commit
  # would sweep the user's unrelated staged work into it. my-git commits must
  # contain ONLY my-git's own changes. (Unstaged modifications and untracked
  # files are fine: flatten only stages the specific paths it touches.)
  trace "(cd $_fl_top && git diff --cached --quiet)   # flatten: require a clean index (no pre-staged changes)"
  if ! git diff --cached --quiet 2>/dev/null; then
    fatal "flatten go: your git index already has STAGED changes. flatten commits the whole index, so it must start from a CLEAN index — otherwise it would sweep your staged work into its own commit. Commit or unstage them first (e.g. 'git -C $_fl_top reset' to unstage, keeping the changes), then re-run. Unstaged/untracked changes are fine." 1
  fi

  # -i: per-item interactive prompt + summary + confirm. TTY already
  # required by the parser. Defaults match what bare 'go' would do per
  # type, so all-Enter ≡ same outcome as plain 'go'. Choices tagged
  # [-i EXCLUSIVE CHOICE] are not reachable via bare 'go' / 'go --rm-git'.
  _fl_nested_delete=""    # paths whose .git get rm -rf'd before main flow (per-item delete)
  _fl_nested_zip=""       # paths whose .git get ARCHIVED to .git.zip before main flow (per-item zip)
  _fl_modules_delete=""   # .git/modules/<name>/ paths to rm -rf after commit (registered+delete)
  _fl_realized=""         # paths successfully realized (self-contained $GIT_SIDECAR_DIRNAME)
  if [ "$_fl_interactive" = 1 ] && [ -z "$_fl_forced_mode" ]; then
    _fl_choices=$(mktemp "${TMPDIR:-/tmp}/${US}.flchoices.XXXXXX") || \
      fatal "flatten -i: mktemp failed" 1
    if ! _fl_interactive_collect "$_fl_choices"; then
      rm -f "$_fl_choices"
      exit 77
    fi
    if ! _fl_interactive_summary_confirm "$_fl_choices"; then
      rm -f "$_fl_choices"
      exit 77
    fi
    _fl_index_touched=0
    _fl_interactive_apply "$_fl_choices"
    rm -f "$_fl_choices"
    # zip paths are tracked separately in _fl_nested_zip (not _fl_nested), so
    # include them here or an all-zip run would wrongly look like "nothing".
    if [ "$_fl_n_nested" -eq 0 ] && [ "$_fl_n_orphan" -eq 0 ] && [ -z "$_fl_realized" ] && [ -z "$_fl_nested_zip" ]; then
      log_major "$_fl_top: nothing to flatten after interactive choices"
      _fl_warn_registered
      exit 0
    fi
  elif [ -n "$_fl_forced_mode" ]; then
    # --sidecar / --merge: apply that one mode across every item in scope
    # (already narrowed to $_fl_scope_path above if given). -i asks
    # [Y]es/[s]kip/[a]bort per item; --local-only skips items that have a
    # remote (⌂ only) — both handled inside _fl_build_forced_choices.
    log_major "$_fl_top: --$_fl_forced_mode on up to $((_fl_n_registered + _fl_n_nested + _fl_n_orphan)) item(s)$([ "$_fl_interactive" = 1 ] && printf ' (-i: per item)')$([ "$_fl_local_only" = 1 ] && printf ' (--local-only: ⌂ only)')"
    _fl_choices=$(mktemp "${TMPDIR:-/tmp}/${US}.flchoices.XXXXXX") || \
      fatal "flatten --$_fl_forced_mode: mktemp failed" 1
    if ! _fl_build_forced_choices "$_fl_choices" "$_fl_forced_mode"; then
      rm -f "$_fl_choices"
      log_major "aborted"
      exit 77
    fi
    _fl_index_touched=0
    _fl_interactive_apply "$_fl_choices"
    rm -f "$_fl_choices"
    if [ "$_fl_n_nested" -eq 0 ] && [ "$_fl_n_orphan" -eq 0 ] && [ -z "$_fl_realized" ]; then
      log_major "$_fl_top: nothing to flatten after --$_fl_forced_mode"
      _fl_warn_registered
      exit 0
    fi
  else
    _fl_did_auto=0
    if [ "${AUTO_SIDECAR_SUBMODULES:-0}" = 1 ] && [ "$_fl_n_registered" -gt 0 ]; then
      # Bare 'go' (no -i), but the config opts every registered submodule
      # into automatic realize — same no-prompt treatment embedded nested
      # repos can now opt into via AUTO_SIDECAR_EMBEDDED below.
      _fl_did_auto=1
      log_major "AUTO_SIDECAR_SUBMODULES=1: sidecaring $_fl_n_registered registered submodule(s) automatically"
      _fl_index_touched=0
      # mktemp'd and heredoc-fed (NOT piped) — a piped 'while' runs in a
      # subshell, so nothing it sets would survive past 'done'; the tmp
      # file itself is an external side effect and persists either way,
      # but keeping the loop in the parent shell (heredoc) matches this
      # script's established convention and avoids relying on that
      # distinction being right by accident.
      _fl_auto_realized_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.flauto.XXXXXX") || \
        fatal "AUTO_SIDECAR_SUBMODULES: mktemp failed" 1
      _fl_auto_failed_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.flautofail.XXXXXX") || \
        fatal "AUTO_SIDECAR_SUBMODULES: mktemp failed" 1
      while IFS= read -r _p; do
        [ -n "$_p" ] || continue
        _fl_submodule_initialized "$_p" || { log_warn "AUTO_SIDECAR_SUBMODULES: $_p not initialized — skipping (nothing to sidecar)"; printf '%s\n' "$_p" >> "$_fl_auto_failed_tmp"; continue; }
        _name=$(_sm_safe_git . config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
                  | awk -v pa="$_p" '$2 == pa {print $1}' \
                  | sed 's/^submodule\.//;s/\.path$//' | head -1)
        # Attempt realize FIRST — deregister only on success, so a
        # failure (e.g. the ambiguous dual-.git case) leaves
        # .gitmodules/index exactly as they were, nothing orphaned.
        if _fl_realize_submodule "$_p" "$_name"; then
          _sm_safe_git . config -f .gitmodules --remove-section "submodule.$_name" >/dev/null 2>&1 || true
          run git update-index --force-remove -- "$_p" >/dev/null 2>&1 || \
            log_warn "update-index --force-remove failed for $_p"
          printf '%s\n' "$_p" >> "$_fl_auto_realized_tmp"
        else
          log_error "sidecar failed for $_p — left as an untouched registered submodule; please inspect manually"
          printf '%s\n' "$_p" >> "$_fl_auto_failed_tmp"
        fi
      done <<_FL_AUTO_EOF
$_fl_registered
_FL_AUTO_EOF
      _fl_index_touched=1
      if [ -s "$_fl_auto_realized_tmp" ]; then
        _fl_realized=$(printf '%s\n%s\n' "$_fl_realized" "$(cat "$_fl_auto_realized_tmp")" | grep -v '^$')
      fi
      _fl_registered=$([ -s "$_fl_auto_failed_tmp" ] && cat "$_fl_auto_failed_tmp" || true)
      _fl_n_registered=$(printf '%s' "$_fl_registered" | grep -c .)
      rm -f "$_fl_auto_realized_tmp" "$_fl_auto_failed_tmp"
      if [ -f .gitmodules ] && ! _sm_safe_git . config -f .gitmodules \
           --get-regexp '^submodule\..*\.path$' >/dev/null 2>&1; then
        run git update-index --force-remove -- .gitmodules >/dev/null 2>&1 || \
          log_warn ".gitmodules: update-index --force-remove failed"
        run rm -f -- .gitmodules
      elif [ -f .gitmodules ]; then
        run git add -- .gitmodules >/dev/null 2>&1 || log_warn ".gitmodules: git add failed"
      fi
    fi

    if [ "${AUTO_SIDECAR_EMBEDDED:-0}" = 1 ] && [ "$_fl_n_nested" -gt 0 ]; then
      # Same idea for plain EMBEDDED nested repos: instead of the
      # default move-out/restore-with-live-.git treatment, realize each
      # one — self-contained GIT_SIDECAR_DIRNAME, no live .git left in the
      # tree. No .gitmodules involved here, so this is simpler than the
      # submodule case above.
      _fl_did_auto=1
      log_major "AUTO_SIDECAR_EMBEDDED=1: sidecaring $_fl_n_nested embedded nested repo(s) automatically"
      _fl_index_touched=0
      _fl_auto_realized_emb_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.flautoemb.XXXXXX") || \
        fatal "AUTO_SIDECAR_EMBEDDED: mktemp failed" 1
      _fl_auto_stay_nested_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.flautostay.XXXXXX") || \
        fatal "AUTO_SIDECAR_EMBEDDED: mktemp failed" 1
      : > "$_fl_auto_stay_nested_tmp"
      # Deepest-first (see the comment in _fl_interactive_apply's
      # embedded pass for why): a shallow item's rename can invalidate
      # a deeper child's gitfile-pointer resolution if done first.
      _fl_nested_deepest_first=$(printf '%s\n' "$_fl_nested" | sed 's|/\.git$||' \
        | awk -F/ '{print NF, $0}' | sort -rn -k1,1 | cut -d' ' -f2- | sed 's|$|/.git|')
      while IFS= read -r _np_git; do
        [ -n "$_np_git" ] || continue
        _p=$(printf '%s' "$_np_git" | sed 's|/\.git$||')
        if _fl_realize_would_fail "$_p"; then
          # Known dead pointer — realize is guaranteed to fail here
          # (history already permanently gone). Skip the doomed
          # attempt entirely and fall through to normal flatten
          # (content-tracking) treatment instead of leaving it
          # untouched — AUTO_SIDECAR_EMBEDDED's whole point is not
          # leaving things embedded when there's a better option.
          log_warn "$_p: history already gone (gitdir pointer unresolvable even via $GIT_SIDECAR_DIRNAME) — flattening as plain content instead of the doomed sidecar attempt"
          printf '%s\n' "$_np_git" >> "$_fl_auto_stay_nested_tmp"
          continue
        fi
        if _fl_realize_embedded "$_p"; then
          printf '%s\n' "$_p" >> "$_fl_auto_realized_emb_tmp"
          # Same reasoning as the -i path: a path can be both embedded
          # AND a stale orphan gitlink at once — clear it here so the
          # realized content is guaranteed to end up properly tracked
          # rather than silently masked by a leftover 160000 entry.
          if printf '%s\n' "$_fl_orphan" | grep -Fxq "$_p"; then
            run git update-index --force-remove -- "$_p" >/dev/null 2>&1 || \
              log_warn "update-index --force-remove failed for $_p"
            _fl_orphan=$(printf '%s\n' "$_fl_orphan" | grep -Fxv "$_p")
          fi
        else
          log_error "sidecar failed for $_p — left as an untouched embedded repo; please inspect manually"
        fi
      done <<_FL_AUTO_EMB_EOF
$_fl_nested_deepest_first
_FL_AUTO_EMB_EOF
      _fl_index_touched=1
      _fl_n_orphan=$(printf '%s' "$_fl_orphan" | grep -c .)
      if [ -s "$_fl_auto_realized_emb_tmp" ]; then
        _fl_realized=$(printf '%s\n%s\n' "$_fl_realized" "$(cat "$_fl_auto_realized_emb_tmp")" | grep -v '^$')
      fi
      rm -f "$_fl_auto_realized_emb_tmp"
      _fl_nested=$(cat "$_fl_auto_stay_nested_tmp" | grep -v '^$')
      rm -f "$_fl_auto_stay_nested_tmp"
      _fl_n_nested=$(printf '%s' "$_fl_nested" | grep -c .)
    fi

    if [ "$_fl_did_auto" = 1 ] && [ "$_fl_n_nested" -eq 0 ] && [ "$_fl_n_orphan" -eq 0 ] && [ -z "$_fl_realized" ]; then
      log_major "$_fl_top: nothing to flatten after auto-convert pass"
      exit 0
    fi
  fi

  # Any realize (interactive or auto) needs the parent to permanently
  # ignore $GIT_SIDECAR_DIRNAME wherever it occurs — already ensured
  # proactively at the top of this command (ensure_sidecar_exclude), but
  # re-checked here too since this run may be the FIRST realize this
  # checkout has ever seen (the proactive check at the top only found
  # what already existed on disk before this run started).
  # Unconditional (not just when $_fl_realized is non-empty): a merge
  # can ALSO create a fresh sidecar via the sub-submodule safety net
  # (_fl_transfer_sub_submodules, called from _fl_write_merge_snapshot)
  # without $_fl_realized ever being touched — found by direct testing,
  # a merge-only run with a transferred sub-submodule left that new
  # sidecar as untracked clutter because this check's guard missed it.
  # ensure_sidecar_exclude's own internal check (list_realized_dirs)
  # makes this a no-op on runs that truly created nothing to exclude.
  ensure_sidecar_exclude "$_fl_top"
  # Likewise for the refspecs that carry preserved merge history to a
  # remote — a no-op until a merge has actually pinned something under
  # $MERGED_REFS_ROOT. Without it, that history stays on this disk only.
  ensure_preserved_refspec "$_fl_top"

  # Compute path list + argv ONCE, up-front — needed both for commit
  # and for the trap's 'git restore --staged -- <paths>' rollback if we
  # fail after touching the index.
  if ! _fl_build_paths_argv; then
    # An all-zip run has NO whole-path content to add (zip commits only the
    # .git.zip archive, staged separately in the zip loop) — an empty path list
    # is expected there, not an error. Otherwise it's a real failure.
    if [ -z "$_fl_nested_zip" ]; then
      log_error "could not compute path list"
      exit 1
    fi
    _fl_paths_raw=""; _fl_argv=""
  fi

  # A path can be BOTH a nested embedded repo AND carry a stale 160000
  # gitlink in the index at the same time (leftover from an old
  # half-converted submodule — same root cause as the orphan-gitlink
  # case elsewhere). Confirmed directly: 'git add <path>' does NOT
  # auto-convert an existing 160000 index entry to plain tree content
  # just because the on-disk .git is absent/moved-out — it needs an
  # explicit 'git update-index --force-remove' first, or 'git add'
  # silently stages nothing at all (surfaces as a false "nothing to
  # commit"). This must run regardless of whether such a path is ALSO
  # independently shown as an 'orphan gitlink' prompt — even when it
  # isn't (e.g. it's swallowed into a single embedded-repo candidate
  # like 'src'), the stale index entry still needs clearing here.
  printf '%s\n' "$_fl_paths_raw" | while IFS= read -r _fl_pcheck; do
    [ -n "$_fl_pcheck" ] || continue
    if _sm_safe_git . ls-files -s -- "$_fl_pcheck" 2>/dev/null | awk '{print $1}' | grep -qx 160000; then
      log_medium "clearing stale gitlink for $_fl_pcheck before staging as content"
      run git update-index --force-remove -- "$_fl_pcheck" 2>/dev/null || \
        log_warn "update-index --force-remove failed for $_fl_pcheck"
    fi
  done

  # Set up the save root + manifest + trap BEFORE we touch anything.
  # _fl_restore_dirs only puts moved .git dirs back; success path uses
  # this. _fl_rollback also un-stages index changes for our paths via
  # 'git restore --staged' (NOT 'git reset' — never use git reset
  # implicitly); failure / trap paths use this.
  _fl_save_root=$(mktemp -d "${TMPDIR:-/tmp}/${US}.flatten.XXXXXX") \
    || { log_error "mktemp failed"; exit 1; }
  _fl_manifest="$_fl_save_root/.manifest"
  : > "$_fl_manifest"
  _fl_index_touched=0
  # _fl_warn_broken_pointers
  # Realizing an item (renaming its .git to GIT_SIDECAR_DIRNAME) breaks
  # the standalone functionality of any of ITS OWN children that are
  # gitfile-pointer submodules referencing that .git — the moment it's
  # renamed, their pointer's target no longer exists at the path they
  # recorded. Their history and files are NOT lost (realizing that
  # child later correctly finds the data via the GIT_SIDECAR_DIRNAME
  # fallback — see _fl_realize_embedded) but until then, that child is
  # a non-functional git repo in place. This scans for exactly that
  # after a run that realized at least one item, so the person finds
  # out now rather than the next time they try to use one.
  _fl_warn_broken_pointers() {
    [ -n "${_fl_realized:-}" ] || return 0
    _fl_bp_found=0
    find "$_fl_top" -name .git -type f -print 2>/dev/null | while IFS= read -r _bp_gitfile; do
      [ -n "$_bp_gitfile" ] || continue
      _bp_dir=${_bp_gitfile%/.git}
      _bp_ptr=$(sed -n 's/^gitdir: *//p' "$_bp_gitfile" 2>/dev/null | head -1)
      [ -n "$_bp_ptr" ] || continue
      case "$_bp_ptr" in
        /*) _bp_real=$_bp_ptr ;;
        *)  _bp_real=$(cd "$_bp_dir" 2>/dev/null && cd "$_bp_ptr" 2>/dev/null && pwd -P) ;;
      esac
      if [ -z "$_bp_real" ] || [ ! -d "$_bp_real" ]; then
        log_warn "$_bp_dir: no longer a functional git repo — its enclosing repo was sidecared in this run, so its gitdir pointer ('$_bp_ptr') doesn't resolve anymore. Its history isn't lost: run flatten again and choose 'sidecar' for this path to fix it."
      fi
    done
    return 0
  }

  _fl_restore_dirs() {
    # Restore each nested .git (deepest first for nested-nested safety).
    [ -s "$_fl_manifest" ] || return 0
    awk '{lines[NR]=$0} END{for(i=NR;i>=1;i--) print lines[i]}' "$_fl_manifest" \
      | while IFS="$(printf '\t')" read -r _orig _saved; do
          [ -e "$_saved" ] || continue
          [ -e "$_orig" ] && run rm -rf -- "$_orig" 2>/dev/null
          run mv -- "$_saved" "$_orig" 2>/dev/null || \
            log_warn "restore failed: $_saved -> $_orig"
        done
  }

  # _fl_shield_nested_within_addpaths
  # Before 'git add'-ing any of $_fl_paths_raw, temporarily move out
  # EVERY nested repo STILL present inside them that wasn't already
  # handled above — added to the SAME manifest _fl_restore_dirs
  # already knows how to put back. Why this is needed regardless of
  # per-item choices already made: a "skip" choice (or an
  # ignore-marked repo, which never even reaches the choices file)
  # means "leave that repo's own structure AND content untouched" —
  # it does NOT mean git's own 'add' machinery will politely ignore
  # it. 'git add <dir>' recurses into <dir> and, on finding ANY nested
  # .git inside it, tries to stage it as a fresh gitlink (at best) or
  # fails the entire 'git add' fatally if that nested repo has no
  # commit checked out yet (at worst — this crash is what necessitated
  # this function in the first place).
  #
  # Critically: this must move the WHOLE embedded directory, not just
  # its .git. By the time this runs, every 'flatten'-chosen item's OWN
  # .git has ALREADY been moved out by the loop above (it iterates the
  # same $_fl_nested list) — so anything this scan still finds here is
  # BY DEFINITION not meant to have its content tracked in this run.
  # An earlier version of this function moved only the .git aside,
  # which stopped the crash but had a worse side effect: with .git out
  # of the way, git saw the child's plain files as ordinary content
  # and silently swept them into the parent's tracked content anyway —
  # exactly what a "skip" choice was supposed to prevent. Moving the
  # entire directory (content included) keeps it genuinely invisible,
  # then restores it, .git and all, exactly as it was.
  _fl_shield_nested_within_addpaths() {
    _fl_shield_raw_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.flshieldraw.XXXXXX") || return 1
    : > "$_fl_shield_raw_tmp"
    while IFS= read -r _fl_ap; do
      [ -n "$_fl_ap" ] || continue
      [ -e "$_fl_ap" ] || continue
      # mindepth 2: a .git found EXACTLY at "$_fl_ap/.git" (mindepth 1)
      # is the add-path's OWN boundary, not a nested child — e.g. an
      # orphan-gitlink path that's ALSO still its own live, untouched
      # embedded repo (ignore-marked). Shielding that would mean
      # moving the entire add-path out from under itself. Only genuine
      # descendants (mindepth 2+) are what this function exists to
      # protect.
      find "$_fl_ap" -mindepth 2 \( -name .git -a \( -type d -o -type f \) \) -print 2>/dev/null \
        | sed 's|/\.git$||' >> "$_fl_shield_raw_tmp"
    done <<_FL_SHIELD_SCAN_EOF
$_fl_paths_raw
_FL_SHIELD_SCAN_EOF
    # Depth-first (shallowest first), then drop any entry that's a
    # descendant of one already kept — moving the shallower directory
    # already carries its own deeper nested repos along with it, so
    # trying to separately move those too would fail ("no such file",
    # since they're already gone from their original location).
    _fl_shield_dedup_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.flshielddedup.XXXXXX") || {
      rm -f "$_fl_shield_raw_tmp"; return 1
    }
    sort -u "$_fl_shield_raw_tmp" | awk -F/ '{print NF, $0}' | sort -n -k1,1 -k2 | cut -d' ' -f2- \
      | awk '
          function is_under(path,   i) { for (i = 1; i <= nk; i++) if (index(path, kept[i] "/") == 1) return 1; return 0 }
          { if (!is_under($0)) { print; kept[++nk] = $0 } }
        ' > "$_fl_shield_dedup_tmp"
    rm -f "$_fl_shield_raw_tmp"
    while IFS= read -r _fl_en; do
      [ -n "$_fl_en" ] || continue
      [ -e "$_fl_en" ] || continue
      _fl_i=$((_fl_i + 1))
      _fl_save_path="$_fl_save_root/$_fl_i"
      printf '%s\t%s\n' "$_fl_en" "$_fl_save_path" >> "$_fl_manifest"
      log_medium "shield (nested repo inside an add-path, left untouched) $_fl_en  ->  $_fl_save_path"
      if ! run mv -- "$_fl_en" "$_fl_save_path"; then
        log_error "move-out failed for $_fl_en"
        rm -f "$_fl_shield_dedup_tmp"
        return 1
      fi
    done < "$_fl_shield_dedup_tmp"
    rm -f "$_fl_shield_dedup_tmp"
    return 0
  }

  _fl_rollback() {
    # (1) Un-stage any index changes we made so the user's index goes
    # back to HEAD state for our paths. Uses 'git restore --staged' —
    # never 'git reset' (forbidden as an implicit my-git side effect).
    if [ "$_fl_index_touched" = 1 ] && [ -n "${_fl_paths_raw:-}" ]; then
      while IFS= read -r _rp; do
        [ -n "$_rp" ] || continue
        run git restore --staged -- "$_rp" >/dev/null 2>&1 || true
      done <<_FL_ROLLBACK_EOF
$_fl_paths_raw
_FL_ROLLBACK_EOF
    fi
    # (2) Restore moved .git dirs.
    _fl_restore_dirs
  }
  trap '_fl_rollback; rm -rf "$_fl_save_root"; exit 1' INT TERM HUP

  # Unstage orphan gitlinks first. Heredoc (not pipe) keeps the loop in
  # the parent shell so _fl_index_touched = 1 actually persists.
  while IFS= read -r _p; do
    [ -n "$_p" ] || continue
    log_medium "remove   $_p"
    _fl_index_touched=1
    run git update-index --force-remove -- "$_p" >/dev/null 2>&1 || \
      log_warn "git update-index --force-remove failed for $_p"
  done <<_FL_ORPHAN_EOF
$_fl_orphan
_FL_ORPHAN_EOF

  # Per-item zip (from -i 'Z'): ARCHIVE each chosen .git into <path>/.git.zip
  # and commit ONLY that .git.zip — zip does NOT absorb the repo's worktree
  # files (unlike sidecar/merge). Done here, ahead of the --rm-git/move-out
  # blocks. We stage just the archive (not the whole path) and add it to the
  # commit's path list (_fl_argv). st then tags the dir [zipped].
  _fl_zipped_staged=0
  if [ -n "$_fl_nested_zip" ]; then
    while IFS= read -r _n; do
      [ -n "$_n" ] || continue
      _zp=$(printf '%s' "$_n" | sed 's|/\.git$||')
      log_medium "zip      $_zp  (.git -> .git.zip; only the archive is committed)"
      _fl_index_touched=1
      if _zip_gitdir "$_zp" 0; then
        # stage ONLY the archive that _zip_gitdir just wrote (.git.zip for a
        # plain repo, GIT_SIDECAR_DIRNAME.zip for a sidecar) — never the files.
        if [ -f "$_zp/.git.zip" ]; then _fl_zname=".git.zip"; else _fl_zname="${GIT_SIDECAR_DIRNAME:-.git.real}.zip"; fi
        if run git add -f -- "$_zp/$_fl_zname" >/dev/null 2>&1; then
          _fl_zipped_staged=1
        else
          log_warn "zip: git add of $_zp/$_fl_zname failed"
        fi
      else
        log_warn "zip failed for $_zp — its .git is left in place (skipped)"
        _fl_nested_zip=$(printf '%s\n' "$_fl_nested_zip" | grep -Fxv "$_n")
      fi
    done <<_FL_ZIP_EOF
$_fl_nested_zip
_FL_ZIP_EOF
  fi

  if [ "$_fl_rmgit" = 1 ] && [ -n "$_fl_nested" ]; then
    # THE destructive escape hatch. Everything else in my-git is
    # revertible — '--merge' now transplants history into the parent
    # rather than destroying it, 'sidecar'/'zip' relocate it, 'shadow'
    # keeps the .git live. --rm-git exists precisely to throw history
    # away, so it asks for a full spelled-out sentence rather than a
    # reflexive 'yes': three characters are too easy to type on autopilot
    # for an action with no undo.
    #
    # Only reachable when something is actually LEFT in $_fl_nested —
    # e.g. AUTO_SIDECAR_EMBEDDED (or -i's per-item 'realize') may have
    # already realized everything, leaving nothing for --rm-git to
    # touch. Without this guard, --rm-git would demand a confirmation
    # to "permanently delete" an empty list — confusing and pointless.
    echo
    printf '%s%s%s\n' "$C_RED$C_BOLD" \
      "!!! --rm-git will PERMANENTLY DELETE the following nested .git dir(s):" "$C_RESET"
    printf '%s\n' "$_fl_nested" | while IFS= read -r _n; do
      [ -n "$_n" ] || continue
      printf '      %s%s/%s%s\n' "$C_YELLOW" "$_fl_top" "$_n" "$C_RESET"
    done
    printf '    Each nested repo'\''s HISTORY WILL BE LOST (unrecoverable unless backed up).\n'
    printf '    This is NOT revertible — every other my-git operation is.\n'
    printf '    To keep the history instead:  %s flatten go --merge   (absorbs it into this repo)\n' "$US"
    printf '                             or:  %s flatten go --sidecar | --zip\n\n' "$US"
    if [ ! -r /dev/tty ]; then
      log_error "--rm-git needs interactive confirmation but no TTY is available"
      exit 1
    fi
    printf '%sType exactly '\''I am sure'\'' to proceed, anything else to abort:%s ' \
      "$C_RED$C_BOLD" "$C_RESET" >/dev/tty
    IFS= read -r _fl_confirm </dev/tty || _fl_confirm=''
    if [ "$_fl_confirm" != "I am sure" ]; then
      log_major "--rm-git: aborted (expected literal 'I am sure', got: '$_fl_confirm') — nothing was deleted"
      exit 1
    fi
    while IFS= read -r _n; do
      [ -n "$_n" ] || continue
      log_medium "delete   $_n"
      run rm -rf -- "$_n" || log_warn "rm failed for $_n"
    done <<_FL_EOF
$_fl_nested
_FL_EOF
    if ! _fl_shield_nested_within_addpaths; then
      log_error "shielding nested repos failed"
      _fl_rollback
      rm -rf "$_fl_save_root"
      exit 1
    fi
    log_major "staging & committing flattened content (only paths flatten touched)..."
    _fl_index_touched=1
    if ! _fl_add_paths_robust; then
      if [ -n "${_fl_realized:-}" ]; then
        _fl_warn_broken_pointers
        log_major "$_fl_top: sidecared $(printf '%s' "$_fl_realized" | grep -c .) item(s) on disk, but none could be tracked as content yet — each one's enclosing repo needs to be flattened/sidecared too before this scope's index can see it. Re-run flatten later to pick it up."
        _fl_rollback
        trap - INT TERM HUP
        rm -rf "$_fl_save_root"
        exit 0
      fi
      log_error "git add failed for every path"
      _fl_rollback
      rm -rf "$_fl_save_root"
      exit 1
    fi
    # Filter out paths that have no staged content (empty nested dirs).
    _fl_filter_to_staged
    if [ -z "$_fl_argv" ]; then
      log_major "nothing to commit (all nested dirs were empty after .git removed)"
      _fl_rollback
      rm -rf "$_fl_save_root"
      trap - INT TERM HUP
      _fl_warn_registered
      exit 0
    fi
    _fl_n_realized=$(printf '%s' "${_fl_realized:-}" | grep -c .)
    _fl_msg="my-git flatten --rm-git: $_fl_n_nested nested .git removed, $_fl_n_orphan orphan gitlink(s) unstaged, $_fl_n_realized repo(s) sidecared"
    _fl_write_msg_file "$_fl_msg" || { log_error "mktemp for commit msg failed"; _fl_rollback; rm -rf "$_fl_save_root"; exit 1; }
    _fl_commit_log=$(mktemp "${TMPDIR:-/tmp}/${US}.flcommit.XXXXXX")
    # shellcheck disable=SC2086
    if run git commit -q -F "$_fl_msgfile" 2>"$_fl_commit_log"; then
      rm -f "$_fl_commit_log" "$_fl_msgfile"
      rm -rf "$_fl_save_root"
      trap - INT TERM HUP
      _fl_warn_broken_pointers
      if [ "$_fl_n_realized" -gt 0 ]; then
        log_major "$_fl_top: $(c_green 'DONE :))') (flattened; $_fl_n_realized repo(s) sidecared into $GIT_SIDECAR_DIRNAME; remaining child .git dirs DELETED; unrelated changes left untouched)"
      else
        log_major "$_fl_top: $(c_green 'DONE :))') (flattened; child .git dirs DELETED; unrelated changes left untouched)"
      fi
      _fl_warn_registered
    else
      log_error "flatten commit failed:"
      cat "$_fl_commit_log" >&2
      rm -f "$_fl_commit_log" "$_fl_msgfile"
      _fl_rollback
      rm -rf "$_fl_save_root"
      exit 1
    fi
    exit 0
  fi

  # Per-item delete (from -i): rm -rf .git for chosen items BEFORE
  # move-out. The move-out loop will skip these (no .git left to move).
  # The main flow's git add still stages their content like the rest.
  if [ -n "$_fl_nested_delete" ]; then
    while IFS= read -r _n; do
      [ -n "$_n" ] || continue
      log_medium "delete   $_n"
      run rm -rf -- "$_n" || log_warn "rm failed for $_n"
    done <<_FL_DEL_EOF
$_fl_nested_delete
_FL_DEL_EOF
  fi

  # Preserve-history path: move each nested .git OUTSIDE the outer
  # worktree, commit, then restore. Trap already armed above.
  # Items in _fl_nested_delete (rm'd) and _fl_nested_zip (archived to .git.zip)
  # are skipped — their live .git is already gone, nothing to move out.
  _fl_i=0
  while IFS= read -r _n; do
    [ -n "$_n" ] || continue
    if [ -n "$_fl_nested_delete" ] && printf '%s\n' "$_fl_nested_delete" | grep -Fxq "$_n"; then
      continue
    fi
    if [ -n "$_fl_nested_zip" ] && printf '%s\n' "$_fl_nested_zip" | grep -Fxq "$_n"; then
      continue
    fi
    _fl_i=$((_fl_i + 1))
    _fl_save_path="$_fl_save_root/$_fl_i"
    printf '%s\t%s\n' "$_fl_top/$_n" "$_fl_save_path" >> "$_fl_manifest"
    log_medium "MOVE-OUT $_n  ->  $_fl_save_path"
    run mv -- "$_n" "$_fl_save_path" || {
      log_error "move-out failed for $_n"
      _fl_rollback
      rm -rf "$_fl_save_root"
      exit 1
    }
  done <<_FL_EOF
$_fl_nested
_FL_EOF

  if ! _fl_shield_nested_within_addpaths; then
    log_error "shielding nested repos failed"
    _fl_rollback
    rm -rf "$_fl_save_root"
    exit 1
  fi
  log_major "staging & committing flattened content (only paths flatten touched)..."
  _fl_index_touched=1
  # An all-zip run has no whole-path content to add ('_fl_paths_raw' empty) —
  # the .git.zip archive was already staged in the zip loop, so skip the add.
  if [ -n "$_fl_paths_raw" ] && ! _fl_add_paths_robust; then
    if [ -n "${_fl_realized:-}" ]; then
      # Nothing could be staged in THIS repo right now, but real,
      # permanent file-level work still happened (realize's rename) —
      # that's an expected outcome when a realized item's enclosing
      # repo wasn't itself processed in the same run, not a failure.
      # The rename stands regardless of git add; don't roll it back.
      _fl_warn_broken_pointers
      log_major "$_fl_top: sidecared $(printf '%s' "$_fl_realized" | grep -c .) item(s) on disk, but none could be tracked as content yet — each one's enclosing repo needs to be flattened/sidecared too before this scope's index can see it. Re-run flatten later to pick it up."
      _fl_rollback
      trap - INT TERM HUP
      rm -rf "$_fl_save_root"
      exit 0
    fi
    log_error "git add failed for every path; restoring .git dirs..."
    _fl_rollback
    rm -rf "$_fl_save_root"
    exit 1
  fi
  # Filter out paths that have no staged content (nested dir was empty).
  _fl_filter_to_staged
  # zip stages only its .git.zip (not a path in _fl_argv), so allow the commit
  # to proceed when a zip archive was staged even if _fl_argv is otherwise empty.
  if [ -z "$_fl_argv" ] && [ "${_fl_zipped_staged:-0}" != 1 ]; then
    log_major "nothing to commit (all nested dirs were empty after .git move-out)"
    _fl_rollback
    rm -rf "$_fl_save_root"
    trap - INT TERM HUP
    _fl_warn_registered
    exit 0
  fi
  _fl_n_realized=$(printf '%s' "${_fl_realized:-}" | grep -c .)
  _fl_n_zip=$(printf '%s' "${_fl_nested_zip:-}" | grep -c .)
  _fl_msg="my-git flatten: $_fl_n_nested nested repo(s) merged as content, $_fl_n_orphan orphan gitlink(s) unstaged, $_fl_n_realized repo(s) sidecared$([ "$_fl_n_zip" -gt 0 ] && printf ', %s zipped' "$_fl_n_zip")"
  _fl_write_msg_file "$_fl_msg" || { log_error "mktemp for commit msg failed"; _fl_rollback; rm -rf "$_fl_save_root"; exit 1; }
  _fl_commit_log=$(mktemp "${TMPDIR:-/tmp}/${US}.flcommit.XXXXXX")
  # shellcheck disable=SC2086
  if ! run git commit -q -F "$_fl_msgfile" 2>"$_fl_commit_log"; then
    log_error "flatten commit failed:"
    cat "$_fl_commit_log" >&2
    rm -f "$_fl_commit_log" "$_fl_msgfile"
    _fl_rollback
    rm -rf "$_fl_save_root"
    exit 1
  fi
  rm -f "$_fl_commit_log" "$_fl_msgfile"

  log_major "restoring nested .git dirs..."
  _fl_restore_dirs
  rm -rf "$_fl_save_root"
  trap - INT TERM HUP
  # Per-item delete from -i: rm -rf .git/modules/<name>/ for registered
  # subs the user chose to DELETE (history destruction).
  if [ -n "$_fl_modules_delete" ]; then
    printf '%s\n' "$_fl_modules_delete" | while IFS= read -r _m; do
      [ -n "$_m" ] || continue
      [ -e "$_m" ] || continue
      log_medium "delete   $_m"
      run rm -rf -- "$_m" || log_warn "rm failed for $_m"
    done
  fi
  _fl_warn_broken_pointers
  _fl_n_deleted=$(printf '%s' "${_fl_nested_delete:-}" | grep -c .)
  _fl_n_zipped=$(printf '%s' "${_fl_nested_zip:-}" | grep -c .)
  _fl_done_parts="flattened"
  [ "$_fl_n_realized" -gt 0 ] && _fl_done_parts="$_fl_done_parts; $_fl_n_realized repo(s) sidecared into $GIT_SIDECAR_DIRNAME"
  [ "$_fl_n_deleted" -gt 0 ] && _fl_done_parts="$_fl_done_parts; $_fl_n_deleted repo(s) merged into this repo (history preserved under $MERGED_REFS_ROOT/)"
  [ "$_fl_n_zipped" -gt 0 ] && _fl_done_parts="$_fl_done_parts; $_fl_n_zipped repo(s) archived to .git.zip"
  if [ "$_fl_n_realized" -eq 0 ] && [ "$_fl_n_deleted" -eq 0 ] && [ "$_fl_n_zipped" -eq 0 ]; then
    _fl_done_parts="$_fl_done_parts; child .git dirs kept as-is"
  fi
  log_major "$_fl_top: $(c_green 'DONE :))') ($_fl_done_parts; unrelated changes left untouched)"
  _fl_warn_registered
}

# ═════════════════════════════════════════════════════════════════════════
# ═══ UNFLATTEN (reverse of flatten: rebuild a live .git) ═══════════════════
# ═════════════════════════════════════════════════════════════════════════
#
# my-git unflatten [go|-T] [-i] [--sidecar|--merge|--zip [-k]] [path]
#
# Inverse of flatten's THREE EQUAL modes:
#   --sidecar   exact, lossless restore: $GIT_SIDECAR_DIRNAME -> .git, plus
#               core.worktree/core.bare unset (realize's own overrides —
#               correct only for its relocated position, not needed once
#               back at a plain <path>/.git). Nothing was ever deleted by
#               sidecar mode, so this loses nothing.
#   --merge     best-effort RECONSTRUCTION: the path has no git artifact
#               left at all (its original .git was deleted by a prior
#               'flatten --merge' / '--rm-git'), so the only recoverable
#               history is what THIS repo's own commits did to that path
#               — extracted via 'git subtree split --prefix=<path>'.
#               This starts from the merge-day commit forward; whatever
#               history existed before the original .git was deleted is
#               gone for good. Bulk-discoverable via its .git.merged
#               marker (list_merged_dirs), same as sidecars via
#               list_realized_dirs.
#   --zip       exact, lossless restore: .git.zip -> .git (or
#               $GIT_SIDECAR_DIRNAME.zip -> the sidecar), then the .zip is
#               removed (-k keeps it). Bulk-discoverable via its .git*.zip
#               marker (list_zipped_dirs).
# With no mode flag and a PATH given, the mode is auto-detected from what's
# actually on disk at that path (.git*.zip -> zip, sidecar dir -> sidecar,
# else merge). Bulk (no path) processes all three unless a flag restricts it.
_unfl_restore_sidecar() {
  _urs_path=$1
  _urs_src="$_urs_path/$GIT_SIDECAR_DIRNAME"
  _urs_dst="$_urs_path/.git"
  [ -d "$_urs_src" ] || { log_error "unflatten: $_urs_src: no such sidecar"; return 1; }
  [ -e "$_urs_dst" ] && { log_error "unflatten: $_urs_dst already exists — refusing to overwrite"; return 1; }

  _urs_status="$_urs_path/$GIT_SIDECAR_DIRNAME.status"
  _urs_was_sub=""
  _urs_sub_name=""
  if [ -f "$_urs_status" ]; then
    _urs_was_sub=$(sed -n 's/^was-submodule: //p' "$_urs_status" | head -1)
    _urs_sub_name=$(sed -n 's/^submodule-name: //p' "$_urs_status" | head -1)
    log_dbg_med "restore sidecar: $_urs_path — provenance from $_urs_status (was_sub='$_urs_was_sub' name='$_urs_sub_name')"
  else
    log_dbg_med "restore sidecar: $_urs_path — no .status file (fine; nothing needs it for an exact restore, provenance just unknown)"
  fi

  log_medium "unflatten  $_urs_path  ($_urs_src -> $_urs_dst)"
  if ! run mv -- "$_urs_src" "$_urs_dst"; then
    log_error "unflatten: $_urs_path: mv $_urs_src -> $_urs_dst failed"
    return 1
  fi

  # Unset both unconditionally, NOT restore-from-capture: realize's
  # core.worktree=".." was only ever correct for the RELOCATED position
  # (a sibling of <path>'s content, same relative depth <path>/.git now
  # sits at too — so leaving it would be harmless, but a plain <path>/.git
  # needs no override at all, same as any ordinary repo git creates
  # itself). Whatever core.worktree/core.bare looked like BEFORE realize
  # touched them (e.g. inside .git/modules/<name>/ for an absorbed
  # submodule) is meaningless here — that was a different location
  # entirely, not this one.
  run git config --file "$_urs_dst/config" --unset core.worktree 2>/dev/null || true
  run git config --file "$_urs_dst/config" --unset core.bare 2>/dev/null || true

  # Cosmetic cleanup: drop the self-exclude lines 'flatten --sidecar' added.
  if [ -f "$_urs_dst/info/exclude" ]; then
    _urs_excl_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.uflexcl.XXXXXX")
    grep -vxF -e "$GIT_SIDECAR_DIRNAME" -e "$GIT_SIDECAR_DIRNAME.status" \
      "$_urs_dst/info/exclude" > "$_urs_excl_tmp" 2>/dev/null
    run mv -f "$_urs_excl_tmp" "$_urs_dst/info/exclude" 2>/dev/null
  fi

  # The .status file was ordinary parent-tracked content — its removal
  # needs staging same as any other file the parent tracks.
  if [ -f "$_urs_status" ]; then
    run git rm -q -- "$_urs_status" >/dev/null 2>&1 || run rm -f -- "$_urs_status"
  fi

  # If the parent was ALSO tracking the sidecar internals themselves
  # (i.e. <path>/GIT_SIDECAR_DIRNAME/** were committed content — e.g.
  # force-added, or a sidecar created before ensure_sidecar_exclude began
  # .gitignoring '**/GIT_SIDECAR_DIRNAME' in the parent), those index
  # entries are now STALE: the directory was just renamed to .git above.
  # Stage their removal too, so unflatten's own commit captures the FULL
  # teardown and never leaves the parent dirty with a pile of
  # 'deleted: <path>/GIT_SIDECAR_DIRNAME/...'. The files are already gone
  # from the worktree; --cached only drops the index entries, and
  # --ignore-unmatch makes this a clean no-op in the normal (properly
  # .gitignore-excluded, never-tracked) case.
  run git rm -r -q --cached --ignore-unmatch -- "$_urs_src" >/dev/null 2>&1 || true

  if [ "$_urs_was_sub" = yes ]; then
    log_major "$_urs_path: was a registered submodule (${_urs_sub_name:-name unknown}) before it was sidecared — run 'my-git sm go' if you want it re-registered in .gitmodules"
  fi

  return 0
}

# _urm_restore_gitignore <path>
# Restore .gitignore from the merge snapshot (merge's own
# _fl_write_merge_snapshot removed the original after capturing it — see
# there for why) and remove the now-superseded .git.merged marker, staged
# like any other parent-tracked content change. Shared by BOTH restore
# routes (preserved-history and subtree-split fallback).
#
# Extract ONLY the '.gitignore' capture block: everything between its
# own '--- .gitignore content at this time ---' header and the NEXT
# such '--- ... content at this time ---' header (or EOF). A plain
# 'sed /marker/,$ p' would run to EOF and swallow every LATER capture
# section too — _fl_capture_and_remove_gitfiles emits one block per
# '.git*' file in glob (alphabetical) order, so a path with both
# '.gitignore' and, say, '.gitmodules' would otherwise get the
# '.gitmodules' block wrongly appended to the restored .gitignore
# (a real bug found in review). Command substitution strips the single
# trailing blank line the capture writes after each block.
_urm_restore_gitignore() {
  _urg_path=$1
  _urg_snapshot="$_urg_path/.git.merged"
  [ -f "$_urg_snapshot" ] || return 0
  _urg_gitignore=$(awk '
    /^--- \.gitignore content at this time ---$/ { grab=1; next }
    grab && /^--- .* content at this time ---$/  { grab=0 }
    grab { print }
  ' "$_urg_snapshot")
  if [ -n "$_urg_gitignore" ]; then
    printf '%s\n' "$_urg_gitignore" > "$_urg_path/.gitignore"
    log_medium "$_urg_path: restored .gitignore from the merge snapshot ($(printf '%s\n' "$_urg_gitignore" | grep -c .) non-blank line(s))"
  else
    log_dbg_med "$_urg_path: no .gitignore block in $_urg_snapshot to restore (none was captured at merge time)"
  fi
  run git rm -q -- "$_urg_snapshot" >/dev/null 2>&1 || run rm -f -- "$_urg_snapshot"
  return 0
}

# _unfl_restore_preserved <path> <ns> <tip> <branch>
# Hands back a merge that PRESERVED its history: every ref under <ns> in
# this repo is fetched into a fresh .git at <path>, restoring the original
# branch names, tags and remote-tracking refs verbatim.
#
# The worktree is deliberately NOT touched. Its files are the CURRENT
# (post-merge) content, which is usually AHEAD of <tip> — the parent has
# been committing to them ever since. So HEAD is pointed at the restored
# branch and the index reset to match it, which leaves exactly the
# post-merge drift showing as ordinary uncommitted changes for the user
# to commit. A 'reset --hard' here would silently destroy that drift.
# Returns 0 on success, 1 if the history is not actually available.
_unfl_restore_preserved() {
  _urp_path=$1
  _urp_ns=$2
  _urp_tip=$3
  _urp_branch=$4
  _urp_parent_gitdir=$(run git rev-parse --absolute-git-dir) || return 1
  if [ -z "$(git for-each-ref --format='%(refname)' "$_urp_ns" 2>/dev/null)" ]; then
    log_warn "unflatten: $_urp_path: .git.merged points at '$_urp_ns' but this repo has no such refs — the preserved history is missing here (a plain clone does NOT fetch $MERGED_REFS_ROOT/*; try: git config --add remote.origin.fetch '+$MERGED_REFS_ROOT/*:$MERGED_REFS_ROOT/*' && git fetch origin)"
    return 1
  fi
  log_medium "unflatten  $_urp_path  (restoring the preserved history from $_urp_ns — full pre-merge history, branches and tags)"
  run git init -q "$_urp_path" || { log_error "unflatten: $_urp_path: git init failed"; return 1; }
  # 'git init' leaves HEAD on a branch (main/master), and git flatly
  # REFUSES to fetch into whatever branch is checked out — which is
  # exactly the branch a restore usually needs to write. Park HEAD on a
  # placeholder name nothing can collide with; the real branch is
  # selected below, once every ref has landed.
  if ! ( cd "$_urp_path" \
         && run git symbolic-ref HEAD "refs/heads/my-git-unflatten-placeholder-$$" \
         && run git fetch -q "$_urp_parent_gitdir" "+$_urp_ns/*:refs/*" ); then
    log_error "unflatten: $_urp_path: could not fetch the preserved refs back out of the parent"
    run rm -rf -- "$_urp_path/.git"
    return 1
  fi
  # Point HEAD at the original branch WITHOUT touching the worktree.
  # 'symbolic-ref' + 'reset --mixed' is the only combination that moves
  # HEAD and syncs the index while leaving files alone; 'checkout' would
  # overwrite the post-merge content.
  if [ -n "$_urp_branch" ] && git -C "$_urp_path" rev-parse -q --verify "refs/heads/$_urp_branch" >/dev/null 2>&1; then
    run git -C "$_urp_path" symbolic-ref HEAD "refs/heads/$_urp_branch" \
      || log_warn "unflatten: $_urp_path: could not point HEAD at '$_urp_branch'"
  elif [ -n "$_urp_tip" ]; then
    log_warn "unflatten: $_urp_path: recorded branch '$_urp_branch' not among the restored refs — leaving HEAD detached at $_urp_tip"
    run git -C "$_urp_path" update-ref --no-deref HEAD "$_urp_tip" 2>/dev/null || true
  fi
  run git -C "$_urp_path" reset -q --mixed >/dev/null 2>&1 \
    || log_warn "unflatten: $_urp_path: index reset failed — 'git status' there may look odd until you run 'git reset'"
  # Restore the REMOTE. The restored .git is a fresh 'git init' plus a fetch,
  # so it has refs but no configuration: remote-tracking refs arrive while
  # remote.origin.url does not, leaving a repo that cannot fetch or push at
  # all. The merge snapshot recorded the URL precisely so it can come back.
  if [ -f "$_urp_path/.git.merged" ]; then
    _urp_url=$(sed -n 's|^remote\.origin\.url: ||p' "$_urp_path/.git.merged" | head -n 1)
    if [ -n "$_urp_url" ]; then
      if [ -z "$(git -C "$_urp_path" config --get remote.origin.url 2>/dev/null)" ]; then
        if run git -C "$_urp_path" remote add origin "$_urp_url" 2>/dev/null; then
          log_medium "$_urp_path: restored remote origin -> $_urp_url"
        else
          log_warn "$_urp_path: could not restore remote origin ($_urp_url) — set it by hand"
        fi
        # Make the restored branch track it, so push/pull work with no args.
        if [ -n "$_urp_branch" ]; then
          git -C "$_urp_path" config "branch.$_urp_branch.remote" origin 2>/dev/null
          git -C "$_urp_path" config "branch.$_urp_branch.merge" "refs/heads/$_urp_branch" 2>/dev/null
        fi
      fi
    else
      log_dbg_med "$_urp_path: the merge snapshot recorded no remote.origin.url (it was local-only)"
    fi
  fi
  _urp_n=$(git -C "$_urp_path" rev-list --count HEAD 2>/dev/null)
  log_major "$_urp_path: history RESTORED — ${_urp_n:-?} commit(s), full pre-merge history intact (post-merge changes to these files are left as uncommitted changes for you to commit)"
  # The parent no longer needs to carry this history: it now lives in the
  # restored repo. Dropping the refs is what lets the parent's next 'gc'
  # actually reclaim the space, and mirrors unflatten's teardown of the
  # sidecar/.status/.git.merged artifacts it supersedes.
  git for-each-ref --format='%(refname)' "$_urp_ns" 2>/dev/null | while IFS= read -r _urp_r; do
    [ -n "$_urp_r" ] || continue
    run git update-ref -d "$_urp_r" 2>/dev/null || log_warn "unflatten: could not drop preserved ref $_urp_r from the parent"
  done
  log_medium "$_urp_path: dropped the parent's now-redundant $_urp_ns/* refs (the history lives in $_urp_path/.git now)"
  return 0
}

# _unfl_reconstruct_merge <path>
# Restores a merged path to a live repo. Two routes:
#   1. The merge PRESERVED its history (the normal case): hand the whole
#      object DB back verbatim via _unfl_restore_preserved.
#   2. The snapshot predates preservation (or its refs are gone): fall
#      back to a best-effort 'git subtree split' from
#      THIS repo's own commits, which recovers nothing from before the
#      merge. See the RECONSTRUCTION note in the section banner above.
_unfl_reconstruct_merge() {
  _urm_path=$1
  [ -e "$_urm_path/.git" ] && { log_error "unflatten: $_urm_path/.git already exists — nothing to reconstruct"; return 1; }
  [ -e "$_urm_path/$GIT_SIDECAR_DIRNAME" ] && { log_error "unflatten: $_urm_path/$GIT_SIDECAR_DIRNAME exists — this is a sidecar, not a merged path; use --sidecar"; return 1; }

  # Route 1: preserved history, if the snapshot recorded a namespace.
  _urm_snap="$_urm_path/.git.merged"
  _urm_ns=""
  if [ -f "$_urm_snap" ]; then
    _urm_ns=$(sed -n 's|^preserved-refs: ||p' "$_urm_snap" | head -n 1 | sed -e 's|/$||')
  fi
  if [ -n "$_urm_ns" ]; then
    _urm_ptip=$(sed -n 's|^preserved-tip: ||p' "$_urm_snap" | head -n 1)
    _urm_pbr=$(sed -n 's|^branch: ||p' "$_urm_snap" | head -n 1)
    case "$_urm_pbr" in "(detached)"*) _urm_pbr="" ;; esac
    if _unfl_restore_preserved "$_urm_path" "$_urm_ns" "$_urm_ptip" "$_urm_pbr"; then
      _urm_restore_gitignore "$_urm_path"
      return 0
    fi
    log_warn "unflatten: $_urm_path: preserved-history restore failed — falling back to the best-effort subtree split (pre-merge history will NOT be recovered)"
  else
    log_dbg_med "unflatten: $_urm_path: .git.merged records no preserved-refs (written before preservation existed) — using the subtree-split fallback"
  fi

  _urm_branch="my-git-unflatten-tmp-$$"
  log_medium "unflatten  $_urm_path  (reconstructing from this repo's own commit history via git subtree split — history before the original merge is NOT recoverable)"
  log_dbg_med "reconstruct $_urm_path: splitting subtree into temp branch '$_urm_branch' (git subtree split --prefix=$_urm_path)"
  if ! run git subtree split --prefix="$_urm_path" -b "$_urm_branch" >/dev/null; then
    log_error "unflatten: $_urm_path: git subtree split failed — does this path actually have tracked commit history in this repo?"
    return 1
  fi
  log_dbg_med "reconstruct $_urm_path: subtree split OK; branch '$_urm_branch' -> $(git rev-parse --short "$_urm_branch" 2>/dev/null)"
  _urm_parent_gitdir=$(run git rev-parse --absolute-git-dir)
  log_dbg_med "reconstruct $_urm_path: parent gitdir = $_urm_parent_gitdir"
  if ! run git init -q "$_urm_path"; then
    log_error "unflatten: $_urm_path: git init failed"
    run git branch -D "$_urm_branch" >/dev/null 2>&1
    return 1
  fi
  # Fetch into FETCH_HEAD, not directly into refs/heads/main — git
  # refuses to fetch straight into whatever branch is currently checked
  # out (which 'main' always is, right after 'git init'). Then
  # 'reset --hard' onto an unborn branch is exactly how first-checkout
  # normally happens, just from a specific commit instead of an empty tree.
  if ! ( cd "$_urm_path" \
         && run git fetch -q "$_urm_parent_gitdir" "$_urm_branch" \
         && run git reset -q --hard FETCH_HEAD ); then
    log_error "unflatten: $_urm_path: materializing the reconstructed history failed"
    run rm -rf -- "$_urm_path/.git"
    run git branch -D "$_urm_branch" >/dev/null 2>&1
    return 1
  fi
  run git branch -D "$_urm_branch" >/dev/null 2>&1
  _urm_n_commits=$(run git -C "$_urm_path" rev-list --count HEAD 2>/dev/null)
  log_dbg_med "reconstruct $_urm_path: materialized live .git, HEAD=$(git -C "$_urm_path" rev-parse --short HEAD 2>/dev/null), $_urm_n_commits commit(s)"
  log_major "$_urm_path: reconstructed — $_urm_n_commits commit(s) recovered, starting from when this path was first merged in"

  _urm_restore_gitignore "$_urm_path"
  return 0
}

cmd_unflatten() {
  _ufl_mode=analyze
  _ufl_interactive=0
  _ufl_forced_mode=""
  _ufl_scope_path_raw=""
  _ufl_keep=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help unflatten; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose)          VERYVRB=1 ;;
      -D|--debug)   DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      go)           _ufl_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _ufl_mode=analyze ;;
      -i|--interactive) _ufl_interactive=1; require_tty unflatten ;;
      --sidecar)
        [ -n "$_ufl_forced_mode" ] && [ "$_ufl_forced_mode" != sidecar ] && \
          fatal "unflatten: --sidecar / --merge / --zip are mutually exclusive" 64
        _ufl_forced_mode=sidecar ;;
      --merge)
        [ -n "$_ufl_forced_mode" ] && [ "$_ufl_forced_mode" != merge ] && \
          fatal "unflatten: --sidecar / --merge / --zip are mutually exclusive" 64
        _ufl_forced_mode=merge ;;
      # --zip: restore a git dir archived by 'flatten --zip' (the 'gu'
      # operation, ported here). Reverses '.git.zip' / SIDECAR.zip -> live dir.
      --zip)
        [ -n "$_ufl_forced_mode" ] && [ "$_ufl_forced_mode" != zip ] && \
          fatal "unflatten: --sidecar / --merge / --zip are mutually exclusive" 64
        _ufl_forced_mode=zip ;;
      -k|--keep)    _ufl_keep=1 ;;
      -*) fatal "unflatten: unknown option: $1" 64 ;;
      *)
        [ -n "$_ufl_scope_path_raw" ] && \
          fatal "unflatten: only one path argument is supported (got '$_ufl_scope_path_raw' and '$1')" 64
        _ufl_scope_path_raw=$1 ;;
    esac
    shift
  done

  _ufl_top=$(git_toplevel_of "$PWD")
  [ -n "$_ufl_top" ] || fatal "unflatten: not inside a git repo" 1
  if [ "$(cd "$PWD" 2>/dev/null && pwd -P)" != "$(cd "$_ufl_top" 2>/dev/null && pwd -P)" ]; then
    log_major "unflatten: scoping to repo toplevel ($_ufl_top) — called from a subdir"
  fi

  _ufl_scope_path=""
  if [ -n "$_ufl_scope_path_raw" ]; then
    _ufl_scope_abs=$(cd "$_ufl_scope_path_raw" 2>/dev/null && pwd -P) || \
      fatal "unflatten: '$_ufl_scope_path_raw': no such directory" 1
    _ufl_top_abs=$(cd "$_ufl_top" 2>/dev/null && pwd -P)
    case "$_ufl_scope_abs" in
      "$_ufl_top_abs")
        fatal "unflatten: '$_ufl_scope_path_raw' is the repo toplevel itself, not a nested path" 64 ;;
      "$_ufl_top_abs"/*)
        _ufl_scope_path=${_ufl_scope_abs#"$_ufl_top_abs"/} ;;
      *)
        fatal "unflatten: '$_ufl_scope_path_raw' is not inside $_ufl_top" 64 ;;
    esac
  fi

  cd "$_ufl_top" || fatal "unflatten: cannot cd to $_ufl_top" 1

  log_repo_context unflatten "$_ufl_top" \
    "this repo's .git receives the teardown commit; each restored path gets its OWN live .git back" \
    "${_ufl_scope_path:+scoped to: $_ufl_scope_path}" \
    "merged paths are restored from history preserved in THIS repo ($MERGED_REFS_ROOT/<path>/)"

  # Build the candidate list: <path>\t<mode> lines.
  _ufl_cand=$(mktemp "${TMPDIR:-/tmp}/${US}.uflcand.XXXXXX") || fatal "unflatten: mktemp failed" 1
  : > "$_ufl_cand"

  if [ -n "$_ufl_scope_path" ]; then
    _ufl_p_mode=$_ufl_forced_mode
    if [ -z "$_ufl_p_mode" ]; then
      if [ -f "$_ufl_scope_path/.git.zip" ] || [ -f "$_ufl_scope_path/$GIT_SIDECAR_DIRNAME.zip" ]; then
        _ufl_p_mode=zip
        log_dbg_med "unflatten: auto-detected mode=zip for '$_ufl_scope_path' (.git.zip/$GIT_SIDECAR_DIRNAME.zip present)"
      elif [ -d "$_ufl_scope_path/$GIT_SIDECAR_DIRNAME" ]; then
        _ufl_p_mode=sidecar
        log_dbg_med "unflatten: auto-detected mode=sidecar for '$_ufl_scope_path' ($_ufl_scope_path/$GIT_SIDECAR_DIRNAME present)"
      elif [ -e "$_ufl_scope_path/.git" ]; then
        runq rm -f "$_ufl_cand"
        fatal "unflatten: '$_ufl_scope_path' already has a live .git — nothing to unflatten" 1
      else
        _ufl_p_mode=merge
        log_dbg_med "unflatten: auto-detected mode=merge for '$_ufl_scope_path' (no $GIT_SIDECAR_DIRNAME, no live .git — will reconstruct from .git.merged/subtree)"
      fi
    else
      log_dbg_med "unflatten: forced mode=$_ufl_p_mode for '$_ufl_scope_path'"
    fi
    printf '%s\t%s\n' "$_ufl_scope_path" "$_ufl_p_mode" >> "$_ufl_cand"
  else
    # Bulk (no path): both modes are discoverable via their own on-disk
    # marker — sidecars via GIT_SIDECAR_DIRNAME (list_realized_dirs),
    # merged paths via .git.merged (list_merged_dirs, written by
    # _fl_write_merge_snapshot since --merge started deleting .git).
    if [ "$_ufl_forced_mode" != merge ]; then
      list_realized_dirs "$_ufl_top" | while IFS= read -r _p; do
        [ -n "$_p" ] || continue
        printf '%s\tsidecar\n' "$_p"
      done >> "$_ufl_cand"
    fi
    if [ "$_ufl_forced_mode" != sidecar ]; then
      list_merged_dirs "$_ufl_top" | while IFS= read -r _p; do
        [ -n "$_p" ] || continue
        printf '%s\tmerge\n' "$_p"
      done >> "$_ufl_cand"
    fi
    # Zipped dirs (flatten --zip) are discoverable via their .git*.zip marker.
    # Only skipped when the run is explicitly restricted to sidecar OR merge.
    if [ "$_ufl_forced_mode" != sidecar ] && [ "$_ufl_forced_mode" != merge ]; then
      list_zipped_dirs "$_ufl_top" | while IFS= read -r _p; do
        [ -n "$_p" ] || continue
        printf '%s\tzip\n' "$_p"
      done >> "$_ufl_cand"
    fi
    log_dbg_med "unflatten bulk discovery: $(grep -c 'sidecar$' "$_ufl_cand" 2>/dev/null) sidecar(s), $(grep -c 'merge$' "$_ufl_cand" 2>/dev/null) merged path(s), $(grep -c 'zip$' "$_ufl_cand" 2>/dev/null) zipped path(s) found under $_ufl_top (forced_mode='${_ufl_forced_mode:-<all>}')"
  fi

  _ufl_n=$(grep -c . "$_ufl_cand" 2>/dev/null)
  if [ "$_ufl_n" -eq 0 ]; then
    runq rm -f "$_ufl_cand"
    log_major "$_ufl_top: nothing to unflatten (no $GIT_SIDECAR_DIRNAME sidecars or .git.merged markers found)"
    exit 0
  fi

  # Always show the full plan first (a helpful OVERVIEW of every item), then
  # under 'go -i' ask repo by repo below (each prompt shown as [i of N]).
  log_major "$_ufl_top: unflatten plan ($_ufl_n item(s))"
  while IFS="$(printf '\t')" read -r _p _m; do
    [ -n "$_p" ] || continue
    if [ "$_m" = merge ]; then
      # Which of the two restore routes applies is knowable HERE, from the
      # snapshot, so the plan says which one rather than always predicting
      # the lossy fallback for a path whose history is sitting right there.
      if [ -n "$(sed -n 's|^preserved-refs: ||p' "$_p/.git.merged" 2>/dev/null | head -n 1)" ]; then
        printf '  %s>> %s  (restore the FULL preserved history — branches, tags and its remote)%s\n' "$C_BLUE" "$_p" "$C_RESET"
      else
        printf '  %s>> %s  (RECONSTRUCT via git subtree split — no preserved history, so anything before the merge is gone)%s\n' "$C_BLUE" "$_p" "$C_RESET"
      fi
    elif [ "$_m" = zip ]; then
      printf '  %s>> %s  (restore git dir from .zip%s)%s\n' "$C_BLUE" "$_p" "$([ "$_ufl_keep" = 1 ] && printf ', keep .zip')" "$C_RESET"
    else
      printf '  %s>> %s  (restore exactly from %s)%s\n' "$C_BLUE" "$_p" "$GIT_SIDECAR_DIRNAME" "$C_RESET"
    fi
  done < "$_ufl_cand"

  if [ "$_ufl_mode" != "go" ]; then
    echo
    log_major "This was analyze-only — re-run with 'go' to apply:"
    printf '  %s>>   %s unflatten go%s\n' "$C_BLUE" "$US" "$C_RESET"
    printf '  %s>>   %s unflatten go -i    (confirm per item)%s\n' "$C_BLUE" "$US" "$C_RESET"
    runq rm -f "$_ufl_cand"
    exit 0
  fi

  _ufl_n_ok=0
  _ufl_n_fail=0
  # Collect ONLY the paths unflatten actually touched, shell-escaped, so
  # the commit below can be scoped to exactly them (git commit -- <paths>
  # == --only). A blanket 'git commit' with no pathspec would sweep any
  # UNRELATED user-staged change into a misleading "my-git unflatten"
  # commit — the same isolation flatten/sm/mc already uphold. All of a
  # restore's own index changes (.status removal for sidecar, .git.merged
  # removal + .gitignore restore for merge) live under its own <path>.
  _ufl_commit_paths=""
  _ufl_i=0
  while IFS="$(printf '\t')" read -r _p _m; do
    [ -n "$_p" ] || continue
    _ufl_i=$((_ufl_i + 1))
    if [ "$_ufl_interactive" = 1 ]; then
      _prompt_ysa "[$_ufl_i of $_ufl_n] \"$_p\" [$_m] restore its own .git  (teardown commit goes to $_ufl_top) ?"
      case $? in
        1) log_medium "skip  $_p"; continue ;;
        2) log_major "aborted"; rm -f "$_ufl_cand"; exit 77 ;;
        3) _ufl_interactive=0 ;;   # go: this one + all remaining, no more asking
      esac
    fi
    log_dbg_med "unflatten apply: $_p (mode=$_m)"
    if [ "$_m" = merge ]; then
      if _unfl_reconstruct_merge "$_p"; then
        _ufl_n_ok=$((_ufl_n_ok + 1)); _ufl_commit_paths="$_ufl_commit_paths $(shell_escape "$_p")"
      else
        _ufl_n_fail=$((_ufl_n_fail + 1)); log_dbg_med "unflatten apply: $_p FAILED (merge reconstruct)"
      fi
    elif [ "$_m" = zip ]; then
      if _unzip_gitdir "$_p" "$_ufl_keep"; then
        _ufl_n_ok=$((_ufl_n_ok + 1))
        log_ok "unflatten --zip: restored $_p$([ "$_ufl_keep" = 1 ] && printf ' (.zip kept)')"
        # flatten --zip committed ONLY the .git.zip into the parent, so the
        # .zip's removal here IS a parent-tracked change — unflatten must
        # commit it itself, the same self-contained teardown sidecar/merge do,
        # so the parent is never left dirty. Skipped under --keep (the .zip
        # stays on disk as valid tracked content). --ignore-unmatch keeps this
        # a no-op for a standalone 'gz' archive that was never committed.
        if [ "$_ufl_keep" != 1 ]; then
          run git rm -q --cached --ignore-unmatch -- \
            "$_p/.git.zip" "$_p/${GIT_SIDECAR_DIRNAME:-.git.real}.zip" >/dev/null 2>&1 || true
          _ufl_commit_paths="$_ufl_commit_paths $(shell_escape "$_p")"
        fi
      else
        _ufl_n_fail=$((_ufl_n_fail + 1)); log_dbg_med "unflatten apply: $_p FAILED (zip restore)"
      fi
    else
      if _unfl_restore_sidecar "$_p"; then
        _ufl_n_ok=$((_ufl_n_ok + 1)); _ufl_commit_paths="$_ufl_commit_paths $(shell_escape "$_p")"
      else
        _ufl_n_fail=$((_ufl_n_fail + 1)); log_dbg_med "unflatten apply: $_p FAILED (sidecar restore)"
      fi
    fi
  done < "$_ufl_cand"
  runq rm -f "$_ufl_cand"

  if [ -z "$_ufl_commit_paths" ]; then
    log_dbg_med "unflatten: no successfully-restored paths — nothing to commit"
  elif eval "git diff --cached --quiet -- $_ufl_commit_paths" 2>/dev/null; then
    log_dbg_med "unflatten: no staged index changes under the restored path(s) — nothing to commit"
  else
    log_dbg_med "unflatten: committing index changes scoped to:$_ufl_commit_paths"
    _ufl_cmsg_sub="my-git unflatten: restored $_ufl_n_ok nested repo(s) to a live .git"
    [ "$_ufl_n_fail" -gt 0 ] && _ufl_cmsg_sub="$_ufl_cmsg_sub ($_ufl_n_fail failed)"
    _ufl_cmsg_body="Restored each nested repo to a live .git (renamed $GIT_SIDECAR_DIRNAME -> .git, reconstructed merged path(s), and/or unzipped .git.zip archive(s)), then dropped the parent's now-obsolete tracking of the sidecar snapshot(s), the .status marker(s), the .git.merged snapshot(s), and the .git.zip archive(s). Nested repo history is intact in the restored live .git. Committed by my-git so unflatten leaves the parent clean, mirroring how flatten/gz commit their own artifacts."
    eval "run git commit -q -m \"\$_ufl_cmsg_sub\" -m \"\$_ufl_cmsg_body\" -- $_ufl_commit_paths" >/dev/null 2>&1 || \
      log_warn "unflatten: self-contained teardown commit failed — the removed $GIT_SIDECAR_DIRNAME/.status/.git.merged entries are left STAGED for manual commit"
  fi

  if [ "$_ufl_n_fail" -gt 0 ]; then
    log_major "$_ufl_top: $(c_yellow "DONE with errors") (restored=$_ufl_n_ok failed=$_ufl_n_fail)"
    exit 1
  fi
  log_major "$_ufl_top: $(c_green 'DONE :))') (restored=$_ufl_n_ok)"
}

# ═════════════════════════════════════════════════════════════════════════
# ═══ SHADOW / UNSHADOW (content-mirror: keep .git LIVE, parent tracks files)
# ═════════════════════════════════════════════════════════════════════════
#
# 'shadow' is the case-3b answer (README): a nested repo you actively develop
# here AND publish to its own origin. UNLIKE flatten (which disposes of the
# live .git — relocate/delete/archive), shadow KEEPS the live .git so the
# IDE/editor git integration keeps working, while making the PARENT ALSO track
# its files (a content-mirror / copy). Bootstrap via MOVE-ASIDE: momentarily
# move <path>/.git out of the worktree so 'git add -f' stages the files as
# ordinary content (git's embedded-repo boundary is gone while .git is
# absent), then restore the live .git. Once a blob is tracked under the dir
# the boundary is transparent, so thereafter ordinary 'git add' / 'mc' carry
# new files + mods + deletions through; 'ga' only bumps 'last-shadowed'.
# 'unshadow' reverses it: 'git rm --cached' the parent's copy (the live .git
# is left alone — it was already live).

# _shadow_write_status <path>
#   Write <path>/.git.shadow.status — an ORDINARY, parent-tracked marker that
#   makes 'st' tag the dir [shadowed] (list_shadowed_dirs) and records
#   everything needed to reason about / undo the shadow. Read from the LIVE
#   .git (call BEFORE moving it aside). 'first-shadowed' is PRESERVED across
#   re-shadows (only written once); 'last-shadowed' is bumped every time —
#   and also by the 'ga' alias when it publishes new files (etc/zshrc.mine).
_shadow_write_status() {
  _sws_p=$1
  _sws_file="$_sws_p/.git.shadow.status"
  _sws_now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  # Preserve the original first-shadowed if this dir is already shadowed.
  _sws_first=$(sed -n 's/^first-shadowed: //p' "$_sws_file" 2>/dev/null | head -1)
  [ -n "$_sws_first" ] || _sws_first=$_sws_now
  _sws_branch=$(run git -C "$_sws_p" symbolic-ref --short -q HEAD 2>/dev/null)
  _sws_commit=$(run git -C "$_sws_p" rev-parse HEAD 2>/dev/null)
  [ -n "$_sws_branch" ] || _sws_branch="(detached) $_sws_commit"
  _sws_subject=$(run git -C "$_sws_p" log -1 --pretty=%s 2>/dev/null)
  _sws_remote=$(run git -C "$_sws_p" config --get remote.origin.url 2>/dev/null)
  # WHICH repo is the mirror? A shadow is a relationship between TWO
  # repos, and the marker used to name only one of them -- so after the
  # mirroring repo changed (or stopped tracking), nothing on disk said
  # where the files had gone. Record it explicitly.
  _sws_into=$(tracking_repo_of "$_sws_p")
  [ -n "$_sws_into" ] || _sws_into=$( cd "$_sws_p/.." 2>/dev/null && git_toplevel_of "$PWD" 2>/dev/null )
  {
    printf '# my-git shadow marker for %s -- written by "shadow".\n' "$_sws_p"
    printf '# SHADOW = content-mirror: this nested repo keeps its LIVE .git (so the\n'
    printf '# IDE works) AND the parent repo also tracks its files. Its OWN .git is\n'
    printf '# the authoritative history; this file is an ordinary, parent-tracked\n'
    printf '# record so "st" can tag it [shadowed] and you know what to undo.\n'
    printf '# Undo with:  my-git unshadow %s\n\n' "$_sws_p"
    printf 'shadowed-into-repo: %s\n' "${_sws_into:-<unknown>}"
    printf '#   ^ the repo whose index MIRRORS these files. This repo keeps its\n'
    printf '#     own live .git, which stays the authoritative history.\n\n'
    printf 'first-shadowed: %s\n' "$_sws_first"
    printf 'last-shadowed: %s\n\n' "$_sws_now"
    printf 'branch: %s\n' "$_sws_branch"
    printf 'commit: %s\n' "$_sws_commit"
    printf 'commit-subject: %s\n' "$_sws_subject"
    printf 'remote.origin.url: %s\n' "$_sws_remote"
  } > "$_sws_file" 2>/dev/null || log_warn "$_sws_p: could not write $_sws_file (cosmetic only, not fatal)"
}

# The parent-repo pre-commit hook installed by 'shadow' bumps each shadowed
# repo's 'last-shadowed' at COMMIT time (atomically, in the same commit) when
# that commit stages content for it. This is the authoritative "mirror last
# updated" timestamp — 'ga'/'git add' no longer touch it. The managed block is
# delimited by these markers so we can install/refresh/remove it idempotently
# and NEVER clobber a foreign pre-commit hook.
_SHADOW_HOOK_BEGIN='# >>> my-git shadow (managed block — bumps last-shadowed on commit) >>>'
_SHADOW_HOOK_END='# <<< my-git shadow (managed block) <<<'

# _shadow_hook_block  — emit the managed block (without the '#!'/shebang, so it
# can be appended to an existing shell hook too). Self-contained POSIX sh.
_shadow_hook_block() {
  printf '%s\n' "$_SHADOW_HOOK_BEGIN"
  cat <<'HOOK'
# Managed by 'my-git shadow'. For each shadowed repo (a dir with a live .git
# and a .git.shadow.status marker) that THIS commit stages content into, bump
# 'last-shadowed' to now and re-stage the marker so it rides in this commit.
# my-git's OWN shadow commit just wrote these markers with a current
# timestamp, so bumping them again is redundant -- and actively harmful:
# that commit uses a pathspec, so anything this hook stages survives it and
# leaves the index permanently dirty, which then blocks 'flatten' and any
# other command that insists on a clean index.
_mgs_top=""
[ -z "${MY_GIT_SHADOW_SELF_COMMIT:-}" ] && _mgs_top=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -n "$_mgs_top" ]; then
  _mgs_now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  find "$_mgs_top" -type f -name .git.shadow.status 2>/dev/null | while IFS= read -r _mgs_f; do
    _mgs_kid=${_mgs_f%/.git.shadow.status}
    [ -e "$_mgs_kid/.git" ] || continue
    # staged content under this repo, OTHER than the marker itself? (capture +
    # test -n: robust to BSD grep returning 0 on empty input)
    _mgs_chg=$(git -C "$_mgs_top" diff --cached --name-only -- "$_mgs_kid" 2>/dev/null | grep -v '/\.git\.shadow\.status$')
    [ -n "$_mgs_chg" ] || continue
    # Refresh the fields 'rehydrate' RESTORES FROM, not just the timestamp.
    # The marker is written once at shadow time, so a remote that changes
    # afterwards (upstream renamed, url switched to ssh) leaves the marker
    # naming somewhere that no longer exists -- and a fresh machine then
    # restores that project from the wrong place, or not at all. Caught for
    # real: ,github/url-in-title had been renamed upstream and the marker
    # still said hostname-in-title, working only on GitHub's redirect.
    #
    # This hook is the right place: it already rewrites and re-stages the
    # marker during a commit, which is when dirtying a tracked file is
    # expected. 'commit'/'commit-subject' stay point-in-time as documented
    # -- they record when the mirror was taken, and a subject can contain
    # anything, which is not worth feeding through awk on every commit.
    _mgs_br=$(git -C "$_mgs_kid" symbolic-ref --short -q HEAD 2>/dev/null)
    _mgs_url=$(git -C "$_mgs_kid" config --get remote.origin.url 2>/dev/null)
    _mgs_tmp="$_mgs_f.mgs.$$"
    awk -v now="$_mgs_now" -v br="$_mgs_br" -v url="$_mgs_url" '
      /^last-shadowed: /                    { print "last-shadowed: " now; next }
      br  != "" && /^branch: /              { print "branch: " br;        next }
      url != "" && /^remote\.origin\.url: / { print "remote.origin.url: " url; next }
      { print }
    ' "$_mgs_f" > "$_mgs_tmp" 2>/dev/null \
      && mv "$_mgs_tmp" "$_mgs_f" 2>/dev/null \
      && git -C "$_mgs_top" add -f -- "$_mgs_f" 2>/dev/null
  done
fi
HOOK
  printf '%s\n' "$_SHADOW_HOOK_END"
}

# _shadow_install_hook <abs-git-dir>  — ensure the parent's pre-commit hook
# carries the managed block. Creates it if absent; leaves ours as-is if already
# present; refuses to touch a FOREIGN hook (warns with the manual snippet).
_shadow_install_hook() {
  _sih_gd=$1
  [ -n "$_sih_gd" ] && [ -d "$_sih_gd" ] || return 0
  _sih_hook="$_sih_gd/hooks/pre-commit"
  if [ -f "$_sih_hook" ]; then
    if grep -qF "$_SHADOW_HOOK_BEGIN" "$_sih_hook" 2>/dev/null; then
      log_dbg_med "shadow: pre-commit hook already carries the managed block ($_sih_hook)"
      return 0
    fi
    log_warn "shadow: $_sih_hook already exists and is NOT managed by my-git — NOT modifying it. 'last-shadowed' won't auto-update on commit until you paste the managed block into it (see '$US --help shadow')."
    return 0
  fi
  run mkdir -p "$_sih_gd/hooks" 2>/dev/null
  { printf '#!/bin/sh\n'; _shadow_hook_block; } > "$_sih_hook" 2>/dev/null \
    && chmod +x "$_sih_hook" 2>/dev/null \
    && log_dbg_med "shadow: installed pre-commit hook ($_sih_hook)" \
    || log_warn "shadow: could not write pre-commit hook at $_sih_hook (last-shadowed won't auto-update on commit)"
}

# _shadow_uninstall_hook <abs-git-dir>  — remove the managed block when the last
# shadow is gone. If the hook was ONLY our block (we created it), delete it;
# otherwise strip just our lines and leave the rest of a foreign hook intact.
_shadow_uninstall_hook() {
  _suh_gd=$1
  [ -n "$_suh_gd" ] && [ -d "$_suh_gd" ] || return 0
  _suh_hook="$_suh_gd/hooks/pre-commit"
  [ -f "$_suh_hook" ] || return 0
  grep -qF "$_SHADOW_HOOK_BEGIN" "$_suh_hook" 2>/dev/null || return 0
  # Strip our block (from BEGIN to END inclusive).
  _suh_tmp="$_suh_hook.mgs.$$"
  awk -v b="$_SHADOW_HOOK_BEGIN" -v e="$_SHADOW_HOOK_END" '
    index($0,b){skip=1} skip{ if(index($0,e))skip=0; next } {print}' \
    "$_suh_hook" > "$_suh_tmp" 2>/dev/null || { rm -f "$_suh_tmp"; return 0; }
  # If what remains is just a shebang + blank lines, remove the file entirely.
  if [ -z "$(grep -vE '^#!|^[[:space:]]*$' "$_suh_tmp" 2>/dev/null | head -1)" ]; then
    rm -f "$_suh_hook" "$_suh_tmp" 2>/dev/null
    log_dbg_med "shadow: removed now-empty pre-commit hook ($_suh_hook)"
  else
    cat "$_suh_tmp" > "$_suh_hook" 2>/dev/null; rm -f "$_suh_tmp" 2>/dev/null
    log_dbg_med "shadow: stripped the managed block from $_suh_hook (left the rest)"
  fi
}

# _shadow_one <path>  — the move-aside bootstrap for ONE nested repo. Writes
# the .git.shadow.status marker, stages its files (incl. the marker) into the
# parent index, and excludes the marker from the nested repo's own status; a
# trap restores .git on interrupt so a crash can't lose it. Does NOT commit
# (caller commits, scoped). Runs in a subshell so the trap is contained; the
# staged index lives on disk and persists past it. Returns 0 on success.
# autoheal_off <value>
#   0 when the knob is switched off. Accepts the same words everywhere so a
#   person need not remember which knob wanted 0 and which wanted "no".
autoheal_off() {
  case "$1" in ''|0|no|No|NO|off|Off|OFF|false|False|FALSE) return 0 ;; *) return 1 ;; esac
}

# autoheal_pull_strategy <repo>
#   Give <repo> a pull strategy when it has NONE. Prints the repo path if it
#   set one.
#
#   Since git 2.27 a 'git pull' on a DIVERGED branch aborts outright:
#     fatal: Need to specify how to reconcile divergent branches.
#   That is a configuration gap, not a conflict -- git simply refuses to
#   guess. Every repo in a tree hits it independently, and the fix is the
#   same each time, so 'pull' healing it beats a person pasting the same
#   'git config' into repo after repo.
#
#   Only ever set when UNSET. pull.rebase / pull.ff are a real preference:
#   if the repo (or the user's global config) already states one, that is an
#   answer, and overwriting it would be exactly the kind of "my-git decided
#   for you" damage this session spent its time undoing. Writes .git/config,
#   which is local and never cloned.
autoheal_pull_strategy() {
  _aps_r=$1
  _aps_want=${AUTOHEAL_PULL_STRATEGY-merge}
  if autoheal_off "$_aps_want"; then
    log_dbg_med "autoheal: pull strategy disabled (AUTOHEAL_PULL_STRATEGY='$_aps_want')"
    return 0
  fi
  [ -e "$_aps_r/.git" ] || return 0
  # An inherited preference counts as already answered -- but the global and
  # system chain is the SAME for every repo, so resolve it once per run
  # instead of per repo. Two run_as_owner_capture calls per repo cost 0.55s
  # on a 41-repo tree; the ownership machinery is only needed for the WRITE.
  if [ -z "${_APS_GLOBAL_CHECKED:-}" ]; then
    _APS_GLOBAL_CHECKED=1
    _APS_GLOBAL_SET=""
    [ -n "$(git config --global --get pull.rebase 2>/dev/null)$(git config --global --get pull.ff 2>/dev/null)$(git config --system --get pull.rebase 2>/dev/null)$(git config --system --get pull.ff 2>/dev/null)" ] \
      && _APS_GLOBAL_SET=1
  fi
  [ -z "$_APS_GLOBAL_SET" ] || return 0
  # Local config only: plain git, no ownership detection needed to READ --
  # that is only wanted for the WRITE. Two targeted --get calls beat one
  # --list: measured, --list was SLOWER, because it dumps the whole config
  # and the match then scans it, while --get exits at the first hit.
  [ -z "$(git -c safe.directory='*' -C "$_aps_r" config --local --get pull.rebase 2>/dev/null)" ] || return 0
  [ -z "$(git -c safe.directory='*' -C "$_aps_r" config --local --get pull.ff 2>/dev/null)" ] || return 0
  case "$_aps_want" in
    merge)   _aps_k=pull.rebase; _aps_v=false ;;
    rebase)  _aps_k=pull.rebase; _aps_v=true ;;
    ff-only) _aps_k=pull.ff;     _aps_v=only ;;
    *) log_warn "autoheal: AUTOHEAL_PULL_STRATEGY='$_aps_want' is not merge/rebase/ff-only (or empty/no/off to disable) — skipping"; return 0 ;;
  esac
  trace "git -C $_aps_r config $_aps_k $_aps_v   # autoheal: no pull strategy was set"
  if run_as_owner "$_aps_r" git config "$_aps_k" "$_aps_v" 2>/dev/null; then
    printf '%s\n' "$_aps_r"
  else
    log_dbg_med "autoheal: could not set $_aps_k in $_aps_r (cosmetic)"
  fi
}

_SHADOW_EXCL_BEGIN='# >>> my-git shadow (managed block — nested repos mirrored elsewhere) >>>'
_SHADOW_EXCL_END='# <<< my-git shadow <<<'

# shadow_sync_excludes <toplevel>
#   Re-derive, for every live repo under <toplevel>, the set of paths it
#   should stop reporting as untracked: the SHADOWED repos nested inside it,
#   whose files another repo mirrors. Prints one line per repo it changed.
#
#   This is DERIVED STATE, not a decision: it is computable from the
#   .git.shadow.status markers on disk, my-git owns it entirely, and it is
#   idempotent. It also does not travel -- .git/info/exclude is local and
#   never cloned -- so a fresh clone starts with none of it and needs this
#   to re-establish the arrangement. That is why 'st' may run it, unlike
#   the .claude check: this writes ONLY to .git/info/exclude, never to a
#   tracked file, so it can never become a commit or reach a remote.
#
#   Written as a managed block so re-deriving never touches hand-written
#   exclude lines, and a path that stops being shadowed drops out on its
#   own instead of lingering.
shadow_sync_excludes() {
  _sse_top=$1
  if autoheal_off "${AUTOHEAL_SHADOW_EXCLUDES-1}"; then
    log_dbg_med "autoheal: shadow excludes disabled (AUTOHEAL_SHADOW_EXCLUDES='${AUTOHEAL_SHADOW_EXCLUDES-1}')"
    return 0
  fi
  [ -d "$_sse_top" ] || return 0
  _sse_map=$(mktemp "${TMPDIR:-/tmp}/${US}.ssemap.XXXXXX" 2>/dev/null) || return 0

  # PASS 1: resolve each shadowed path's enclosing repo ONCE (not once per
  # candidate repo) and record "<repo><TAB></rel/>" lines. No forks: the
  # helper answers in SELR_ENCL, and the loop reads from a heredoc so the
  # accumulated file stays in this shell.
  while IFS= read -r _sse_p; do
    [ -n "$_sse_p" ] || continue
    # The child side of the same derived state: a shadowed repo must not see
    # its OWN marker as untracked. That exclusion also lives in a
    # .git/info/exclude a clone does not carry, so it needs re-establishing
    # for exactly the reason the parent-side block does -- and this loop is
    # already walking every marker on disk.
    _shadow_exclude_marker "$_sse_top/$_sse_p" && printf '%s\n' "$_sse_p"
    _shadow_enclosing_live_repo "$_sse_p" "$_sse_top" || continue
    printf '%s\t/%s/\n' "$SELR_ENCL" "${_sse_p#"$SELR_ENCL"/}" >> "$_sse_map"
  done <<_SSE_EOF
$(list_shadowed_dirs "$_sse_top" 2>/dev/null)
_SSE_EOF

  # PASS 2: the repos to visit are those that WANT entries, plus any that
  # already carry a managed block and might need it retired. Finding the
  # latter by grepping exclude files is far cheaper than walking every .git.
  # NOT 'grep -rl --include=exclude .': that walks the ENTIRE tree, object
  # databases included, and measured 2x SLOWER than the naive version it was
  # meant to speed up. Address the exclude files by path instead, then grep
  # only those few.
  _sse_repos=$( { cut -f1 "$_sse_map" 2>/dev/null
                  ( cd "$_sse_top" 2>/dev/null \
                    && find . -maxdepth 7 -path '*/.git/info/exclude' -type f 2>/dev/null \
                       | while IFS= read -r _sse_x; do
                           grep -qF -- "$_SHADOW_EXCL_BEGIN" "$_sse_x" 2>/dev/null || continue
                           _sse_x=${_sse_x#./}; printf '%s\n' "${_sse_x%/.git/info/exclude}"
                         done ) ; } \
                | sort -u | grep -v '^$')

  while IFS= read -r _sse_r; do
    [ -n "$_sse_r" ] || continue
    _sse_gd="$_sse_top/$_sse_r/.git"
    [ -d "$_sse_gd" ] || continue
    _sse_want=$(awk -F'\t' -v r="$_sse_r" '$1==r{print $2}' "$_sse_map" 2>/dev/null | sort -u)
    _sse_f="$_sse_gd/info/exclude"
    _sse_have=$(awk -v b="$_SHADOW_EXCL_BEGIN" -v e="$_SHADOW_EXCL_END" \
                  '$0==b{f=1;next} $0==e{f=0;next} f' "$_sse_f" 2>/dev/null | sort -u)
    [ "$_sse_want" = "$_sse_have" ] && continue
    mkdir -p "$_sse_gd/info" 2>/dev/null || true
    _sse_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.sse.XXXXXX" 2>/dev/null) || continue
    # keep everything outside the managed block verbatim
    awk -v b="$_SHADOW_EXCL_BEGIN" -v e="$_SHADOW_EXCL_END" \
      '$0==b{f=1;next} $0==e{f=0;next} !f' "$_sse_f" 2>/dev/null > "$_sse_tmp"
    if [ -n "$_sse_want" ]; then
      { printf '%s\n' "$_SHADOW_EXCL_BEGIN"
        printf '%s\n' "$_sse_want"
        printf '%s\n' "$_SHADOW_EXCL_END"; } >> "$_sse_tmp"
    fi
    trace "rewrite $_sse_f   # my-git shadow managed block: $(printf '%s' "$_sse_want" | tr '\n' ' ')"
    if cat "$_sse_tmp" > "$_sse_f" 2>/dev/null; then
      printf '%s\n' "$_sse_r"
      # A tracked .gitignore can NEGATE ('!path') what we just excluded, and
      # negation beats .git/info/exclude -- the block is then written and
      # does nothing. Say so instead of leaving a silent no-op.
      printf '%s\n' "$_sse_want" | while IFS= read -r _sse_w; do
        [ -n "$_sse_w" ] || continue
        _sse_bare=${_sse_w#/}; _sse_bare=${_sse_bare%/}
        if grep -qE "^!/?${_sse_bare}/?$" "$_sse_top/$_sse_r/.gitignore" 2>/dev/null; then
          log_warn "$_sse_r: its TRACKED .gitignore negates '!$_sse_bare', which beats .git/info/exclude — that path will keep showing as untracked until the '!' line is removed"
        fi
      done
    fi
    rm -f "$_sse_tmp" 2>/dev/null
  done <<_SSE_EOF2
$_sse_repos
_SSE_EOF2
  rm -f "$_sse_map" 2>/dev/null
}

# _shadow_enclosing_live_repo <rel-path> <toplevel>
#   Print the path (relative to <toplevel>) of the nearest LIVE repo that
#   CONTAINS <rel-path>, or nothing if that is the toplevel itself.
#
#   A shadowed repo often sits inside another live repo rather than
#   directly under the toplevel -- ,archive/nimbiestatemachine lives in
#   py/my-nimbie, and both are shadowed into src. Nothing tracks that
#   directory FROM my-nimbie's point of view, so my-nimbie reported it as
#   an untracked directory forever: noise a person cannot act on, because
#   the whole arrangement is deliberate.
#   Result comes back in SELR_ENCL, not on stdout: the caller runs this
#   once per shadowed path, and a $(...) capture forks a subshell each time.
#   At 25 shadowed paths x 26 candidate repos that was 650 forks and a
#   measurable 0.26s on every single 'st'.
_shadow_enclosing_live_repo() {
  _selr_p=$1; _selr_top=$2
  SELR_ENCL=""
  _selr_d=${_selr_p%/*}
  [ "$_selr_d" = "$_selr_p" ] && return 1   # directly under the toplevel
  while [ -n "$_selr_d" ] && [ "$_selr_d" != "." ]; do
    if [ -e "$_selr_top/$_selr_d/.git" ]; then SELR_ENCL=$_selr_d; return 0; fi
    case "$_selr_d" in */*) _selr_d=${_selr_d%/*} ;; *) break ;; esac
  done
  return 1
}

# Keep the marker (and any '.git.shadow.status.*' temp file a bump might
# briefly leave behind on interrupt) out of the NESTED repo's own status --
# the parent tracks the marker, the nested repo should not see either as
# untracked. Idempotent; both patterns added if missing.
#
# Shared with rehydrate, and that sharing is the point: this lives in
# .git/info/exclude, which git never clones. A rehydrated repo therefore
# starts WITHOUT it and reports its own marker as untracked -- one phantom
# "??" per project, on every machine that got its repos by cloning.
# Returns 0 only when it ADDED something, so callers can report what they
# healed without re-reading the file.
_shadow_exclude_marker() {
  _sem_gd="$1/.git"
  [ -d "$_sem_gd" ] || return 1
  _sem_added=0
  mkdir -p "$_sem_gd/info" 2>/dev/null || true
  for _sem_pat in '.git.shadow.status' '.git.shadow.status.*'; do
    grep -qxF "$_sem_pat" "$_sem_gd/info/exclude" 2>/dev/null && continue
    if printf '%s\n' "$_sem_pat" >> "$_sem_gd/info/exclude" 2>/dev/null; then
      _sem_added=1
    else
      log_dbg_med "shadow: $1 — could not add '$_sem_pat' to .git/info/exclude (cosmetic)"
    fi
  done
  [ "$_sem_added" = 1 ]
}

_shadow_one() {
  _sho_p=$1
  _sho_gd="$_sho_p/.git"
  [ -e "$_sho_gd" ] || { log_error "shadow: $_sho_p has no live .git — nothing to shadow"; return 1; }
  log_dbg_med "shadow: $_sho_p — write .git.shadow.status, move .git aside, 'git add -f', restore .git live"
  # Write the marker while .git is still live (reads HEAD/remote from it).
  _shadow_write_status "$_sho_p"
  _shadow_exclude_marker "$_sho_p" || true   # 1 just means "already there"
  # Hiding this repo from its ENCLOSING repo is handled by the whole-tree
  # sync below, which re-derives every managed block from the markers on
  # disk. Doing it per-repo here would only ever add, never retire.
  shadow_sync_excludes "$PWD" >/dev/null || true   # stderr carries the warnings

  ( _sho_tmp=$(mktemp -d "${TMPDIR:-/tmp}/${US}.shadow.XXXXXX") || { log_error "shadow: mktemp -d failed"; exit 1; }
    # restore .git on interrupt (contained to this subshell)
    trap 'mv -- "$_sho_tmp/gitdir" "$_sho_gd" 2>/dev/null' INT TERM HUP
    if ! run mv -- "$_sho_gd" "$_sho_tmp/gitdir"; then
      log_error "shadow: $_sho_p: could not move .git aside"; rmdir "$_sho_tmp" 2>/dev/null; exit 1
    fi
    # advice.addEmbeddedRepo=false: a shadowed repo may itself contain nested
    # repos (their own live .git) — git would print its long "adding embedded
    # git repository" hint for each. That's expected here (my-git manages
    # nesting deliberately), so silence the noise.
    # A 160000 gitlink may already sit at this path -- shadowing an OUTER
    # repo stages any nested repo inside it as a gitlink, so shadowing that
    # nested repo afterwards finds one waiting. 'git add' does NOT convert a
    # gitlink to content just because the .git moved away: it stages nothing
    # and reports success, leaving the parent holding a POINTER while the
    # marker claims a mirror. Clear it first (same reason flatten does).
    if git ls-files -s -- "$_sho_p" 2>/dev/null | awk '{print $1}' | grep -qx 160000; then
      log_medium "shadow: $_sho_p — clearing a stale gitlink so the files can be staged as content"
      run git update-index --force-remove -- "$_sho_p" 2>/dev/null \
        || log_warn "shadow: $_sho_p — could not clear the gitlink; the mirror may not be created"
    fi
    run git -c advice.addEmbeddedRepo=false add -f -- "$_sho_p"; _sho_rc=$?
    if ! run mv -- "$_sho_tmp/gitdir" "$_sho_gd"; then
      log_error "shadow: $_sho_p: FAILED to restore .git! It is at $_sho_tmp/gitdir — move it back to $_sho_gd BY HAND."; exit 2
    fi
    rmdir "$_sho_tmp" 2>/dev/null
    exit $_sho_rc
  )
}

# my-git shadow [go] [-i] [path]     (analyze by default)
cmd_shadow() {
  _sh_mode=analyze; _sh_interactive=0; _sh_scope_raw=""; _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help shadow; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose)          VERYVRB=1 ;;
      -D|--debug)   DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      go)           _sh_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _sh_mode=analyze ;;
      -i|--interactive) _sh_interactive=1; require_tty shadow ;;
      -R|--recursive) RECURSIVE=1 ;;
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "shadow: unknown option: $1" 64 ;;
      *)            [ -n "$_sh_scope_raw" ] && fatal "shadow: only one path argument is supported" 64
                    _sh_scope_raw=$1 ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"
  _sh_top=$(git_toplevel_of "$PWD"); [ -n "$_sh_top" ] || fatal "shadow: not inside a git repo" 1
  _sh_scope=""
  if [ -n "$_sh_scope_raw" ]; then
    _sh_abs=$(cd "$_sh_scope_raw" 2>/dev/null && pwd -P) || fatal "shadow: '$_sh_scope_raw': no such directory" 1
    _sh_top_abs=$(cd "$_sh_top" 2>/dev/null && pwd -P)
    case "$_sh_abs" in
      "$_sh_top_abs")   fatal "shadow: '$_sh_scope_raw' is the toplevel itself, not a nested repo" 64 ;;
      "$_sh_top_abs"/*) _sh_scope=${_sh_abs#"$_sh_top_abs"/} ;;
      *)                fatal "shadow: '$_sh_scope_raw' is not inside $_sh_top" 64 ;;
    esac
  fi
  cd "$_sh_top" || fatal "shadow: cannot cd to $_sh_top" 1

  # shadow mirrors files into the ENCLOSING toplevel while each nested
  # repo keeps its own live .git -- i.e. two repos end up tracking the
  # same files. Which one is the mirror is exactly what must not be
  # guessed at.
  log_repo_context shadow "$_sh_top" \
    "the commit goes to the PARENT git shown above -- $_sh_top/.git" \
    "that creates a MIRROR of the nested files inside the parent git (they become its ordinary content)" \
    "each shadowed repo KEEPS its own live .git, which stays the authoritative history" \
    "a marker is written to  <path>/.git.shadow.status  (inside the shadowed repo's own dir, tracked BY the parent) recording  shadowed-into-repo: $_sh_top" \
    "${_sh_scope:+scoped to: $_sh_scope}"

  if [ -n "$_sh_scope" ]; then
    [ -e "$_sh_scope/.git" ] || fatal "shadow: '$_sh_scope' is not a nested LIVE repo (no live .git). shadow keeps a live .git — for a sidecar/merged/zipped path use flatten/unflatten." 1
    _sh_list=$_sh_scope
  else
    # Bulk: every embedded nested LIVE repo NOT already shadowed. (Skipping the
    # already-shadowed ones keeps a re-run from re-mirroring everything; refresh
    # a specific one by naming its PATH, which re-runs and bumps last-shadowed.)
    _sh_shadowed=$(list_shadowed_dirs "$_sh_top")
    _sh_list=$(list_unregistered_nested "$_sh_top" | while IFS= read -r _p; do
      [ -n "$_p" ] || continue
      printf '%s\n' "$_sh_shadowed" | grep -qxF "$_p" && continue
      printf '%s\n' "$_p"
    done)
    if [ -z "$_sh_list" ]; then
      log_major "$_sh_top: no embedded nested repos to shadow (already-shadowed ones are skipped; name a PATH to re-shadow one explicitly)"
      exit 0
    fi
  fi

  if [ "$_sh_mode" != go ]; then
    log_major "$_sh_top: shadow plan (keep the LIVE .git; make the parent track the files too)"
    printf '%s\n' "$_sh_list" | while IFS= read -r _p; do
      [ -n "$_p" ] || continue
      printf '  %s>> %s   (git add -f its files -> parent; .git stays LIVE — IDE keeps working)%s\n' "$C_BLUE" "$_p" "$C_RESET"
    done
    echo
    log_major "This was analyze-only — re-run with 'go' to apply:"
    printf '  %s>>   %s shadow go %s%s%s\n' "$C_BLUE" "$US" "$([ "$_sh_interactive" = 1 ] && printf -- '-i ')" "${_sh_scope:-}" "$C_RESET"
    exit 0
  fi

  _sh_oifs=$IFS; IFS='
'
  # shellcheck disable=SC2086
  set -- $_sh_list
  IFS=$_sh_oifs
  _sh_ok=0; _sh_fail=0; _sh_skip=0; _sh_i=0; _sh_total=$#; _sh_commit=""
  for _p in "$@"; do
    [ -n "$_p" ] || continue
    _sh_i=$((_sh_i + 1))
    if [ "$_sh_interactive" = 1 ]; then
      _prompt_ysa "[$_sh_i of $_sh_total] \"$_p\" shadow: keep its own .git live, ALSO mirror its files into $_sh_top ?"
      case $? in
        1) _sh_skip=$((_sh_skip + 1)); log_medium "skip  $_p"; continue ;;
        2) log_major "aborted"; break ;;
        3) _sh_interactive=0 ;;
      esac
    fi
    if _shadow_one "$_p"; then
      _sh_ok=$((_sh_ok + 1)); _sh_commit="$_sh_commit $(shell_escape "$_p")"
      log_ok "shadow: $_p — files mirrored to parent (.git kept live)"
    else
      _sh_fail=$((_sh_fail + 1))
    fi
  done
  if [ -n "$_sh_commit" ] && ! eval "run git diff --cached --quiet -- $_sh_commit" 2>/dev/null; then
    MY_GIT_SHADOW_SELF_COMMIT=1 \
    eval "run git commit -q -m \"my-git shadow: content-mirror into the parent (live .git kept)\" -- $_sh_commit" >/dev/null 2>&1 \
      || log_warn "shadow: commit failed — staged content left for manual commit"
    unset MY_GIT_SHADOW_SELF_COMMIT
  fi
  # Install the parent pre-commit hook that keeps 'last-shadowed' current at
  # commit time (idempotent; never clobbers a foreign hook).
  if [ "$_sh_ok" -gt 0 ]; then
    _sh_gitdir=$(git rev-parse --absolute-git-dir 2>/dev/null)
    _shadow_install_hook "$_sh_gitdir"
  fi
  echo
  if [ "$_sh_ok" -gt 0 ]; then
    log_ok "shadow: $_sh_ok repo(s) now mirrored into the parent — their .git is still LIVE (IDE works). Ordinary 'git add'/'mc' keep the mirror current; 'last-shadowed' bumps on commit.$([ "$_sh_skip" -gt 0 ] && printf ' %s skipped.' "$_sh_skip")$([ "$_sh_fail" -gt 0 ] && printf ' %s FAILED.' "$_sh_fail")"
  else
    log_major "shadow: nothing shadowed$([ "$_sh_skip" -gt 0 ] && printf ' (%s skipped)' "$_sh_skip")$([ "$_sh_fail" -gt 0 ] && printf ' (%s failed)' "$_sh_fail")."
  fi
  [ "$_sh_fail" = 0 ]
}

# my-git unshadow [go] [-i] [path]     (analyze by default)
cmd_unshadow() {
  _ush_mode=analyze; _ush_interactive=0; _ush_scope_raw=""; _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help unshadow; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose)          VERYVRB=1 ;;
      -D|--debug)   DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      go)           _ush_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _ush_mode=analyze ;;
      -i|--interactive) _ush_interactive=1; require_tty unshadow ;;
      -R|--recursive) RECURSIVE=1 ;;
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "unshadow: unknown option: $1" 64 ;;
      *)            [ -n "$_ush_scope_raw" ] && fatal "unshadow: only one path argument is supported" 64
                    _ush_scope_raw=$1 ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"
  _ush_top=$(git_toplevel_of "$PWD"); [ -n "$_ush_top" ] || fatal "unshadow: not inside a git repo" 1
  _ush_scope=""
  if [ -n "$_ush_scope_raw" ]; then
    _ush_abs=$(cd "$_ush_scope_raw" 2>/dev/null && pwd -P) || fatal "unshadow: '$_ush_scope_raw': no such directory" 1
    _ush_top_abs=$(cd "$_ush_top" 2>/dev/null && pwd -P)
    case "$_ush_abs" in
      "$_ush_top_abs")   fatal "unshadow: '$_ush_scope_raw' is the toplevel itself, not a nested repo" 64 ;;
      "$_ush_top_abs"/*) _ush_scope=${_ush_abs#"$_ush_top_abs"/} ;;
      *)                 fatal "unshadow: '$_ush_scope_raw' is not inside $_ush_top" 64 ;;
    esac
  fi
  cd "$_ush_top" || fatal "unshadow: cannot cd to $_ush_top" 1

  log_repo_context unshadow "$_ush_top" \
    "the commit goes to the PARENT git shown above -- $_ush_top/.git" \
    "that REMOVES the mirror: the parent stops tracking the nested files (git rm --cached)" \
    "each nested repo's own live .git is NOT touched -- no history is affected, the files stay on disk" \
    "the marker  <path>/.git.shadow.status  is removed too, so nothing claims a mirror that no longer exists" \
    "${_ush_scope:+scoped to: $_ush_scope}"

  # A SHADOWED repo = a nested LIVE repo carrying a '.git.shadow.status' marker
  # (list_shadowed_dirs). For an explicit path we also accept the older signal
  # "live .git + parent tracks its files" so a repo shadowed before the marker
  # existed can still be undone.
  if [ -n "$_ush_scope" ]; then
    [ -e "$_ush_scope/.git" ] || fatal "unshadow: '$_ush_scope' has no live .git — it isn't a shadowed repo" 1
    if [ ! -f "$_ush_scope/.git.shadow.status" ] && [ -z "$(git ls-files -- "$_ush_scope" 2>/dev/null | head -1)" ]; then
      fatal "unshadow: '$_ush_scope' is not shadowed — no .git.shadow.status marker and the parent tracks none of its files" 1
    fi
    _ush_list=$_ush_scope
  else
    _ush_list=$(list_shadowed_dirs "$_ush_top")
    if [ -z "$_ush_list" ]; then
      log_major "$_ush_top: nothing to unshadow (no shadowed repo — none carry a .git.shadow.status marker)"
      exit 0
    fi
  fi

  if [ "$_ush_mode" != go ]; then
    log_major "$_ush_top: unshadow plan (stop the parent tracking these; the live .git is left untouched)"
    printf '%s\n' "$_ush_list" | while IFS= read -r _p; do
      [ -n "$_p" ] || continue
      printf '  %s>> %s   (git rm --cached its files from the parent; .git stays LIVE)%s\n' "$C_BLUE" "$_p" "$C_RESET"
    done
    echo
    log_major "This was analyze-only — re-run with 'go' to apply:"
    printf '  %s>>   %s unshadow go %s%s%s\n' "$C_BLUE" "$US" "$([ "$_ush_interactive" = 1 ] && printf -- '-i ')" "${_ush_scope:-}" "$C_RESET"
    exit 0
  fi

  # A 'git rm --cached' removal lives ONLY in the index — the files stay in
  # the worktree. 'git commit -- <path>' would take the WORKTREE view of that
  # path (files present) and so commit NOTHING; we must commit the index
  # as-is (no pathspec). To avoid sweeping in the user's OTHER staged work,
  # bail out of committing if the index already has staged changes.
  trace "(git diff --cached --name-only)   # unshadow: any pre-existing staged changes?"
  _ush_pre_staged=$( git diff --cached --name-only 2>/dev/null | head -1 )

  _ush_oifs=$IFS; IFS='
'
  # shellcheck disable=SC2086
  set -- $_ush_list
  IFS=$_ush_oifs
  # Remove the on-disk marker + any stray temp, and its nested-repo exclude
  # lines, so the dir is a plain nested repo again. Shared by the normal
  # route and the stale-marker route below.
  _unshadow_clean_marker() {
    _ucm_p=$1
    run rm -f -- "$_ucm_p/.git.shadow.status" 2>/dev/null
    rm -f -- "$_ucm_p"/.git.shadow.status.* 2>/dev/null || true
    if [ -f "$_ucm_p/.git/info/exclude" ] && grep -qE '^\.git\.shadow\.status' "$_ucm_p/.git/info/exclude" 2>/dev/null; then
      _ucm_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.unshadow.XXXXXX" 2>/dev/null) \
        && grep -vxF -e '.git.shadow.status' -e '.git.shadow.status.*' "$_ucm_p/.git/info/exclude" > "$_ucm_tmp" 2>/dev/null \
        && cat "$_ucm_tmp" > "$_ucm_p/.git/info/exclude" 2>/dev/null
      rm -f "$_ucm_tmp" 2>/dev/null
    fi
  }

  _ush_ok=0; _ush_fail=0; _ush_skip=0; _ush_stale=0; _ush_i=0; _ush_total=$#
  for _p in "$@"; do
    [ -n "$_p" ] || continue
    _ush_i=$((_ush_i + 1))
    if [ "$_ush_interactive" = 1 ]; then
      _prompt_ysa "[$_ush_i of $_ush_total] \"$_p\" unshadow: stop $_ush_top tracking it (its own .git stays live) ?"
      case $? in
        1) _ush_skip=$((_ush_skip + 1)); log_medium "skip  $_p"; continue ;;
        2) log_major "aborted"; break ;;
        3) _ush_interactive=0 ;;
      esac
    fi
    # Work out what is actually TRUE before trying to undo anything. A
    # marker only means "someone was mirroring this once". If this repo
    # is not that someone, 'git rm --cached' matches nothing and reports a
    # bare failure that explains none of it -- which is precisely what a
    # tree looks like after the mirroring repo stopped tracking the path.
    # A 160000 entry here is a SUBMODULE REGISTRATION, never a mirror.
    # 'git rm --cached' on it would drop the gitlink and leave .gitmodules
    # pointing at nothing -- deregistering a submodule under a command that
    # promises "no history is affected". unshadow untracks CONTENT only.
    if [ "$(git ls-files -s -- "$_p" 2>/dev/null | awk '{print $1; exit}')" = 160000 ]; then
      _ush_fail=$((_ush_fail + 1))
      log_fail "unshadow: $_p — $_ush_top registers it as a SUBMODULE (gitlink), it is not mirroring its files. Refusing: untracking that would deregister the submodule. Remove the stale marker by hand, or de-register with:  $US unsm $_p"
      continue
    fi
    if [ -z "$(git ls-files -s -- "$_p" 2>/dev/null | awk '$1 != 160000 { print; exit }')" ]; then
      _ush_owner=$(tracking_repo_of "$_ush_top/$_p")
      if [ -n "$_ush_owner" ]; then
        _ush_fail=$((_ush_fail + 1))
        log_fail "unshadow: $_p — $_ush_top does NOT mirror it; @$(basename "$_ush_owner") does. Undo it there:  (cd $_ush_owner && $US unshadow go ${_ush_top}/${_p#"$_ush_owner"/})"
        continue
      fi
      # NOBODY mirrors it: the marker is stale and removing it IS the fix.
      # Counting this as a failure (the old behaviour) was wrong -- there
      # is nothing to untrack, and the marker was the only thing lying.
      _unshadow_clean_marker "$_p"
      _ush_stale=$((_ush_stale + 1))
      log_ok "unshadow: $_p — STALE marker removed (no repo was mirroring it; nothing to untrack)"
      continue
    fi
    if run git rm -r --cached -q -- "$_p" >/dev/null 2>&1; then
      _ush_ok=$((_ush_ok + 1))
      _unshadow_clean_marker "$_p"
      log_ok "unshadow: $_p — parent stopped tracking it (.git still live)"
    else
      _ush_fail=$((_ush_fail + 1)); log_fail "unshadow: $_p — git rm --cached failed"
    fi
  done
  # The shadow set just changed, so the derived excludes must follow --
  # otherwise an enclosing repo keeps hiding a path nothing mirrors.
  shadow_sync_excludes "$_ush_top" >/dev/null || true   # stderr carries the warnings
  if [ "$_ush_ok" -gt 0 ] || [ "$_ush_stale" -gt 0 ]; then
    if [ "$_ush_ok" -eq 0 ]; then
      : # only stale markers were cleaned -- nothing was staged, nothing to commit
    elif [ -n "$_ush_pre_staged" ]; then
      log_warn "unshadow: your index already had staged changes before this ran — NOT committing the removal automatically (it would sweep them in). Commit/reset your index, the removal is staged and ready."
    elif run git commit -q -m "my-git unshadow: stop mirroring into the parent (live .git kept)" >/dev/null 2>&1; then
      :
    else
      log_warn "unshadow: commit failed — staged removal left for manual commit"
    fi
    # If no shadowed repo remains under the parent, retire the pre-commit hook
    # (removes our managed block; deletes the hook only if it was solely ours).
    if [ -z "$(list_shadowed_dirs "$_ush_top")" ]; then
      _shadow_uninstall_hook "$(git rev-parse --absolute-git-dir 2>/dev/null)"
    fi
  fi
  echo
  if [ "$_ush_ok" -gt 0 ] || [ "$_ush_stale" -gt 0 ]; then
    if [ "$_ush_ok" -gt 0 ]; then
      _ush_msg="$_ush_ok repo(s) — parent no longer tracks them; each is a plain nested LIVE repo again."
      [ "$_ush_stale" -gt 0 ] && _ush_msg="$_ush_msg Plus $_ush_stale STALE marker(s) removed (no repo was mirroring those)."
    else
      _ush_msg="$_ush_stale STALE marker(s) removed — no repo was mirroring them, so there was nothing to untrack. Each is a plain nested LIVE repo again."
    fi
    log_ok "unshadow: $_ush_msg$([ "$_ush_skip" -gt 0 ] && printf ' %s skipped.' "$_ush_skip")$([ "$_ush_fail" -gt 0 ] && printf ' %s FAILED.' "$_ush_fail")"
  else
    log_major "unshadow: nothing unshadowed$([ "$_ush_skip" -gt 0 ] && printf ' (%s skipped)' "$_ush_skip")."
  fi
  [ "$_ush_fail" = 0 ]
}

# ═════════════════════════════════════════════════════════════════════════
# ═══ REMOTE (list / check) ══════════════════════════════════════════════
# ═════════════════════════════════════════════════════════════════════════
#
# my-git remote [--check] [-R] [paths...]
#
# LIST (default): one line per repo: '<path>   <remote> -> <url>'.
#   If the repo has multiple remotes, prints one line each.
#   If it has NO remote: '<path>   (no remotes)' — flagged red.
# CHECK (--check): list + add a ⚠ tag for suspicious urls.
#   Heuristics (all yellow-flagged, none fatal):
#     - relative path (./foo, ../foo)
#     - file:// scheme
#     - plain http:// (should usually be https or ssh)
#     - no origin remote at all (but other remotes exist)

_mg_remote_flag() {
  # Return " ⚠ <reason>" if the url is suspicious, else empty.
  _u=$1
  case "$_u" in
    ./*|../*)  printf ' %s⚠ relative path%s' "$C_YELLOW" "$C_RESET" ;;
    file://*)  printf ' %s⚠ file:// scheme%s' "$C_YELLOW" "$C_RESET" ;;
    http://*)  printf ' %s⚠ plain http%s'     "$C_YELLOW" "$C_RESET" ;;
  esac
}

# ════════════════════════════════════════════════════════════════════════
# ═══ PURGE — remove a path's CONTENT AND HISTORY from a repo ═══════════
# ════════════════════════════════════════════════════════════════════════
# The counterpart to 'unshadow'/'unflatten', which answer "who tracks this
# path NOW?". Purge answers "who has EVER tracked it?" — and is the only
# command that rewrites history.
#
# It is deliberately its own verb rather than a flag on unshadow: burying
# a history rewrite behind an option on a routine command is how it gets
# run by accident. Like '--rm-git' it has NO inverse, and in my-git that
# asymmetry is the signal — every reversible operation comes as a pair
# (shadow/unshadow, flatten/unflatten, sm/unsm); the destructive ones
# stand alone.

# _purge_candidates <abs-path>
#   Print every enclosing repo whose HISTORY contains <abs-path>, one per
#   line, innermost first. Deliberately searches history, NOT the index:
#   after an 'unshadow' no repo tracks the path any more, yet its objects
#   still sit in the repo above — which is exactly when purge is wanted.
#   A nested path can legitimately appear in TWO repos' histories, so this
#   returns a list and the caller insists on --from when it is ambiguous.
_purge_candidates() {
  _pc_abs=$1
  _pc_dir=$( cd "$_pc_abs/.." 2>/dev/null && pwd ) || return 0
  while [ -n "$_pc_dir" ]; do
    if [ -e "$_pc_dir/.git" ] || [ -d "$_pc_dir/${GIT_SIDECAR_DIRNAME:-.git.real}" ]; then
      _pc_top=$( cd "$_pc_dir" 2>/dev/null && git -c safe.directory='*' rev-parse --show-toplevel 2>/dev/null )
      if [ -n "$_pc_top" ]; then
        _pc_rel=${_pc_abs#"$_pc_dir"/}
        if [ -n "$( cd "$_pc_dir" 2>/dev/null && git -c safe.directory='*' log --oneline --all -- "$_pc_rel" 2>/dev/null | head -n 1 )" ]; then
          printf '%s\n' "$_pc_dir"
        fi
      fi
    fi
    [ "$_pc_dir" = "/" ] && break
    _pc_dir=$( cd "$_pc_dir/.." 2>/dev/null && pwd ) || break
  done
  return 0
}

# _purge_survives_elsewhere <abs-path>
#   0 when the path's content still exists as a repo in its own right, so
#   purging the OUTER repo's copy loses nothing. This is the check that
#   makes purge a space-reclaiming operation rather than a delete.
_purge_survives_elsewhere() {
  _pse=$1
  [ -e "$_pse/.git" ] && return 0
  [ -d "$_pse/${GIT_SIDECAR_DIRNAME:-.git.real}" ] && return 0
  [ -f "$_pse/.git.zip" ] || [ -f "$_pse/${GIT_SIDECAR_DIRNAME:-.git.real}.zip" ] && return 0
  return 1
}

cmd_purge() {
  _pg_mode=analyze
  _pg_force=0
  _pg_from=""
  _pg_path_raw=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help purge; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose) VERYVRB=1 ;;
      -D|--debug) DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      go) _pg_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _pg_mode=analyze ;;
      --force) _pg_force=1 ;;
      --from) shift; [ $# -gt 0 ] || fatal "purge: --from needs a REPO path" 64
              _pg_from=$1 ;;
      --from=*) _pg_from=${1#--from=} ;;
      -*) fatal "purge: unknown option: $1" 64 ;;
      *)  [ -n "$_pg_path_raw" ] && fatal "purge: only one PATH is supported (got '$_pg_path_raw' and '$1')" 64
          _pg_path_raw=$1 ;;
    esac
    shift
  done
  [ -n "$_pg_path_raw" ] || fatal "purge: needs a <PATH> to purge. There is deliberately no bulk form — purging is a history rewrite, one deliberate path at a time.
  Analyze first:  $US purge <PATH>" 64

  _pg_abs=$(cd "$_pg_path_raw" 2>/dev/null && pwd) || \
    fatal "purge: '$_pg_path_raw': no such directory" 1

  # ── Which repo's history? ──────────────────────────────────────────
  if [ -n "$_pg_from" ]; then
    _pg_repo=$(cd "$_pg_from" 2>/dev/null && pwd) || fatal "purge: --from '$_pg_from': no such directory" 1
    [ -e "$_pg_repo/.git" ] || [ -d "$_pg_repo/${GIT_SIDECAR_DIRNAME:-.git.real}" ] \
      || fatal "purge: --from '$_pg_from' is not a git repo" 1
  else
    _pg_cands=$(_purge_candidates "$_pg_abs")
    _pg_n=$(printf '%s' "$_pg_cands" | grep -c .)
    if [ "$_pg_n" -eq 0 ]; then
      log_major "purge: no repo's history contains '$_pg_path_raw' — nothing to purge"
      exit 0
    fi
    if [ "$_pg_n" -gt 1 ]; then
      log_error "purge: '$_pg_path_raw' appears in the history of MORE THAN ONE repo — say which one:"
      printf '%s\n' "$_pg_cands" | while IFS= read -r _c; do
        [ -n "$_c" ] && printf '      %s%s purge %s --from %s%s\n' "$C_BLUE" "$US" "$_pg_path_raw" "$_c" "$C_RESET"
      done
      exit 64
    fi
    _pg_repo=$_pg_cands
  fi
  _pg_rel=${_pg_abs#"$_pg_repo"/}
  [ "$_pg_rel" != "$_pg_abs" ] || fatal "purge: '$_pg_path_raw' is not inside '$_pg_repo'" 64

  log_repo_context purge "$_pg_repo" \
    "this repo's HISTORY IS REWRITTEN — '$_pg_rel' is removed from every commit that ever contained it" \
    "every commit SHA in this repo changes; a force-push is required afterwards" \
    "the path's own repo (if any) and every OTHER repo are untouched"

  # ── Facts before the gate ──────────────────────────────────────────
  _pg_commits=$( cd "$_pg_repo" && git -c safe.directory='*' log --oneline --all -- "$_pg_rel" 2>/dev/null | grep -c . )
  _pg_total=$( cd "$_pg_repo" && git -c safe.directory='*' rev-list --count --all 2>/dev/null )
  _pg_objtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.purgeobj.XXXXXX")
  ( cd "$_pg_repo" && git -c safe.directory='*' rev-list --objects --all -- "$_pg_rel" 2>/dev/null ) \
    | awk '{print $1}' | sort -u > "$_pg_objtmp"
  _pg_mb=$( cd "$_pg_repo" && git -c safe.directory='*' cat-file --batch-check='%(objectsize:disk)' < "$_pg_objtmp" 2>/dev/null \
            | awk '{s+=$1} END {printf "%.0f", s/1048576}' )
  rm -f "$_pg_objtmp"

  log_major "$_pg_repo: purge plan for '$_pg_rel'"
  printf '    > %s of %s commit(s) touch it and will be rewritten\n' "${_pg_commits:-0}" "${_pg_total:-?}"
  printf '    > ~%s MB of objects become unreferenced (reclaimed after gc)\n' "${_pg_mb:-0}"
  if _purge_survives_elsewhere "$_pg_abs"; then
    printf '    > the content SURVIVES: %s is a repo in its own right\n' "$_pg_rel"
  else
    printf '  %s>> the content does NOT survive anywhere else — purging DESTROYS it%s\n' "$C_RED$C_BOLD" "$C_RESET"
  fi

  if [ "$_pg_mode" != go ]; then
    echo
    log_major "This was analyze-only — re-run with 'go' to apply:"
    printf '  %s>>   %s purge go %s --from %s%s\n' "$C_BLUE" "$US" "$_pg_path_raw" "$_pg_repo" "$C_RESET"
    exit 0
  fi

  # ── Safety: never purge content that exists nowhere else ───────────
  if ! _purge_survives_elsewhere "$_pg_abs" && [ "$_pg_force" != 1 ]; then
    fatal "purge: '$_pg_rel' is not a repo in its own right — its history exists ONLY inside $_pg_repo, so purging would DESTROY it, not relocate it.
  purge is for reclaiming space after content has moved out. If you really mean to destroy it, re-run with --force." 1
  fi

  # ── The gate ───────────────────────────────────────────────────────
  echo
  printf '%s%s%s\n' "$C_RED$C_BOLD" "!!! purge REWRITES HISTORY in $_pg_repo. This is NOT revertible." "$C_RESET"
  printf '    Every commit SHA in that repo changes (%s commit(s) total).\n' "${_pg_total:-?}"
  printf '    You MUST force-push afterwards, and every OTHER clone of it must be\n'
  printf '    re-cloned or hard-reset — their history no longer matches.\n'
  printf '    A full backup of .git is taken first; its path is printed at the end.\n\n'
  if [ ! -r /dev/tty ]; then
    log_error "purge needs interactive confirmation but no TTY is available"
    exit 1
  fi
  printf '%sType exactly '\''I am sure'\'' to proceed, anything else to abort:%s ' \
    "$C_RED$C_BOLD" "$C_RESET" >/dev/tty
  IFS= read -r _pg_confirm </dev/tty || _pg_confirm=''
  if [ "$_pg_confirm" != "I am sure" ]; then
    log_major "purge: aborted (expected literal 'I am sure', got: '$_pg_confirm') — nothing was changed"
    exit 1
  fi

  # ── Backup, then rewrite ───────────────────────────────────────────
  _pg_stamp=$(date -u +%Y%m%dT%H%M%SZ)
  _pg_backup="$_pg_repo/.git.purge-backup-$_pg_stamp"
  log_major "$_pg_repo: backing up .git -> $_pg_backup (before touching anything)"
  cp -a "$_pg_repo/.git" "$_pg_backup" || fatal "purge: backup failed — refusing to rewrite without one" 1

  _pg_before=$(du -sm "$_pg_repo/.git" 2>/dev/null | awk '{print $1}')

  # Rewrite a BARE COPY of the gitdir, never the live repo.
  #
  # filter-branch run in place refuses to start unless the worktree is
  # clean, and checks out the rewritten history when it finishes -- which
  # DELETES the very files being purged, even though they belong to
  # another repo now. Moving the path aside to dodge that just makes the
  # worktree look dirty instead. Operating on a detached bare copy sizes
  # the problem correctly: history is a property of the gitdir, so the
  # worktree has no business being involved at all.
  _pg_tmp=$(mktemp -d "${TMPDIR:-/tmp}/${US}.purge.XXXXXX") || fatal "purge: mktemp -d failed" 1
  log_medium "copying the gitdir to $_pg_tmp/rw.git and rewriting THERE (the worktree is never touched)"
  cp -a "$_pg_repo/.git" "$_pg_tmp/rw.git" || { rm -rf "$_pg_tmp"; fatal "purge: could not copy the gitdir" 1; }
  # A bare gitdir has no worktree to check out or complain about.
  git --git-dir="$_pg_tmp/rw.git" config core.bare true 2>/dev/null
  git --git-dir="$_pg_tmp/rw.git" config --unset core.worktree 2>/dev/null
  rm -f "$_pg_tmp/rw.git/index"

  log_major "$_pg_repo: rewriting history (removing '$_pg_rel' from every commit)"
  _pg_rc=0
  if command -v git-filter-repo >/dev/null 2>&1; then
    log_medium "using git-filter-repo"
    ( cd "$_pg_tmp/rw.git" && run git filter-repo --force --invert-paths --path "$_pg_rel" ) || _pg_rc=1
  else
    log_medium "using git filter-branch (git-filter-repo not installed; slower)"
    ( cd "$_pg_tmp/rw.git" \
      && FILTER_BRANCH_SQUELCH_WARNING=1 run git filter-branch --force \
           --index-filter "git rm -r --cached --ignore-unmatch -- $(shell_escape "$_pg_rel")" \
           --prune-empty --tag-name-filter cat -- --all ) || _pg_rc=1
    log_medium "dropping refs/original/ and expiring the reflog so the old objects become unreferenced"
    # 'cd || exit' is load-bearing, not boilerplate: without it a failed cd
    # would leave the following 'update-ref -d' running in the CURRENT
    # repository and deleting ITS refs.
    ( cd "$_pg_tmp/rw.git" || exit 1
      git for-each-ref --format='%(refname)' refs/original/ 2>/dev/null | while IFS= read -r _pg_r; do
        [ -n "$_pg_r" ] && git update-ref -d "$_pg_r" 2>/dev/null
      done
      run git reflog expire --expire=now --all >/dev/null 2>&1 )
  fi

  # --prune-empty drops commits that become empty. If EVERY commit touched
  # this path, that prunes the whole history and the branches disappear --
  # meaning the path was not a subdirectory of this repo's history, it WAS
  # that history. Refuse rather than install a hollow repo.
  if [ -z "$(git --git-dir="$_pg_tmp/rw.git" for-each-ref --format='%(refname)' refs/heads 2>/dev/null | head -n 1)" ]; then
    rm -rf "$_pg_tmp"
    fatal "purge: removing '$_pg_rel' would empty EVERY commit — this repo's history is nothing BUT that path, so there would be no repo left. Nothing was changed (the live .git was never touched); the backup at $_pg_backup can be deleted." 1
  fi
  if [ "$_pg_rc" != 0 ]; then
    rm -rf "$_pg_tmp"
    fatal "purge: the history rewrite failed — NOTHING was changed (it ran on a copy). The live repo is intact; delete the backup at $_pg_backup if you like." 1
  fi

  # Install the rewritten gitdir. The worktree is left exactly as it is;
  # 'reset --mixed' then rebuilds the index from the new HEAD, so the
  # purged path simply becomes untracked-but-present -- which is correct,
  # it is another repo's business now.
  log_medium "installing the rewritten gitdir and rebuilding the index (worktree untouched)"
  git --git-dir="$_pg_tmp/rw.git" config core.bare false 2>/dev/null
  rm -rf "$_pg_repo/.git" || fatal "purge: could not replace the live gitdir — the original is at $_pg_backup" 1
  mv "$_pg_tmp/rw.git" "$_pg_repo/.git" \
    || fatal "purge: could not move the rewritten gitdir into place — the original is at $_pg_backup" 1
  rm -rf "$_pg_tmp"
  ( cd "$_pg_repo" && run git reset -q --mixed >/dev/null 2>&1 ) \
    || log_warn "purge: index rebuild reported a problem — run 'git -C $_pg_repo reset' by hand"

  log_medium "repacking to actually reclaim the space"
  ( cd "$_pg_repo" && run git gc --prune=now --aggressive >/dev/null 2>&1 ) \
    || log_warn "purge: gc reported a problem — the rewrite itself succeeded; re-run 'git gc --prune=now' by hand"

  _pg_after=$(du -sm "$_pg_repo/.git" 2>/dev/null | awk '{print $1}')
  echo
  log_ok "purge: '$_pg_rel' removed from $_pg_repo's history — .git ${_pg_before:-?} MB -> ${_pg_after:-?} MB"
  log_major "backup of the ORIGINAL .git: $_pg_backup"
  printf '    > verify the repo, then delete the backup yourself: rm -rf %s\n' "$(shell_escape "$_pg_backup")"
  printf '    > every SHA changed — publish with:  git -C %s push --force --all && git -C %s push --force --tags\n' \
    "$(shell_escape "$_pg_repo")" "$(shell_escape "$_pg_repo")"
  printf '    > any OTHER clone of this repo must be re-cloned or hard-reset\n'
  return 0
}

remote_one() {
  _r=$1
  RM_N_TOTAL=$((RM_N_TOTAL + 1))
  _rm_grd=${GIT_SIDECAR_DIRNAME:-.git.real}
  # MERGED path: no git dir on disk; the remote (if any) is recorded in
  # the .git.merged snapshot. Read it from there.
  if [ ! -e "$_r/.git" ] && [ ! -d "$_r/$_rm_grd" ] && [ -f "$_r/.git.merged" ]; then
    _rm_murl=$(sed -n 's/^remote\.origin\.url: //p' "$_r/.git.merged" 2>/dev/null | head -1)
    if [ -n "$_rm_murl" ]; then
      printf ' >>> %-60s %-10s -> %s %s(merged)%s\n' "$_r" "origin" "$_rm_murl" "$C_DIM" "$C_RESET"
    else
      printf ' >>> %-60s %s(no remotes — merged, was local-only)%s\n' "$_r" "$C_RED" "$C_RESET"
      RM_N_NOREMOTE=$((RM_N_NOREMOTE + 1))
    fi
    return 0
  fi
  # SIDECAR-AWARE: a sidecar has GIT_SIDECAR_DIRNAME, not .git — point git
  # at it so 'git remote' reads the sidecar's real config (its remote is
  # the whole reason it was published). Live repos need no extra args.
  _rm_gargs=""
  _rm_kindtag=""
  if [ ! -e "$_r/.git" ] && [ -d "$_r/$_rm_grd" ]; then
    _rm_gargs="--git-dir=$_rm_grd --work-tree=."
    _rm_kindtag=" ${C_DIM}(sidecar)${C_RESET}"
  fi
  # Honor ignore marker so scoped audits don't spam known-ignored repos.
  _gd_for_marker=$(_sm_resolve_gitdir "$_r/.git" "$_r" 2>/dev/null)
  if [ -n "$_gd_for_marker" ] && [ -e "$_gd_for_marker/$_sm_IGNORE_MARKER" ]; then
    if [ "${RM_FORCE:-0}" -ne 1 ]; then
      [ "$VRB" = 1 ] && log_medium "$_r: [ignored marker — skipping]"
      RM_N_IGNORED=$((RM_N_IGNORED + 1))
      return 0
    fi
  fi
  # shellcheck disable=SC2086
  _remotes=$(run_as_owner_capture "$_r" git $_rm_gargs remote 2>/dev/null)
  if [ -z "$_remotes" ]; then
    printf ' >>> %-60s %s(no remotes)%s%s\n' "$_r" "$C_RED" "$C_RESET" "$_rm_kindtag"
    RM_N_NOREMOTE=$((RM_N_NOREMOTE + 1))
    return 0
  fi
  _has_origin=0
  _sus=0
  printf '%s\n' "$_remotes" | while IFS= read -r _rem; do
    [ -n "$_rem" ] || continue
    # shellcheck disable=SC2086
    _url=$(run_as_owner_capture "$_r" git $_rm_gargs remote get-url "$_rem" 2>/dev/null)
    _flag=""
    if [ "${RM_CHECK:-0}" = 1 ]; then
      _flag=$(_mg_remote_flag "$_url")
    fi
    printf ' >>> %-60s %-10s -> %s%s%s\n' "$_r" "$_rem" "$_url" "$_flag" "$_rm_kindtag"
  done
  # Origin-missing check (only when --check and repo has remotes but no origin).
  if [ "${RM_CHECK:-0}" = 1 ]; then
    if ! printf '%s\n' "$_remotes" | grep -qx 'origin'; then
      printf ' >>> %-60s %s⚠ no '\''origin'\'' remote%s\n' "$_r" "$C_YELLOW" "$C_RESET"
      RM_N_SUS=$((RM_N_SUS + 1))
    fi
    # Count suspicious urls.
    printf '%s\n' "$_remotes" | while IFS= read -r _rem; do
      # shellcheck disable=SC2086
      _url=$(run_as_owner_capture "$_r" git $_rm_gargs remote get-url "$_rem" 2>/dev/null)
      case "$_url" in ./*|../*|file://*|http://*) echo S ;; esac
    done >> "$_rm_sus_tmp"
  fi
}

# ─── diff: view a conflict's two sides side by side ─────────────────────
# During a conflict git keeps three versions in the index -- :1 the common
# ancestor, :2 OURS, :3 THEIRS -- while the worktree file holds neither: it
# is the merged text with <<<<<<< markers through it. Reading a conflict
# from that file means reconstructing both sides in your head.
#
# This writes the two sides out and opens them side by side. The temp names
# say WHICH SIDE each one is, including the branch, because "left pane" and
# "right pane" are not something you should have to remember four files in:
#     my-plex.LOCAL_ours_main.py
#     my-plex.REMOTE_theirs_feature.py
# The original extension is preserved so the viewer still highlights syntax.

# _diff_side_label <ours|theirs>
#   Name the side being shown. During a REBASE git's ours/theirs are
#   swapped relative to intuition -- "ours" is the upstream you are
#   replaying onto, "theirs" is your own commit -- so say which operation
#   is in progress rather than leaving a label that means the opposite.
_diff_side_label() {
  _dsl_side=$1
  _dsl_gd=$(git rev-parse --git-dir 2>/dev/null)
  if [ -d "$_dsl_gd/rebase-merge" ] || [ -d "$_dsl_gd/rebase-apply" ]; then
    case "$_dsl_side" in
      ours)   printf 'LOCAL_upstream_%s' "$(cat "$_dsl_gd/rebase-merge/onto-name" 2>/dev/null || echo onto)" ;;
      theirs) printf 'REMOTE_yourcommit_%s' "$(cat "$_dsl_gd/rebase-merge/head-name" 2>/dev/null | sed 's|.*/||' || echo replayed)" ;;
    esac
    return
  fi
  case "$_dsl_side" in
    ours)   printf 'LOCAL_ours_%s' "$(git rev-parse --abbrev-ref HEAD 2>/dev/null | sed 's|/|-|g')" ;;
    theirs) printf 'REMOTE_theirs_%s' "$(git name-rev --name-only MERGE_HEAD 2>/dev/null | sed -e 's|^remotes/||' -e 's|/|-|g' || echo incoming)" ;;
  esac
}

cmd_diff() {
  _df_file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help diff; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose) VERYVRB=1 ;;
      -D|--debug) DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      --tool) shift; [ $# -gt 0 ] || fatal "diff: --tool needs a program" 64; DIFF_TOOL=$1 ;;
      --tool=*) DIFF_TOOL=${1#--tool=} ;;
      -*) fatal "diff: unknown option: $1" 64 ;;
      *)  [ -n "$_df_file" ] && fatal "diff: only one FILE is supported (got '$_df_file' and '$1')" 64
          _df_file=$1 ;;
    esac
    shift
  done

  _df_top=$(git_toplevel_of "$PWD") || fatal "diff: not inside a git repo" 1
  [ -n "$_df_top" ] || fatal "diff: not inside a git repo" 1
  cd "$_df_top" || fatal "diff: cannot cd to $_df_top" 1

  log_repo_context diff "$_df_top" \
    "READ-ONLY: writes the two conflicting versions to temp files and opens '${DIFF_TOOL}'" \
    "nothing in this repo is modified -- resolve by editing the real file yourself"

  _df_list=$(git diff --name-only --diff-filter=U 2>/dev/null)
  if [ -n "$_df_file" ]; then
    # Accept a path typed from anywhere in the tree.
    _df_abs=$(cd "$(dirname "$_df_file")" 2>/dev/null && pwd -P)/$(basename "$_df_file")
    _df_top_abs=$(cd "$_df_top" && pwd -P)
    _df_rel=${_df_abs#"$_df_top_abs"/}
    printf '%s\n' "$_df_list" | grep -qxF "$_df_rel" \
      || fatal "diff: '$_df_file' is not conflicted. Conflicted right now:$(printf '%s\n' "$_df_list" | sed 's/^/\n     /')" 1
    _df_list=$_df_rel
  fi
  if [ -z "$_df_list" ]; then
    log_major "$_df_top: no conflicted files — nothing to compare"
    exit 0
  fi

  command -v "${DIFF_TOOL%% *}" >/dev/null 2>&1 \
    || fatal "diff: '${DIFF_TOOL%% *}' not found — set DIFF_TOOL in the config, or pass --tool" 1

  _df_ours=$(_diff_side_label ours)
  _df_theirs=$(_diff_side_label theirs)
  _df_n=$(printf '%s\n' "$_df_list" | grep -c .)
  log_major "$_df_top: $_df_n conflicted file(s); left=$_df_ours  right=$_df_theirs"

  _df_tmp=$(mktemp -d "${TMPDIR:-/tmp}/${US}.diff.XXXXXX") || fatal "diff: mktemp -d failed" 1
  _df_i=0
  while IFS= read -r _df_f; do
    [ -n "$_df_f" ] || continue
    _df_i=$((_df_i + 1))
    _df_base=${_df_f##*/}
    case "$_df_base" in
      *.*) _df_stem=${_df_base%.*}; _df_ext=.${_df_base##*.} ;;
      *)   _df_stem=$_df_base;      _df_ext="" ;;
    esac
    _df_a="$_df_tmp/$_df_stem.$_df_ours$_df_ext"
    _df_b="$_df_tmp/$_df_stem.$_df_theirs$_df_ext"
    # A stage can be ABSENT: add/add has no ancestor, and modify/delete has
    # no :2 or no :3. Write an empty file and say so, rather than letting
    # the viewer open on a mystery.
    if ! git show ":2:$_df_f" > "$_df_a" 2>/dev/null; then
      : > "$_df_a"; log_warn "$_df_f: no '$_df_ours' version (deleted on that side) — showing an empty file"
    fi
    if ! git show ":3:$_df_f" > "$_df_b" 2>/dev/null; then
      : > "$_df_b"; log_warn "$_df_f: no '$_df_theirs' version (deleted on that side) — showing an empty file"
    fi
    log_major "[$_df_i of $_df_n] $_df_f"
    printf '    > left : %s\n' "$_df_a"
    printf '    > right: %s\n' "$_df_b"
    trace "$DIFF_TOOL $_df_a $_df_b"
    # A full-screen viewer (vimdiff) needs the terminal, and when my-git's
    # own output is piped or paged it must not inherit that pipe. But
    # FORCING /dev/tty breaks every case without one -- a pipeline, a
    # script, the test suite -- with "Device not configured". Use the
    # terminal when there is one, inherit stdio when there is not.
    # shellcheck disable=SC2086
    # NOT '[ -r /dev/tty ]': on macOS the node exists and is world-rw, so
    # the test passes with no controlling terminal and the redirect then
    # dies with "Device not configured". Actually OPENING it is the only
    # honest test -- the same idiom require_tty uses.
    if ( : </dev/tty ) 2>/dev/null && ( : >/dev/tty ) 2>/dev/null; then
      $DIFF_TOOL "$_df_a" "$_df_b" </dev/tty >/dev/tty 2>&1 || true
    else
      $DIFF_TOOL "$_df_a" "$_df_b" || true
    fi
  done <<_DF_EOF
$_df_list
_DF_EOF

  log_major "$_df_top: done — the temp copies are in $_df_tmp"
  printf '    > they are COPIES: resolve by editing the real file, then '\''git add'\'' it\n'
  printf '    > still conflicted: %s\n' "$(git diff --name-only --diff-filter=U 2>/dev/null | tr '\n' ' ')"
  return 0
}

# ─── rehydrate: give a fresh clone back its per-project repos ────────────
# A clone of the container repo carries every project's FILES, because
# shadowing mirrors them -- but not their .git dirs, which git never
# tracks. So a new machine gets all the code and cannot push any of it
# upstream: the container is only half of what a working tree needs.
#
# Each .git.shadow.status records the remote and branch precisely so the
# other half can be rebuilt. This clones each project's history back in
# WITHOUT touching the files already on disk: the container's copy stays
# authoritative, and anything it holds that upstream does not shows up as
# ordinary uncommitted changes.
cmd_rehydrate() {
  _rh_mode=analyze
  _rh_scope=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help rehydrate; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose) VERYVRB=1 ;;
      -D|--debug) DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      go) _rh_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _rh_mode=analyze ;;
      -*) fatal "rehydrate: unknown option: $1" 64 ;;
      *)  [ -n "$_rh_scope" ] && fatal "rehydrate: only one PATH is supported" 64
          _rh_scope=$1 ;;
    esac
    shift
  done

  _rh_top=$(git_toplevel_of "$PWD") || fatal "rehydrate: not inside a git repo" 1
  [ -n "$_rh_top" ] || fatal "rehydrate: not inside a git repo" 1
  cd "$_rh_top" || fatal "rehydrate: cannot cd to $_rh_top" 1

  log_repo_context rehydrate "$_rh_top" \
    "this repo is NOT modified -- its files stay exactly as they are" \
    "each listed path gets its OWN .git back, cloned from the remote its marker records" \
    "the files already here win: upstream history is attached UNDER them, and any difference shows as uncommitted changes"

  # Candidates: a marker, no live .git, and a remote to clone from.
  _rh_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.rehyd.XXXXXX") || fatal "rehydrate: mktemp failed" 1
  : > "$_rh_tmp"
  while IFS= read -r _rh_p; do
    [ -n "$_rh_p" ] || continue
    [ -n "$_rh_scope" ] && [ "$_rh_p" != "$_rh_scope" ] && continue
    [ -e "$_rh_p/.git" ] && continue
    _rh_url=$(sed -n 's|^remote\.origin\.url: ||p' "$_rh_p/.git.shadow.status" 2>/dev/null | head -n 1)
    _rh_br=$(sed -n 's|^branch: ||p' "$_rh_p/.git.shadow.status" 2>/dev/null | head -n 1)
    case "$_rh_br" in '(detached)'*) _rh_br="" ;; esac
    if [ -z "$_rh_url" ]; then
      log_warn "$_rh_p: marker records no remote — cannot rehydrate (it was local-only; its history lives in $_rh_top if it was merged)"
      continue
    fi
    printf '%s\t%s\t%s\n' "$_rh_p" "$_rh_url" "${_rh_br:-}" >> "$_rh_tmp"
  done <<_RH_EOF
$(list_shadow_markers "$_rh_top" 2>/dev/null)
_RH_EOF

  _rh_n=$(grep -c . "$_rh_tmp" 2>/dev/null)
  if [ "${_rh_n:-0}" -eq 0 ]; then
    rm -f "$_rh_tmp"
    log_major "$_rh_top: nothing to rehydrate — every shadowed repo already has its own .git"
    exit 0
  fi

  log_major "$_rh_top: $_rh_n project(s) have their files but no repo"
  while IFS="$(printf '\t')" read -r _rh_p _rh_url _rh_br; do
    [ -n "$_rh_p" ] || continue
    printf '  %s>> %-42s <- %s%s%s\n' "$C_BLUE" "$_rh_p" "$_rh_url" "${_rh_br:+  (}${_rh_br}${_rh_br:+)}" "$C_RESET"
  done < "$_rh_tmp"

  if [ "$_rh_mode" != go ]; then
    echo
    log_major "This was analyze-only — re-run with 'go' to apply:"
    printf '  %s>>   %s rehydrate go %s%s\n' "$C_BLUE" "$US" "${_rh_scope:-}" "$C_RESET"
    rm -f "$_rh_tmp"
    exit 0
  fi

  _rh_ok=0; _rh_fail=0
  while IFS="$(printf '\t')" read -r _rh_p _rh_url _rh_br; do
    [ -n "$_rh_p" ] || continue
    _rh_work=$(mktemp -d "${TMPDIR:-/tmp}/${US}.rhclone.XXXXXX") || { log_error "$_rh_p: mktemp -d failed"; _rh_fail=$((_rh_fail+1)); continue; }
    # --no-checkout: we want the HISTORY, never the files. The container's
    # copy of the worktree is the one to keep.
    if ! run git clone -q --no-checkout "$_rh_url" "$_rh_work/c" 2>/dev/null; then
      log_fail "rehydrate: $_rh_p — could not clone $_rh_url (unreachable or no access); files left untouched"
      rm -rf "$_rh_work"; _rh_fail=$((_rh_fail+1)); continue
    fi
    if ! run mv -- "$_rh_work/c/.git" "$_rh_p/.git"; then
      log_fail "rehydrate: $_rh_p — could not move the cloned .git into place"
      rm -rf "$_rh_work"; _rh_fail=$((_rh_fail+1)); continue
    fi
    rm -rf "$_rh_work"
    # Point HEAD at the recorded branch WITHOUT touching the worktree, then
    # sync the index to it -- so the files stay as the container had them
    # and any difference from upstream reads as uncommitted changes.
    if [ -n "$_rh_br" ] && git -C "$_rh_p" rev-parse -q --verify "refs/heads/$_rh_br" >/dev/null 2>&1; then
      run git -C "$_rh_p" symbolic-ref HEAD "refs/heads/$_rh_br" 2>/dev/null || true
    fi
    run git -C "$_rh_p" reset -q --mixed >/dev/null 2>&1 || true
    # The clone brought no .git/info/exclude, so re-apply the marker
    # exclusion here -- before the drift count, which would otherwise report
    # the marker itself as a difference from upstream.
    _shadow_exclude_marker "$_rh_p" || true   # 1 just means "already there"
    _rh_drift=$(git -C "$_rh_p" status --porcelain 2>/dev/null | grep -c .)
    log_ok "rehydrate: $_rh_p — repo restored ($(git -C "$_rh_p" rev-list --count HEAD 2>/dev/null) commits, branch $(git -C "$_rh_p" symbolic-ref --short -q HEAD 2>/dev/null); $_rh_drift file(s) differ from upstream)"
    _rh_ok=$((_rh_ok+1))
  done < "$_rh_tmp"
  rm -f "$_rh_tmp"

  echo
  if [ "$_rh_ok" -gt 0 ]; then
    log_ok "rehydrate: $_rh_ok project(s) can push upstream again.$([ "$_rh_fail" -gt 0 ] && printf ' %s FAILED.' "$_rh_fail")"
    printf '    > files were NOT touched: what differs from upstream is now uncommitted work for you to review\n'
  else
    log_error "rehydrate: nothing restored ($_rh_fail failed)"
  fi
  [ "$_rh_fail" -eq 0 ]
}

cmd_remote() {
  RM_CHECK=0
  RM_FORCE=0
  _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help remote; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose)          VERYVRB=1 ;;
      -D|--debug)   DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      --check)      RM_CHECK=1 ;;
      -R|--recursive) RECURSIVE=1 ;;
      --force)      RM_FORCE=1 ;;
      list)         : ;;      # optional explicit 'list' subword
      check)        RM_CHECK=1 ;;  # alias for --check
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "remote: unknown option: $1" 64 ;;
      *)            _args="$_args $(shell_escape "$1")" ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"

  _roots=$(resolve_scope "$@") || exit 1
  [ -z "$_roots" ] && { log_error "no repositories to inspect"; exit 1; }

  RM_N_TOTAL=0; RM_N_NOREMOTE=0; RM_N_IGNORED=0; RM_N_SUS=0
  _rm_sus_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.rmsus.XXXXXX")
  _rtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.rmroots.XXXXXX")
  trap 'rm -f "$_rm_sus_tmp" "$_rtmp"' EXIT INT TERM HUP
  printf '%s\n' "$_roots" > "$_rtmp"

  while IFS= read -r _rm_root; do
    [ -n "$_rm_root" ] || continue
    priv_gate "$_rm_root"
    case "$PRIV_ACTION" in
      skip) continue ;;
      warn) log_major "$_rm_root: [SKIPPED — cross-user policy]"; continue ;;
    esac
    # 'rem' is an overview, so it ALWAYS walks the whole tree (like 'st')
    # — registered submodules AND unregistered nested repos AND sidecars
    # AND merged paths. (-R is kept as a harmless no-op for muscle
    # memory.) walk_tree_lines emits '<pfx+display>\t<abs>\t<tag>'; we
    # take the abs path (field 2). Sidecar/merged nodes get their remote
    # read from .git.real / .git.merged inside remote_one. SCOPE_MANAGED=1
    # forces full discovery even for a foreign scope you cd'd into.
    _ntmp=$(mktemp "${TMPDIR:-/tmp}/${US}.rmnodes.XXXXXX")
    SCOPE_MANAGED=1 walk_tree_lines "$_rm_root" "$_rm_root" "" "" "" 2>/dev/null \
      | awk -F'\t' 'NF>=2 && $2!="" {print $2}' > "$_ntmp"
    while IFS= read -r _rm_node; do
      [ -n "$_rm_node" ] || continue
      remote_one "$_rm_node"
    done < "$_ntmp"
    rm -f "$_ntmp"
  done < "$_rtmp"
  rm -f "$_rtmp"

  # Count suspicious from file.
  if [ -s "$_rm_sus_tmp" ]; then
    RM_N_SUS=$((RM_N_SUS + $(grep -c '^S$' "$_rm_sus_tmp" 2>/dev/null | head -1)))
  fi
  rm -f "$_rm_sus_tmp"

  # Summary.
  echo
  log_major "remote: summary"
  _p=""
  _p="$_p total=$RM_N_TOTAL"
  [ "$RM_N_NOREMOTE" -gt 0 ] && _p="$_p $(c_red "no-remote=$RM_N_NOREMOTE")"
  [ "$RM_N_IGNORED" -gt 0 ]  && _p="$_p ignored=$RM_N_IGNORED"
  [ "$RM_CHECK" = 1 ] && [ "$RM_N_SUS" -gt 0 ] && _p="$_p $(c_yellow "suspicious=$RM_N_SUS")"
  printf '  %s>> %s%s\n' "$C_BLUE" "$_p" "$C_RESET"
  [ "$RM_CHECK" = 0 ] && printf '  %s>> run with --check to flag suspicious urls%s\n' "$C_BLUE" "$C_RESET"
}

# ═════════════════════════════════════════════════════════════════════════
# ═══ SYNC ════════════════════════════════════════════════════════════════
# ═════════════════════════════════════════════════════════════════════════
#
# my-git sync [go] [-R|-i|--force] [paths...]
#
# Composite "settle the tree" pipeline: sm → pull → mc.
#   Phase 1: sm     — register new nested repos, rebind moved ones,
#                     clean stale .gitmodules entries, .claude fixes.
#   Phase 2: pull   — fetch + fast-forward.
#   Phase 3: mc     — commit (auto + user-dirt) + push where allowed.
# Same flags apply uniformly to all three phases. Analyze by default.
cmd_sync() {
  _sy_mode=analyze
  _sy_rec=0; _sy_int=0; _sy_force=0
  _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help sync; exit 0 ;;
      go)           _sy_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _sy_mode=analyze ;;
      -R|--recursive)   _sy_rec=1 ;;
      -i|--interactive) _sy_int=1; require_tty sync ;;
      --force)          _sy_force=1 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose)          VERYVRB=1 ;;
      -D|--debug)   DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "sync: unknown option: $1" 64 ;;
      *)            _args="$_args $(shell_escape "$1")" ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"

  _phase_flags=""
  [ "$_sy_mode" = "go" ]  && _phase_flags="$_phase_flags go"
  [ "$_sy_rec" = 1 ]      && _phase_flags="$_phase_flags -R"
  [ "$_sy_int" = 1 ]      && _phase_flags="$_phase_flags -i"
  [ "$_sy_force" = 1 ]    && _phase_flags="$_phase_flags --force"

  # Resolve the scope once; sm doesn't accept path args, so we cd into
  # each resolved root and run sm + pull + mc from there.
  _roots=$(resolve_scope "$@") || exit 1
  [ -z "$_roots" ] && { log_error "sync: no repositories to process"; exit 1; }
  _rtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.sync.roots.XXXXXX")
  printf '%s\n' "$_roots" > "$_rtmp"

  _worst=0
  # NOTE: use a distinct loop variable name. cmd_pull / cmd_masscommits
  # internally use their own 'while read _root' loops which would clobber
  # an outer '_root' mid-iteration.
  while IFS= read -r _sy_root; do
    [ -n "$_sy_root" ] || continue
    echo
    log_major "sync: ── $_sy_root ──"

    echo
    log_major "sync: phase 1/3 — sm (register / rebind / stale cleanup / .claude)"
    echo
    # sm operates on CWD, so cd in; subshell to keep outer $PWD untouched.
    # shellcheck disable=SC2086
    ( cd "$_sy_root" && cmd_submodules $_phase_flags )
    _rc1=$?
    [ "$_rc1" = 77 ] && { rm -f "$_rtmp"; log_major "sync: aborted in sm phase."; return 77; }

    echo
    log_major "sync: phase 2/3 — pull (fetch + fast-forward)"
    echo
    # shellcheck disable=SC2086
    cmd_pull $_phase_flags "$_sy_root"
    _rc2=$?
    [ "$_rc2" = 77 ] && { rm -f "$_rtmp"; log_major "sync: aborted in pull phase."; return 77; }

    echo
    log_major "sync: phase 3/3 — mc (commit + push)"
    echo
    # shellcheck disable=SC2086
    cmd_masscommits $_phase_flags "$_sy_root"
    _rc3=$?
    [ "$_rc3" = 77 ] && { rm -f "$_rtmp"; log_major "sync: aborted in mc phase."; return 77; }

    for _rcx in "$_rc1" "$_rc2" "$_rc3"; do
      [ "$_rcx" -gt "$_worst" ] && _worst=$_rcx
    done
  done < "$_rtmp"
  rm -f "$_rtmp"

  echo
  log_major "sync: all phases complete"
  return $_worst
}

# ─── .claude setup enforcement ──────────────────────────────────────────
# Compute where in the central repo a project's .claude should live.
claude_dest_for() {
  _r=$1
  # Compare RESOLVED paths, not strings. The same root is reachable under
  # several spellings here (/LINKS/global, /syst/global,
  # /Users/.../system/global all name one directory), so a textual match
  # missed whenever my-git was invoked through a different one -- and every
  # project then fell through to misc/, breaking the mirror-the-project-path
  # layout that every correctly-placed .claude follows.
  _cdf_rp=$( cd "$_r" 2>/dev/null && pwd -P ) || _cdf_rp=$_r
  # The central repo lives INSIDE the tree it serves
  # (/LINKS/src/,claude-configs alongside /LINKS/src/sh/my-git), and the
  # layout mirrors each project's path relative to THAT parent:
  #   src/sh/my-appleRAID  ->  ,claude-configs/sh/my-appleRAID
  # So the parent is the natural anchor, and it is derived rather than
  # configured twice. Deriving it from GIT_REPOS instead produced
  # ',claude-configs/src/sh/my-git' -- correct relative to /LINKS/global,
  # but not what any existing sibling looks like.
  _cdf_anchor=${CLAUDE_PROJECT_DIR_CENTRAL_REPO%/*}
  _cdf_ap=$( cd "$_cdf_anchor" 2>/dev/null && pwd -P ) || _cdf_ap=""
  if [ -n "$_cdf_ap" ]; then
    case "$_cdf_rp/" in
      "$_cdf_ap"/*)
        printf '%s/%s\n' "$CLAUDE_PROJECT_DIR_CENTRAL_REPO" "${_cdf_rp#"$_cdf_ap"/}"
        return
        ;;
    esac
  fi
  for _base in $GIT_REPOS; do
    _cdf_bp=$( cd "$_base" 2>/dev/null && pwd -P ) || _cdf_bp=$_base
    [ -n "$_cdf_bp" ] || continue
    if [ "$_cdf_rp" = "$_cdf_bp" ]; then
      printf '%s/%s\n' "$CLAUDE_PROJECT_DIR_CENTRAL_REPO" "${_cdf_bp##*/}"
      return
    fi
    case "$_cdf_rp/" in
      "$_cdf_bp"/*)
        printf '%s/%s\n' "$CLAUDE_PROJECT_DIR_CENTRAL_REPO" "${_cdf_rp#"$_cdf_bp"/}"
        return
        ;;
    esac
  done
  # Fallback — basename under misc/. Reaching this means the project is
  # outside every GIT_REPOS root, which is worth saying out loud: the
  # result does NOT mirror the project's path, so it will not match its
  # siblings.
  log_warn "claude: $_r is under no GIT_REPOS root — placing its .claude at misc/${_r##*/}, which does NOT mirror the project path. Add its root to GIT_REPOS to get the usual layout."
  printf '%s/misc/%s\n' "$CLAUDE_PROJECT_DIR_CENTRAL_REPO" "${_r##*/}"
}

# _mc_record_change <abs-path>
# Append <abs-path> to MC_COMMIT_PATHS if not already there. Mirror of
# _sm_record_change. Used by mc helpers that mutate tracked files so
# the end-of-node auto-commit can include exactly those paths (and
# NOTHING the user edited) in a 'git commit --only' call.
_mc_record_change() {
  _rc_p=$1
  [ -n "$_rc_p" ] || return 0
  case "$_rc_p" in ./*) _rc_p=${_rc_p#./} ;; esac
  case "
${MC_COMMIT_PATHS}
" in
    *"
${_rc_p}
"*) return 0 ;;
  esac
  MC_COMMIT_PATHS="${MC_COMMIT_PATHS}${_rc_p}
"
}

# Ensure '.claude' appears in <repo>/.gitignore (safe, idempotent).
# Return 0 on success, 1 on failure.
ensure_claude_gitignore() {
  _r=$1
  _gi=$_r/.gitignore
  if [ -f "$_gi" ]; then
    # A pattern WITHOUT a trailing slash is the effective one -- see the
    # note below on symlinks. Accept it and stop.
    if grep -Eq '^/?\.claude$' "$_gi" 2>/dev/null; then
      log_dbg_med ".gitignore already lists .claude: $_gi"
      return 0
    fi
    # Only the '.claude/' form present: it matches DIRECTORIES only, so it
    # does nothing for the symlink the convention actually creates. Upgrade
    # it in place rather than appending a second, near-identical line.
    if grep -Eq '^/?\.claude/(\*\*)?$' "$_gi" 2>/dev/null; then
      if [ "$DRY_RUN" = 1 ]; then
        log_major "$_gi lists only '.claude/', which cannot match a symlink — DRY: would replace with '.claude'"
        return 0
      fi
      _ecg_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.ecg.XXXXXX" 2>/dev/null) || return 1
      # Drop every slash-form line, then fall through to append the good one.
      # NOT chained on grep's status: 'grep -v' exits 1 when it selects
      # NOTHING, which is exactly the case where the file contains only the
      # lines being removed -- so '&& cat' silently skipped the write and
      # left the broken pattern in place.
      grep -Ev '^/?\.claude/(\*\*)?$' "$_gi" > "$_ecg_tmp" 2>/dev/null
      cat "$_ecg_tmp" > "$_gi" 2>/dev/null
      rm -f "$_ecg_tmp" 2>/dev/null
      log_major "$_gi: replaced '.claude/' with '.claude' (the slash form cannot match a symlink)"
    fi
  fi
  if [ "$DRY_RUN" = 1 ]; then
    log_major ".claude missing from $_gi — DRY: would append"
    return 0
  fi
  log_major ".claude added to $_gi"
  # Preserve trailing newline; if file exists without final newline, fix that.
  if [ -f "$_gi" ] && [ -s "$_gi" ]; then
    _last=$(tail -c1 "$_gi" 2>/dev/null)
    if [ "$_last" != "" ] && [ "$_last" != "
" ]; then
      printf '\n' >> "$_gi" 2>/dev/null \
        || { sudo -n true 2>/dev/null || sudo true; echo "" | sudo tee -a "$_gi" >/dev/null; }
    fi
  fi
  # '.claude' WITHOUT a trailing slash. The convention makes .claude a
  # SYMLINK into the central configs repo, and git treats a symlink as a
  # FILE -- a pattern ending in '/' matches directories only, so '.claude/'
  # can never match it. Every project set up correctly therefore reported
  # its own .claude as untracked, forever, because of the line my-git
  # itself wrote. Without the slash it matches BOTH a symlink and a real
  # directory, so it also covers a not-yet-migrated project.
  if ! printf '.claude\n' >> "$_gi" 2>/dev/null; then
    printf '.claude\n' | sudo tee -a "$_gi" >/dev/null || return 1
  fi
  # Record the .gitignore path so commit_one phase-1 auto-commit picks it up.
  _mc_record_change "$_gi"
  return 0
}

# Classify and (when safe) auto-migrate <repo>/.claude.
# Return 0 on clean/fixed; 1 on unfixable problem (caller should fail).
ensure_claude_setup() {
  _r=$1

  # Skip if this IS (or is inside) the central repo itself.
  case "$_r/" in
    "$CLAUDE_PROJECT_DIR_CENTRAL_REPO"/*|"$CLAUDE_PROJECT_DIR_CENTRAL_REPO"*/)
      log_dbg_med "claude-check: $_r is inside central repo — skipping"
      return 0 ;;
  esac

  _cl=$_r/.claude

  # Only a repo that ACTUALLY HAS a .claude gets the ignore line.
  #
  # This used to run unconditionally, and 'mc' runs these checks before every
  # commit -- so a single 'mc -R' wrote '.claude/' into the .gitignore of
  # every repo in the tree and committed it, including third-party clones
  # that have no .claude and are not ours to change. Eleven repos sat one
  # unpushable commit ahead of their upstreams for months because of it.
  #
  # The existence of .claude is also the ownership test in practice: nobody
  # sets one up in a repo they do not work in.
  if [ -e "$_cl" ]; then
    ensure_claude_gitignore "$_r" || { log_error "$_r: could not update .gitignore"; return 1; }
  else
    log_dbg_med "claude-check: $_r has no .claude — not touching its .gitignore"
    return 0
  fi
  if [ -L "$_cl" ]; then
    _tgt=$(readlink "$_cl")
    # Resolve target to real absolute path (follows symlinks + resolves '..').
    _tgt_real=$( cd -P -- "$_cl" 2>/dev/null && pwd -P ) || _tgt_real=
    [ -z "$_tgt_real" ] && {
      case "$_tgt" in /*) _tgt_real=$_tgt ;; *) _tgt_real=$_r/$_tgt ;; esac
    }
    # Also resolve the central repo (it may itself contain symlinks like /LINKS).
    _ctr_real=$( cd -P -- "$CLAUDE_PROJECT_DIR_CENTRAL_REPO" 2>/dev/null && pwd -P ) \
      || _ctr_real=$CLAUDE_PROJECT_DIR_CENTRAL_REPO
    case "$_tgt_real" in
      "$_ctr_real"/*|"$_ctr_real")
        log_medium "$_r/.claude -> $_tgt (in central repo)"
        return 0
        ;;
      *)
        log_major "$_r/.claude points OUTSIDE central repo: $_tgt"
        log_medium "  resolved: $_tgt_real"
        log_medium "  central:  $_ctr_real"
        log_medium "not auto-correcting (user intent unclear)"
        return 0
        ;;
    esac
  fi

  if [ ! -e "$_cl" ]; then
    # Nothing there — fine.
    return 0
  fi

  if [ ! -d "$_cl" ]; then
    log_error "$_r/.claude exists but is not a symlink or directory"
    return 1
  fi

  # Real directory — auto-migrate.
  _dest=$(claude_dest_for "$_r")
  log_major "$_r/.claude is a real directory — migrating to central repo"
  log_medium "destination: $_dest"

  # Refuse if destination exists and is non-empty.
  if [ -e "$_dest" ]; then
    if [ -n "$(ls -A "$_dest" 2>/dev/null)" ]; then
      log_error "destination already exists and is non-empty: $_dest"
      log_medium "resolve manually, then re-run  (see: my-git --help claude-check)"
      return 1
    fi
  fi

  # Refuse if settings.json is present — rule classification needs human judgement.
  if [ -f "$_cl/settings.json" ]; then
    log_error "$_r/.claude/settings.json present — manual migration required"
    log_medium "per CLAUDE.md: split narrow/blanket/one-off rules by hand."
    log_medium "skipping this project; nothing moved."
    return 1
  fi

  if [ "$DRY_RUN" = 1 ]; then
    log_medium "DRY: would mkdir $_dest, move files, rmdir $_cl, symlink"
    return 0
  fi

  if [ "$INTERACTIVE" = 1 ]; then
    printf '    proceed with migration?  %s[y]es%s / %s[N]o%s (default: No): ' \
      "$C_GREEN" "$C_RESET" "$C_RED" "$C_RESET" >&2
    read -r _ans </dev/tty || _ans=n
    case "$_ans" in y|Y|yes) : ;; *) log_medium "skipped by user"; return 1 ;; esac
  fi

  mkdir -p "$_dest" || { log_error "mkdir failed: $_dest"; return 1; }
  # Move everything except settings.json (which we refused above).
  _moved=0
  for _f in "$_cl"/* "$_cl"/.[!.]* "$_cl"/..?*; do
    [ -e "$_f" ] || continue
    run mv -- "$_f" "$_dest/" || { log_error "mv failed: $_f"; return 1; }
    _moved=$((_moved + 1))
  done
  log_medium "moved $_moved item(s)"

  rmdir "$_cl" || { log_error "rmdir $_cl failed (not empty?)"; return 1; }

  # Relative symlink.
  _rel=$(python3 -c "import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))" "$_dest" "$_r" 2>/dev/null)
  if [ -z "$_rel" ]; then
    _rel=$_dest
    log_medium "(absolute link; python3 unavailable for relative calc)"
  fi
  ln -s "$_rel" "$_cl" || { log_error "ln -s failed"; return 1; }
  log_major "$_r/.claude -> $_rel  (migration complete)"
  # Record the migrated .claude symlink so commit_one phase-1 auto-commit
  # picks it up (it's a tracked file change caused by my-git, not user).
  _mc_record_change "$_cl"
  return 0
}

cmd_claude_check() {
  _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help claude-check; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose)          VERYVRB=1 ;;
      -D|--debug)   DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      -n|-T|--try|--dry|--dry-run) DRY_RUN=1 ;;
      -i|--interactive) INTERACTIVE=1; require_tty claude-check ;;
      -R|--recursive) RECURSIVE=1 ;;
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "claude-check: unknown option: $1" 64 ;;
      *)            _args="$_args $(shell_escape "$1")" ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"

  # READ-ONLY, unconditionally. This is an audit: it answers "what is the
  # state of the tree", never "make it so". Enforcement belongs to 'mc',
  # which is already writing to the repo it checks.
  DRY_RUN=1

  _roots=$(resolve_scope "$@") || exit 1
  [ -z "$_roots" ] && { log_error "no repositories to audit"; exit 1; }

  # An audit that prints nothing when all is well tells you nothing: this
  # was silent on a whole tree, so 'audit --claude' looked broken. Report a
  # line per repo with the two facts that decide what should happen to it --
  # does it HAVE a .claude, and is it PUBLISHED (does it have a remote).
  printf '%-46s %-9s %-11s %s\n' 'REPO' '.claude' 'PUBLISHED' 'NOTE'
  printf '%s\n' "$_roots" | while IFS= read -r _root; do
    [ -n "$_root" ] || continue
    # walk_submodules only sees REGISTERED submodules. Once a tree uses
    # shadowing (live .git kept, files mirrored) there are none, and this
    # audit reported a single line for a tree of 20+ repos. Every nested
    # repo has a .claude question to answer, registered or not.
    _nodes=$(printf '%s\n%s\n' "$_root" "$(list_unregistered_nested "$_root" 2>/dev/null | while IFS= read -r _n; do
               [ -n "$_n" ] && printf '%s/%s\n' "$_root" "$_n"; done)" \
             | grep -v '^$' | sort -u)
    # Top-down reading order.
    printf '%s\n' "$_nodes" | awk '{a[NR]=$0} END{for(i=NR;i>=1;i--) print a[i]}' \
      | while IFS= read -r _node; do
          [ -n "$_node" ] || continue
          _cc_rel=${_node#"$_root"/}; [ "$_cc_rel" = "$_node" ] && _cc_rel=$(basename "$_node")
          # .claude: symlink into the central repo is the convention; a real
          # directory is the thing claude-check exists to migrate.
          if [ -L "$_node/.claude" ]; then _cc_cl='symlink'
          elif [ -d "$_node/.claude" ]; then _cc_cl='REAL-DIR'
          elif [ -e "$_node/.claude" ]; then _cc_cl='file?'
          else _cc_cl='-'; fi
          _cc_url=$(run_as_owner_capture "$_node" git config --get remote.origin.url 2>/dev/null)
          if [ -n "$_cc_url" ]; then
            _cc_pub=$(basename "$_cc_url" .git)
          else
            _cc_pub='- (local)'
          fi
          # The ignore line belongs here IFF there is a .claude to ignore.
          _cc_note=''
          if [ "$_cc_cl" != '-' ]; then
            if grep -Eq '^/?\.claude$' "$_node/.gitignore" 2>/dev/null; then
              _cc_note='ok'
            elif grep -Eq '^/?\.claude/(\*\*)?$' "$_node/.gitignore" 2>/dev/null; then
              # The slash form matches directories only; the convention makes
              # .claude a SYMLINK, which git treats as a file.
              _cc_note='.gitignore has ".claude/" — cannot match a symlink, use ".claude"'
            else
              _cc_note='.gitignore MISSING .claude'
            fi
            [ "$_cc_cl" = 'REAL-DIR' ] && _cc_note="$_cc_note; not a symlink into the central repo"
          elif grep -Eq '^/?\.claude/?$' "$_node/.gitignore" 2>/dev/null; then
            # An ignore line with no .claude beside it is USUALLY the damage
            # this tool once caused -- but '.claude/' in a .gitignore matches
            # at ANY depth, and a parent that mirrors nested repos (shadow)
            # relies on it to keep THEIR .claude dirs out of its index. src
            # has no .claude at its root yet shields six nested ones; calling
            # that line removable nearly got a load-bearing line deleted.
            if [ -n "$(find "$_node" -name .claude -not -path '*/.git/*' -not -path '*/.git.real/*' -print 2>/dev/null | head -n 1)" ]; then
              _cc_note='ok (no .claude at the root, but the line shields NESTED .claude dirs)'
            else
              _cc_note='.gitignore ignores .claude/ but there is NONE here (root or nested)'
            fi
          fi
          printf '%-46s %-9s %-11s %s\n' "$_cc_rel" "$_cc_cl" "$_cc_pub" "$_cc_note"
          # NOTHING is changed here. An audit reports; it does not enforce.
          # Enforcement lives in 'mc', which runs ensure_claude_setup before
          # committing a repo it is already writing to.
        done
  done
}

# ═════════════════════════════════════════════════════════════════════════
# ═══ AUDIT / REPAIR (sidecar setup) ═══════════════════════════════════════
# ═════════════════════════════════════════════════════════════════════════
#
# _do_sidecar_audit <toplevel> <apply 0|1>
#   Inspect (apply=0) or repair (apply=1) the SETUP of every sidecar under
#   <toplevel>. Legacy sidecars (created before this tooling, or by hand)
#   commonly have setup problems that are invisible to normal use but
#   matter for portability and repo hygiene:
#     (A) '**/GIT_SIDECAR_DIRNAME' missing from the tracked .gitignore, so
#         sidecars show as '??' untracked clutter (or, worse, their whole
#         object DB got committed as content — see B).
#     (B) a sidecar's internal git DB tracked as ordinary content in the
#         parent index (repo bloat) — should be excluded, not committed.
#     (C) a NON-portable absolute 'core.worktree' (points at the original
#         tree; breaks if the repo is moved/cloned). Portable form is '..'.
#     (D) an EMPTY sidecar (0 commits) — preserves no history; flagged for
#         the user to decide (never auto-deleted).
#     (E) sidecar worktree files (INCLUDING the '.status' snapshot) not yet
#         tracked by the parent — a sidecar only works if the parent holds
#         all its content; repair 'git add's the untracked, non-ignored ones.
#   Returns the number of issues found (apply=0) or fixed (apply=1) via the
#   global _SA_ISSUES counter.
_do_sidecar_audit() {
  _sa_top=$1; _sa_apply=$2
  _sa_grd=${GIT_SIDECAR_DIRNAME:-.git.real}
  _SA_ISSUES=0   # auto-FIXABLE problems (repair 'go' fixes these)
  _SA_NOTES=0    # informational / manual-only observations (repair NEVER changes these)
  _sa_list=$(list_realized_dirs "$_sa_top")
  if [ -z "$_sa_list" ]; then
    log_major "$_sa_top: no sidecars found — nothing to audit"
    return 0
  fi
  _sa_n=$(printf '%s\n' "$_sa_list" | grep -c .)
  log_major "$_sa_top: auditing $_sa_n sidecar(s)$([ "$_sa_apply" = 1 ] && printf ' (repair mode)')"

  # (A) tracked-.gitignore exclude — one entry covers the whole tree.
  if [ -d "$_sa_top/.git" ] && ! grep -qxF "**/$_sa_grd" "$_sa_top/.gitignore" 2>/dev/null; then
    _SA_ISSUES=$((_SA_ISSUES + 1))
    if [ "$_sa_apply" = 1 ]; then
      ensure_sidecar_exclude "$_sa_top"
      log_major "  fixed: added '**/$_sa_grd' to tracked .gitignore (committed)"
    else
      log_major "  ISSUE: '**/$_sa_grd' not in tracked .gitignore — sidecars show as untracked clutter (repair adds+commits it)"
    fi
  fi

  # (B) sidecar internals wrongly TRACKED as content in the toplevel index.
  if [ -d "$_sa_top/.git" ]; then
    trace "(cd $_sa_top && git ls-files -- '*/$_sa_grd/*')   # audit: sidecar internals tracked as content?"
    _sa_tracked_dirs=$( cd "$_sa_top" 2>/dev/null && git ls-files -- "*/$_sa_grd/*" 2>/dev/null \
                        | sed "s|/$_sa_grd/.*|/$_sa_grd|" | sort -u )
    if [ -n "$_sa_tracked_dirs" ]; then
      _sa_bd=$(printf '%s\n' "$_sa_tracked_dirs" | grep -c .)
      _SA_ISSUES=$((_SA_ISSUES + 1))
      if [ "$_sa_apply" = 1 ]; then
        # NOTE: this is an INDEX-ONLY removal ('git rm --cached' keeps the
        # files on disk). A pathspec commit ('git commit -- <dir>') would
        # take the WORKTREE version of <dir> — where the files still exist —
        # and so commit NOTHING. The removal only lives in the index, so it
        # must be committed by a plain 'git commit' (index-as-is). To keep
        # that from sweeping in the user's OTHER staged work, we bail out if
        # the index already has staged changes (repair is safely re-runnable
        # once the index is clean).
        trace "(cd $_sa_top && git diff --cached --name-only)   # repair: any pre-existing staged changes?"
        _sa_pre_staged=$( cd "$_sa_top" 2>/dev/null && git diff --cached --name-only 2>/dev/null | head -1 )
        if [ -n "$_sa_pre_staged" ]; then
          log_major "  SKIP:  $_sa_bd sidecar object-DB dir(s) tracked as content — NOT touched: your index already has staged changes. Commit/reset them, then re-run 'repair --sidecar go'."
        else
          ( cd "$_sa_top" 2>/dev/null || exit 0
            _sa_oifs=$IFS; IFS='
'
            # shellcheck disable=SC2086
            set -- $_sa_tracked_dirs
            IFS=$_sa_oifs
            for _bd in "$@"; do
              [ -n "$_bd" ] || continue
              run git rm -r --cached -q -- "$_bd" >/dev/null 2>&1 || true
            done
            # plain commit: index holds ONLY our staged removals (verified
            # clean above), so nothing unrelated can ride along.
            run git commit -q -m "my-git repair: stop tracking sidecar internals as content" >/dev/null 2>&1 || true )
          log_major "  fixed: untracked $_sa_bd sidecar object-DB dir(s) from the parent index (committed; files kept on disk)"
        fi
      else
        log_major "  ISSUE: $_sa_bd sidecar object-DB dir(s) TRACKED as content in the parent (bloat) — repair 'git rm --cached'es them"
      fi
    fi
  fi

  # (C)+(D) per-sidecar: absolute core.worktree, empty history.
  # Iterate WITHOUT a pipe (IFS-split into positional args) so the
  # _SA_ISSUES/_SA_NOTES counters set inside survive into the summary.
  _sa_oifs2=$IFS; IFS='
'
  # shellcheck disable=SC2086
  set -- $_sa_list
  IFS=$_sa_oifs2
  for _sc in "$@"; do
    [ -n "$_sc" ] || continue
    _sa_gd="$_sa_top/$_sc/$_sa_grd"
    _sa_cw=$(git config --file "$_sa_gd/config" --get core.worktree 2>/dev/null)
    case "$_sa_cw" in
      /*)
        _SA_ISSUES=$((_SA_ISSUES + 1))
        if [ "$_sa_apply" = 1 ]; then
          run git config --file "$_sa_gd/config" core.worktree ".." 2>/dev/null \
            && log_major "  fixed: $_sc core.worktree '$_sa_cw' -> '..' (portable)"
        else
          log_major "  ISSUE: $_sc core.worktree is absolute ('$_sa_cw') — not portable; repair sets it to '..'"
        fi
        ;;
    esac
    _sa_commits=$(git --git-dir="$_sa_gd" rev-list --all --count 2>/dev/null || echo 0)
    if [ "${_sa_commits:-0}" -eq 0 ]; then
      _SA_NOTES=$((_SA_NOTES + 1))
      log_major "  NOTE:  $_sc is an EMPTY sidecar (0 commits). MANUAL/informational — repair does NOT touch it: 'unflatten --sidecar $_sc' to restore an empty live repo, or remove its $_sa_grd yourself."
    fi

    # (E) the sidecar's own worktree content — INCLUDING its .status snapshot
    #     — must be TRACKED by the parent. That is the whole point of a
    #     sidecar: the git dir is set aside as $_sa_grd (excluded), and every
    #     other file lives in the parent as plain tracked content. Untracked
    #     files here mean the parent isn't actually capturing the sidecar.
    if [ -d "$_sa_top/.git" ]; then
      _sa_statusrel="$_sc/$_sa_grd.status"
      if [ ! -f "$_sa_top/$_sa_statusrel" ]; then
        _SA_NOTES=$((_SA_NOTES + 1))
        log_major "  NOTE:  $_sc has no $_sa_grd.status snapshot. MANUAL/informational (OPTIONAL — 'unflatten --sidecar' works without it); repair does NOT create it. To record one, re-sidecar via 'unflatten --sidecar $_sc' then 'flatten $_sc --sidecar go'."
      fi
      # Untracked, non-ignored files under the sidecar, minus the git dir
      # itself (which is meant to be excluded, checked in (A)).
      trace "(cd $_sa_top && git ls-files --others --exclude-standard -- $_sc)   # audit: sidecar content tracked by parent?"
      _sa_untracked=$( cd "$_sa_top" 2>/dev/null \
        && git ls-files --others --exclude-standard -- "$_sc" 2>/dev/null \
        | grep -v "^$_sc/$_sa_grd/" )
      _sa_untracked_n=$(printf '%s\n' "$_sa_untracked" | grep -c .)
      if [ "${_sa_untracked_n:-0}" -gt 0 ]; then
        _SA_ISSUES=$((_SA_ISSUES + 1))
        _sa_status_note=""
        printf '%s\n' "$_sa_untracked" | grep -qxF "$_sa_statusrel" \
          && _sa_status_note=" (including its $_sa_grd.status)"
        if [ "$_sa_apply" = 1 ]; then
          ( cd "$_sa_top" 2>/dev/null || exit 0
            run git add -- "$_sc" >/dev/null 2>&1
            run git commit -q -m "my-git repair: track sidecar content in the parent" -- "$_sc" >/dev/null 2>&1 || true )
          log_major "  fixed: $_sc: staged+committed $_sa_untracked_n untracked sidecar file(s)$_sa_status_note"
        else
          log_major "  ISSUE: $_sc: $_sa_untracked_n file(s) under it NOT tracked by the parent$_sa_status_note — sidecar content not fully captured (repair 'git add's them)"
        fi
      fi
    fi
  done
  return 0
}

# my-git audit [--claude] [--sidecar] [-R] [paths...]   (read-only)
cmd_audit() {
  _au_claude=0; _au_sidecar=0; _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help audit; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose)          VERYVRB=1 ;;
      -D|--debug)   DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      -R|--recursive) RECURSIVE=1 ;;
      --claude)     _au_claude=1 ;;
      --sidecar)    _au_sidecar=1 ;;
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "audit: unknown option: $1" 64 ;;
      *)            _args="$_args $(shell_escape "$1")" ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"
  # Default: audit everything we know how to.
  [ "$_au_claude" = 0 ] && [ "$_au_sidecar" = 0 ] && { _au_claude=1; _au_sidecar=1; }
  if [ "$_au_claude" = 1 ]; then
    # shellcheck disable=SC2086
    ( cmd_claude_check "$@" )
  fi
  if [ "$_au_sidecar" = 1 ]; then
    _roots=$(resolve_scope "$@") || exit 1
    _au_oifs=$IFS; IFS='
'
    # shellcheck disable=SC2086
    set -- $_roots
    IFS=$_au_oifs
    _au_fix=0; _au_note=0
    for _r in "$@"; do
      [ -n "$_r" ] || continue
      _do_sidecar_audit "$_r" 0
      _au_fix=$((_au_fix + ${_SA_ISSUES:-0}))
      _au_note=$((_au_note + ${_SA_NOTES:-0}))
    done
    echo
    if [ "$_au_fix" -gt 0 ]; then
      log_major "audit --sidecar: $_au_fix auto-fixable issue(s)$([ "$_au_note" -gt 0 ] && printf ', %s manual/informational note(s)' "$_au_note") — fix with:  $US repair --sidecar go"
    else
      log_major "audit --sidecar: no auto-fixable issues.$([ "$_au_note" -gt 0 ] && printf ' (%s manual/informational note(s) above.)' "$_au_note")"
    fi
  fi
}

# my-git repair --sidecar [go] [-R] [paths...]   (analyze by default)
cmd_repair() {
  _rp_sidecar=0; _rp_mode=analyze; _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help repair; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV|--very-verbose)          VERYVRB=1 ;;
      -D|--debug)   DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg) DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      -R|--recursive) RECURSIVE=1 ;;
      go)           _rp_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _rp_mode=analyze ;;
      --sidecar)    _rp_sidecar=1 ;;
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "repair: unknown option: $1" 64 ;;
      *)            _args="$_args $(shell_escape "$1")" ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"
  # --sidecar is the only repair target so far; bare 'repair' defaults to it
  # (analyze) rather than erroring — so 'repair' shows what it WOULD fix.
  _rp_sidecar=1
  _roots=$(resolve_scope "$@") || exit 1
  _rp_apply=0; [ "$_rp_mode" = go ] && _rp_apply=1
  # Loop WITHOUT a pipe so _SA_ISSUES/_SA_NOTES survive and can be summed.
  _rp_oifs=$IFS; IFS='
'
  # shellcheck disable=SC2086
  set -- $_roots
  IFS=$_rp_oifs
  _rp_fix=0; _rp_note=0
  for _r in "$@"; do
    [ -n "$_r" ] || continue
    _do_sidecar_audit "$_r" "$_rp_apply"
    _rp_fix=$((_rp_fix + ${_SA_ISSUES:-0}))
    _rp_note=$((_rp_note + ${_SA_NOTES:-0}))
  done

  # ── Clear outcome, so you always know whether anything happened ──────────
  echo
  if [ "$_rp_apply" = 1 ]; then
    if [ "$_rp_fix" -gt 0 ]; then
      log_ok "repair --sidecar: FIXED $_rp_fix issue(s)$([ "$_rp_note" -gt 0 ] && printf '. %s manual/informational note(s) above were left as-is (repair never changes those).' "$_rp_note")"
    else
      log_major "repair --sidecar: NOTHING to fix — the sidecar setup is already clean.$([ "$_rp_note" -gt 0 ] && printf ' (The %s note(s) above are manual/informational — nothing '\''go'\'' would ever change.)' "$_rp_note")"
    fi
  else
    if [ "$_rp_fix" -gt 0 ]; then
      log_major "repair --sidecar: $_rp_fix auto-fixable issue(s)$([ "$_rp_note" -gt 0 ] && printf ' (+ %s manual/informational note(s))' "$_rp_note") — apply them with:"
      printf '  %s>>   %s repair --sidecar go%s\n' "$C_BLUE" "$US" "$C_RESET"
    else
      log_major "repair --sidecar: NOTHING to auto-repair — the setup is clean.$([ "$_rp_note" -gt 0 ] && printf ' The %s note(s) above are manual/informational only; '\''go'\'' would change nothing, so it is NOT offered.' "$_rp_note")"
    fi
  fi
}

