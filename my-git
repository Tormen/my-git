  test_merge_refuses_a_shallow_clone_instead_of_losing_it() {
    # REAL DATA LOSS, found by running it: py/my-uhs/testing/openuhs-src was
    # a shallow clone. git fetched its objects but REJECTED every ref
    # ("shallow roots are not allowed to be updated"), so nothing pinned
    # them -- yet the gate passed, because it only checked that the tip
    # OBJECT was readable. The .git was deleted and the history survived
    # only until the next gc. The snapshot even recorded
    # 'preserved-ref-count: 0' while claiming 'history-preserved: yes'.
    _rt_repo_file kid_o a.md
    ( cd kid_o && echo b > b.md && git add -A && git commit -q -m second )
    _rt_repo par
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd par && git clone -q --depth 1 "file://$PWD/../kid_o" kid >/dev/null 2>&1 )
    cd par || return 1
    [ -f kid/.git/shallow ] || { _rt_fail "setup: kid should be a shallow clone"; return 1; }

    _rt_my_git flatten go kid --merge >"$_rt_out" 2>"$_rt_err"
    # The whole point: the repo must SURVIVE.
    _rt_isdir "the shallow repo's .git SURVIVES" kid/.git || return 1
    _rt_absent "no .git.merged claiming a preserved history" kid/.git.merged || return 1
    _rt_contains "says it is shallow" "$_rt_err" "SHALLOW clone" || return 1
    _rt_contains "says how to fix it" "$_rt_err" "fetch --unshallow" || return 1
    git --git-dir=kid/.git log -1 >/dev/null 2>&1 \
      || { _rt_fail "the shallow repo's own history is damaged"; return 1; }
    return 0
  }

