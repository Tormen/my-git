main() {
  # ─── Pre-dispatch: peel globals / --config / --create-config / --help ───
  _want_create_config=0
  _create_config_path=""
  _want_help=""
  _rest=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -V|--verbose)      VRB=1 ;;
      -VV|--very-verbose)               VERYVRB=1 ;;
      -D|--debug)        DBG=1; VERYVRB=1 ;;
      -DD|--deepdbg|--deep-dbg)     DBG=1; DEEPDBG=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      -R|--recursive)    RECURSIVE=1 ;;
      --run-tests)
        shift
        case "${1:-}" in
          --name) shift; cmd_run_tests "${1:-}" ;;
          ""|-*)  cmd_run_tests "" ;;
          *)      cmd_run_tests "$1" ;;
        esac
        exit $? ;;
      --config)          shift; CONFIG_FILE=${1:-}; [ -n "$CONFIG_FILE" ] || fatal "--config: missing argument" ;;
      --config=*)        CONFIG_FILE=${1#--config=} ;;
      --create-config)
        _want_create_config=1
        # Optional filename: peek next arg. If it exists and doesn't look
        # like another option, treat it as the target file. Otherwise
        # print to stdout (CLI).
        if [ $# -ge 2 ]; then
          case "$2" in
            -*|'') : ;;
            *)     _create_config_path=$2; shift ;;
          esac
        fi
        ;;
      --create-config=*)  _want_create_config=1; _create_config_path=${1#--create-config=} ;;
      -h|--help)
        # `--help [topic]` — peek next arg
        if [ $# -ge 2 ]; then
          case "$2" in
            -*|'')  _want_help=top ;;
            *)      _want_help=$2; shift ;;
          esac
        else
          _want_help=top
        fi
        ;;
      --)                shift; while [ $# -gt 0 ]; do _rest="$_rest $(shell_escape "$1")"; shift; done; break ;;
      -*)                _rest="$_rest $(shell_escape "$1")" ;;
      *)                 _rest="$_rest $(shell_escape "$1")"; shift; while [ $# -gt 0 ]; do _rest="$_rest $(shell_escape "$1")"; shift; done; break ;;
    esac
    shift
  done

  if [ -n "$_want_help" ]; then
    show_help "$_want_help"
    exit 0
  fi

  if [ "$_want_create_config" -eq 1 ]; then
    create_config "$_create_config_path"
    exit 0
  fi

  load_config

  # Self-deploying zsh completions (mirrors my-appleRAID's own
  # install_zsh_completions() pattern) — deliberately placed AFTER the
  # --run-tests/--help/--create-config early exits above, not
  # unconditionally at the top of the script: --run-tests promises to
  # "touch nothing of yours," and this writes to $HOME/.zsh/completions
  # + patches $HOME/.zshrc, so it must never fire for that path (or for
  # a bare --help / --create-config, neither of which need a real repo
  # or config at all). Runs on every actual subcommand invocation.
  install_zsh_completions

  # ─── Rebuild argv from $_rest ───
  # shellcheck disable=SC2086
  eval "set -- $_rest"

  # ─── No subcommand → legacy default: status (piped through less if TTY) ───
  if [ $# -eq 0 ]; then
    if [ -t 1 ]; then
      _xu_init_session
      cmd_status #| less -R
    else
      _xu_init_session
      cmd_status
    fi
    exit $?
  fi

  _sub=$1; shift
  _xu_init_session
  case "$_sub" in
    status|st|s)                cmd_status "$@" ;;
    masscommits|mc|c)           cmd_masscommits "$@" ;;
    go)
      # Back-compat: 'my-git go' = 'my-git mc go' (action).
      cmd_masscommits go "$@" ;;
    pull|pl)                    cmd_pull "$@" ;;
    push|ps)                    cmd_push "$@" ;;
    pp)                         cmd_pullpush "$@" ;;
    fetch)                      cmd_pull --fetch-only "$@" ;;
    sync|syn)                   cmd_sync "$@" ;;
    remote|rem)                 cmd_remote "$@" ;;
    flatten|fl)                 cmd_flatten "$@" ;;
    unflatten|unfl)             cmd_unflatten "$@" ;;
    shadow|sh)                  cmd_shadow "$@" ;;
    unshadow|unsh)              cmd_unshadow "$@" ;;
    purge)                      cmd_purge "$@" ;;
    diff)                       cmd_diff "$@" ;;
    rehydrate)                  cmd_rehydrate "$@" ;;
    submodules|sub|sm)          cmd_submodules "$@" ;;
    unsm|unsub|unsubmodules)    cmd_unsm "$@" ;;
    ignore)                     cmd_ignore "$@" ;;
    unignore)                   cmd_unignore "$@" ;;
    claude-check)               cmd_claude_check "$@" ;;
    audit)                      cmd_audit "$@" ;;
    repair)                     cmd_repair "$@" ;;
    help)                       show_help "${1:-top}" ;;
    -h|--help)                  show_help top ;;
    *)
      log_error "unknown subcommand: $_sub"
      echo >&2
      show_help_top >&2
      exit 64
      ;;
  esac
}

