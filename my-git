  test_claude_ignore_pattern_matches_the_symlink_not_a_directory() {
    # The convention makes .claude a SYMLINK into the central configs repo,
    # and git treats a symlink as a FILE -- so '.claude/' (and '.claude/**')
    # match DIRECTORIES only and can never match it. my-git wrote exactly
    # that pattern, so every correctly-set-up project reported its own
    # .claude as untracked forever, because of the line my-git added.
    _rt_repo_file proj a.md
    mkdir -p central/proj
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    printf 'CHECK_CLAUDE_SETUP=1\nCLAUDE_PROJECT_DIR_CENTRAL_REPO=%s\n' "$PWD/central" >> "$_rt_conf_path"
    cd proj || return 1
    printf '%s\n' '*.pyc' '.claude/' '.claude/**' 'build/' > .gitignore
    git add -A && git commit -q -m "gitignore with the ineffective pattern"
    ln -s ../central/proj .claude
    [ -n "$(git status --porcelain)" ] \
      || { _rt_fail "setup: the symlink should be reported as untracked"; return 1; }

    _rt_my_git mc go >/dev/null 2>&1
    [ -z "$(git status --porcelain)" ] \
      || { _rt_fail "the symlink is STILL untracked: $(git status --porcelain)"; return 1; }
    _rt_contains "the effective pattern is present" .gitignore ".claude" || return 1
    grep -qxE '/?\.claude/(\*\*)?' .gitignore \
      && { _rt_fail "the ineffective slash form was left behind"; return 1; }
    # Unrelated lines must survive the rewrite -- this edits a TRACKED file.
    _rt_contains "unrelated line kept (before)" .gitignore "*.pyc" || return 1
    _rt_contains "unrelated line kept (after)" .gitignore "build/" || return 1
    return 0
  }

  test_claude_check_leaves_repos_without_a_claude_alone() {
    # ROOT CAUSE of eleven repos sitting one unpushable commit ahead of their
    # upstreams for months: ensure_claude_setup ALWAYS appended '.claude/' to
    # .gitignore, and 'mc' runs these checks before every commit -- so one
    # 'mc -R' wrote that line into every repo in the tree, including
    # third-party clones with no .claude, and committed it.
    # A repo only gets the line if it actually HAS a .claude. That test also
    # serves as the ownership test: nobody sets one up in a stranger's repo.
    _rt_repo_file kid_o a.md
    _rt_repo par
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd par && git clone -q ../kid_o stranger >/dev/null 2>&1
      git clone -q ../kid_o mine     >/dev/null 2>&1 )
    cd par || return 1
    mkdir -p mine/.claude && echo '{}' > mine/.claude/settings.local.json
    # The harness config disables the .claude audit so tests never touch the
    # real setup; this test is ABOUT that audit, so switch it on and point it
    # at a scratch central repo.
    mkdir -p "$PWD/central"
    printf 'CHECK_CLAUDE_SETUP=1\nCLAUDE_PROJECT_DIR_CENTRAL_REPO=%s\n' "$PWD/central" >> "$_rt_conf_path"

    # Enforcement lives in 'mc' now -- 'claude-check' is a pure audit. Run it
    # inside each repo: even 'mc -R' walks only REGISTERED submodules, so it
    # never descends into a shadowed or plain nested repo.
    ( cd stranger && _rt_my_git mc go >/dev/null 2>&1 )
    ( cd mine     && _rt_my_git mc go >/dev/null 2>&1 )

    # The stranger's repo must be untouched.
    if [ -f stranger/.gitignore ] && grep -Eq '^/?\.claude/?$' stranger/.gitignore; then
      _rt_fail "wrote .claude/ into a repo that has no .claude"; return 1
    fi
    # ...while a repo that HAS one still gets it.
    grep -Eq '^/?\.claude/?$' mine/.gitignore 2>/dev/null \
      || { _rt_fail "a repo WITH a .claude did not get the ignore line"; return 1; }
    return 0
  }

  test_claude_audit_reports_claude_and_published_state() {
    # An audit that prints nothing when all is well tells you nothing -- this
    # one was silent over a whole tree, so 'audit --claude' looked broken.
    # And it walked only REGISTERED submodules, so a shadowed tree reported a
    # single line for 20+ repos.
    _rt_repo_file kid_o a.md
    _rt_repo par
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd par && git clone -q ../kid_o pub >/dev/null 2>&1 )
    cd par || return 1
    mkdir -p pub/.claude
    _rt_ok "claude-check (read-only)" _rt_my_git claude-check || return 1
    _rt_contains "has a header" "$_rt_out" ".claude" || return 1
    _rt_contains "names the PUBLISHED column" "$_rt_out" "PUBLISHED" || return 1
    _rt_contains "reports the nested repo, not just the root" "$_rt_out" "pub" || return 1
    # A parent with NO root .claude whose ignore line shields a NESTED
    # .claude (src's exact shape) must not be advised to remove the line.
    printf '.claude/\n' > .gitignore
    _rt_ok "claude-check with a shielding parent line" _rt_my_git claude-check || return 1
    _rt_contains "recognises the shield" "$_rt_out" "shields NESTED" || return 1
    _rt_not_contains "must not call the parent line removable" "$_rt_out" "NONE here (root or nested)" || return 1
    rm -f .gitignore
    # An audit must not change anything -- not even the thing it is auditing.
    _rt_before=$(git -C pub rev-parse HEAD)
    [ -f pub/.gitignore ] && _rt_gi_before=$(cat pub/.gitignore) || _rt_gi_before=''
    _rt_ok "claude-check again" _rt_my_git claude-check || return 1
    [ "$(git -C pub rev-parse HEAD)" = "$_rt_before" ] \
      || { _rt_fail "the audit COMMITTED something"; return 1; }
    [ -f pub/.gitignore ] && _rt_gi_after=$(cat pub/.gitignore) || _rt_gi_after=''
    [ "$_rt_gi_after" = "$_rt_gi_before" ] \
      || { _rt_fail "the audit modified .gitignore — it must be read-only"; return 1; }
    return 0
  }

  test_st_rows_stay_short_and_status_files_carry_the_detail() {
    # The tree is meant to be READ. Long explanations inline made rows wrap
    # on a 154-column terminal, which turns a scannable tree into mush. The
    # row carries the essence; anything longer -- what the state means, how
    # to undo it, where the history went -- lives in the path's own .status
    # file, which the row names.
    _rt_repo_file kid_o a.md
    _rt_repo par
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd par && git clone -q ../kid_o merged_kid >/dev/null 2>&1
      git clone -q ../kid_o side_kid   >/dev/null 2>&1
      git clone -q ../kid_o shadow_kid >/dev/null 2>&1 )
    cd par || return 1
    _rt_my_git flatten go merged_kid --merge   >/dev/null 2>&1
    _rt_my_git flatten go side_kid   --sidecar >/dev/null 2>&1
    _rt_my_git shadow  go shadow_kid           >/dev/null 2>&1

    _rt_ok "st -R" _rt_my_git -R st || return 1
    # No row may run long. 110 leaves room for deeper nesting on a normal
    # terminal; the paths in this fixture are short on purpose.
    _rt_long=$(awk '/^[|`+\\]|^[├└│]/ && length > 110 { print length": "$0 }' "$_rt_out" | head -n 1)
    [ -z "$_rt_long" ] || { _rt_fail "an st row exceeds 110 chars: $_rt_long"; return 1; }
    # ...and each row must point at the file that holds the detail.
    _rt_contains "merged row names its record" "$_rt_out" ".git.merged" || return 1
    _rt_contains "sidecar row names its record" "$_rt_out" ".git.real.status" || return 1

    # Every marker must carry its own undo command, so the file is enough.
    _rt_contains "merged snapshot says how to restore" merged_kid/.git.merged "unflatten --merge" || return 1
    _rt_contains "sidecar status says how to undo" side_kid/.git.real.status "unflatten --sidecar" || return 1
    _rt_contains "shadow marker says how to undo" shadow_kid/.git.shadow.status "unshadow" || return 1
    return 0
  }

  test_clean_stale_catches_an_entry_inside_another_submodule() {
    # After src itself became a submodule, global still carried an entry for
    # a path that now lives INSIDE src. The directory is right there, so the
    # "no directory on disk" test said nothing was stale -- yet git can never
    # act on that entry, because the path belongs to the inner submodule's
    # worktree. Dead registration, invisible to --clean-stale.
    _rt_repo_file inner_o a.md
    _rt_repo outer
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    cd outer || return 1
    git -c protocol.file.allow=always submodule add -q ../inner_o inner >/dev/null 2>&1
    git commit -q -m "inner as a submodule"
    # Register a path that lives inside 'inner' -- exactly the dead shape.
    git config -f .gitmodules submodule.'inner/deep'.path 'inner/deep'
    git config -f .gitmodules submodule.'inner/deep'.url 'https://example.invalid/deep.git'
    mkdir -p inner/deep && ( cd inner/deep && git init -q . && git config user.email t@t.com \
        && git config user.name t && echo d > d.txt && git add -A && git commit -q -m d )
    git add .gitmodules && git commit -q -m "dead entry for a path inside inner"

    _rt_ok "sm --clean-stale" _rt_my_git sm --clean-stale || return 1
    _rt_contains "reports it as stale" "$_rt_err" "INSIDE another registered submodule" || return 1
    [ -z "$(git config -f .gitmodules --get submodule.'inner/deep'.path 2>/dev/null)" ] \
      || { _rt_fail "the dead entry was not removed"; return 1; }
    # The legitimate inner submodule must survive untouched.
    [ -n "$(git config -f .gitmodules --get submodule.inner.path 2>/dev/null)" ] \
      || { _rt_fail "the real submodule registration was removed too"; return 1; }
    return 0
  }

