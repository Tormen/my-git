#!/bin/sh
# my-git — multi-repo git dispatcher with recursive submodule support.
#
# Subcommands:  status|st|s   masscommits|mc|c   submodules|sub|sm   claude-check
# Global opts:  -V|-VV   -D|-DD   --config FILE   --create-config   -h|--help
#
# See:  my-git --help   (or: my-git --help <subcommand>)

US=${0##*/}
ME=$(id -un 2>/dev/null || echo "$USER")

# ─── Runtime flags ───────────────────────────────────────────────────────
VRB=0; VERYVRB=0; DBG=0; DEEPDBG=0
CONFIG_FILE=""
CONFIG_SEARCH_ORDER="/LINKS/default/my-git.conf $HOME/.my-git.conf /etc/my-git.conf /usr/local/etc/my-git.conf"
DRY_RUN=0
INTERACTIVE=0
RECURSIVE=0

# ─── Colors (TTY only) ───────────────────────────────────────────────────
# Mirrors my-appleRAID. Empty on non-TTY so no escape codes leak into
# pipes / log files / subshell captures.
if [ -t 1 ]; then
  C_BOLD=$(printf '\033[1m')
  C_DIM=$(printf '\033[2m')
  C_RED=$(printf '\033[31m')
  C_GREEN=$(printf '\033[32m')
  C_YELLOW=$(printf '\033[33m')
  C_BLUE=$(printf '\033[34m')
  C_CYAN=$(printf '\033[36m')
  C_RESET=$(printf '\033[0m')
else
  C_BOLD=''; C_DIM=''; C_RED=''; C_GREEN=''; C_YELLOW=''; C_BLUE=''; C_CYAN=''; C_RESET=''
fi

# ─── Logging ─────────────────────────────────────────────────────────────
# MILESTONE / major info → bold cyan.
log_major()     { printf ' %s>>>%s %s\n' "$C_BOLD$C_CYAN" "$C_RESET" "$*"; }
# Medium info → blue, only at -V / -VV / -D / -DD.
log_medium()    { [ "$VRB"      = 1 ] && printf '  %s>>%s %s\n' "$C_BLUE" "$C_RESET" "$*"; return 0; }
# Minor detail → default color, only at -VV / -DD.
log_minor()     { [ "$VERYVRB"  = 1 ] && printf '    > %s\n' "$*"; return 0; }
# Debug output → dim/grey, stderr.
log_dbg_major() { [ "$DBG"      = 1 ] && printf ' %s~~~ %s%s\n' "$C_DIM" "$*" "$C_RESET" >&2; return 0; }
log_dbg_med()   { [ "$DBG"      = 1 ] && printf '  %s~~ %s%s\n'  "$C_DIM" "$*" "$C_RESET" >&2; return 0; }
log_dbg_minor() { [ "$DEEPDBG"  = 1 ] && printf '   %s~ %s%s\n'   "$C_DIM" "$*" "$C_RESET" >&2; return 0; }
log_warn()      { printf '%sWARN: %s %s\n'  "$C_YELLOW" "$C_RESET" "$*" >&2; }
log_error()     { printf '%sERROR:%s %s\n'  "$C_RED"    "$C_RESET" "$*" >&2; }

# ─── Command trace (run / show) — mirrors my-appleRAID ───────────────────
# run: echo command in grey at -V, then execute. Preserves exit code.
# show: print a "would run" command in grey (always shown at callsite —
#   callsite decides when to use it, e.g. for dry-run illustrations).
run() {
  # Trace goes to stderr so stdout-captured callers (run_as_owner_capture,
  # $(...) wrappers) stay clean. Only visible at -V (and therefore -D, -DD).
  [ "$VRB" = 1 ] && printf '%s$ %s%s\n' "$C_DIM" "$*" "$C_RESET" >&2
  "$@"
}
show() {
  printf '%s$ %s%s\n' "$C_DIM" "$*" "$C_RESET"
}
# Inline status colorizers used inside longer strings.
c_green() { printf '%s%s%s' "$C_GREEN"  "$1" "$C_RESET"; }
c_yellow(){ printf '%s%s%s' "$C_YELLOW" "$1" "$C_RESET"; }
c_red()   { printf '%s%s%s' "$C_RED"    "$1" "$C_RESET"; }
c_dim()   { printf '%s%s%s' "$C_DIM"    "$1" "$C_RESET"; }

fatal() {
  _ec=${2:-1}
  log_error "$1"
  exit "$_ec"
}

# ─── Config file handling ────────────────────────────────────────────────
_default_config_content() {
  cat <<'EOF'
# my-git.conf — configuration for the my-git CLI.
# Shell-syntax; sourced by my-git at startup.

# Space-delimited list of super-repos for fallback scope (used when my-git is
# invoked outside of any tracked repo and without explicit path arguments).
GIT_REPOS="/LINKS/global /LINKS/local /learn /LINKS/appData /LINKS/archive"

# ─── .claude setup enforcement (masscommits + claude-check) ──────────────
# 1 = audit+auto-fix; 0 = disable entirely
CHECK_CLAUDE_SETUP=1
# Central repo where all <project>/.claude directories live as real dirs.
# Each project's .claude must be a symlink into this tree.
CLAUDE_PROJECT_DIR_CENTRAL_REPO="/LINKS/src/,claude-configs"

# ─── Auto-commit message template knobs ──────────────────────────────────
COMMIT_MSG_LAST_N=3
COMMIT_MSG_DIFF_MAX_FILES=10

# ─── mc: auto-include untracked files ────────────────────────────────────
# 1 = treat '??' porcelain entries (new files the user added but didn't
#     'git add' yet) as auto-committable along with my-git-caused dirt
#     (submodule gitlink bumps, .claude/.gitignore edits). Rationale:
#     new files are harmless to add; dragging the user through a prompt
#     for every new file is noise. Set 0 to prompt for untracked too.
MC_AUTO_COMMIT_UNTRACKED=1

# ─── st / sm: directory basenames to prune during unregistered-nested
#     discovery. Without this, walking from ~/ descends into package
#     caches that have tens of thousands of cloned .git dirs and takes
#     tens of seconds. These basenames are '-prune'd in the find walk.
#     Add more if you have other noisy cache/build roots.
ST_EXCLUDE_DIRS=".cache node_modules .npm .venv .tox __pycache__ .cargo .gradle .m2 .yarn Library .Trash"

# ─── Privilege: cross-user policy ───────────────────────────────────────
# Controls what happens when the current user differs from the repo's
# .git owner. Running as root ALWAYS just works (plain 'su <owner> -c ...',
# no password, no policy). These two policies apply only when the caller
# is a non-root user.
#
# Policy values:
#   sudo    - escalate via 'sudo su <owner> -c ...' (requires sudo rights;
#             macOS: caller must be in 'admin'/'wheel'/'sudo' group;
#             if no rights, behaves like 'fail')
#   fail    - ERROR and abort the whole run
#   ignore  - silently skip this repo, continue with the rest
#   warn    - print a warning and skip this repo, continue with the rest

# user (non-root) operating on a root-owned repo:
PRIV_POLICY_USER_TO_ROOT=warn

# user A (non-root) operating on user B's (non-root) repo:
PRIV_POLICY_USER_TO_USER=fail

# ─── Default verbosity / debug ──────────────────────────────────────────
# 1 = always behave as -V / -D (CLI flag can still raise the level)
DEFAULT_VERBOSE=0
DEFAULT_DEBUG=0

# ─── Submodules (sm) subcommand ─────────────────────────────────────────
SM_AUTO_SAFE_DIRECTORY=1
# SSH ConnectTimeout (seconds) applied to any clone/fetch ‘sm’ performs
# via SSH. Protects against half-minute+ default stalls when a host is
# unreachable. Applied via GIT_SSH_COMMAND at cmd_submodules start.
SM_SSH_CONNECT_TIMEOUT=30
EOF
}

load_config() {
  # Honour --config / $MY_GIT_CONFIG / search order.
  _cf=""
  if [ -n "$CONFIG_FILE" ]; then
    [ -f "$CONFIG_FILE" ] || fatal "--config: no such file: $CONFIG_FILE"
    _cf=$CONFIG_FILE
  elif [ -n "${MY_GIT_CONFIG:-}" ]; then
    [ -f "$MY_GIT_CONFIG" ] || fatal "\$MY_GIT_CONFIG: no such file: $MY_GIT_CONFIG"
    _cf=$MY_GIT_CONFIG
  else
    for _c in $CONFIG_SEARCH_ORDER; do
      if [ -f "$_c" ]; then _cf=$_c; break; fi
    done
  fi
  if [ -z "$_cf" ]; then
    log_major "no config file found"
    printf '  >> searched (in order):\n'
    for _c in $CONFIG_SEARCH_ORDER; do
      printf '    > %s\n' "$_c"
    done
    printf '  >> run:  my-git --create-config\n'
    printf '  >> or:   my-git --config /path/to/your.conf <subcommand>\n'
    exit 2
  fi
  log_dbg_med "config: $_cf"
  # All values come from the user's config. Defaults are NOT baked into
  # my-git at runtime — they live only inside _default_config_content(),
  # which --create-config writes to the config file. If the user's config
  # is missing variables that my-git depends on, that is the user's
  # responsibility: re-run --create-config (to a fresh path and diff) to
  # see what is expected.
  # shellcheck disable=SC1090
  . "$_cf"
  # Apply defaults from config to runtime flags (CLI flags can still escalate).
  [ "$DEFAULT_VERBOSE" = 1 ] && [ "$VRB" = 0 ] && VRB=1
  [ "$DEFAULT_DEBUG"   = 1 ] && [ "$DBG" = 0 ] && DBG=1
  # Back-compat defaults for vars newer than a user's existing config file.
  # New knobs: keep them conservative so upgrades don't surprise users.
  : "${MC_AUTO_COMMIT_UNTRACKED:=1}"
  : "${ST_EXCLUDE_DIRS:=.cache node_modules .npm .venv .tox __pycache__ .cargo .gradle .m2 .yarn Library .Trash}"
}

create_config() {
  # --create-config           → print default config to stdout (CLI).
  # --create-config <path>    → write default config to <path> (refuse overwrite).
  _target=${1:-}
  if [ -z "$_target" ]; then
    _default_config_content
    exit 0
  fi
  if [ -e "$_target" ]; then
    log_error "--create-config: refusing to overwrite existing file: $_target"
    exit 3
  fi
  _dir=${_target%/*}
  case "$_target" in */*) : ;; *) _dir=. ;; esac
  [ -d "$_dir" ] || fatal "--create-config: parent directory does not exist: $_dir"
  [ -w "$_dir" ] || fatal "--create-config: parent directory not writable: $_dir"
  _default_config_content > "$_target" || fatal "could not write $_target"
  log_major "config written: $_target"
  log_medium "edit it, then:  my-git <subcommand>"
  exit 0
}

# ─── Generic helpers ────────────────────────────────────────────────────
shell_escape() {
  # Print argv as a single space-joined, single-quoted POSIX-safe string.
  _esc=""
  for _a in "$@"; do
    _q=$(printf '%s' "$_a" | sed "s/'/'\\\\''/g")
    _esc="$_esc '$_q'"
  done
  printf '%s' "${_esc# }"
}

file_owner() {
  # macOS and GNU stat differ — try both.
  stat -f '%Su' "$1" 2>/dev/null || stat -c '%U' "$1" 2>/dev/null
}

is_managed_path() {
  # 0 = path is in GIT_REPOS (or a descendant); 1 = foreign.
  # "Managed" means: my-git is authorized to recursively discover
  # unregistered nested repos inside this scope. For foreign scopes
  # (e.g. ~/ which happens to be a git repo but is not in the config
  # list), my-git stays shallow — shows only the scope root itself,
  # does not descend looking for embedded / nested repos.
  # Match BOTH logical (symlink-preserving) and physical paths so a
  # caller's CWD of '/LINKS/src' matches a GIT_REPOS entry of
  # '/LINKS/global' via physical '/Users/MINE/system/global'.
  _im_p=$1
  _im_log=$(cd "$_im_p" 2>/dev/null && printf '%s' "$PWD") || return 1
  _im_phys=$(cd "$_im_p" 2>/dev/null && pwd -P) || return 1
  for _im_base in $GIT_REPOS; do
    [ -d "$_im_base" ] || continue
    _im_bl=$(cd "$_im_base" 2>/dev/null && printf '%s' "$PWD") || continue
    _im_bp=$(cd "$_im_base" 2>/dev/null && pwd -P) || continue
    # Equal or descendant test in both forms.
    case "$_im_log" in
      "$_im_bl"|"$_im_bl"/*) return 0 ;;
    esac
    case "$_im_phys" in
      "$_im_bp"|"$_im_bp"/*) return 0 ;;
    esac
  done
  return 1
}

is_pushable() {
  # 0 = push allowed, 1 = commit-only.
  # Push is allowed ONLY when the repo's absolute path matches one of
  # the entries in GIT_REPOS. Compare BOTH forms — logical (symlink-
  # preserving, e.g. '/LINKS/src') and physical (realpath, e.g.
  # '/Users/MINE/system/global/src') — on each side, so the match works
  # regardless of whether GIT_REPOS and the caller's CWD use symlink
  # or resolved form. Each super-repo in GIT_REPOS is meant to receive
  # pushes; submodules walked via -R that aren't in the list are not.
  _ip_r=$1
  _ip_log=$(cd "$_ip_r" 2>/dev/null && printf '%s' "$PWD") || return 1
  _ip_phys=$(cd "$_ip_r" 2>/dev/null && pwd -P) || return 1
  for _ip_base in $GIT_REPOS; do
    [ -d "$_ip_base" ] || continue
    _ip_base_log=$(cd "$_ip_base" 2>/dev/null && printf '%s' "$PWD") || continue
    _ip_base_phys=$(cd "$_ip_base" 2>/dev/null && pwd -P) || continue
    if [ "$_ip_log" = "$_ip_base_log" ] || [ "$_ip_phys" = "$_ip_base_phys" ]; then
      return 0
    fi
  done
  return 1
}

need_sudo_for() {
  # Echo 1 if repo's .git is not owned by current user; 0 otherwise.
  _r=$1
  _gd=$_r/.git
  [ -e "$_gd" ] || { echo 0; return; }
  _o=$(file_owner "$_gd")
  if [ -n "$_o" ] && [ "$_o" != "$ME" ]; then echo 1; else echo 0; fi
}

has_sudo_rights() {
  # True if the current user is entitled to sudo. Checks admin/wheel/sudo
  # group membership (covers macOS 'admin', Linux 'sudo'/'wheel'), then
  # falls back to a non-interactive 'sudo -n -v' probe (succeeds only if
  # credentials are cached OR NOPASSWD is configured — still a positive
  # signal). If neither indicator says yes, we say no.
  _me=${ME}
  _groups=$(id -Gn "$_me" 2>/dev/null | tr ' ' '\n')
  for _g in admin wheel sudo; do
    printf '%s\n' "$_groups" | grep -qx "$_g" && return 0
  done
  sudo -n -v 2>/dev/null && return 0
  return 1
}

# check_priv <repo>
#   Decide whether to proceed with an operation on <repo> given current
#   user, repo owner, and configured policy. Echoes ONE of:
#     exec        — proceed (direct exec or su/sudo under the hood)
#     skip        — policy=ignore: skip silently
#     warn        — policy=warn: WARN already printed to stderr; skip
#     fail:<msg>  — policy=fail (or sudo-without-rights, or bad policy
#                   value): caller must log_error+fatal
#   This function itself NEVER calls fatal() because it is usually invoked
#   inside $(...), where fatal's exit would only kill the subshell.
check_priv() {
  _repo=$1
  _gd=$_repo/.git
  [ -e "$_gd" ] || { echo exec; return; }
  _owner=$(file_owner "$_gd")
  if [ -z "$_owner" ] || [ "$_owner" = "$ME" ] || [ "$ME" = "root" ]; then
    echo exec; return
  fi
  if [ "$_owner" = "root" ]; then
    _pol=${PRIV_POLICY_USER_TO_ROOT:-fail}
    _polvar=PRIV_POLICY_USER_TO_ROOT
  else
    _pol=${PRIV_POLICY_USER_TO_USER:-fail}
    _polvar=PRIV_POLICY_USER_TO_USER
  fi
  case "$_pol" in
    sudo)
      if has_sudo_rights; then
        echo exec
      else
        echo "fail:$_repo: owned by $_owner; $_polvar=sudo but $ME has no sudo rights"
      fi
      ;;
    ignore)
      echo skip
      ;;
    warn)
      log_warn "$_repo: owned by $_owner — skipping ($_polvar=warn)"
      echo warn
      ;;
    fail)
      echo "fail:$_repo: owned by $_owner; $_polvar=fail"
      ;;
    *)
      echo "fail:$_polvar has invalid value '$_pol' (expected: sudo|fail|ignore|warn)"
      ;;
  esac
}

# priv_gate <repo>
#   Wrapper around check_priv that MUST be called in the PARENT shell
#   (not inside $()) so fatal() can exit the whole run. Sets the global
#   PRIV_ACTION to one of: exec | skip | warn. If the policy is 'fail',
#   calls fatal and terminates the process.
priv_gate() {
  PRIV_ACTION=$(check_priv "$1")
  case "$PRIV_ACTION" in
    fail:*) fatal "${PRIV_ACTION#fail:}" 13 ;;
    exec|skip|warn) : ;;
    *) fatal "internal: unknown priv action '$PRIV_ACTION'" 14 ;;
  esac
}

# _xuser_exec <target_user> <repo> <cmd...>
#   Execute a command in <repo> as <target_user>, picking the right
#   mechanism for the current user:
#     root -> user      : 'su <user> -c ...'        (no password, no sudo)
#     user -> other     : 'sudo su <user> -c ...'   (sudo prompts)
#     user -> same user : direct exec in subshell   (handled by callers)
_xuser_exec() {
  _tgt=$1; _repo=$2; shift 2
  _cmdstr=$(shell_escape "$@")
  _repo_q=$(shell_escape "$_repo")
  if [ "$ME" = "root" ]; then
    log_dbg_med "su $_tgt -c \"cd $_repo && $_cmdstr\""
    run su "$_tgt" -c "cd $_repo_q && $_cmdstr"
  else
    log_dbg_med "sudo su $_tgt -c \"cd $_repo && $_cmdstr\""
    run sudo -p "[sudo for $_tgt @ $_repo] password: " su "$_tgt" -c "cd $_repo_q && $_cmdstr"
  fi
}

run_as_owner() {
  # run_as_owner <repo_worktree> <cmd> [args...]
  #   Runs cmd in $repo as the .git owner. Dispatch:
  #     same user:  direct exec
  #     caller=root: plain 'su <owner> -c ...' (always allowed)
  #     cross-user: governed by PRIV_POLICY_USER_TO_{ROOT,USER}
  #
  # Policy NOTE: run_as_owner itself does NOT call priv_gate — it is often
  # invoked inside $(...) (e.g. from list_direct_submodules), where
  # priv_gate's fatal() couldn't exit the whole run. Callers that drive
  # a repo (status_one, commit_one) must call priv_gate FIRST and only
  # invoke run_as_owner when PRIV_ACTION = exec. When called in a context
  # where the caller hasn't gated, cross-user access simply proceeds via
  # _xuser_exec (which may then fail naturally if it's not permitted).
  _repo=$1; shift
  _gitdir=$_repo/.git
  [ -e "$_gitdir" ] || { log_error "run_as_owner: no .git at $_repo"; return 1; }
  _owner=$(file_owner "$_gitdir")
  log_dbg_minor "run_as_owner: repo=$_repo owner=$_owner me=$ME cmd=$*"
  if [ -z "$_owner" ] || [ "$_owner" = "$ME" ]; then
    ( cd "$_repo" && run "$@" )
    return $?
  fi
  _xuser_exec "$_owner" "$_repo" "$@"
}

run_as_owner_capture() {
  # As run_as_owner, but captures stdout. Trailing newline stripped by $().
  # See run_as_owner for policy notes: no priv_gate call here.
  _repo=$1; shift
  _gitdir=$_repo/.git
  [ -e "$_gitdir" ] || return 1
  _owner=$(file_owner "$_gitdir")
  if [ -z "$_owner" ] || [ "$_owner" = "$ME" ]; then
    ( cd "$_repo" && run "$@" )
    return $?
  fi
  _xuser_exec "$_owner" "$_repo" "$@"
}

is_git_repo() {
  # True if $1 contains a readable .git dir or file.
  [ -n "$1" ] && [ -e "$1/.git" ]
}

git_toplevel_of() {
  # Print the top-level of the git worktree containing $1, or empty.
  # Returns the LOGICAL (symlink-preserving) path — i.e. if $1 was
  # '/LINKS/src' (a symlink to /Users/MINE/system/global/src), the
  # output is '/LINKS/src', not the dereferenced physical path. This
  # keeps my-git's user-facing output speaking the same path the user
  # typed. Equality checks that need to dereference use pwd -P locally.
  _p=$1
  [ -d "$_p" ] || _p=${_p%/*}
  (
    cd "$_p" 2>/dev/null || exit 1
    _cdup=$(git rev-parse --show-cdup 2>/dev/null) || exit 1
    # Descend via the relative cdup — 'cd' is logical by default in
    # POSIX sh, so $PWD stays in the symlinked world.
    if [ -n "$_cdup" ]; then
      cd "$_cdup" 2>/dev/null || exit 1
    fi
    printf '%s\n' "$PWD"
  )
}

# ─── Submodule discovery ────────────────────────────────────────────────
# list_direct_submodules <repo>
#   Print paths (relative to $repo) of registered submodules whose worktree
#   exists at the expected location.
list_direct_submodules() {
  _r=$1
  [ -f "$_r/.gitmodules" ] || return 0
  run_as_owner_capture "$_r" git config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
    | awk '{$1=""; sub(/^ /,""); print}' \
    | while IFS= read -r _sub; do
        [ -n "$_sub" ] || continue
        [ -e "$_r/$_sub/.git" ] && printf '%s\n' "$_sub"
      done
}

# list_unregistered_nested <repo>
#   Print paths (relative to $repo) of DIRECT nested git repos that are NOT
#   registered in $repo/.gitmodules — i.e. embedded/unregistered repos. Skips
#   descendants of registered submodules (those are that sub's concern) and
#   any repo marked with .git/my-git-submodules.ignore (see 'sm' subcommand).
#   Also dedupes: if an unregistered repo contains another nested repo, only
#   the shallower one is returned (descent into it happens via walk_tree_lines).
list_unregistered_nested() {
  _r=$1
  [ -d "$_r" ] || return 0
  _regtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.reg.XXXXXX")
  run_as_owner_capture "$_r" git config -f .gitmodules \
    --get-regexp '^submodule\..*\.path$' 2>/dev/null \
    | awk '{$1=""; sub(/^ /,""); print}' > "$_regtmp" 2>/dev/null || : > "$_regtmp"
  ( cd "$_r" 2>/dev/null || exit 0
    # Prune:
    #   - './.git' (the scope root itself — we only want NESTED repos)
    #   - every basename in ST_EXCLUDE_DIRS (cache/build roots that
    #     otherwise contain thousands of cloned .git dirs and make a
    #     walk from ~/ take 30+ seconds).
    # IMPORTANT: use the root-repo exclusion as a -path, and cache
    # names as -name (match at any depth). Do NOT use -mindepth here:
    # -mindepth is a global filter applied before -prune, which means
    # any directory shallower than the mindepth is NEVER examined for
    # pruning and find happily descends into it.
    _pex='-path ./.git'
    for _ed in ${ST_EXCLUDE_DIRS:-}; do
      _pex="$_pex -o -name $_ed"
    done
    # shellcheck disable=SC2086
    eval "find . \\( $_pex \\) -prune -o -name .git -print 2>/dev/null"
  ) | sed -e 's|^\./||' -e 's|/\.git$||' | sort | awk -v reg="$_regtmp" '
      BEGIN {
        nr = 0
        while ((getline r < reg) > 0) if (r != "") registered[++nr] = r
      }
      {
        for (i = 1; i <= nr; i++) {
          if ($0 == registered[i] || index($0, registered[i] "/") == 1) next
        }
        if (last != "" && index($0, last "/") == 1) next
        print
        last = $0
      }' | while IFS= read -r _sub; do
    [ -n "$_sub" ] || continue
    printf '%s\n' "$_sub"
  done
  rm -f "$_regtmp"
}

# list_stale_submodules <repo>
#   Print paths (relative to $repo) of entries registered in $repo/.gitmodules
#   whose on-disk path doesn't exist (no .git file or dir at that path).
#   These are phantom registrations the user should clean up via 'sm go'.
list_stale_submodules() {
  _lsr_r=$1
  [ -d "$_lsr_r" ] || return 0
  [ -f "$_lsr_r/.gitmodules" ] || return 0
  run_as_owner_capture "$_lsr_r" git config -f .gitmodules \
    --get-regexp '^submodule\..*\.path$' 2>/dev/null \
    | awk '{$1=""; sub(/^ /,""); print}' \
    | while IFS= read -r _p; do
        [ -n "$_p" ] || continue
        [ -e "$_lsr_r/$_p/.git" ] && continue
        printf '%s\n' "$_p"
      done
}

# is_nested_ignored <repo> <sub>
#   Return 0 if $repo/$sub has the my-git-submodules.ignore marker.
is_nested_ignored() {
  _ini_r=$1; _ini_sub=$2
  _ini_gd=$(_sm_resolve_gitdir "$_ini_r/$_ini_sub/.git" "$_ini_r/$_ini_sub")
  [ -e "$_ini_gd/$_sm_IGNORE_MARKER" ]
}

# find_cross_submodule_unregistered <repo>
#   Walk every REGISTERED submodule under <repo> and list unregistered
#   non-ignored nested git repos found inside them. These cannot be
#   registered from <repo> (they belong to their parent submodule); we list
#   them so 'sm' can tell the user where to run the actual registration.
#   Output: TAB-separated "<parent-submodule-abs-path>\t<unregistered-sub-rel-to-parent>".
find_cross_submodule_unregistered() {
  _fcu_r=$1
  [ -d "$_fcu_r" ] || return 0
  walk_submodules "$_fcu_r" | while IFS= read -r _fcu_node; do
    [ -n "$_fcu_node" ] || continue
    # Skip the root itself — sm already analyzed it directly.
    [ "$_fcu_node" = "$_fcu_r" ] && continue
    list_unregistered_nested "$_fcu_node" | while IFS= read -r _fcu_sub; do
      [ -n "$_fcu_sub" ] || continue
      is_nested_ignored "$_fcu_node" "$_fcu_sub" && continue
      printf '%s\t%s\n' "$_fcu_node" "$_fcu_sub"
    done
  done
}

# walk_submodules <repo>
#   Post-order DFS: prints absolute worktree paths, deepest first, root last.
# Defined as a subshell function (using '( )' not '{ }') so every recursive
# invocation runs in its own scope — otherwise _root/_subs/_sub leak across
# calls (POSIX sh has no 'local'), producing bogus concatenated paths.
walk_submodules() (
  _root=$1
  log_dbg_minor "walk_submodules: $_root"
  _subs=$(list_direct_submodules "$_root")
  if [ -n "$_subs" ]; then
    printf '%s\n' "$_subs" | while IFS= read -r _sub; do
      [ -n "$_sub" ] || continue
      walk_submodules "$_root/$_sub"
    done
  fi
  printf '%s\n' "$_root"
)

# depth_of <root> <node>  — relative depth (# of path components past root)
depth_of() {
  _root=$1; _node=$2
  _rel=${_node#"$_root"}
  _rel=${_rel#/}
  [ -z "$_rel" ] && { echo 0; return; }
  printf '%s\n' "$_rel" | awk -F/ '{print NF}'
}

indent_for() {
  # Print $1 * 3 spaces.
  _n=$1
  _i=0
  while [ "$_i" -lt "$_n" ]; do printf '   '; _i=$((_i + 1)); done
}

# ─── Scope resolution ───────────────────────────────────────────────────
# Echoes newline-separated list of super-repo roots to operate on.
resolve_scope() {
  # Returns LOGICAL (symlink-preserving) absolute paths — see git_toplevel_of.
  # If explicit paths passed, use them.
  if [ $# -gt 0 ]; then
    for _p in "$@"; do
      _abs=$(cd "$_p" 2>/dev/null && printf '%s' "$PWD") || { log_error "not a directory: $_p"; return 1; }
      if ! is_git_repo "$_abs"; then
        log_error "not a git repo (no .git): $_abs"
        return 1
      fi
      printf '%s\n' "$_abs"
    done
    return 0
  fi
  # No args: try CWD.
  _top=$(git_toplevel_of "$PWD")
  if [ -n "$_top" ]; then
    log_dbg_med "scope: CWD-inferred $_top"
    printf '%s\n' "$_top"
    return 0
  fi
  # Fallback to GIT_REPOS list.
  log_dbg_med "scope: config fallback \$GIT_REPOS"
  for _r in $GIT_REPOS; do
    [ -d "$_r" ] || { log_warn "skipping missing repo from GIT_REPOS: $_r"; continue; }
    is_git_repo "$_r" || { log_warn "skipping non-git path from GIT_REPOS: $_r"; continue; }
    # Logical path: preserve the form written in GIT_REPOS (e.g. /LINKS/src).
    _abs=$(cd "$_r" 2>/dev/null && printf '%s' "$PWD")
    printf '%s\n' "$_abs"
  done
}

# ─── Status subcommand ──────────────────────────────────────────────────
# walk_tree_lines <abs_path> <display> <branch_prefix> <child_prefix> <tag>
#   Pre-order DFS emitting one TAB-separated line per node:
#     <branch_prefix>\t<abs_path>\t<display>\t<tag>
#   <branch_prefix> : box-drawing prefix printed before the display name.
#   <tag>           : "" for root, "reg" for registered submodule,
#                     "unreg" for embedded/unregistered nested git repo,
#                     "unreg-ign" for unregistered repo carrying the ignore
#                     marker (not descended — shown as leaf),
#                     "reg-ign" for the rare conflict state (registered AND
#                     marked ignore),
#                     "stale" for a .gitmodules entry with no directory on
#                     disk (shown as leaf; can't be descended).
#   Does NOT descend into repos that cross-user policy says we can't read.
walk_tree_lines() (
  _root=$1; _display=$2; _pfx=$3; _cpfx=$4; _tag=$5
  # Emit 3 TAB-sep fields: <pfx+display>\t<abs>\t<tag>. Combining pfx
  # and display up-front avoids POSIX 'read' eating a leading empty
  # field when _pfx is "" (read treats TAB as IFS-whitespace and
  # strips leading whitespace; so the root, with _pfx="", would have
  # its display shifted into the pfx slot downstream).
  printf '%s%s\t%s\t%s\n' "$_pfx" "$_display" "$_root" "$_tag"
  _action=$(check_priv "$_root")
  [ "$_action" = "exec" ] || return 0
  # Don't descend into a subtree marked as ignored (opt-out) or stale
  # (there's no directory on disk to descend into).
  case "$_tag" in
    *ign|stale) return 0 ;;
  esac
  _subs_reg=$(list_direct_submodules "$_root")
  # Unregistered-nested discovery is automatic for MANAGED scopes (in
  # GIT_REPOS or a descendant). For FOREIGN scopes (e.g. $HOME happens
  # to be a git repo but isn't in the config list) we stay shallow by
  # default — UNLESS the user explicitly passes -R / --recursive, which
  # is the opt-in override for "yes I do want you to walk this foreign
  # tree too". Registered submodules are ALWAYS shown regardless.
  # sm uses list_unregistered_nested directly for its own analysis and
  # is NOT gated by these flags (discovery IS sm's purpose).
  if [ "${SCOPE_MANAGED:-1}" = 1 ] || [ "${RECURSIVE:-0}" = 1 ]; then
    _subs_unreg=$(list_unregistered_nested "$_root")
  else
    _subs_unreg=""
  fi
  _subs_stale=$(list_stale_submodules "$_root")
  _all=$(printf '%s\n%s\n%s\n' "$_subs_reg" "$_subs_unreg" "$_subs_stale" | grep -v '^$' | sort -u)
  [ -z "$_all" ] && return 0
  _total=$(printf '%s\n' "$_all" | grep -c .)
  _i=0
  printf '%s\n' "$_all" | while IFS= read -r _sub; do
    [ -n "$_sub" ] || continue
    _i=$((_i + 1))
    if [ "$_i" -eq "$_total" ]; then
      _my_pfx="${_cpfx}└── "
      _my_cpfx="${_cpfx}    "
    else
      _my_pfx="${_cpfx}├── "
      _my_cpfx="${_cpfx}│   "
    fi
    # Classification precedence: stale beats reg/unreg (no dir on disk means
    # we can't do anything else with it). Otherwise reg vs unreg by membership.
    if printf '%s\n' "$_subs_stale" | grep -qxF "$_sub"; then
      _ntag=stale
    elif printf '%s\n' "$_subs_reg" | grep -qxF "$_sub"; then
      _ntag=reg
    else
      _ntag=unreg
    fi
    if [ "$_ntag" != stale ] && is_nested_ignored "$_root" "$_sub"; then
      _ntag="${_ntag}-ign"
    fi
    walk_tree_lines "$_root/$_sub" "$_sub" "$_my_pfx" "$_my_cpfx" "$_ntag"
  done
)

# status_summary <repo>
#   Print ONE compact line describing the repo's state. Handles cross-user
#   policy, errors, dirty counts, ahead/behind/diverged. Never multiline.
status_summary() {
  _r=$1
  is_git_repo "$_r" || { echo "[ERROR no .git]"; return 1; }
  _action=$(check_priv "$_r")
  case "$_action" in
    fail:*) printf '[ERROR] %s\n' "${_action#fail:}"; return 1 ;;
    skip|warn) echo "[SKIPPED — cross-user policy]"; return 0 ;;
  esac
  _porc=$(run_as_owner_capture "$_r" git status --porcelain --ignore-submodules 2>/dev/null)
  _rc=$?
  [ "$_rc" -ne 0 ] && { echo "[ERROR git status failed]"; return 1; }
  if [ -n "$_porc" ]; then
    _total=$(printf '%s\n' "$_porc" | grep -c .)
    _tally=$(printf '%s\n' "$_porc" | awk '
      /^\?\?/ { u++; next }
      {
        x=substr($0,1,1); y=substr($0,2,1)
        if (x=="M" || y=="M") m++
        else if (x=="A" || y=="A") a++
        else if (x=="D" || y=="D") d++
        else if (x=="R" || y=="R") r++
        else other++
      }
      END {
        s=""
        if (m) s=s" M:"m
        if (a) s=s" A:"a
        if (d) s=s" D:"d
        if (r) s=s" R:"r
        if (u) s=s" ??:"u
        if (other) s=s" ?:"other
        sub(/^ /,"",s)
        print s
      }')
    printf 'DIRTY (%d)  [%s]\n' "$_total" "$_tally"
    return 0
  fi
  _branch=$(run_as_owner_capture "$_r" git rev-parse --abbrev-ref HEAD 2>/dev/null)
  _rem_ref=origin/$_branch
  _has_remote=$(run_as_owner_capture "$_r" git branch -a 2>/dev/null \
    | grep -E "^[[:space:]]*remotes/$_rem_ref$" || true)
  if [ -z "$_has_remote" ]; then
    printf 'CLEAN (no remote for %s)\n' "$_branch"
    return 0
  fi
  _ab=$(run_as_owner_capture "$_r" git rev-list --left-right --count \
    "${_rem_ref}...${_branch}" 2>/dev/null)
  _behind=$(printf '%s' "$_ab" | awk '{print $1+0}')
  _ahead=$(printf '%s' "$_ab" | awk '{print $2+0}')
  if [ "${_ahead:-0}" -gt 0 ] && [ "${_behind:-0}" -gt 0 ]; then
    printf 'DIVERGED (ahead %s, behind %s)\n' "$_ahead" "$_behind"
  elif [ "${_ahead:-0}" -gt 0 ]; then
    printf 'CLEAN, ahead %s\n' "$_ahead"
  elif [ "${_behind:-0}" -gt 0 ]; then
    printf 'CLEAN, behind %s\n' "$_behind"
  else
    echo "CLEAN :))"
  fi
}

# Print porcelain status + branch divergence for a single repo, indented.
# Error codes 021-034 preserved from the original script where applicable.
status_one() {
  _r=$1; _depth=$2
  _ind=$(indent_for "$_depth")
  # Only run if the repo's .git is accessible to this process (via run_as_owner).
  is_git_repo "$_r" || { printf '%s > %s: [ERROR no .git]\n' "$_ind" "$_r"; return 1; }

  # Per-node cross-user policy check. status_one runs inside a pipeline
  # subshell, so fatal() can't abort the whole run from here — we treat
  # 'fail' at this depth as "print ERROR and skip this node" (root-level
  # fails are caught by priv_gate in cmd_status, which IS the parent).
  _action=$(check_priv "$_r")
  case "$_action" in
    fail:*)
      printf '%s > %s: [ERROR] %s\n' "$_ind" "$_r" "${_action#fail:}"
      return 1
      ;;
    skip|warn)
      printf '%s > %s: [SKIPPED — cross-user policy]\n' "$_ind" "$_r"
      return 0
      ;;
  esac

  _porc=$(run_as_owner_capture "$_r" git status --porcelain --ignore-submodules 2>&1)
  _rc=$?
  if [ "$_rc" -ne 0 ]; then
    printf '%s > %s:\n' "$_ind" "$_r"
    printf '%s   [ERROR] git status failed:\n' "$_ind"
    printf '%s\n' "$_porc" | sed -e "s|^|${_ind}     |"
    return 1
  fi

  if [ -z "$_porc" ]; then
    # Clean worktree — check divergence.
    _branch=$(run_as_owner_capture "$_r" git rev-parse --abbrev-ref HEAD 2>/dev/null)
    _rem_ref=origin/$_branch
    _has_remote=$(run_as_owner_capture "$_r" git branch -a 2>/dev/null | grep -E "^\s*remotes/$_rem_ref$" || true)
    if [ -z "$_has_remote" ]; then
      printf '%s > %s: CLEAN (no remote tracking for %s)\n' "$_ind" "$_r" "$_branch"
      return 0
    fi
    _div=$(run_as_owner_capture "$_r" git log "${_rem_ref}...${_branch}" 2>/dev/null)
    if [ -z "$_div" ]; then
      printf '%s > %s: CLEAN :))\n' "$_ind" "$_r"
    else
      printf '%s > %s: Local <-> Remote out of sync!\n' "$_ind" "$_r"
      printf '%s\n' "$_div" | sed -e "s|^|${_ind}        |"
    fi
  else
    printf '%s > %s:\n' "$_ind" "$_r"
    printf '%s\n' "$_porc" | sed -e "s|^|${_ind}        |"
  fi
}

cmd_status() {
  # Sub-option parse — accept global flags again and --help.
  _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help status; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV)          VRB=1; VERYVRB=1 ;;
      -D|--debug)   DBG=1; VRB=1 ;;
      -DD|--deepdbg) DBG=1; DEEPDBG=1; VRB=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      -R|--recursive) RECURSIVE=1 ;;  # -R forces discovery in foreign scopes too
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "status: unknown option: $1" 64 ;;
      *)            _args="$_args $(shell_escape "$1")" ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"

  _roots=$(resolve_scope "$@") || exit 1
  [ -z "$_roots" ] && { log_error "no repositories to inspect"; exit 1; }

  # Iterate roots in the PARENT shell (via a for-loop over a tmpfile) so
  # that priv_gate's fatal() actually aborts the whole run on policy=fail.
  _rtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.roots.XXXXXX")
  # Per-repo state counts are collected into a separate tmp (one char
  # per repo: C=clean, A=ahead, B=behind, V=diverged, D=dirty, E=error/skip).
  _stcounts_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.stcounts.XXXXXX")
  trap 'rm -f "$_rtmp" "$_stcounts_tmp"' EXIT INT TERM HUP
  printf '%s\n' "$_roots" > "$_rtmp"
  _first=1
  while IFS= read -r _root; do
    [ -n "$_root" ] || continue
    priv_gate "$_root"
    [ "$_first" = 1 ] || printf '\n'
    _first=0
    case "$PRIV_ACTION" in
      skip)
        echo E >> "$_stcounts_tmp"
        continue
        ;;
      warn)
        printf '%s  [SKIPPED — cross-user policy]\n' "$_root"
        echo E >> "$_stcounts_tmp"
        continue
        ;;
    esac
    # Is this scope a managed repo (in GIT_REPOS or a descendant)?
    # If yes: walk registered submodules + auto-discover unregistered
    #         nested repos below. If no (e.g. $HOME happens to be a
    #         git repo but isn't in GIT_REPOS): stay shallow — show
    #         only the repo root, no discovery.
    if is_managed_path "$_root"; then SCOPE_MANAGED=1; else SCOPE_MANAGED=0; fi
    if [ "$VRB" = 1 ]; then
      # Verbose: original per-node porcelain output, indented by depth.
      _nodes=$(walk_submodules "$_root")
      # walk_submodules returns post-order (leaves first). For status we want
      # top-down readability: super first, then its children. Reverse.
      printf '%s\n' "$_nodes" | awk '{a[NR]=$0} END{for(i=NR;i>=1;i--) print a[i]}' \
        | while IFS= read -r _node; do
            [ -n "$_node" ] || continue
            _d=$(depth_of "$_root" "$_node")
            status_one "$_node" "$_d"
            # Classify for counters.
            _s=$(status_summary "$_node" 2>/dev/null)
            case "$_s" in
              "CLEAN :))"*)        echo C ;;
              "CLEAN, ahead"*)     echo A ;;
              "CLEAN, behind"*)    echo B ;;
              "DIVERGED"*)         echo V ;;
              "DIRTY"*)            echo D ;;
              "CLEAN (no remote"*) echo C ;;
              *)                   echo E ;;
            esac >> "$_stcounts_tmp"
          done
    else
      # Default: compact one-line-per-repo tree. Output streams line-
      # by-line so the user sees progress in big trees instead of a
      # long stall followed by everything at once.
      #
      # Phase A (fast): structural walk only — gather every entry's
      #   (pfx+disp, mark, tag, abs) into a tmpfile. NO status calls;
      #   this is just 'find' + .gitmodules lookups.
      # Phase B (fast): compute the max display-widths of col1 and col2
      #   from the tmpfile (one awk pass) and emit each row with the
      #   LEFT side already padded so phase C just appends the state.
      # Phase C (slow, streaming): read the padded file line by line;
      #   for each row call status_summary (the expensive git call)
      #   and print '<padded-left>  <state>' immediately. User sees
      #   the tree fill in as status completes per repo.
      _rawtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.tree.raw.XXXXXX")
      _padtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.tree.pad.XXXXXX")

      # Phase A.  walk_tree_lines emits: <pfx+display>\t<abs>\t<tag>
      walk_tree_lines "$_root" "$_root" "" "" "" \
        | while IFS="$(printf '\t')" read -r _left _abs _tag; do
            _mark=""
            case "$_tag" in
              reg)       _mark="[registered]" ;;
              unreg)     _mark="[unregistered]" ;;
              unreg-ign) _mark="[unregistered, ignored]" ;;
              reg-ign)   _mark="[registered, ignored]" ;;
              stale)     _mark="[STALE REGISTRATION]" ;;
            esac
            # Columns for awk: <left> TAB <mark> TAB <tag> TAB <abs>
            printf '%s\t%s\t%s\t%s\n' "$_left" "$_mark" "$_tag" "$_abs" >> "$_rawtmp"
          done

      # Phase B — compute widths + emit each line with left-side padded.
      # Output to $_padtmp: "<padded-left><TAB><tag><TAB><abs>".
      awk -F'\t' '
        function dwidth(s,   n, w) {
          w = length(s)
          n = gsub(/│/, "", s); w -= 2 * n
          n = gsub(/├/, "", s); w -= 2 * n
          n = gsub(/└/, "", s); w -= 2 * n
          n = gsub(/─/, "", s); w -= 2 * n
          return w
        }
        # pass 1: gather max widths of col1 (name) and col2 (mark)
        NR == FNR {
          d1 = dwidth($1); if (d1 > m1) m1 = d1
          d2 = dwidth($2); if (d2 > m2) m2 = d2
          next
        }
        # pass 2: emit padded left + TAB + abs + TAB + tag.
        # Tag is LAST because it can be empty (root) and POSIX read
        # collapses consecutive separators for middle-whitespace fields;
        # a trailing empty field reads correctly as "".
        {
          d1 = dwidth($1); p1 = m1 - d1
          if (m2 > 0) {
            d2 = dwidth($2); p2 = m2 - d2
            left = sprintf("%s%*s  %s%*s", $1, p1, "", $2, p2, "")
          } else {
            left = sprintf("%s%*s", $1, p1, "")
          }
          printf "%s\t%s\t%s\n", left, $4, $3
        }
      ' "$_rawtmp" "$_rawtmp" > "$_padtmp"
      rm -f "$_rawtmp"

      # Phase C — stream status per line (progress visible).
      while IFS="$(printf '\t')" read -r _left _abs _tag; do
        [ -n "$_abs" ] || continue
        case "$_tag" in
          stale) _sum="[no directory on disk — run 'sm go' to clean]" ;;
          *)     _sum=$(status_summary "$_abs") ;;
        esac
        printf '%s  %s\n' "$_left" "$_sum"
        case "$_sum" in
          "CLEAN :))"*)        echo C ;;
          "CLEAN, ahead"*)     echo A ;;
          "CLEAN, behind"*)    echo B ;;
          "DIVERGED"*)         echo V ;;
          "DIRTY"*)            echo D ;;
          "CLEAN (no remote"*) echo C ;;
          "[no directory"*)    echo E ;;
          *)                   echo E ;;
        esac >> "$_stcounts_tmp"
      done < "$_padtmp"
      rm -f "$_padtmp"
    fi
  done < "$_rtmp"
  rm -f "$_rtmp"

  # ─── Summary ─────────────────────────────────────────────────────────
  _st_total=$(grep -c . "$_stcounts_tmp" 2>/dev/null | head -1)
  if [ "$_st_total" -gt 1 ]; then
    _n_clean=$(grep -c '^C$' "$_stcounts_tmp" 2>/dev/null | head -1)
    _n_ahead=$(grep -c '^A$' "$_stcounts_tmp" 2>/dev/null | head -1)
    _n_behind=$(grep -c '^B$' "$_stcounts_tmp" 2>/dev/null | head -1)
    _n_div=$(grep -c '^V$' "$_stcounts_tmp" 2>/dev/null | head -1)
    _n_dirty=$(grep -c '^D$' "$_stcounts_tmp" 2>/dev/null | head -1)
    _n_err=$(grep -c '^E$' "$_stcounts_tmp" 2>/dev/null | head -1)
    echo
    log_major "Summary"
    _parts=""
    [ "$_n_clean" -gt 0 ]  && _parts="$_parts $(c_green "CLEAN=$_n_clean")"
    [ "$_n_ahead" -gt 0 ]  && _parts="$_parts ahead=$_n_ahead"
    [ "$_n_behind" -gt 0 ] && _parts="$_parts behind=$_n_behind"
    [ "$_n_div" -gt 0 ]    && _parts="$_parts $(c_yellow "diverged=$_n_div")"
    [ "$_n_dirty" -gt 0 ]  && _parts="$_parts $(c_yellow "DIRTY=$_n_dirty")"
    [ "$_n_err" -gt 0 ]    && _parts="$_parts $(c_red "err/skip=$_n_err")"
    printf '  %s>>%s total=%s:%s\n' "$C_BLUE" "$C_RESET" "$_st_total" "$_parts"
  fi
  rm -f "$_stcounts_tmp"
}

# ─── Masscommits subcommand ─────────────────────────────────────────────
# Build auto-commit message body for a repo with changes.
# Prints (to stdout) the complete commit message.
# Args: <repo>
build_commit_message() {
  _r=$1
  _files=$(run_as_owner_capture "$_r" git status --porcelain 2>/dev/null | cut -c4-)
  _files_cnt=$(printf '%s\n' "$_files" | grep -c . || true)

  # Intro line
  if [ "$_files_cnt" -eq 1 ]; then
    _intro="$_files: ..."
  elif [ "$_files_cnt" -le 5 ]; then
    _intro=$( printf '%s' "$_files" | paste -s - ; printf '\n\n'; printf '%s\n' "$_files" | sed -e 's/$/: .../' )
  else
    _intro="$_r: AUTOMATIC-MASS-COMMIT [my-git mc]"
  fi

  # Diff / files block
  if [ "$_files_cnt" -gt "$COMMIT_MSG_DIFF_MAX_FILES" ]; then
    _diffs="
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
@@@@@ FILES @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

$(printf '%s\n' "$_files" | sed -e 's/^/    > /')
"
  else
    _diffs="
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
@@@@@ FILE DIFFS @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

$(printf '%s\n' "$_files" | sed -e 's/^/    > /')
$(printf '%s\n' "$_files" | while IFS= read -r _f; do
    [ -n "$_f" ] || continue
    printf '\n:::: %s ::::::::::::::::::::::::::::::::::::::::::::::::::::::\n\n' "$_f"
    run_as_owner_capture "$_r" git diff --cached -- "$_f" 2>/dev/null
  done)
"
  fi

  _cmtMsgs="
@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
@@@@@ LAST $COMMIT_MSG_LAST_N COMMIT MESSAGES @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

$(run_as_owner_capture "$_r" git log "-${COMMIT_MSG_LAST_N}" 2>/dev/null)"

  # Final message
  printf '%s\n.\n' "$_intro"
  printf '%s%s\n' "$_diffs" "$_cmtMsgs" | sed -e 's/^/#   /'
}

# _mc_classify_dirt <repo> <porcelain>
# Reads porcelain via stdin (newline-separated) and prints 3 lines to
# stdout (each may be empty):
#    <bump-paths-space-sep>
#    <recorded-paths-space-sep>
#    <user-paths-space-sep>
# where:
#    bumps    = paths that appear in <repo>/.gitmodules (submodule gitlink bumps)
#    recorded = paths whose abs form is in MC_COMMIT_PATHS
#               (my-git-side edits to .gitignore, .claude, etc.)
#    user     = everything else (the user's own dirt)
_mc_classify_dirt() {
  _cd_r=$1
  _cd_submods=""
  if [ -f "$_cd_r/.gitmodules" ]; then
    _cd_submods=$(run_as_owner_capture "$_cd_r" git config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
                  | awk '{print $2}')
  fi
  _cd_bumps=""; _cd_recorded=""; _cd_user=""
  while IFS= read -r _cd_line; do
    [ -n "$_cd_line" ] || continue
    # Capture status prefix (first 2 chars) + path.
    _cd_st=${_cd_line%"${_cd_line#??}"}
    _cd_p=${_cd_line#???}
    # Strip rename "old -> new" — keep the new path only.
    case "$_cd_p" in *" -> "*) _cd_p=${_cd_p##*" -> "} ;; esac
    # Submodule gitlink?
    if [ -n "$_cd_submods" ] && printf '%s\n' "$_cd_submods" | grep -qxF "$_cd_p"; then
      _cd_bumps="$_cd_bumps $_cd_p"
      continue
    fi
    # Recorded by my-git this run?
    _cd_abs="$_cd_r/$_cd_p"
    case "
${MC_COMMIT_PATHS}
" in
      *"
${_cd_abs}
"*) _cd_recorded="$_cd_recorded $_cd_p" ; continue ;;
    esac
    # Untracked file with MC_AUTO_COMMIT_UNTRACKED=1 → treat as auto
    # (new files are harmless to add; don't make the user confirm each).
    if [ "$_cd_st" = "??" ] && [ "${MC_AUTO_COMMIT_UNTRACKED:-1}" = 1 ]; then
      _cd_recorded="$_cd_recorded $_cd_p"
      continue
    fi
    _cd_user="$_cd_user $_cd_p"
  done
  printf '%s\n%s\n%s\n' "${_cd_bumps# }" "${_cd_recorded# }" "${_cd_user# }"
}

# _mc_auto_commit_my_git_changes <repo>
# Phase-1 of commit_one (go mode only): detect dirt caused BY my-git
# (submodule gitlink bumps + paths in MC_COMMIT_PATHS) and commit it
# transparently via 'git commit --only' — NO user prompt.
# Returns 0 on success (including no-op), 1 on error.
_mc_auto_commit_my_git_changes() {
  _ac_r=$1
  [ "$DRY_RUN" = 1 ] && return 0
  _ac_porc=$(run_as_owner_capture "$_ac_r" git status --porcelain --ignore-submodules=dirty 2>/dev/null)
  [ -z "$_ac_porc" ] && return 0

  _ac_cls=$(printf '%s\n' "$_ac_porc" | _mc_classify_dirt "$_ac_r")
  _ac_bumps=$(printf '%s\n' "$_ac_cls" | sed -n '1p')
  _ac_recorded=$(printf '%s\n' "$_ac_cls" | sed -n '2p')

  # Nothing my-git-caused → nothing to auto-commit.
  [ -z "$_ac_bumps" ] && [ -z "$_ac_recorded" ] && return 0

  if [ -z "$_ac_bumps" ]; then _ac_bump_count=0; else _ac_bump_count=$(printf '%s' "$_ac_bumps" | awk '{print NF}'); fi
  if [ -z "$_ac_recorded" ]; then _ac_rec_count=0; else _ac_rec_count=$(printf '%s' "$_ac_recorded" | awk '{print NF}'); fi

  # Build positional args (paths) for --only.
  _ac_all="$_ac_bumps $_ac_recorded"
  log_major "$_ac_r: auto-commit my-git-caused (bumps=$_ac_bump_count recorded=$_ac_rec_count)"
  if [ "$VRB" = 1 ]; then
    for _ac_p in $_ac_all; do
      log_medium "  $_ac_p"
    done
  fi

  # Stage exactly those paths.
  # shellcheck disable=SC2086
  run_as_owner "$_ac_r" git add -- $_ac_all 2>/dev/null || {
    log_error "$_ac_r: auto-commit: git add failed"
    return 1
  }
  # Compose commit subject.
  _ac_cm="my-git mc: auto-commit (bumps=$_ac_bump_count recorded=$_ac_rec_count)"
  # Commit ONLY these paths; --only ignores any other staged changes
  # (which would be user-dirt that the user may later want to prompt on).
  # shellcheck disable=SC2086
  if ! run_as_owner "$_ac_r" git commit --only -m "$_ac_cm" -- $_ac_all >/dev/null 2>&1; then
    log_error "$_ac_r: auto-commit failed"
    return 1
  fi
  log_major "$_ac_r: $(c_green 'DONE :))') (auto-committed my-git changes)"
  MC_N_AUTOCOMMITTED=$((${MC_N_AUTOCOMMITTED:-0} + 1))

  # Push if pushable (gitlink bumps should propagate upstream).
  if is_pushable "$_ac_r"; then
    _ac_remotes=$(run_as_owner_capture "$_ac_r" git remote 2>/dev/null)
    if [ -n "$_ac_remotes" ]; then
      run_as_owner "$_ac_r" git push -q --all 2>/dev/null \
        || log_warn "$_ac_r: auto-commit push failed (commit kept locally)"
    fi
  fi
  return 0
}

# commit_one <repo>  — if dirty, add -A + commit + push; if ahead, push.
commit_one() {
  _r=$1
  MC_N_TOTAL=$((MC_N_TOTAL + 1))

  # Honor the 'my-git-submodules.ignore' marker: if a nested repo is
  # flagged as "leave alone" for sm, mc respects the same signal.
  # --force (MC_FORCE=1) overrides — matches 'sm --force' semantics.
  _gd_for_marker=$(_sm_resolve_gitdir "$_r/.git" "$_r" 2>/dev/null)
  if [ -n "$_gd_for_marker" ] && [ -e "$_gd_for_marker/$_sm_IGNORE_MARKER" ]; then
    if [ "${MC_FORCE:-0}" -eq 1 ]; then
      log_medium "$_r: ignore marker present, OVERRIDDEN by --force"
    else
      [ "$VRB" = 1 ] && log_medium "$_r: [ignored marker — skipping]"
      MC_N_IGNORED=$((MC_N_IGNORED + 1))
      return 0
    fi
  fi

  # Cross-user policy. Deep nodes run inside a pipeline subshell, so
  # fatal() can't abort the whole run from here — root-level fails are
  # caught by priv_gate in cmd_masscommits (parent shell). Deep fails
  # become per-node ERRORs.
  _action=$(check_priv "$_r")
  case "$_action" in
    fail:*)
      log_error "${_action#fail:}"
      MC_N_ERROR=$((MC_N_ERROR + 1))
      return 1
      ;;
    skip)
      MC_N_SKIPPED=$((MC_N_SKIPPED + 1))
      return 0
      ;;
    warn)
      log_major "$_r: [SKIPPED — cross-user policy]"
      MC_N_SKIPPED=$((MC_N_SKIPPED + 1))
      return 0
      ;;
  esac

  # .claude setup audit (before staging so auto-fixes are part of the commit).
  if [ "$CHECK_CLAUDE_SETUP" = 1 ]; then
    ensure_claude_setup "$_r" || {
      log_error "$_r: .claude setup check failed (see above)"
      MC_N_ERROR=$((MC_N_ERROR + 1))
      return 1
    }
  fi

  # --ignore-submodules=dirty: show gitlink BUMPS (new commits in
  # submodules) so -R bottom-up walk can catch them in the parent's
  # cleanup commit, but still suppress noise from uncommitted worktree
  # changes INSIDE submodules (those are the submodule's business, not
  # the super's). Using bare '--ignore-submodules' (aka =all) would
  # hide gitlink bumps too — bug: the super would falsely show CLEAN
  # after children committed under -R.
  _porc=$(run_as_owner_capture "$_r" git status --porcelain --ignore-submodules=dirty 2>/dev/null)

  # Push is allowed only when BOTH conditions hold:
  #   (1) repo path matches an entry in GIT_REPOS (explicit allowlist), AND
  #   (2) at least one remote is configured ('git remote' non-empty).
  # Condition (1) protects against third-party-fork pushes; condition (2)
  # protects against repos with no upstream at all — trying to push would
  # fail with 'No configured push destination'.
  if is_pushable "$_r"; then
    _remotes=$(run_as_owner_capture "$_r" git remote 2>/dev/null)
    if [ -n "$_remotes" ]; then
      _pushable=1
      _nopush_reason=""
    else
      _pushable=0
      _nopush_reason="no remote configured"
    fi
  else
    _pushable=0
    _nopush_reason="not in GIT_REPOS"
  fi

  # ── Classify state ────────────────────────────────────────────────────
  #   state=clean-matched      CLEAN :))                  action: noop
  #   state=clean-no-remote    CLEAN (no remote)          action: noop
  #   state=clean-ahead        CLEAN, ahead=N             action: push  (if pushable) else noop
  #   state=dirty              DIRTY (N) [M:..  A:..  ??:..]  action: add+commit (+push if pushable)
  _state=""; _state_desc=""; _action=""
  if [ -z "$_porc" ]; then
    _branch=$(run_as_owner_capture "$_r" git rev-parse --abbrev-ref HEAD 2>/dev/null)
    _rem_ref=origin/$_branch
    _has_remote=$(run_as_owner_capture "$_r" git branch -a 2>/dev/null | grep -E "^\s*remotes/$_rem_ref$" || true)
    if [ -z "$_has_remote" ]; then
      _state=clean-no-remote
      _state_desc="CLEAN (no remote for $_branch)"
      _action=noop
    else
      _div=$(run_as_owner_capture "$_r" git log --oneline "${_rem_ref}..${_branch}" 2>/dev/null)
      if [ -z "$_div" ]; then
        _state=clean-matched
        _state_desc="CLEAN :))"
        _action=noop
      else
        _ahead=$(printf '%s\n' "$_div" | grep -c . 2>/dev/null | head -1)
        _state=clean-ahead
        _state_desc="CLEAN, ahead=$_ahead"
        if [ "$_pushable" = 1 ]; then
          _action=push
        else
          # Clean-ahead but not pushable (either not in GIT_REPOS, or no
          # remote configured). Commits already local; nothing to push to.
          _state_desc="$_state_desc  ($_nopush_reason → no push)"
          _action=noop
        fi
      fi
    fi
  else
    _n=$(printf '%s\n' "$_porc" | grep -c . 2>/dev/null | head -1)
    _state=dirty
    # Split dirt into buckets: bumps + recorded (my-git-caused) vs user.
    _cls=$(printf '%s\n' "$_porc" | _mc_classify_dirt "$_r")
    _bumps=$(printf '%s\n' "$_cls" | sed -n '1p')
    _recorded=$(printf '%s\n' "$_cls" | sed -n '2p')
    _userp=$(printf '%s\n' "$_cls" | sed -n '3p')
    # awk '{print NF}' on an empty string outputs nothing (no input
    # line), which breaks '[ -gt 0 ]' later. Guard with explicit 0.
    if [ -z "$_bumps" ]; then _bump_ct=0; else _bump_ct=$(printf '%s' "$_bumps" | awk '{print NF}'); fi
    if [ -z "$_recorded" ]; then _rec_ct=0; else _rec_ct=$(printf '%s' "$_recorded" | awk '{print NF}'); fi
    if [ -z "$_userp" ]; then _user_ct=0; else _user_ct=$(printf '%s' "$_userp" | awk '{print NF}'); fi
    # Description: show bumps/user split when bumps+recorded > 0.
    if [ "$_bump_ct" -gt 0 ] || [ "$_rec_ct" -gt 0 ]; then
      _auto_ct=$((_bump_ct + _rec_ct))
      if [ "$_user_ct" -gt 0 ]; then
        _state_desc="DIRTY ($_n) [auto:$_auto_ct user:$_user_ct]"
      else
        _state_desc="DIRTY ($_n) [auto:$_auto_ct]"
      fi
    else
      # No my-git-caused dirt → use the classic per-type counts.
      _m=$(printf '%s\n' "$_porc" | awk '{s=substr($0,1,2); if (s ~ /M/) m++} END{print m+0}')
      _a=$(printf '%s\n' "$_porc" | awk '{s=substr($0,1,2); if (s ~ /A/) a++} END{print a+0}')
      _d=$(printf '%s\n' "$_porc" | awk '{s=substr($0,1,2); if (s ~ /D/) d++} END{print d+0}')
      _u=$(printf '%s\n' "$_porc" | awk '{s=substr($0,1,2); if (s == "??") u++} END{print u+0}')
      _parts=""
      [ "$_m" -gt 0 ] && _parts="$_parts M:$_m"
      [ "$_a" -gt 0 ] && _parts="$_parts A:$_a"
      [ "$_d" -gt 0 ] && _parts="$_parts D:$_d"
      [ "$_u" -gt 0 ] && _parts="$_parts ??:$_u"
      _state_desc="DIRTY ($_n) [$(printf '%s' "$_parts" | sed 's/^ //')]"
    fi
    # Action: my-git-caused part always auto-commits (no prompt); user
    # part follows the normal add+commit[+push] flow.
    _user_action=""
    if [ "$_user_ct" -gt 0 ]; then
      if [ "$_pushable" = 1 ]; then
        _user_action="add+commit+push"
      else
        _user_action="add+commit"
      fi
    fi
    if [ "$_bump_ct" -gt 0 ] || [ "$_rec_ct" -gt 0 ]; then
      _auto_ct=$((_bump_ct + _rec_ct))
      if [ -n "$_user_action" ]; then
        _action="auto-commit $_auto_ct + $_user_action"
      else
        _action="auto-commit $_auto_ct"
      fi
    else
      _action=$_user_action
      [ -z "$_action" ] && _action=noop
    fi
  fi

  # ── Analyze mode: print a single concise line per repo and bail ───────
  if [ "$DRY_RUN" = 1 ]; then
    printf ' >>> %-60s %-32s -> %s\n' "$_r" "$_state_desc" "$_action"
    if [ "$VRB" = 1 ] && [ "$_state" = dirty ]; then
      printf '%s\n' "$_porc" | while IFS= read -r _l; do
        printf '        %s\n' "$_l"
      done
    fi
    # Counters for analyze-mode summary.
    case "$_state" in
      clean-matched|clean-no-remote) MC_N_CLEAN=$((MC_N_CLEAN + 1)) ;;
      clean-ahead) [ "$_pushable" = 1 ] && MC_N_WOULD_PUSH=$((MC_N_WOULD_PUSH + 1)) \
                   || MC_N_CLEAN=$((MC_N_CLEAN + 1)) ;;
      dirty)
        [ "${_bump_ct:-0}" -gt 0 ] || [ "${_rec_ct:-0}" -gt 0 ] && \
          MC_N_WOULD_AUTO=$((MC_N_WOULD_AUTO + 1))
        [ "${_user_ct:-0}" -gt 0 ] && MC_N_WOULD_USER=$((MC_N_WOULD_USER + 1))
        ;;
    esac
    return 0
  fi

  # ── go mode: perform the action ───────────────────────────────────────
  case "$_state" in
    clean-matched|clean-no-remote)
      log_major "$_r: $_state_desc"
      MC_N_CLEAN=$((MC_N_CLEAN + 1))
      return 0
      ;;
    clean-ahead)
      if [ "$_pushable" != 1 ]; then
        log_major "$_r: $_state_desc  ($_nopush_reason — no push)"
        MC_N_CLEAN=$((MC_N_CLEAN + 1))
        return 0
      fi
      log_major "$_r: $_state_desc — pushing"
      [ "$VRB" = 1 ] && log_minor "$_div"
      if [ "$INTERACTIVE" = 1 ]; then
        printf '%s\n' "$_div" | sed -e 's/^/        /'
        _ans=$(_sm_ask "    $_r: push $_ahead commit(s)? [Y]es / [S]kip / [A]bort [Y/s/a]: ")
        case "$_ans" in
          a|A) log_major "$_r: [ABORT requested]"; return 77 ;;
          s|S|n|N) log_major "$_r: skipped (push)"; MC_N_SKIPPED=$((MC_N_SKIPPED + 1)); return 0 ;;
        esac
      fi
      run_as_owner "$_r" git push -q --all || {
        log_error "$_r: git push failed"; MC_N_ERROR=$((MC_N_ERROR + 1)); return 1;
      }
      log_major "$_r: DONE :)) (pushed)"
      MC_N_PUSHED=$((MC_N_PUSHED + 1))
      return 0
      ;;
  esac

  # Dirty — go mode. Split the work:
  #   Phase 1: auto-commit my-git-caused dirt (bumps + recorded paths)
  #            transparently via 'git commit --only' — no prompt.
  #   Phase 2: if any user-dirt remains, follow the normal -i prompt
  #            flow (add -A + commit -F + push) on the reduced set.
  log_major "$_r: $_state_desc — $_action"
  [ "$VRB" = 1 ] && printf '%s\n' "$_porc" | sed -e 's/^/        /' \
    | while IFS= read -r _l; do log_medium "$_l"; done

  # Phase 1.
  if ! _mc_auto_commit_my_git_changes "$_r"; then
    MC_N_ERROR=$((MC_N_ERROR + 1))
    return 1
  fi

  # Re-read porcelain. If auto-commit cleared everything my-git touched,
  # only user-dirt remains (or nothing).
  _porc=$(run_as_owner_capture "$_r" git status --porcelain --ignore-submodules=dirty 2>/dev/null)
  if [ -z "$_porc" ]; then
    # Auto-commit handled everything; no user-dirt left.
    return 0
  fi

  # Phase 2: normal user-dirt flow on the reduced porcelain.
  _msgfile=$(mktemp "${TMPDIR:-/tmp}/${US}.commit-msg.XXXXXX")
  build_commit_message "$_r" > "$_msgfile" || { log_error "$_r: message build failed"; rm -f "$_msgfile"; MC_N_ERROR=$((MC_N_ERROR + 1)); return 1; }

  if [ "$INTERACTIVE" = 1 ]; then
    # Show remaining porcelain + proposed commit subject (first line) before acting.
    printf '%s\n' "$_porc" | sed -e 's/^/        /'
    _subject=$(sed -n '1p' "$_msgfile" 2>/dev/null)
    printf '    proposed commit subject: %s\n' "$_subject"
    _user_verb="add+commit"
    [ "$_pushable" = 1 ] && _user_verb="add+commit+push"
    _ans=$(_sm_ask "    $_r: $_user_verb (user changes)? [Y]es / [S]kip / [A]bort [Y/s/a]: ")
    case "$_ans" in
      a|A) rm -f "$_msgfile"; log_major "$_r: [ABORT requested]"; return 77 ;;
      s|S|n|N) rm -f "$_msgfile"; log_major "$_r: skipped (user changes)"; MC_N_SKIPPED=$((MC_N_SKIPPED + 1)); return 0 ;;
    esac
  fi

  run_as_owner "$_r" git add -A || { log_error "$_r: git add -A failed"; rm -f "$_msgfile"; return 1; }

  # If we must run git as another user, msgfile needs readable perms + chown.
  _owner=$(file_owner "$_r/.git")
  if [ -n "$_owner" ] && [ "$_owner" != "$ME" ]; then
    if [ "$ME" = "root" ]; then
      chown "$_owner" "$_msgfile" 2>/dev/null || chmod 644 "$_msgfile"
    elif has_sudo_rights; then
      sudo chown "$_owner" "$_msgfile" 2>/dev/null || chmod 644 "$_msgfile"
    else
      chmod 644 "$_msgfile"
    fi
  fi

  # -F takes the file as the literal commit message (no editor opens).
  # Previously -t was used → required interactive editing → failed in
  # non-interactive contexts.
  run_as_owner "$_r" git commit -q -a -F "$_msgfile" || {
    log_error "$_r: git commit failed"
    rm -f "$_msgfile"
    MC_N_ERROR=$((MC_N_ERROR + 1))
    return 1
  }
  rm -f "$_msgfile"
  MC_N_USER_COMMITTED=$((MC_N_USER_COMMITTED + 1))
  if [ "$_pushable" = 1 ]; then
    run_as_owner "$_r" git push -q --all || {
      log_error "$_r: git push failed"; MC_N_ERROR=$((MC_N_ERROR + 1)); return 1;
    }
    log_major "$_r: DONE :)) (added, committed, pushed)"
  else
    log_major "$_r: DONE :)) (added, committed — no push: $_nopush_reason)"
  fi
}

cmd_masscommits() {
  # mode: analyze (default, dry-like preview) vs go (actually add+commit+push).
  # Default is analyze to match 'sm' — only 'go' (or explicit alias) acts.
  _mc_mode=analyze
  MC_FORCE=0
  # Back-compat default for users whose existing config predates this var.
  MC_AUTO_COMMIT_UNTRACKED=${MC_AUTO_COMMIT_UNTRACKED:-1}
  _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help masscommits; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV)          VRB=1; VERYVRB=1 ;;
      -D|--debug)   DBG=1; VRB=1 ;;
      -DD|--deepdbg) DBG=1; DEEPDBG=1; VRB=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      go)           _mc_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _mc_mode=analyze ;;
      -i|--interactive) INTERACTIVE=1 ;;
      -R|--recursive) RECURSIVE=1 ;;
      --force)      MC_FORCE=1 ;;  # bypass per-repo my-git-submodules.ignore markers
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "masscommits: unknown option: $1" 64 ;;
      *)            _args="$_args $(shell_escape "$1")" ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"
  # Translate mode → DRY_RUN for commit_one (and friends).
  if [ "$_mc_mode" = "go" ]; then
    DRY_RUN=0
  else
    DRY_RUN=1
  fi

  _roots=$(resolve_scope "$@") || exit 1
  [ -z "$_roots" ] && { log_error "no repositories to commit"; exit 1; }

  # Reset the per-run list of paths my-git's mc side modified — see
  # _mc_record_change. commit_one phase-1 auto-commit consumes this.
  MC_COMMIT_PATHS=""

  # Per-run counters (summary at end). commit_one updates these globals
  # at each exit path. Analyze mode uses WOULD_* counters; go mode uses
  # the action counters.
  MC_N_TOTAL=0
  MC_N_CLEAN=0          # noop (already clean, matched remote or no remote)
  MC_N_PUSHED=0         # clean-ahead → pushed
  MC_N_AUTOCOMMITTED=0  # had a phase-1 auto-commit (bumps+recorded)
  MC_N_USER_COMMITTED=0 # had a phase-2 user-dirt commit
  MC_N_SKIPPED=0        # user said [S]kip (push or user-dirt) under -i
  MC_N_IGNORED=0        # carries my-git-submodules.ignore marker → silent skip
  MC_N_ERROR=0          # per-repo error (non-fatal, continued)
  MC_N_WOULD_PUSH=0     # analyze: would push
  MC_N_WOULD_AUTO=0     # analyze: would auto-commit my-git-caused dirt
  MC_N_WOULD_USER=0     # analyze: would commit user-dirt

  _rc_total=0
  # File-redirected while keeps us in the parent shell so root-level
  # priv_gate fail aborts the whole run.
  _rtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.roots.XXXXXX")
  trap 'rm -f "$_rtmp"' EXIT INT TERM HUP
  printf '%s\n' "$_roots" > "$_rtmp"
  while IFS= read -r _root; do
    [ -n "$_root" ] || continue
    priv_gate "$_root"
    case "$PRIV_ACTION" in
      skip) continue ;;
      warn) log_major "$_root: [SKIPPED — cross-user policy]"; continue ;;
    esac
    if [ "$RECURSIVE" = 1 ]; then
      # Post-order: deepest first so parent gitlinks can bump to freshly
      # committed children.
      _nodes=$(walk_submodules "$_root")
    else
      # Single level: git only cares about this repo's own index. A
      # submodule gitlink bump here (if any) is picked up by 'git add -A'
      # — but we do NOT descend into the submodule's own working tree.
      _nodes=$_root
    fi
    # File-redirected while keeps this in the parent shell so an abort
    # signal from commit_one (via return 77) actually propagates.
    _ntmp=$(mktemp "${TMPDIR:-/tmp}/${US}.nodes.XXXXXX")
    printf '%s\n' "$_nodes" > "$_ntmp"
    _abort_requested=0
    while IFS= read -r _node; do
      [ -n "$_node" ] || continue
      if [ "$_abort_requested" = 1 ] && [ "$_node" != "$_root" ]; then
        # Post-abort: skip every remaining descendant so we can still
        # process the ROOT as a cleanup commit (capturing any gitlink
        # bumps from children that already committed before the abort).
        continue
      fi
      commit_one "$_node"
      _rc=$?
      case "$_rc" in
        0)  : ;;
        77) _abort_requested=1 ;;   # continue loop so root still runs
        *)  _rc_total=1 ;;
      esac
    done < "$_ntmp"
    rm -f "$_ntmp"
    if [ "$_abort_requested" = 1 ]; then
      # Abort propagates to the outer root loop too: remaining roots in
      # GIT_REPOS-fallback scope are NOT processed. Ctrl+C (SIGINT) still
      # exits immediately via signal; this is specifically for [A]bort.
      rm -f "$_rtmp"
      log_major "mc: ABORT requested — parent cleanup done, stopping."
      return 77
    fi
  done < "$_rtmp"
  rm -f "$_rtmp"

  # ─── Concise summary ────────────────────────────────────────────────
  # Detailed tree is intentionally left to 'my-git st' — summary gives
  # "what was done / what's left" in one screen.
  echo
  if [ "$_mc_mode" = "go" ]; then
    # What WAS done.
    log_major "mc: summary"
    _parts=""
    [ "$MC_N_CLEAN" -gt 0 ]          && _parts="$_parts clean=$MC_N_CLEAN"
    [ "$MC_N_PUSHED" -gt 0 ]         && _parts="$_parts pushed=$MC_N_PUSHED"
    [ "$MC_N_AUTOCOMMITTED" -gt 0 ]  && _parts="$_parts auto-committed=$MC_N_AUTOCOMMITTED"
    [ "$MC_N_USER_COMMITTED" -gt 0 ] && _parts="$_parts user-committed=$MC_N_USER_COMMITTED"
    [ "$MC_N_SKIPPED" -gt 0 ]        && _parts="$_parts skipped=$MC_N_SKIPPED"
    [ "$MC_N_IGNORED" -gt 0 ]        && _parts="$_parts ignored=$MC_N_IGNORED"
    [ "$MC_N_ERROR" -gt 0 ]          && _parts="$_parts $(c_red "errors=$MC_N_ERROR")"
    [ -z "$_parts" ] && _parts=" (nothing to do)"
    printf '  %s>>%s total=%s:%s\n' "$C_BLUE" "$C_RESET" "$MC_N_TOTAL" "$_parts"
    # What's LEFT to do.
    _left_hint=""
    [ "$MC_N_SKIPPED" -gt 0 ] && _left_hint="$MC_N_SKIPPED repo(s) skipped under -i"
    [ "$MC_N_IGNORED" -gt 0 ] && {
      [ -n "$_left_hint" ] && _left_hint="$_left_hint; "
      _left_hint="${_left_hint}$MC_N_IGNORED ignored (--force to override markers)"
    }
    [ "$MC_N_ERROR" -gt 0 ] && {
      [ -n "$_left_hint" ] && _left_hint="$_left_hint; "
      _left_hint="${_left_hint}$MC_N_ERROR error(s)"
    }
    [ -n "$_left_hint" ] && printf '  %s>>%s left to do: %s\n' "$C_BLUE" "$C_RESET" "$_left_hint"
    printf '  %s>>%s for details:  %s st%s\n' "$C_BLUE" "$C_RESET" "$US" \
      "$([ "$RECURSIVE" = 1 ] && echo ' -R')"
  else
    # Analyze mode: "what would be done".
    log_major "mc: analyze summary"
    _wparts=""
    [ "$MC_N_CLEAN" -gt 0 ]      && _wparts="$_wparts clean=$MC_N_CLEAN"
    [ "$MC_N_WOULD_PUSH" -gt 0 ] && _wparts="$_wparts would-push=$MC_N_WOULD_PUSH"
    [ "$MC_N_WOULD_AUTO" -gt 0 ] && _wparts="$_wparts would-auto-commit=$MC_N_WOULD_AUTO"
    [ "$MC_N_WOULD_USER" -gt 0 ] && _wparts="$_wparts would-user-commit=$MC_N_WOULD_USER"
    [ "$MC_N_IGNORED" -gt 0 ]    && _wparts="$_wparts ignored=$MC_N_IGNORED"
    [ -z "$_wparts" ] && _wparts=" (nothing to do)"
    printf '  %s>>%s total=%s:%s\n' "$C_BLUE" "$C_RESET" "$MC_N_TOTAL" "$_wparts"
    printf '  %s>>%s apply:       %s mc go%s\n' "$C_BLUE" "$C_RESET" "$US" \
      "$([ "$RECURSIVE" = 1 ] && echo ' -R')"
    printf '  %s>>%s for details: %s st%s\n' "$C_BLUE" "$C_RESET" "$US" \
      "$([ "$RECURSIVE" = 1 ] && echo ' -R')"
  fi
  return $_rc_total
}

# ═════════════════════════════════════════════════════════════════════════
# ═══ PULL / FETCH ════════════════════════════════════════════════════════
# ═════════════════════════════════════════════════════════════════════════
#
# my-git pull [go] [-R|-i|--force|--fetch-only] [paths...]
#
# Two-phase like mc/sm: default analyze, 'go' acts.
#   * fetches origin on every scoped repo (always, even in analyze — fetch
#     is read-only wrt the worktree)
#   * with 'go' AND when clean + behind: fast-forward merges
#   * clean + diverged → refuses (user resolves manually)
#   * dirty or ignored → skipped
# --fetch-only: stops after fetch; never merges. Use when you just want
#   refs updated.

# pull_one <repo>
# Returns:
#   0 = success (clean, ff'd, or noop)
#   1 = error (fetch failed / merge failed)
#  77 = abort requested via -i prompt
pull_one() {
  _r=$1
  PL_N_TOTAL=$((PL_N_TOTAL + 1))

  # Honor the ignore marker.
  _gd_for_marker=$(_sm_resolve_gitdir "$_r/.git" "$_r" 2>/dev/null)
  if [ -n "$_gd_for_marker" ] && [ -e "$_gd_for_marker/$_sm_IGNORE_MARKER" ]; then
    if [ "${PL_FORCE:-0}" -eq 1 ]; then
      log_medium "$_r: ignore marker present, OVERRIDDEN by --force"
    else
      [ "$VRB" = 1 ] && log_medium "$_r: [ignored marker — skipping]"
      PL_N_IGNORED=$((PL_N_IGNORED + 1))
      return 0
    fi
  fi

  # No remote → nothing to fetch.
  _remotes=$(run_as_owner_capture "$_r" git remote 2>/dev/null)
  if [ -z "$_remotes" ]; then
    [ "$VRB" = 1 ] && log_medium "$_r: [no remote — skipping]"
    PL_N_NOREMOTE=$((PL_N_NOREMOTE + 1))
    return 0
  fi

  # Fetch (always runs — read-only).
  if [ "$_pl_mode" = "go" ] || [ "${PL_FETCH_ONLY:-0}" = 1 ] || [ "$DRY_RUN" != 1 ]; then
    # In analyze mode we also fetch so the ff/diverged/behind status
    # reflects the real upstream — otherwise analyze is meaningless
    # when stale. Only skipped when user asks for pure no-network mode
    # (not currently exposed; all modes fetch).
    if ! run_as_owner "$_r" git fetch --quiet --all --prune 2>/dev/null; then
      log_error "$_r: git fetch failed"
      PL_N_ERROR=$((PL_N_ERROR + 1))
      return 1
    fi
  fi

  # Compute ahead/behind vs current branch's tracked remote.
  _branch=$(run_as_owner_capture "$_r" git rev-parse --abbrev-ref HEAD 2>/dev/null)
  _rem_ref=origin/$_branch
  _has_remote=$(run_as_owner_capture "$_r" git branch -a 2>/dev/null \
    | grep -E "^[[:space:]]*remotes/$_rem_ref$" || true)
  if [ -z "$_has_remote" ]; then
    _desc="fetched; no origin/$_branch tracking ref"
    _action=noop
  else
    _ab=$(run_as_owner_capture "$_r" git rev-list --left-right --count \
      "${_rem_ref}...${_branch}" 2>/dev/null)
    _behind=$(printf '%s' "$_ab" | awk '{print $1+0}')
    _ahead=$(printf '%s' "$_ab" | awk '{print $2+0}')
    # Worktree dirty?
    _porc=$(run_as_owner_capture "$_r" git status --porcelain --ignore-submodules=dirty 2>/dev/null)
    if [ -n "$_porc" ]; then
      _desc="DIRTY (${_ahead:-0}/${_behind:-0} ahead/behind)"
      _action="skip (worktree dirty)"
    elif [ "${_behind:-0}" -gt 0 ] && [ "${_ahead:-0}" -gt 0 ]; then
      _desc="DIVERGED (ahead=$_ahead behind=$_behind)"
      _action="skip (manual merge needed)"
    elif [ "${_behind:-0}" -gt 0 ]; then
      _desc="behind=$_behind"
      _action="ff-merge"
    elif [ "${_ahead:-0}" -gt 0 ]; then
      _desc="ahead=$_ahead"
      _action="noop (nothing to pull)"
    else
      _desc="CLEAN :))"
      _action=noop
    fi
  fi

  # Analyze mode — print and bail.
  if [ "$DRY_RUN" = 1 ]; then
    printf ' >>> %-60s %-32s -> %s\n' "$_r" "$_desc" "$_action"
    case "$_action" in
      noop*|"skip (worktree dirty)"|"skip (manual merge needed)")
        PL_N_CLEAN=$((PL_N_CLEAN + 1)) ;;
      ff-merge)
        PL_N_WOULD_FF=$((PL_N_WOULD_FF + 1)) ;;
    esac
    return 0
  fi

  # go mode.
  case "$_action" in
    noop*)
      log_major "$_r: $_desc"
      PL_N_CLEAN=$((PL_N_CLEAN + 1))
      return 0
      ;;
    "skip (worktree dirty)")
      log_major "$_r: $_desc (dirty — commit or stash, then re-run)"
      PL_N_SKIPPED=$((PL_N_SKIPPED + 1))
      return 0
      ;;
    "skip (manual merge needed)")
      log_major "$_r: $_desc (resolve manually: git merge / git rebase)"
      PL_N_SKIPPED=$((PL_N_SKIPPED + 1))
      return 0
      ;;
  esac

  # ff-merge.
  if [ "${PL_FETCH_ONLY:-0}" = 1 ]; then
    log_major "$_r: fetched ($_desc), --fetch-only → not merging"
    PL_N_CLEAN=$((PL_N_CLEAN + 1))
    return 0
  fi
  if [ "$INTERACTIVE" = 1 ]; then
    _ans=$(_sm_ask "    $_r: fast-forward $_behind commit(s)? [Y]es / [S]kip / [A]bort [Y/s/a]: ")
    case "$_ans" in
      a|A) log_major "$_r: [ABORT requested]"; return 77 ;;
      s|S|n|N) log_major "$_r: skipped (ff-merge)"; PL_N_SKIPPED=$((PL_N_SKIPPED + 1)); return 0 ;;
    esac
  fi
  if run_as_owner "$_r" git merge --ff-only --quiet "$_rem_ref" 2>/dev/null; then
    log_major "$_r: $(c_green 'DONE :))') (fast-forwarded $_behind commit(s))"
    PL_N_FFD=$((PL_N_FFD + 1))
    return 0
  else
    log_error "$_r: ff-merge failed"
    PL_N_ERROR=$((PL_N_ERROR + 1))
    return 1
  fi
}

cmd_pull() {
  _pl_mode=analyze
  PL_FORCE=0
  PL_FETCH_ONLY=0
  _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help pull; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV)          VRB=1; VERYVRB=1 ;;
      -D|--debug)   DBG=1; VRB=1 ;;
      -DD|--deepdbg) DBG=1; DEEPDBG=1; VRB=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      go)           _pl_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _pl_mode=analyze ;;
      -i|--interactive) INTERACTIVE=1 ;;
      -R|--recursive)   RECURSIVE=1 ;;
      --force)          PL_FORCE=1 ;;
      --fetch-only)     PL_FETCH_ONLY=1 ;;
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "pull: unknown option: $1" 64 ;;
      *)            _args="$_args $(shell_escape "$1")" ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"
  if [ "$_pl_mode" = "go" ]; then DRY_RUN=0; else DRY_RUN=1; fi

  _roots=$(resolve_scope "$@") || exit 1
  [ -z "$_roots" ] && { log_error "no repositories to pull"; exit 1; }

  PL_N_TOTAL=0; PL_N_CLEAN=0; PL_N_FFD=0; PL_N_WOULD_FF=0
  PL_N_SKIPPED=0; PL_N_IGNORED=0; PL_N_NOREMOTE=0; PL_N_ERROR=0

  _rc_total=0
  _rtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.roots.XXXXXX")
  trap 'rm -f "$_rtmp"' EXIT INT TERM HUP
  printf '%s\n' "$_roots" > "$_rtmp"
  while IFS= read -r _root; do
    [ -n "$_root" ] || continue
    priv_gate "$_root"
    case "$PRIV_ACTION" in
      skip) continue ;;
      warn) log_major "$_root: [SKIPPED — cross-user policy]"; continue ;;
    esac
    if [ "$RECURSIVE" = 1 ]; then
      # Top-down: parents fetch first (so submodule refs are resolvable).
      # walk_submodules is post-order; reverse for top-down.
      _nodes=$(walk_submodules "$_root" | awk '{a[NR]=$0} END{for(i=NR;i>=1;i--) print a[i]}')
    else
      _nodes=$_root
    fi
    _ntmp=$(mktemp "${TMPDIR:-/tmp}/${US}.nodes.XXXXXX")
    printf '%s\n' "$_nodes" > "$_ntmp"
    _abort_requested=0
    while IFS= read -r _node; do
      [ -n "$_node" ] || continue
      [ "$_abort_requested" = 1 ] && continue
      pull_one "$_node"
      _rc=$?
      case "$_rc" in
        0)  : ;;
        77) _abort_requested=1 ;;
        *)  _rc_total=1 ;;
      esac
    done < "$_ntmp"
    rm -f "$_ntmp"
    if [ "$_abort_requested" = 1 ]; then
      rm -f "$_rtmp"
      log_major "pull: ABORT requested — stopping."
      return 77
    fi
  done < "$_rtmp"
  rm -f "$_rtmp"

  # Summary.
  echo
  if [ "$_pl_mode" = "go" ]; then
    log_major "pull: summary"
    _p=""
    [ "$PL_N_CLEAN" -gt 0 ]    && _p="$_p clean=$PL_N_CLEAN"
    [ "$PL_N_FFD" -gt 0 ]      && _p="$_p fast-forwarded=$PL_N_FFD"
    [ "$PL_N_SKIPPED" -gt 0 ]  && _p="$_p skipped=$PL_N_SKIPPED"
    [ "$PL_N_IGNORED" -gt 0 ]  && _p="$_p ignored=$PL_N_IGNORED"
    [ "$PL_N_NOREMOTE" -gt 0 ] && _p="$_p no-remote=$PL_N_NOREMOTE"
    [ "$PL_N_ERROR" -gt 0 ]    && _p="$_p $(c_red "errors=$PL_N_ERROR")"
    [ -z "$_p" ] && _p=" (nothing to do)"
    printf '  %s>>%s total=%s:%s\n' "$C_BLUE" "$C_RESET" "$PL_N_TOTAL" "$_p"
  else
    log_major "pull: analyze summary"
    _p=""
    [ "$PL_N_CLEAN" -gt 0 ]    && _p="$_p clean=$PL_N_CLEAN"
    [ "$PL_N_WOULD_FF" -gt 0 ] && _p="$_p would-ff=$PL_N_WOULD_FF"
    [ "$PL_N_IGNORED" -gt 0 ]  && _p="$_p ignored=$PL_N_IGNORED"
    [ "$PL_N_NOREMOTE" -gt 0 ] && _p="$_p no-remote=$PL_N_NOREMOTE"
    [ "$PL_N_ERROR" -gt 0 ]    && _p="$_p $(c_red "errors=$PL_N_ERROR")"
    [ -z "$_p" ] && _p=" (nothing to do)"
    printf '  %s>>%s total=%s:%s\n' "$C_BLUE" "$C_RESET" "$PL_N_TOTAL" "$_p"
    printf '  %s>>%s apply:       %s pull go%s\n' "$C_BLUE" "$C_RESET" "$US" \
      "$([ "$RECURSIVE" = 1 ] && echo ' -R')"
    printf '  %s>>%s for details: %s st%s\n' "$C_BLUE" "$C_RESET" "$US" \
      "$([ "$RECURSIVE" = 1 ] && echo ' -R')"
  fi
  return $_rc_total
}

# ═════════════════════════════════════════════════════════════════════════
# ═══ FLATTEN (merge nested git repos into outer as content) ═════════════
# ═════════════════════════════════════════════════════════════════════════
#
# my-git flatten [go|-T] [-i] [--rm-git]
#
# Converts every nested .git under the current super-repo into plain
# content of the super. Default mode keeps each nested .git INTACT
# (briefly moves .git outside the worktree, commits the content, moves
# each .git back); --rm-git irreversibly deletes the nested .git dirs.
# Must run from the repo's toplevel.
cmd_flatten() {
  _fl_mode=analyze
  _fl_interactive=0
  _fl_rmgit=0
  _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help flatten; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV)          VRB=1; VERYVRB=1 ;;
      -D|--debug)   DBG=1; VRB=1 ;;
      -DD|--deepdbg) DBG=1; DEEPDBG=1; VRB=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      go)           _fl_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _fl_mode=analyze ;;
      -i|--interactive) _fl_interactive=1 ;;
      --rm-git)     _fl_rmgit=1 ;;
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "flatten: unknown option: $1" 64 ;;
      *)            fatal "flatten: unexpected argument: $1" 64 ;;
    esac
    shift
  done

  # Use logical toplevel (symlink-preserving). 'git rev-parse
  # --show-toplevel' dereferences symlinks, which confuses the user
  # who typed '/LINKS/src' but would then see '/Users/MINE/...'.
  _fl_top=$(git_toplevel_of "$PWD")
  [ -n "$_fl_top" ] || fatal "flatten: not inside a git repo" 1
  if [ "$(cd "$PWD" 2>/dev/null && pwd -P)" != "$(cd "$_fl_top" 2>/dev/null && pwd -P)" ]; then
    fatal "flatten: must be run from the repo's toplevel: $_fl_top" 1
  fi
  cd "$_fl_top" || fatal "flatten: cannot cd to $_fl_top" 1

  # Nested .git (dirs AND files — submodule-pointer .git files).
  _fl_nested=$(find . -path ./.git -prune -o \( -name .git -a \( -type d -o -type f \) \) -print 2>/dev/null | sed 's|^\./||' | sort)

  # Orphan gitlinks.
  _fl_embedded=$(_sm_safe_git . ls-files -s 2>/dev/null | awk '$1 == "160000" {print}' | cut -f2- | sort)
  _fl_reg=''
  [ -f .gitmodules ] && _fl_reg=$(
    _sm_safe_git . config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
      | sed 's/^[^ ]* //')
  _fl_orphan=$(printf '%s\n' "$_fl_embedded" | while IFS= read -r _p; do
    [ -n "$_p" ] || continue
    if ! printf '%s\n' "$_fl_reg" | grep -Fxq "$_p"; then
      printf '%s\n' "$_p"
    fi
  done)

  _fl_n_nested=$(printf '%s' "$_fl_nested" | grep -c .)
  _fl_n_orphan=$(printf '%s' "$_fl_orphan" | grep -c .)

  if [ "$_fl_n_nested" -eq 0 ] && [ "$_fl_n_orphan" -eq 0 ]; then
    log_major "$_fl_top: nothing to flatten (no nested .git, no orphan gitlinks)"
    exit 0
  fi

  log_major "$_fl_top: flatten plan"
  # Plan details: always visible (not -V-gated) — the user needs to see
  # WHAT would be touched before deciding whether to run 'go'. Git jargon
  # is explained inline so a non-git-expert can follow.
  if [ "$_fl_n_nested" -gt 0 ]; then
    if [ "$_fl_rmgit" = 1 ]; then
      printf '  %s>>%s nested .git dirs to DELETE (%s, irreversible):\n' \
        "$C_BLUE" "$C_RESET" "$_fl_n_nested"
    else
      printf '  %s>>%s folders to add to parent git as content (%s):\n' \
        "$C_BLUE" "$C_RESET" "$_fl_n_nested"
    fi
    printf '%s\n' "$_fl_nested" | while IFS= read -r _n; do
      [ -n "$_n" ] && printf '       %s\n' "$_n"
    done
  fi
  if [ "$_fl_n_orphan" -gt 0 ]; then
    printf '  %s>>%s orphan gitlinks to remove (%s):\n' \
      "$C_BLUE" "$C_RESET" "$_fl_n_orphan"
    printf '%s\n' "$_fl_orphan" | while IFS= read -r _p; do
      [ -n "$_p" ] && printf '       %s\n' "$_p"
    done
  fi

  # analyze mode — print plan and bail. NOTHING is changed until 'go'.
  if [ "$_fl_mode" != "go" ]; then
    echo
    printf '  %s>>%s analyze-only — re-run with '\''go'\'' to apply:\n' "$C_BLUE" "$C_RESET"
    printf '  %s>>%s   default (history preserved):  %s flatten go\n' "$C_BLUE" "$C_RESET" "$US"
    printf '  %s>>%s   irreversible delete:          %s flatten go --rm-git\n' "$C_BLUE" "$C_RESET" "$US"
    exit 0
  fi

  if [ "$_fl_interactive" = 1 ]; then
    _ans=$(_sm_ask "Proceed with flatten? [Y]es / [A]bort [Y/a]: ")
    case "$_ans" in a|A) echo "Aborted."; exit 77 ;; esac
  fi

  # Unstage orphan gitlinks first (safe regardless of .git handling).
  printf '%s\n' "$_fl_orphan" | while IFS= read -r _p; do
    [ -n "$_p" ] || continue
    log_medium "remove   $_p"
    run git rm --cached -rf -- "$_p" >/dev/null 2>&1 || \
      log_warn "git rm --cached failed for $_p"
  done

  if [ "$_fl_rmgit" = 1 ]; then
    # Destructive path: explicit 'yes' confirmation required.
    echo
    printf '%s%s%s\n' "$C_RED$C_BOLD" \
      "!!! --rm-git will PERMANENTLY DELETE the following nested .git dir(s):" "$C_RESET"
    printf '%s\n' "$_fl_nested" | while IFS= read -r _n; do
      [ -n "$_n" ] || continue
      printf '      %s%s/%s%s\n' "$C_YELLOW" "$_fl_top" "$_n" "$C_RESET"
    done
    printf '    Each nested repo'\''s HISTORY WILL BE LOST (unrecoverable unless backed up).\n'
    printf '    Default flatten (without --rm-git) keeps histories; use that if unsure.\n\n'
    if [ ! -r /dev/tty ]; then
      log_error "--rm-git needs interactive confirmation but no TTY is available"
      exit 1
    fi
    printf '%sType exactly '\''yes'\'' to proceed, anything else to abort:%s ' \
      "$C_RED$C_BOLD" "$C_RESET" >/dev/tty
    IFS= read -r _fl_confirm </dev/tty || _fl_confirm=''
    if [ "$_fl_confirm" != "yes" ]; then
      log_major "--rm-git: aborted (expected literal 'yes', got: '$_fl_confirm')"
      exit 1
    fi
    printf '%s\n' "$_fl_nested" | while IFS= read -r _n; do
      [ -n "$_n" ] || continue
      log_medium "delete   $_n"
      run rm -rf -- "$_n" || log_warn "rm failed for $_n"
    done
    log_major "staging & committing flattened content..."
    run git add -A || { log_error "git add -A failed"; exit 1; }
    _fl_msg="my-git flatten --rm-git: $_fl_n_nested nested .git removed, $_fl_n_orphan orphan gitlink(s) unstaged"
    _fl_commit_log=$(mktemp "${TMPDIR:-/tmp}/${US}.flcommit.XXXXXX")
    if run git commit -q -m "$_fl_msg" 2>"$_fl_commit_log"; then
      rm -f "$_fl_commit_log"
      log_major "$_fl_top: $(c_green 'DONE :))') (flattened; nested histories DELETED)"
    else
      log_error "flatten commit failed:"
      cat "$_fl_commit_log" >&2
      rm -f "$_fl_commit_log"
      exit 1
    fi
    exit 0
  fi

  # Preserve-history path: move each nested .git OUTSIDE the outer
  # worktree, commit, then restore.
  _fl_save_root=$(mktemp -d "${TMPDIR:-/tmp}/${US}.flatten.XXXXXX") \
    || { log_error "mktemp failed"; exit 1; }
  _fl_manifest="$_fl_save_root/.manifest"
  : > "$_fl_manifest"
  _fl_restore() {
    [ -s "$_fl_manifest" ] || return 0
    awk '{lines[NR]=$0} END{for(i=NR;i>=1;i--) print lines[i]}' "$_fl_manifest" \
      | while IFS="$(printf '\t')" read -r _orig _saved; do
          [ -e "$_saved" ] || continue
          [ -e "$_orig" ] && rm -rf -- "$_orig" 2>/dev/null
          mv -- "$_saved" "$_orig" 2>/dev/null || \
            log_warn "restore failed: $_saved -> $_orig"
        done
  }
  trap '_fl_restore; rm -rf "$_fl_save_root"; exit 1' INT TERM HUP

  _fl_i=0
  printf '%s\n' "$_fl_nested" | while IFS= read -r _n; do
    [ -n "$_n" ] || continue
    _fl_i=$((_fl_i + 1))
    _fl_save_path="$_fl_save_root/$_fl_i"
    printf '%s\t%s\n' "$_fl_top/$_n" "$_fl_save_path" >> "$_fl_manifest"
    log_medium "move aside $_n  ->  $_fl_save_path"
    run mv -- "$_n" "$_fl_save_path" || {
      log_error "move-out failed for $_n"
      _fl_restore
      rm -rf "$_fl_save_root"
      exit 1
    }
  done

  log_major "staging & committing flattened content..."
  if ! run git add -A; then
    log_error "git add -A failed; restoring .git dirs..."
    _fl_restore
    rm -rf "$_fl_save_root"
    exit 1
  fi
  _fl_msg="my-git flatten: $_fl_n_nested nested repo(s) merged as content, $_fl_n_orphan orphan gitlink(s) unstaged"
  _fl_commit_log=$(mktemp "${TMPDIR:-/tmp}/${US}.flcommit.XXXXXX")
  if ! run git commit -q -m "$_fl_msg" 2>"$_fl_commit_log"; then
    log_error "flatten commit failed:"
    cat "$_fl_commit_log" >&2
    rm -f "$_fl_commit_log"
    _fl_restore
    rm -rf "$_fl_save_root"
    exit 1
  fi
  rm -f "$_fl_commit_log"

  log_major "restoring nested .git dirs..."
  _fl_restore
  rm -rf "$_fl_save_root"
  trap - INT TERM HUP
  log_major "$_fl_top: $(c_green 'DONE :))') (flattened; nested histories preserved)"
}

# ═════════════════════════════════════════════════════════════════════════
# ═══ REMOTE (list / check) ══════════════════════════════════════════════
# ═════════════════════════════════════════════════════════════════════════
#
# my-git remote [--check] [-R] [paths...]
#
# LIST (default): one line per repo: '<path>   <remote> -> <url>'.
#   If the repo has multiple remotes, prints one line each.
#   If it has NO remote: '<path>   (no remotes)' — flagged red.
# CHECK (--check): list + add a ⚠ tag for suspicious urls.
#   Heuristics (all yellow-flagged, none fatal):
#     - relative path (./foo, ../foo)
#     - file:// scheme
#     - plain http:// (should usually be https or ssh)
#     - no origin remote at all (but other remotes exist)

_mg_remote_flag() {
  # Return " ⚠ <reason>" if the url is suspicious, else empty.
  _u=$1
  case "$_u" in
    ./*|../*)  printf ' %s⚠ relative path%s' "$C_YELLOW" "$C_RESET" ;;
    file://*)  printf ' %s⚠ file:// scheme%s' "$C_YELLOW" "$C_RESET" ;;
    http://*)  printf ' %s⚠ plain http%s'     "$C_YELLOW" "$C_RESET" ;;
  esac
}

remote_one() {
  _r=$1
  RM_N_TOTAL=$((RM_N_TOTAL + 1))
  # Honor ignore marker so scoped audits don't spam known-ignored repos.
  _gd_for_marker=$(_sm_resolve_gitdir "$_r/.git" "$_r" 2>/dev/null)
  if [ -n "$_gd_for_marker" ] && [ -e "$_gd_for_marker/$_sm_IGNORE_MARKER" ]; then
    if [ "${RM_FORCE:-0}" -ne 1 ]; then
      [ "$VRB" = 1 ] && log_medium "$_r: [ignored marker — skipping]"
      RM_N_IGNORED=$((RM_N_IGNORED + 1))
      return 0
    fi
  fi
  _remotes=$(run_as_owner_capture "$_r" git remote 2>/dev/null)
  if [ -z "$_remotes" ]; then
    printf ' >>> %-60s %s(no remotes)%s\n' "$_r" "$C_RED" "$C_RESET"
    RM_N_NOREMOTE=$((RM_N_NOREMOTE + 1))
    return 0
  fi
  _has_origin=0
  _sus=0
  printf '%s\n' "$_remotes" | while IFS= read -r _rem; do
    [ -n "$_rem" ] || continue
    _url=$(run_as_owner_capture "$_r" git remote get-url "$_rem" 2>/dev/null)
    _flag=""
    if [ "${RM_CHECK:-0}" = 1 ]; then
      _flag=$(_mg_remote_flag "$_url")
    fi
    printf ' >>> %-60s %-10s -> %s%s\n' "$_r" "$_rem" "$_url" "$_flag"
  done
  # Origin-missing check (only when --check and repo has remotes but no origin).
  if [ "${RM_CHECK:-0}" = 1 ]; then
    if ! printf '%s\n' "$_remotes" | grep -qx 'origin'; then
      printf ' >>> %-60s %s⚠ no '\''origin'\'' remote%s\n' "$_r" "$C_YELLOW" "$C_RESET"
      RM_N_SUS=$((RM_N_SUS + 1))
    fi
    # Count suspicious urls.
    printf '%s\n' "$_remotes" | while IFS= read -r _rem; do
      _url=$(run_as_owner_capture "$_r" git remote get-url "$_rem" 2>/dev/null)
      case "$_url" in ./*|../*|file://*|http://*) echo S ;; esac
    done >> "$_rm_sus_tmp"
  fi
}

cmd_remote() {
  RM_CHECK=0
  RM_FORCE=0
  _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help remote; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV)          VRB=1; VERYVRB=1 ;;
      -D|--debug)   DBG=1; VRB=1 ;;
      -DD|--deepdbg) DBG=1; DEEPDBG=1; VRB=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      --check)      RM_CHECK=1 ;;
      -R|--recursive) RECURSIVE=1 ;;
      --force)      RM_FORCE=1 ;;
      list)         : ;;      # optional explicit 'list' subword
      check)        RM_CHECK=1 ;;  # alias for --check
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "remote: unknown option: $1" 64 ;;
      *)            _args="$_args $(shell_escape "$1")" ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"

  _roots=$(resolve_scope "$@") || exit 1
  [ -z "$_roots" ] && { log_error "no repositories to inspect"; exit 1; }

  RM_N_TOTAL=0; RM_N_NOREMOTE=0; RM_N_IGNORED=0; RM_N_SUS=0
  _rm_sus_tmp=$(mktemp "${TMPDIR:-/tmp}/${US}.rmsus.XXXXXX")
  _rtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.rmroots.XXXXXX")
  trap 'rm -f "$_rm_sus_tmp" "$_rtmp"' EXIT INT TERM HUP
  printf '%s\n' "$_roots" > "$_rtmp"

  while IFS= read -r _rm_root; do
    [ -n "$_rm_root" ] || continue
    priv_gate "$_rm_root"
    case "$PRIV_ACTION" in
      skip) continue ;;
      warn) log_major "$_rm_root: [SKIPPED — cross-user policy]"; continue ;;
    esac
    if [ "$RECURSIVE" = 1 ]; then
      _nodes=$(walk_submodules "$_rm_root" | awk '{a[NR]=$0} END{for(i=NR;i>=1;i--) print a[i]}')
    else
      _nodes=$_rm_root
    fi
    _ntmp=$(mktemp "${TMPDIR:-/tmp}/${US}.rmnodes.XXXXXX")
    printf '%s\n' "$_nodes" > "$_ntmp"
    while IFS= read -r _rm_node; do
      [ -n "$_rm_node" ] || continue
      remote_one "$_rm_node"
    done < "$_ntmp"
    rm -f "$_ntmp"
  done < "$_rtmp"
  rm -f "$_rtmp"

  # Count suspicious from file.
  if [ -s "$_rm_sus_tmp" ]; then
    RM_N_SUS=$((RM_N_SUS + $(grep -c '^S$' "$_rm_sus_tmp" 2>/dev/null | head -1)))
  fi
  rm -f "$_rm_sus_tmp"

  # Summary.
  echo
  log_major "remote: summary"
  _p=""
  _p="$_p total=$RM_N_TOTAL"
  [ "$RM_N_NOREMOTE" -gt 0 ] && _p="$_p $(c_red "no-remote=$RM_N_NOREMOTE")"
  [ "$RM_N_IGNORED" -gt 0 ]  && _p="$_p ignored=$RM_N_IGNORED"
  [ "$RM_CHECK" = 1 ] && [ "$RM_N_SUS" -gt 0 ] && _p="$_p $(c_yellow "suspicious=$RM_N_SUS")"
  printf '  %s>>%s %s\n' "$C_BLUE" "$C_RESET" "$_p"
  [ "$RM_CHECK" = 0 ] && printf '  %s>>%s run with --check to flag suspicious urls\n' "$C_BLUE" "$C_RESET"
}

# ═════════════════════════════════════════════════════════════════════════
# ═══ SYNC ════════════════════════════════════════════════════════════════
# ═════════════════════════════════════════════════════════════════════════
#
# my-git sync [go] [-R|-i|--force] [paths...]
#
# Composite "settle the tree" pipeline: sm → pull → mc.
#   Phase 1: sm     — register new nested repos, rebind moved ones,
#                     clean stale .gitmodules entries, .claude fixes.
#   Phase 2: pull   — fetch + fast-forward.
#   Phase 3: mc     — commit (auto + user-dirt) + push where allowed.
# Same flags apply uniformly to all three phases. Analyze by default.
cmd_sync() {
  _sy_mode=analyze
  _sy_rec=0; _sy_int=0; _sy_force=0
  _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help sync; exit 0 ;;
      go)           _sy_mode=go ;;
      -n|-T|--try|--dry|--dry-run) _sy_mode=analyze ;;
      -R|--recursive)   _sy_rec=1 ;;
      -i|--interactive) _sy_int=1 ;;
      --force)          _sy_force=1 ;;
      -V|--verbose) VRB=1 ;;
      -VV)          VRB=1; VERYVRB=1 ;;
      -D|--debug)   DBG=1; VRB=1 ;;
      -DD|--deepdbg) DBG=1; DEEPDBG=1; VRB=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "sync: unknown option: $1" 64 ;;
      *)            _args="$_args $(shell_escape "$1")" ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"

  _phase_flags=""
  [ "$_sy_mode" = "go" ]  && _phase_flags="$_phase_flags go"
  [ "$_sy_rec" = 1 ]      && _phase_flags="$_phase_flags -R"
  [ "$_sy_int" = 1 ]      && _phase_flags="$_phase_flags -i"
  [ "$_sy_force" = 1 ]    && _phase_flags="$_phase_flags --force"

  # Resolve the scope once; sm doesn't accept path args, so we cd into
  # each resolved root and run sm + pull + mc from there.
  _roots=$(resolve_scope "$@") || exit 1
  [ -z "$_roots" ] && { log_error "sync: no repositories to process"; exit 1; }
  _rtmp=$(mktemp "${TMPDIR:-/tmp}/${US}.sync.roots.XXXXXX")
  printf '%s\n' "$_roots" > "$_rtmp"

  _worst=0
  # NOTE: use a distinct loop variable name. cmd_pull / cmd_masscommits
  # internally use their own 'while read _root' loops which would clobber
  # an outer '_root' mid-iteration.
  while IFS= read -r _sy_root; do
    [ -n "$_sy_root" ] || continue
    echo
    log_major "sync: ── $_sy_root ──"

    echo
    log_major "sync: phase 1/3 — sm (register / rebind / stale cleanup / .claude)"
    echo
    # sm operates on CWD, so cd in; subshell to keep outer $PWD untouched.
    # shellcheck disable=SC2086
    ( cd "$_sy_root" && cmd_submodules $_phase_flags )
    _rc1=$?
    [ "$_rc1" = 77 ] && { rm -f "$_rtmp"; log_major "sync: aborted in sm phase."; return 77; }

    echo
    log_major "sync: phase 2/3 — pull (fetch + fast-forward)"
    echo
    # shellcheck disable=SC2086
    cmd_pull $_phase_flags "$_sy_root"
    _rc2=$?
    [ "$_rc2" = 77 ] && { rm -f "$_rtmp"; log_major "sync: aborted in pull phase."; return 77; }

    echo
    log_major "sync: phase 3/3 — mc (commit + push)"
    echo
    # shellcheck disable=SC2086
    cmd_masscommits $_phase_flags "$_sy_root"
    _rc3=$?
    [ "$_rc3" = 77 ] && { rm -f "$_rtmp"; log_major "sync: aborted in mc phase."; return 77; }

    for _rcx in "$_rc1" "$_rc2" "$_rc3"; do
      [ "$_rcx" -gt "$_worst" ] && _worst=$_rcx
    done
  done < "$_rtmp"
  rm -f "$_rtmp"

  echo
  log_major "sync: all phases complete"
  return $_worst
}

# ─── .claude setup enforcement ──────────────────────────────────────────
# Compute where in the central repo a project's .claude should live.
claude_dest_for() {
  _r=$1
  # Match against known GIT_REPOS roots; keep relpath under that root.
  for _base in $GIT_REPOS; do
    case "$_r/" in
      "$_base"/*)
        _rel=${_r#"$_base"/}
        [ "$_r" = "$_base" ] && { printf '%s/%s\n' "$CLAUDE_PROJECT_DIR_CENTRAL_REPO" "${_base##*/}"; return; }
        printf '%s/%s\n' "$CLAUDE_PROJECT_DIR_CENTRAL_REPO" "$_rel"
        return
        ;;
    esac
  done
  # Fallback — use the basename under misc/. User gets a warning.
  printf '%s/misc/%s\n' "$CLAUDE_PROJECT_DIR_CENTRAL_REPO" "${_r##*/}"
}

# _mc_record_change <abs-path>
# Append <abs-path> to MC_COMMIT_PATHS if not already there. Mirror of
# _sm_record_change. Used by mc helpers that mutate tracked files so
# the end-of-node auto-commit can include exactly those paths (and
# NOTHING the user edited) in a 'git commit --only' call.
_mc_record_change() {
  _rc_p=$1
  [ -n "$_rc_p" ] || return 0
  case "$_rc_p" in ./*) _rc_p=${_rc_p#./} ;; esac
  case "
${MC_COMMIT_PATHS}
" in
    *"
${_rc_p}
"*) return 0 ;;
  esac
  MC_COMMIT_PATHS="${MC_COMMIT_PATHS}${_rc_p}
"
}

# Ensure '.claude/' appears in <repo>/.gitignore (safe, idempotent).
# Return 0 on success, 1 on failure.
ensure_claude_gitignore() {
  _r=$1
  _gi=$_r/.gitignore
  if [ -f "$_gi" ]; then
    if grep -Eq '^/?\.claude/?$' "$_gi" 2>/dev/null; then
      log_dbg_med ".gitignore already lists .claude/: $_gi"
      return 0
    fi
  fi
  if [ "$DRY_RUN" = 1 ]; then
    log_major ".claude/ missing from $_gi — DRY: would append"
    return 0
  fi
  log_major ".claude/ added to $_gi"
  # Preserve trailing newline; if file exists without final newline, fix that.
  if [ -f "$_gi" ] && [ -s "$_gi" ]; then
    _last=$(tail -c1 "$_gi" 2>/dev/null)
    if [ "$_last" != "" ] && [ "$_last" != "
" ]; then
      printf '\n' >> "$_gi" 2>/dev/null \
        || { sudo -n true 2>/dev/null || sudo true; echo "" | sudo tee -a "$_gi" >/dev/null; }
    fi
  fi
  if ! printf '.claude/\n' >> "$_gi" 2>/dev/null; then
    printf '.claude/\n' | sudo tee -a "$_gi" >/dev/null || return 1
  fi
  # Record the .gitignore path so commit_one phase-1 auto-commit picks it up.
  _mc_record_change "$_gi"
  return 0
}

# Classify and (when safe) auto-migrate <repo>/.claude.
# Return 0 on clean/fixed; 1 on unfixable problem (caller should fail).
ensure_claude_setup() {
  _r=$1

  # Skip if this IS (or is inside) the central repo itself.
  case "$_r/" in
    "$CLAUDE_PROJECT_DIR_CENTRAL_REPO"/*|"$CLAUDE_PROJECT_DIR_CENTRAL_REPO"*/)
      log_dbg_med "claude-check: $_r is inside central repo — skipping"
      return 0 ;;
  esac

  # Always ensure .gitignore entry.
  ensure_claude_gitignore "$_r" || { log_error "$_r: could not update .gitignore"; return 1; }

  _cl=$_r/.claude
  if [ -L "$_cl" ]; then
    _tgt=$(readlink "$_cl")
    # Resolve target to real absolute path (follows symlinks + resolves '..').
    _tgt_real=$( cd -P -- "$_cl" 2>/dev/null && pwd -P ) || _tgt_real=
    [ -z "$_tgt_real" ] && {
      case "$_tgt" in /*) _tgt_real=$_tgt ;; *) _tgt_real=$_r/$_tgt ;; esac
    }
    # Also resolve the central repo (it may itself contain symlinks like /LINKS).
    _ctr_real=$( cd -P -- "$CLAUDE_PROJECT_DIR_CENTRAL_REPO" 2>/dev/null && pwd -P ) \
      || _ctr_real=$CLAUDE_PROJECT_DIR_CENTRAL_REPO
    case "$_tgt_real" in
      "$_ctr_real"/*|"$_ctr_real")
        log_medium "$_r/.claude -> $_tgt (in central repo)"
        return 0
        ;;
      *)
        log_major "$_r/.claude points OUTSIDE central repo: $_tgt"
        log_medium "  resolved: $_tgt_real"
        log_medium "  central:  $_ctr_real"
        log_medium "not auto-correcting (user intent unclear)"
        return 0
        ;;
    esac
  fi

  if [ ! -e "$_cl" ]; then
    # Nothing there — fine.
    return 0
  fi

  if [ ! -d "$_cl" ]; then
    log_error "$_r/.claude exists but is not a symlink or directory"
    return 1
  fi

  # Real directory — auto-migrate.
  _dest=$(claude_dest_for "$_r")
  log_major "$_r/.claude is a real directory — migrating to central repo"
  log_medium "destination: $_dest"

  # Refuse if destination exists and is non-empty.
  if [ -e "$_dest" ]; then
    if [ -n "$(ls -A "$_dest" 2>/dev/null)" ]; then
      log_error "destination already exists and is non-empty: $_dest"
      log_medium "resolve manually, then re-run  (see: my-git --help claude-check)"
      return 1
    fi
  fi

  # Refuse if settings.json is present — rule classification needs human judgement.
  if [ -f "$_cl/settings.json" ]; then
    log_error "$_r/.claude/settings.json present — manual migration required"
    log_medium "per CLAUDE.md: split narrow/blanket/one-off rules by hand."
    log_medium "skipping this project; nothing moved."
    return 1
  fi

  if [ "$DRY_RUN" = 1 ]; then
    log_medium "DRY: would mkdir $_dest, move files, rmdir $_cl, symlink"
    return 0
  fi

  if [ "$INTERACTIVE" = 1 ]; then
    printf '    proceed with migration? [y/N]: ' >&2
    read -r _ans </dev/tty || _ans=n
    case "$_ans" in y|Y|yes) : ;; *) log_medium "skipped by user"; return 1 ;; esac
  fi

  mkdir -p "$_dest" || { log_error "mkdir failed: $_dest"; return 1; }
  # Move everything except settings.json (which we refused above).
  _moved=0
  for _f in "$_cl"/* "$_cl"/.[!.]* "$_cl"/..?*; do
    [ -e "$_f" ] || continue
    mv -- "$_f" "$_dest/" || { log_error "mv failed: $_f"; return 1; }
    _moved=$((_moved + 1))
  done
  log_medium "moved $_moved item(s)"

  rmdir "$_cl" || { log_error "rmdir $_cl failed (not empty?)"; return 1; }

  # Relative symlink.
  _rel=$(python3 -c "import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))" "$_dest" "$_r" 2>/dev/null)
  if [ -z "$_rel" ]; then
    _rel=$_dest
    log_medium "(absolute link; python3 unavailable for relative calc)"
  fi
  ln -s "$_rel" "$_cl" || { log_error "ln -s failed"; return 1; }
  log_major "$_r/.claude -> $_rel  (migration complete)"
  # Record the migrated .claude symlink so commit_one phase-1 auto-commit
  # picks it up (it's a tracked file change caused by my-git, not user).
  _mc_record_change "$_cl"
  return 0
}

cmd_claude_check() {
  _args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) show_help claude-check; exit 0 ;;
      -V|--verbose) VRB=1 ;;
      -VV)          VRB=1; VERYVRB=1 ;;
      -D|--debug)   DBG=1; VRB=1 ;;
      -DD|--deepdbg) DBG=1; DEEPDBG=1; VRB=1; VERYVRB=1; set -x; PS4='+ [${LINENO}] ' ;;
      -n|-T|--try|--dry|--dry-run) DRY_RUN=1 ;;
      -i|--interactive) INTERACTIVE=1 ;;
      -R|--recursive) RECURSIVE=1 ;;
      --)           shift; _args="$_args $(shell_escape "$@")"; break ;;
      -*)           fatal "claude-check: unknown option: $1" 64 ;;
      *)            _args="$_args $(shell_escape "$1")" ;;
    esac
    shift
  done
  # shellcheck disable=SC2086
  eval "set -- $_args"

  # Audit-only: force DRY_RUN by default. To actually apply, masscommits does it.
  # claude-check is READ-ONLY unless user passes -i or explicit --apply.
  _applied=0
  for _a in "$@"; do
    case "$_a" in --apply) _applied=1 ;; esac
  done
  [ "$_applied" = 1 ] || DRY_RUN=1

  _roots=$(resolve_scope "$@") || exit 1
  [ -z "$_roots" ] && { log_error "no repositories to audit"; exit 1; }

  printf '%s\n' "$_roots" | while IFS= read -r _root; do
    [ -n "$_root" ] || continue
    _nodes=$(walk_submodules "$_root")
    # Top-down reading order.
    printf '%s\n' "$_nodes" | awk '{a[NR]=$0} END{for(i=NR;i>=1;i--) print a[i]}' \
      | while IFS= read -r _node; do
          [ -n "$_node" ] || continue
          ensure_claude_setup "$_node" || true
        done
  done
}

# ─── Help pages ─────────────────────────────────────────────────────────
show_help_top() {
  cat <<EOF
usage: $US [global-opts] <subcommand> [sub-opts] [paths...]

Purpose: manage a multitude of git repos — plus nested git trees and
repos that use submodules — easily, from a single command. 'st' gives a
recursive OVERVIEW of every repo in sight. 'sm' and 'mc' act on ONE
level at a time by default (git's native scope), and recurse through the
submodule tree only when you pass -R/--recursive.

Subcommands:
  status | st | s          List status of repo(s) + submodules (always recursive — overview)
  masscommits | mc | c     Analyze (default) / add + commit + push with 'go'
                           (single level; -R = full bottom-up walk)
  pull | pl                Fetch + fast-forward merge (analyze / 'go'; -R top-down)
  fetch                    Fetch only (alias: pull --fetch-only)
  submodules | sub | sm    Nested-repo registration (single level; -R = full top-down walk)
  flatten | fl             Merge nested repos into outer as content (history preserved by default)
  sync | syn               Composite: sm → pull → mc (settle the tree in one shot)
  remote | rem             List / audit git remotes across the tree (--check for warnings)
  claude-check             Audit .claude/ setup (read-only by default)
  help                     Show this help

Global options:
  -V, --verbose            Verbosity level 1
  -VV                      Verbosity level 2
  -D, --debug              Debug level 1  (implies -V)
  -DD, --deepdbg           Debug level 2  (implies -VV; enables set -x)
  -R, --recursive          Force-recurse. For 'mc'/'sm': walk the full
                           submodule tree. For 'st': force discovery of
                           unregistered nested repos in a FOREIGN scope
                           (one outside GIT_REPOS) — managed scopes
                           recurse by default, -R is a no-op there.
  --config <FILE>          Use specific config file
  --create-config          Write default config to first writable location
  -h, --help [TOPIC]       Show help (topic = subcommand or option)

Scope (st / mc / claude-check):
  explicit paths           operate on each given repo
  none + inside git repo   operate on that repo (CWD-aware)
  none + outside any repo  fallback to \$GIT_REPOS from config

Recursion (mc / sm):
  default                  ONE level only — git itself only cares about the
                           current repo's own gitlinks. A changed submodule
                           HEAD is picked up as a gitlink bump, but the
                           submodule's own working tree is NOT touched.
