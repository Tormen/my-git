    # embedded-content candidate list, but orphan-gitlink discovery
    # never checked the marker at all — so flatten would unstage it
    # anyway (a default, unconditional cleanup for TRULY stale
    # gitlinks), completely ignoring "leave this alone". "Ignored"
    # must mean fully hands-off, gitlink status included: the SHA
    # recorded for this path must be byte-for-byte identical before
    # and after, and the working tree must end up perfectly clean —
    # no phantom deletion, no untracked directory left behind.
    _rt_repo_file myotr-o x.txt
    mkdir -p src-o && ( cd src-o && git init -q && git config user.email t@t.com && git config user.name t \
      && git commit -q -m init --allow-empty \
      && git submodule add -q ../myotr-o myotr >/dev/null 2>&1 && git commit -q -m add )
    _rt_repo global
    ( cd global && git clone -q ../src-o src && git -C src submodule update --init --recursive -q
      _sha=$(git -C src rev-parse HEAD)
      git update-index --add --cacheinfo 160000,"$_sha",src
      git commit -q -m addsrc )
    cd global || return 1
    _rt_sha_before=$(git ls-files -s src | awk '{print $2}')
    [ -n "$_rt_sha_before" ] || { _rt_fail "test setup: could not read src's initial gitlink sha"; return 1; }
    touch src/.git/my-git.ignore
    _rt_conf_path="$PWD/conf.ini"; _rt_conf_auto_emb "$_rt_conf_path"
    _rt_ok "flatten go: src is orphan + ignored + still live" _rt_my_git flatten go || return 1
    _rt_not_contains "plan must not list src as an orphan to remove" "$_rt_out" "Orphan gitlinks to remove" || return 1
    _rt_sha_after=$(git ls-files -s src | awk '{print $2}')
    if [ "$_rt_sha_before" != "$_rt_sha_after" ]; then
      _rt_fail "src's gitlink sha changed (before=$_rt_sha_before after=$_rt_sha_after) — ignored must mean byte-for-byte untouched"
      return 1
    fi
    _rt_src_status=$(git status --porcelain -- src 2>/dev/null)
    if [ -n "$_rt_src_status" ]; then
      _rt_fail "src shows unexpected status changes: $(printf '%s' "$_rt_src_status" | tr '\n' '|')"
      return 1
    fi
    return 0
  }

  test_flatten_realize_genuinely_lost_history_not_a_bug() {
    # A gitfile pointer can fail to resolve even after the
    # GIT_SIDECAR_DIRNAME fallback for a completely different, entirely
    # legitimate reason: the underlying git history may have been
    # permanently deleted at some EARLIER point (e.g. by an
    # 'sm --clean-stale' run, long before the enclosing repo was ever
    # realized) — not misplaced, genuinely gone. This must not be
    # confused with the "enclosing repo was realized" case (which the
    # fallback DOES recover from). AUTO_SIDECAR_EMBEDDED must detect
    # this in advance and skip the doomed realize attempt entirely —
    # flattening the item as plain content instead of leaving it
    # untouched — and must not take down any OTHER, perfectly valid
    # item in the same batch.
    _rt_repo_file good-o x.txt
    mkdir -p src-o && ( cd src-o && git init -q && git config user.email t@t.com && git config user.name t \
      && git commit -q -m init --allow-empty \
      && git submodule add -q ../good-o good-child >/dev/null 2>&1 && git commit -q -m add )
    _rt_repo global
    ( cd global && git clone -q ../src-o src && git -C src submodule update --init --recursive -q
      _sha=$(git -C src rev-parse HEAD)
      git update-index --add --cacheinfo 160000,"$_sha",src
      git commit -q -m addsrc )
    cd global || return 1
    # Simulate a submodule whose absorbed history was already
    # permanently deleted earlier (e.g. by 'sm --clean-stale'): a
    # gitfile pointer whose target has never existed at all, at
    # either the '.git' or '.git.real' location.
    mkdir -p src/broken-child
    printf 'gitdir: ../../.git/modules/broken-child\n' > src/broken-child/.git
    echo content > src/broken-child/x.txt
    _rt_conf_path="$PWD/conf.ini"; _rt_conf_auto_emb "$_rt_conf_path"
    _rt_ok "flatten go: known-dead item handled gracefully" _rt_my_git flatten go || return 1
    _rt_contains "clear WARNING (not ERROR) shown, doomed attempt skipped entirely" "$_rt_err" "history already gone" || return 1
    _rt_not_contains "no scary crash/error, since the attempt is skipped up front" "$_rt_err" "does not resolve to an existing directory" || return 1
    _rt_isdir "the OTHER, valid item still succeeded" src/good-child/.git.real || return 1
    _rt_gitlink_mode "broken-child's content flattened as plain tracked files, not left untouched" "src/broken-child/x.txt" 100644 || return 1
    return 0
  }

