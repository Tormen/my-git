  test_st_reheals_nested_shadow_excludes_and_keeps_user_lines() {
    # The excludes are LOCAL (.git/info/exclude) and never cloned, so a
    # fresh clone starts with none and the nesting noise returns. They are
    # derived state -- computable from the markers, idempotent, and unable
    # to reach a commit or a remote -- so 'st' re-derives them. The managed
    # block makes that safe: hand-written lines are never touched, and a
    # path that stops being shadowed drops out instead of lingering.
    _rt_repo_file inner_o a.md
    _rt_repo top
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    cd top || return 1
    mkdir -p mid && ( cd mid && git init -q . && git config user.email t@t.com \
        && git config user.name t && echo m > m.txt && git add -A && git commit -q -m m )
    git clone -q ../inner_o 'mid/,archive/nested' >/dev/null 2>&1
    _rt_ok "shadow the nested repo" _rt_my_git shadow go 'mid/,archive/nested' || return 1

    # A fresh clone has no local excludes at all.
    rm -f mid/.git/info/exclude
    [ -n "$(git -C mid status --porcelain)" ] \
      || { _rt_fail "setup: mid should report the nested dir again"; return 1; }
    _rt_ok "plain st re-derives them" _rt_my_git st || return 1
    [ -z "$(git -C mid status --porcelain)" ] \
      || { _rt_fail "st did not re-heal the exclude"; return 1; }

    # Hand-written lines must survive a re-derive untouched...
    printf '%s\n' '# my own line' 'build/' >> mid/.git/info/exclude
    _rt_ok "st again" _rt_my_git st || return 1
    _rt_contains "user comment kept" mid/.git/info/exclude "# my own line" || return 1
    _rt_contains "user pattern kept" mid/.git/info/exclude "build/" || return 1

    # ...and the block must RETIRE when the shadow goes away.
    _rt_ok "unshadow" _rt_my_git unshadow go 'mid/,archive/nested' || return 1
    _rt_ok "st after unshadow" _rt_my_git st || return 1
    grep -qF ',archive/nested/' mid/.git/info/exclude 2>/dev/null \
      && { _rt_fail "the managed entry outlived the shadow"; return 1; }
    _rt_contains "user lines STILL kept after retirement" mid/.git/info/exclude "# my own line" || return 1
    return 0
  }

