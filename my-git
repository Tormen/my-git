# ═══════════════════════════════════════════════════════════════════════
# Self-test suite ('my-git --run-tests')
# ═══════════════════════════════════════════════════════════════════════
#
# Builds REAL git repositories in a fresh temp directory and runs the
# actual my-git binary against them — not mocks — covering concrete
# regressions found and fixed while hardening this script. Every test
# is fully isolated (own temp repo tree + own throwaway config file)
# and cleaned up afterward. Exits 0 if every test passes, 1 otherwise
# (non-zero on ANY failure — safe to wire into a pre-deploy check).
# Touches NONE of the user's own config, repos, GIT_REPOS, or global
# git settings — GIT_ALLOW_PROTOCOL is scoped to this process's own
# environment only, to allow the local-path 'git clone'/'submodule
# add' calls the tests make without needing that enabled system-wide.
#
# Scope note: this exercises every NON-interactive code path — which
# is the vast majority of what was actually found broken: discovery
# correctness, apply-time robustness, sm's add/untrack logic,
# realize's layout handling and ordering. The interactive ('-i')
# prompt UI itself reads from /dev/tty by design and isn't exercised
# here — that needs a real terminal or a pty harness, which this
# self-contained suite deliberately doesn't depend on (no python/expect
# requirement). Spot-check '-i' behavior by hand after any change to
# _fl_interactive_collect/_fl_interactive_apply.
cmd_run_tests() {
  # Every test spawns THIS script as a real subprocess for its actual
  # subcommand calls (flatten go, status, ...) — those subprocesses go
  # through the normal main()/load_config() path and would otherwise
  # trigger install_zsh_completions() against the REAL $HOME, breaking
  # --run-tests' own "touches nothing of yours" promise even though the
  # top-level --run-tests entry point itself never reaches that call
  # (it exits before load_config). Exported so every subprocess spawned
  # below inherits it without threading it through each call site.
  MY_GIT_SELFTEST=1
  export MY_GIT_SELFTEST

  # $1 (optional): substring filter — only test NAMES containing it run.
  # Lets a single test or a whole functional area (e.g. 'unflatten',
  # 'merge', 'sidecar') run fast during iteration, instead of the full
  # suite every time. Empty/absent = run everything (default).
  _rt_filter=${1:-}
  _rt_pass=0
  _rt_fail=0
  _rt_failed_names=""

  # Resolve an absolute, re-invokable path to THIS running script —
  # tests need to invoke the real my-git as a subprocess (its own
  # config/arg parsing, its own dispatch), not call internal functions
  # directly. $0 alone may be relative or PATH-resolved.
  case "$0" in
    */*) _rt_self=$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)/$(basename "$0") ;;
    *)   _rt_self=$(command -v "$0" 2>/dev/null) ;;
  esac
  [ -n "$_rt_self" ] && [ -x "$_rt_self" ] || { log_error "--run-tests: could not resolve an executable path to myself (\$0='$0')"; return 1; }

  _rt_workdir=$(mktemp -d "${TMPDIR:-/tmp}/${US}.selftest.XXXXXX") || { log_error "--run-tests: mktemp -d failed"; return 1; }
  log_major "my-git --run-tests: running in $_rt_workdir"
  log_major "(builds real git repos in temp dirs; touches nothing of yours; safe to run anywhere)"

  GIT_ALLOW_PROTOCOL="file:git:https:ssh:http"
  export GIT_ALLOW_PROTOCOL

  _rt_conf() {
    cat > "$1" <<'_RT_CONF_EOF'
GIT_REPOS=""
CHECK_CLAUDE_SETUP=0
CLAUDE_PROJECT_DIR_CENTRAL_REPO=""
COMMIT_MSG_LAST_N=3
COMMIT_MSG_DIFF_MAX_FILES=10
MC_AUTO_COMMIT_UNTRACKED=1
ST_EXCLUDE_DIRS=""
PRIV_POLICY_USER_TO_ROOT=warn
PRIV_POLICY_USER_TO_USER=fail
DEFAULT_VERBOSE=0
DEFAULT_DEBUG=0
SM_AUTO_SAFE_DIRECTORY=1
SM_SSH_CONNECT_TIMEOUT=5
GIT_SIDECAR_DIRNAME=.git.real
AUTO_SIDECAR_SUBMODULES=0
AUTO_SIDECAR_EMBEDDED=0
_RT_CONF_EOF
  }
  _rt_conf_auto_sub() { _rt_conf "$1"; printf 'AUTO_SIDECAR_SUBMODULES=1\n' >> "$1"; }
  _rt_conf_auto_emb() { _rt_conf "$1"; printf 'AUTO_SIDECAR_EMBEDDED=1\n' >> "$1"; }

  _rt_my_git() { "$_rt_self" --config "$_rt_conf_path" "$@"; }

  _rt_fail() {
    printf '%s' "$1" > "$_rt_reason_file"
    return 1
  }
  _rt_ok() {
    _d=$1; shift
    if ! "$@" >"$_rt_out" 2>"$_rt_err"; then
      _rt_fail "$_d (exit $?): $(tail -c 300 "$_rt_err" 2>/dev/null | tr '\n' ' ')"
      return 1
    fi
    return 0
  }
  _rt_exists()      { [ -e "$2" ]  || { _rt_fail "$1: '$2' should exist"; return 1; }; return 0; }
  _rt_absent()      { [ ! -e "$2" ] || { _rt_fail "$1: '$2' should NOT exist"; return 1; }; return 0; }
  _rt_isdir()       { [ -d "$2" ]  || { _rt_fail "$1: '$2' should be a directory"; return 1; }; return 0; }
  # -e is REQUIRED, not cosmetic: without it a needle that starts with
  # '-' (e.g. a '--- section ---' snapshot header) is parsed by grep as
  # an option and the match silently errors out — a real gotcha that
  # produced a false test failure during review.
  _rt_contains()    { grep -qF -e "$3" "$2" 2>/dev/null || { _rt_fail "$1: '$2' should contain '$3'"; return 1; }; return 0; }
  _rt_not_contains(){ if grep -qF -e "$3" "$2" 2>/dev/null; then _rt_fail "$1: '$2' should NOT contain '$3'"; return 1; fi; return 0; }
  _rt_clean() {
    _rt_s=$(git status --porcelain 2>/dev/null)
    [ -z "$_rt_s" ] || { _rt_fail "$1: expected clean git status, got: $(printf '%s' "$_rt_s" | tr '\n' '|')"; return 1; }
    return 0
  }
  _rt_gitlink_mode() {
    _rt_m=$(git ls-files -s -- "$2" 2>/dev/null | awk '{print $1}' | head -1)
    [ "$_rt_m" = "$3" ] || { _rt_fail "$1: expected mode $3 for '$2', got '$_rt_m'"; return 1; }
    return 0
  }
  _rt_repo() {
    mkdir -p "$1" && ( cd "$1" && git init -q && git config user.email t@t.com && git config user.name t && git commit -q -m init --allow-empty )
  }
  _rt_repo_file() {
    mkdir -p "$1" && ( cd "$1" && git init -q && git config user.email t@t.com && git config user.name t && echo x > "$2" && git add . && git commit -q -m init )
  }

  test_st_comma_naming_pruning() {
    # ',' (0x2C) sorts before '.' (0x2E) in ASCII — a naive
    # lexicographic "shallow boundary suppresses its own deeper
    # matches" dedup breaks for comma-prefixed children. In st's tree
    # (list_unregistered_nested), a comma-named child of an
    # unregistered embedded repo must nest correctly UNDER its parent,
    # not leak out as a separate top-level entry.
    _rt_repo_file gc x.txt
    mkdir -p src-o && ( cd src-o && git init -q && git config user.email t@t.com && git config user.name t \
      && git commit -q -m init --allow-empty && mkdir -p ,gh \
      && git submodule add -q ../gc ,gh/child >/dev/null 2>&1 && git commit -q -m add )
    _rt_repo global
    ( cd global && git clone -q ../src-o src && git -C src submodule update --init --recursive -q
      _sha=$(git -C src rev-parse HEAD)
      git update-index --add --cacheinfo 160000,"$_sha",src
      git commit -q -m addsrc )
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    cd global || return 1
    _rt_ok "st -R runs" _rt_my_git -R st || return 1
    _rt_contains "src shown as top-level unregistered" "$_rt_out" "src" || return 1
    _rt_contains "child shown nested under src (not top-level)" "$_rt_out" ",gh/child" || return 1
    return 0
  }

  test_flatten_nested_submodule_both_visible() {
    _rt_repo_file myotr x.txt
    mkdir -p src-o && ( cd src-o && git init -q && git config user.email t@t.com && git config user.name t \
      && git commit -q -m init --allow-empty && mkdir -p a/b \
      && git submodule add -q ../myotr a/b/myotr >/dev/null 2>&1 && git commit -q -m add )
    _rt_repo global
    ( cd global && git clone -q ../src-o src && git -C src submodule update --init --recursive -q
      _sha=$(git -C src rev-parse HEAD)
      git update-index --add --cacheinfo 160000,"$_sha",src
      git commit -q -m addsrc )
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    cd global || return 1
    _rt_ok "flatten plan runs" _rt_my_git flatten || return 1
    _rt_contains "src listed" "$_rt_out" "src/.git" || return 1
    _rt_contains "myotr ALSO listed separately" "$_rt_out" "src/a/b/myotr/.git" || return 1
    return 0
  }

  test_flatten_realize_old_style_submodule() {
    _rt_repo_file sub-o x.txt
    _rt_repo parent
    ( cd parent && git submodule add -q ../sub-o oldsub >/dev/null 2>&1 && git commit -q -m add
      _gd=$(git rev-parse --absolute-git-dir)
      rm oldsub/.git
      mv "$_gd/modules/oldsub" oldsub/.git
      git config --file oldsub/.git/config core.worktree "$(pwd)/oldsub" )
    _rt_conf_path="$PWD/conf.ini"; _rt_conf_auto_sub "$_rt_conf_path"
    cd parent || return 1
    _rt_ok "flatten go realizes old-style submodule" _rt_my_git flatten go || return 1
    _rt_clean "clean after" || return 1
    _rt_isdir "oldsub/.git.real is a real dir" oldsub/.git.real || return 1
    _rt_gitlink_mode "oldsub content is plain, not a gitlink" oldsub/x.txt 100644 || return 1
    return 0
  }

  test_flatten_realize_ambiguous_dual_git_refuses() {
    _rt_repo_file sub-o x.txt
    _rt_repo parent
    ( cd parent && git submodule add -q ../sub-o src >/dev/null 2>&1 && git commit -q -m add
      _gd=$(git rev-parse --absolute-git-dir)
      rm src/.git
      cp -r "$_gd/modules/src" src/.git
      git config --file src/.git/config core.worktree "$(pwd)/src" )
    _rt_conf_path="$PWD/conf.ini"; _rt_conf_auto_sub "$_rt_conf_path"
    cd parent || return 1
    _rt_my_git flatten go >"$_rt_out" 2>"$_rt_err"
    _rt_clean "nothing touched after refusal" || return 1
    _rt_absent "no .git.real created" src/.git.real || return 1
    _rt_isdir "original .git still a real dir" src/.git || return 1
    return 0
  }

  test_flatten_realize_gitfile_pointer_embedded() {
    _rt_repo_file myotr x.txt
    mkdir -p src-o && ( cd src-o && git init -q && git config user.email t@t.com && git config user.name t \
      && git commit -q -m init --allow-empty \
      && git submodule add -q ../myotr myotr >/dev/null 2>&1 && git commit -q -m add )
    _rt_repo global
    ( cd global && git clone -q ../src-o src && git -C src submodule update --init --recursive -q
      _sha=$(git -C src rev-parse HEAD)
      git update-index --add --cacheinfo 160000,"$_sha",src
      git commit -q -m addsrc )
    _rt_conf_path="$PWD/conf.ini"; _rt_conf_auto_emb "$_rt_conf_path"
    cd global || return 1
    _rt_my_git flatten go >"$_rt_out" 2>"$_rt_err"
    _rt_isdir "myotr/.git.real created from the gitfile pointer" src/myotr/.git.real || return 1
    _rt_ok "myotr/.git.real has real history" git --git-dir=src/myotr/.git.real log --oneline || return 1
    return 0
  }

  test_flatten_partial_apply_graceful() {
    _rt_repo_file myotr x.txt
    mkdir -p src-o && ( cd src-o && git init -q && git config user.email t@t.com && git config user.name t \
      && git commit -q -m init --allow-empty \
      && git submodule add -q ../myotr myotr >/dev/null 2>&1 && git commit -q -m add )
    _rt_repo global
    ( cd global && git clone -q ../src-o src && git -C src submodule update --init --recursive -q
      _sha=$(git -C src rev-parse HEAD)
      git update-index --add --cacheinfo 160000,"$_sha",src
      git commit -q -m addsrc )
    _rt_conf_path="$PWD/conf.ini"; _rt_conf_auto_emb "$_rt_conf_path"
    cd global || return 1
    touch src/.git/my-git.ignore
    _rt_my_git flatten go >"$_rt_out" 2>"$_rt_err"
    _rt_rc=$?
    [ "$_rt_rc" -eq 0 ] || { _rt_fail "expected exit 0 (graceful), got $_rt_rc"; return 1; }
    _rt_isdir "myotr realized on disk regardless" src/myotr/.git.real || return 1
    _rt_not_contains "no scary top-level ERROR banner" "$_rt_err" "ERROR: git add failed for every path" || return 1
    _rt_clean "index left clean, nothing partially staged" || return 1
    return 0
  }

  test_flatten_followup_run_completes() {
    _rt_repo_file myotr x.txt
    mkdir -p src-o && ( cd src-o && git init -q && git config user.email t@t.com && git config user.name t \
      && git commit -q -m init --allow-empty \
      && git submodule add -q ../myotr myotr >/dev/null 2>&1 && git commit -q -m add )
    _rt_repo global
    ( cd global && git clone -q ../src-o src && git -C src submodule update --init --recursive -q
      _sha=$(git -C src rev-parse HEAD)
      git update-index --add --cacheinfo 160000,"$_sha",src
      git commit -q -m addsrc )
    _rt_conf_path="$PWD/conf.ini"; _rt_conf_auto_emb "$_rt_conf_path"
    cd global || return 1
    touch src/.git/my-git.ignore
    _rt_my_git flatten go >/dev/null 2>&1
