    if [ "$_rt_tracked_real" -gt 0 ]; then
      _rt_fail "myitem/.git.real's internal database got tracked as regular files ($_rt_tracked_real entries!) — the relocated git database must NEVER be swept into the outer repo's own history"
      return 1
    fi
    return 0
  }

