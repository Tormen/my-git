  test_shadow_keeps_git_live_and_parent_tracks() {
    # shadow = content-mirror: the nested repo's LIVE .git is KEPT (so IDE git
    # keeps working) AND the parent starts tracking its files too. Analyze is
    # read-only; 'go' does the move-aside bootstrap and commits.
    _rt_repo_file kid_o k.txt
    _rt_repo top
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd top && git clone -q ../kid_o kid >/dev/null 2>&1 )   # embedded nested LIVE repo
    cd top || return 1
    _kid_head_before=$(git -C kid rev-parse HEAD 2>/dev/null)
    # analyze changes nothing
    _rt_ok "shadow analyze" _rt_my_git shadow kid || return 1
    _rt_contains "analyze names the repo" "$_rt_out" "kid" || return 1
    if [ -n "$(git ls-files -- kid 2>/dev/null | head -1)" ]; then
      _rt_fail "analyze must NOT stage/track kid's files"; return 1
    fi
    # go
    _rt_ok "shadow go" _rt_my_git shadow go kid || return 1
    _rt_isdir ".git kept LIVE" kid/.git || return 1
    _khb=$(git -C kid rev-parse HEAD 2>/dev/null)
    [ "$_khb" = "$_kid_head_before" ] || { _rt_fail "nested repo HEAD changed: $_kid_head_before != $_khb"; return 1; }
    if [ -z "$(git ls-files -- kid/k.txt 2>/dev/null | head -1)" ]; then
      _rt_fail "parent should now track kid/k.txt (content-mirror)"; return 1
    fi
    # tracked as plain content, NOT a gitlink
    _rt_gitlink_mode "kid/k.txt tracked as blob not gitlink" kid/k.txt 100644 || return 1
    _rt_clean "commit left the tree clean" || return 1
    # the .git.shadow.status marker exists, is parent-tracked, and carries both
    # timestamps
    _rt_exists "shadow marker written" kid/.git.shadow.status || return 1
    [ -n "$(git ls-files -- kid/.git.shadow.status 2>/dev/null | head -1)" ] || { _rt_fail "marker should be parent-tracked"; return 1; }
    _rt_contains "marker has first-shadowed" kid/.git.shadow.status "first-shadowed:" || return 1
    _rt_contains "marker has last-shadowed" kid/.git.shadow.status "last-shadowed:" || return 1
    # the marker is excluded from the NESTED repo's own status (stays clean)
    _kid_dirt=$(git -C kid status --porcelain 2>/dev/null)
    [ -z "$_kid_dirt" ] || { _rt_fail "nested repo should stay clean (marker excluded), got: $(printf '%s' "$_kid_dirt" | tr '\n' '|')"; return 1; }
    # st tags it [shadowed], not [raw-nested-git]
    _rt_ok "st shows the shadowed repo" _rt_my_git st "$PWD" || return 1
    # The tag now NAMES the mirroring repo: '[shadowed -> <repo>]'.
    _rt_contains "tagged [shadowed @<repo>]" "$_rt_out" "[shadowed @" || return 1
    _rt_not_contains "not tagged [raw-nested-git]" "$_rt_out" "[raw-nested-git]" || return 1
    return 0
  }

  test_shadow_status_preserves_first_bumps_last() {
    # Re-shadowing the same repo must PRESERVE first-shadowed and only move
