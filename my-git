  test_flatten_never_tracks_git_real_internals() {
    # CRITICAL: GIT_SIDECAR_DIRNAME ('.git.real' by default) is NOT the
    # standard '.git' name git recognizes as a repository boundary —
    # left unexcluded, 'git add' on a realized item's path walks
    # straight into it and stages its ENTIRE git database
