  test_ignore_unignore_toggles_marker() {
    # 'ignore'/'unignore' follow the analyze/go idiom (like flatten/unshadow):
    # analyze by default, 'go' applies. Bare 'unignore' acts tree-wide; bare
    # 'ignore' is refused (no bulk ignore-everything). Marker toggle drives the
    # [.., ignored] tag.
    _rt_repo_file kid_o x.txt
    _rt_repo root
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd root && git clone -q ../kid_o kid >/dev/null 2>&1 )
    cd root || return 1
    # analyze must NOT write.
    _rt_ok "ignore kid (analyze)" _rt_my_git ignore kid || return 1
    _rt_contains "analyze shows the plan" "$_rt_out" "mark ignored" || return 1
    _rt_absent "analyze wrote nothing" kid/.git/my-git.ignore || return 1
    # go applies.
    _rt_ok "ignore go kid" _rt_my_git ignore go kid || return 1
    _rt_exists "marker written by go" kid/.git/my-git.ignore || return 1
    _rt_ok "st -R after ignore" _rt_my_git -R st || return 1
    grep 'kid' "$_rt_out" | grep -q ', ignored\]' \
      || { _rt_fail "kid should be tagged [.., ignored] after ignore go"; return 1; }
    # idempotent go.
    _rt_ok "ignore go again" _rt_my_git ignore go kid || return 1
    _rt_contains "reports no-op" "$_rt_out" "no-op" || return 1
    # bare 'ignore go' (no path) is refused — no bulk ignore-everything.
    if _rt_my_git ignore go >"$_rt_out" 2>"$_rt_err"; then
      _rt_fail "bare 'ignore go' (no path) should be refused"; return 1
    fi
    # bare 'unignore' acts tree-wide: analyze lists kid, changes nothing.
    _rt_ok "unignore (bulk analyze)" _rt_my_git unignore || return 1
    _rt_contains "bulk analyze lists kid" "$_rt_out" "kid" || return 1
    _rt_exists "bulk analyze wrote nothing" kid/.git/my-git.ignore || return 1
    # bulk go removes it.
    _rt_ok "unignore go (bulk)" _rt_my_git unignore go || return 1
    _rt_absent "marker removed by bulk go" kid/.git/my-git.ignore || return 1
    # bare unignore with nothing ignored -> graceful message, not an error.
    _rt_ok "unignore again (nothing left)" _rt_my_git unignore || return 1
    _rt_contains "nothing to unignore" "$_rt_out" "nothing to unignore" || return 1
    return 0
  }

  test_unsm_deregisters_submodule_to_raw_nested_git() {
    # 'unsm' reverses 'sm': de-absorbs the gitdir (.git/modules/<name> ->
    # <path>/.git), drops the .gitmodules entry + index gitlink, keeps the
    # repo LIVE with history intact, and self-commits the parent. Analyze
    # changes nothing; st then tags it [raw-nested-git].
    _rt_repo_file origin_o a.txt
    ( cd origin_o && echo b > b.txt && git add b.txt && git commit -q -m o2 )
    _rt_repo parent
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd parent && git -c protocol.file.allow=always submodule add -q ../origin_o sub >/dev/null 2>&1 \
        && git commit -q -m addsub )
    cd parent || return 1
    [ -f sub/.git ] || { _rt_fail "setup: sub/.git should be an absorbed gitfile pointer"; return 1; }
    _rt_isdir "absorbed gitdir present" .git/modules/sub || return 1
    # analyze: no change.
    _rt_ok "unsm (analyze)" _rt_my_git unsm || return 1
    _rt_contains "plan mentions raw-nested-git" "$_rt_out" "raw-nested-git" || return 1
    [ -f sub/.git ] || { _rt_fail "analyze must not de-absorb"; return 1; }
    # go.
    _rt_ok "unsm go" _rt_my_git unsm go || return 1
    _rt_isdir "sub/.git is now a real dir" sub/.git || return 1
    _rt_absent "absorbed gitdir removed" .git/modules/sub || return 1
    _rt_absent ".gitmodules gone (only sub was registered)" .gitmodules || return 1
    [ "$(git ls-files -s sub 2>/dev/null | wc -l | tr -d ' ')" -eq 0 ] \
      || { _rt_fail "index gitlink for sub must be gone"; return 1; }
    [ "$(git -C sub rev-list --count HEAD 2>/dev/null)" -eq 2 ] \
      || { _rt_fail "sub history must be intact (2 commits)"; return 1; }
    git log -1 --format=%s | grep -q 'unsm' \
      || { _rt_fail "parent must have self-committed the de-registration"; return 1; }
    # st now tags it raw-nested-git.
    _rt_ok "st -R" _rt_my_git -R st || return 1
    grep 'sub' "$_rt_out" | grep -q 'raw-nested-git' \
      || { _rt_fail "sub should be [raw-nested-git] after unsm"; return 1; }
    return 0
  }

  test_unsm_proceeds_with_orphan_absorbed_gitdir() {
    # A submodule with BOTH a live .git DIR (what git uses) AND a leftover
    # absorbed .git/modules/<name> (e.g. two copies of the SAME history):
    # unsm must NOT refuse (unlike flatten's relocate) — it uses the live
    # .git, de-registers, and leaves the orphan in place.
    _rt_repo_file origin_o a.txt
    _rt_repo parent
    _rt_conf_path="$PWD/conf.ini"; _rt_conf "$_rt_conf_path"
    ( cd parent && git -c protocol.file.allow=always submodule add -q ../origin_o sub >/dev/null 2>&1 \
        && git commit -q -m addsub )
    cd parent || return 1
    # turn the absorbed gitfile pointer into a live .git DIR, KEEPING .git/modules/sub.
    # Clear the copied-in core.worktree via --file (a plain 'git -C' would try to
    # chdir into that now-wrong relative path and fail — same reason the real
    # orphaned modules gitdir can't resolve).
    rm -f sub/.git
    cp -R .git/modules/sub sub/.git
    git config --file sub/.git/config --unset core.worktree 2>/dev/null || true
    { [ -d sub/.git ] && [ -d .git/modules/sub ]; } || { _rt_fail "setup: need both live .git and absorbed"; return 1; }
    # must proceed, not refuse on ambiguity.
    _rt_ok "unsm go (both gitdirs present)" _rt_my_git unsm go || return 1
    _rt_isdir "sub stays live" sub/.git || return 1
    _rt_absent ".gitmodules gone" .gitmodules || return 1
    [ "$(git ls-files -s sub 2>/dev/null | wc -l | tr -d ' ')" -eq 0 ] \
      || { _rt_fail "gitlink removed from index"; return 1; }
    [ "$(git -C sub rev-list --count HEAD 2>/dev/null)" -ge 1 ] \
      || { _rt_fail "sub history intact"; return 1; }
    return 0
  }

