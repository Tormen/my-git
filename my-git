    _rt_ok "sidecar sc" _rt_my_git flatten go sc --sidecar || return 1
    rm -f .gitignore
    git add -f sc/.git.real >/dev/null 2>&1
    git commit -q -m "break: track internals" >/dev/null 2>&1
    # user stages an unrelated change, then runs repair
    echo "user work" > mine.txt
    git add mine.txt
    _rt_ok "repair with a dirty index" _rt_my_git repair --sidecar go "$PWD" || return 1
    _rt_contains "repair warns it skipped (B)" "$_rt_out" "your index already has staged changes" || return 1
    # user's staged file is still staged and uncommitted, internals still tracked
    git diff --cached --name-only | grep -qx mine.txt || { _rt_fail "repair disturbed the user's staged change"; return 1; }
    [ -n "$(git ls-files -- 'sc/.git.real/*' 2>/dev/null)" ] || { _rt_fail "repair untracked internals despite dirty index"; return 1; }
    return 0
  }

