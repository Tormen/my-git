    '--create-config[Write default config to first writable location]::target file:_files'
    '--run-tests[Run the built-in self-test suite]::name/pattern filter:'
    '(-h --help)'{-h,--help}'[Show help]::topic:->helptopic'
  )

  _arguments -s -C : \
    $global_opts \
    '1: :->cmd' \
    '*::arg:->args'

