    _rt_ok "shadow go (set up)" _rt_my_git shadow go kid || return 1
    [ -n "$(git ls-files -- kid/k.txt 2>/dev/null | head -1)" ] || { _rt_fail "setup: parent should track kid/k.txt"; return 1; }
    # analyze changes nothing
    _rt_ok "unshadow analyze" _rt_my_git unshadow kid || return 1
    [ -n "$(git ls-files -- kid/k.txt 2>/dev/null | head -1)" ] || { _rt_fail "analyze must NOT untrack"; return 1; }
    # go
    _rt_ok "unshadow go" _rt_my_git unshadow go kid || return 1
    if [ -n "$(git ls-files -- kid 2>/dev/null | head -1)" ]; then
      _rt_fail "parent should no longer track kid's files"; return 1
    fi
    _rt_isdir ".git still live after unshadow" kid/.git || return 1
    _rt_exists "worktree file still on disk" kid/k.txt || return 1
    # the marker file is removed from disk and its exclude line dropped
    _rt_absent "shadow marker removed" kid/.git.shadow.status || return 1
    if grep -qxF '.git.shadow.status' kid/.git/info/exclude 2>/dev/null; then
      _rt_fail "the .git/info/exclude line should have been dropped"; return 1
    fi
    # The removal must be COMMITTED (index-as-is, not the worktree view which
    # would recommit the still-present files). Nothing staged should remain.
    if [ -n "$(git diff --cached --name-only 2>/dev/null | head -1)" ]; then
      _rt_fail "the cached removal should have been committed, not left staged"; return 1
    fi
    # kid is a plain embedded nested repo again — to the parent it now shows as
    # a normal untracked dir ('?? kid/'), which is the correct pre-shadow state.
    return 0
  }

